// Package clipboard renders Tabler's copy button: a button that copies the text of an element (a field's
// value or any element's text) or a literal string, and shows a confirmation for a moment. Tabler's own
// script does the copying (data-bs-toggle="clipboard").
//
//	@form.Group() {
//		@form.Input(form.InputProps{ID: "api-key", Value: key, Readonly: true})
//		@clipboard.Button(clipboard.Props{Target: "api-key", Label: "Copy"})
//	}
package clipboard

import (
	"strconv"

	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/kit"
)

// Style is the look of the button.
type Style string

const (
	StyleButton Style = ""     // a button (btn)
	StyleLink   Style = "link" // a bare icon link, for an input-group-text of a flat input group
)

type Props struct {
	Class      string
	Attributes templ.Attributes
	Style      Style
	Small      bool // btn-sm
	// Target is the id of the element whose value or text is copied.
	Target string
	// Text is copied instead of a Target's content.
	Text string
	// Delay is how long the copied state lasts in milliseconds; 0 = Tabler's default (2000).
	Delay int
	// Label is the button's text, swapped for Feedback after a copy. Without it the button shows only
	// Icon and FeedbackIcon; give it an AriaLabel then.
	Label string
	// Feedback is the text shown (or, for an icon-only button, announced) after a copy; default "Copied".
	Feedback string
	// Icon and FeedbackIcon go before Label and Feedback; an icon-only button defaults to "ti-clipboard"
	// and "ti-check".
	Icon         string
	FeedbackIcon string
	// FeedbackColor colors the confirmation, e.g. "green" (text-green).
	FeedbackColor string
	AriaLabel     string
}

func classes(p Props) string {
	if p.Style == StyleLink {
		return kit.Classes("link-secondary input-group-link border-0 bg-transparent p-0", p.Class)
	}
	return kit.Classes("btn", kit.If(p.Small, "btn-sm"), kit.If(p.Label == "", "btn-icon"), p.Class)
}

func attrs(p Props) templ.Attributes {
	a := templ.Attributes{"data-bs-toggle": "clipboard"}
	if p.Target != "" {
		a["data-bs-target"] = "#" + p.Target
	}
	if p.Text != "" {
		a["data-bs-text"] = p.Text
	}
	if p.Delay > 0 {
		a["data-bs-delay"] = strconv.Itoa(p.Delay)
	}
	if p.AriaLabel != "" {
		a["aria-label"] = p.AriaLabel
	}
	return kit.Attrs(a, p.Attributes)
}

// Button is the copy button.
templ Button(p Props) {
	{{ feedback := kit.Or(p.Feedback, "Copied") }}
	{{ color := kit.If(p.FeedbackColor != "", "text-"+p.FeedbackColor) }}
	<button type="button" class={ classes(p) } { attrs(p)... }>
		if p.Label != "" {
			<span class="clipboard-label">
				if p.Icon != "" {
					@icon.Icon(p.Icon)
				}
				{ p.Label }
			</span>
			<span class={ kit.Classes("clipboard-feedback", color) }>
				if p.FeedbackIcon != "" {
					@icon.Icon(p.FeedbackIcon)
				}
				{ feedback }
			</span>
		} else {
			@icon.Icon(kit.Or(p.Icon, "ti-clipboard"), icon.Props{Class: "clipboard-label"})
			@icon.Icon(kit.Or(p.FeedbackIcon, "ti-check"), icon.Props{Class: kit.Classes("clipboard-feedback", color)})
			<span class="clipboard-feedback visually-hidden">{ feedback }</span>
		}
	</button>
}
