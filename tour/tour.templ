// Package tour renders a guided tour of a page with Driver.js: steps that highlight elements one after
// another with a popover each. Start it from a button with StartAttrs, or on load with AutoStart. Load the
// plugin with Library in the head, before Tabler's stylesheet.
//
//	@tour.Tour(tour.Props{ID: "intro", Steps: []tour.Step{{Element: "#new-project", Title: "New project", Description: "Start here."}}})
//	<button class="btn" { tour.StartAttrs("intro")... }>Show me around</button>
package tour

import (
	"github.com/mind-vm/tabler-templ/cdn"
	"github.com/mind-vm/tabler-templ/internal/plugin"
	"github.com/mind-vm/tabler-templ/versions"
)

// Version is the Driver.js version Library loads.
const Version = versions.Driver

// LibraryURL and StylesheetURL() are Driver.js (on cdn.Base).
// LibraryURL is the file on cdn.Base.
func LibraryURL() string { return cdn.URL("driver.js", Version, "dist/driver.js.iife.js") }

// StylesheetURL is the file on cdn.Base.
func StylesheetURL() string { return cdn.URL("driver.js", Version, "dist/driver.css") }


// Step is a step of a tour.
type Step struct {
	Element     string // a selector; without it the popover sits in the middle of the page
	Title       string
	Description string
	Side        string // "top", "right", "bottom", "left"
	Align       string // "start", "center", "end"
}

type Props struct {
	ID    string // required: StartAttrs start the tour by it
	Steps []Step
	// HideProgress hides "1 of 7"; NoClose hides the close button and keeps the tour open on a click
	// outside it.
	HideProgress bool
	NoClose      bool
	AutoStart    bool // start when the page is ready
	// Options are Driver.js options merged over these, e.g. nextBtnText, doneBtnText.
	Options map[string]any
}

func config(p Props) string {
	steps := make([]map[string]any, len(p.Steps))
	for i, s := range p.Steps {
		pop := map[string]any{"title": s.Title, "description": s.Description}
		if s.Side != "" {
			pop["side"] = s.Side
		}
		if s.Align != "" {
			pop["align"] = s.Align
		}
		steps[i] = map[string]any{"popover": pop}
		if s.Element != "" {
			steps[i]["element"] = s.Element
		}
	}
	buttons := []string{"next", "previous", "close"}
	if p.NoClose {
		buttons = buttons[:2]
	}
	o := map[string]any{"allowClose": !p.NoClose, "overlayClickNext": true, "showButtons": buttons, "showProgress": !p.HideProgress, "steps": steps}
	for k, v := range p.Options {
		o[k] = v
	}
	return plugin.JSON(map[string]any{"options": o, "autoStart": p.AutoStart})
}

// StartAttrs make an element start the tour with that ID on click.
func StartAttrs(id string) templ.Attributes {
	return templ.Attributes{"data-tour-start": id}
}

// Tour is a tour; it renders nothing visible.
templ Tour(p Props) {
	<template id={ p.ID } data-tabler-tour={ config(p) }></template>
	@Script()
}

// Script starts the tours; Tour renders it.
func Script() templ.Component {
	return plugin.Start("tour", `(function () {
	var tours = {};
	document.addEventListener('click', function (e) {
		var t = e.target.closest && e.target.closest('[data-tour-start]');
		if (t && tours[t.getAttribute('data-tour-start')]) tours[t.getAttribute('data-tour-start')].drive();
	});
	return function (root) {
		if (!window.driver || !window.driver.js) return;
		window.tabler_tour = tours;
		root.querySelectorAll('template[data-tabler-tour]').forEach(function (el) {
			if (tours[el.id]) return;
			var c = JSON.parse(el.getAttribute('data-tabler-tour'));
			tours[el.id] = window.driver.js.driver(c.options);
			if (c.autoStart) tours[el.id].drive();
		});
	};
})()`)
}

// Library loads Driver.js and its stylesheet and starts every tour on the page; put it in the head,
// before Tabler's stylesheet.
templ Library() {
	@plugin.Stylesheet(StylesheetURL())
	@plugin.Script(LibraryURL())
	@Script()
}

func init() {
	cdn.Register("tour", "driver.js", Version, "dist/driver.js.iife.js", "dist/driver.css")
}
