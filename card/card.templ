// Package card renders Tabler cards: Card (sizes, surfaces, states, status, link), Header with Title,
// Subtitle and Actions, Body, Footer, and the parts a card can hold: Stamp, Progress, Image.
package card

import (
	"strconv"
	"strings"

	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/kit"
)

type Size string

const (
	SizeDefault Size = ""
	SizeSmall   Size = "sm"
	SizeMedium  Size = "md"
	SizeLarge   Size = "lg"
)

// Edge is where a card's status line sits.
type Edge string

const (
	EdgeTop    Edge = "top"
	EdgeBottom Edge = "bottom"
	EdgeStart  Edge = "start"
)

// Hover is the hover effect of a card that is a link.
type Hover string

const (
	HoverNone   Hover = ""
	HoverPop    Hover = "pop"
	HoverRotate Hover = "rotate"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Section renders <section> instead of <div>, for cards that form a page region.
	Section bool
	// Href makes the whole card a link (card-link).
	Href  string
	Hover Hover
	Size  Size // body padding (card-sm, card-md, card-lg)
	// Surfaces and states.
	Borderless  bool
	Dashed      bool
	Transparent bool // no background either; on Footer: card-footer-transparent
	Stacked     bool // a second edge behind the card: more items of the kind
	Active      bool
	Inactive    bool // faded until hovered
	// Status is a color line at StatusEdge (default top), e.g. "primary", "red".
	Status     string
	StatusEdge Edge
	// Gradient is a colored gradient background: "default", a color ("primary", "blue" …) or a named
	// gradient ("rainbow", "sun"); GradientEdge starts it from "start", "end" or "bottom";
	// GradientAnimated moves it.
	// Rotate tilts the card: "start", "end", "left" or "right" (card-rotate-*).
	Rotate           string
	Gradient         string
	GradientEdge     string
	GradientAnimated bool
	// Light tints a Header (card-header-light).
	Light bool
	// Scrollable keeps a long Body inside the card (card-body-scrollable); give it a height.
	Scrollable bool
	// Level is the heading level of a Title (2–6), default 3.
	Level int
}

func level(n int) string {
	if n >= 2 && n <= 6 {
		return string(rune('0' + n))
	}
	return "3"
}

func attrs(p Props) templ.Attributes {
	if p.ID == "" {
		return p.Attributes
	}
	return kit.Default(kit.Attrs(p.Attributes), "id", p.ID)
}

// Classes returns the class string of a card.
func Classes(p Props) string {
	s := ""
	if p.Size != SizeDefault {
		s = "card-" + string(p.Size)
	}
	return kit.Classes("card", s, kit.If(p.Href != "", "card-link"), kit.If(p.Href != "" && p.Hover != HoverNone, "card-link-"+string(p.Hover)),
		kit.If(p.Borderless, "card-borderless"), kit.If(p.Dashed, "card-dashed"), kit.If(p.Transparent, "card-transparent"),
		kit.If(p.Stacked, "card-stacked"), kit.If(p.Active, "card-active"), kit.If(p.Inactive, "card-inactive"), gradient(p), kit.If(p.Rotate != "", "card-rotate-"+p.Rotate), p.Class)
}

func gradient(p Props) string {
	if p.Gradient == "" {
		return ""
	}
	return kit.Classes("card-gradient", kit.If(p.Gradient != "default", "card-gradient-"+p.Gradient),
		kit.If(p.GradientEdge != "", "card-gradient-"+p.GradientEdge), kit.If(p.GradientAnimated, "card-gradient-animated"))
}

templ status(p Props) {
	if p.Status != "" {
		<div class={ "card-status-" + string(kit.Or(string(p.StatusEdge), string(EdgeTop))), "bg-" + p.Status }></div>
	}
}

templ Card(props ...Props) {
	{{ p := kit.First(props) }}
	if p.Href != "" {
		<a href={ templ.URL(p.Href) } class={ Classes(p) } { attrs(p)... }>
			@status(p)
			{ children... }
		</a>
	} else if p.Section {
		<section class={ Classes(p) } { attrs(p)... }>
			@status(p)
			{ children... }
		</section>
	} else {
		<div class={ Classes(p) } { attrs(p)... }>
			@status(p)
			{ children... }
		</div>
	}
}

templ Header(props ...Props) {
	{{ p := kit.First(props) }}
	<div class={ kit.Classes("card-header", kit.If(p.Light, "card-header-light"), p.Class) } { attrs(p)... }>
		{ children... }
	</div>
}

templ Title(props ...Props) {
	{{ p := kit.First(props) }}
	{{ c := kit.Classes("card-title", p.Class) }}
	switch level(p.Level) {
		case "2":
			<h2 class={ c } { attrs(p)... }>
				{ children... }
			</h2>
		case "4":
			<h4 class={ c } { attrs(p)... }>
				{ children... }
			</h4>
		case "5":
			<h5 class={ c } { attrs(p)... }>
				{ children... }
			</h5>
		case "6":
			<h6 class={ c } { attrs(p)... }>
				{ children... }
			</h6>
		default:
			<h3 class={ c } { attrs(p)... }>
				{ children... }
			</h3>
	}
}

// Subtitle is a muted line below the Title (card-subtitle).
templ Subtitle(props ...Props) {
	{{ p := kit.First(props) }}
	<p class={ kit.Classes("card-subtitle", p.Class) } { attrs(p)... }>
		{ children... }
	</p>
}

// Actions sits at the right end of a Header.
templ Actions(props ...Props) {
	{{ p := kit.First(props) }}
	<div class={ kit.Classes("card-actions", p.Class) } { attrs(p)... }>
		{ children... }
	</div>
}

templ Body(props ...Props) {
	{{ p := kit.First(props) }}
	<div class={ kit.Classes("card-body", kit.If(p.Scrollable, "card-body-scrollable"), p.Class) } { attrs(p)... }>
		{ children... }
	</div>
}

templ Footer(props ...Props) {
	{{ p := kit.First(props) }}
	<div class={ kit.Classes("card-footer", kit.If(p.Transparent, "card-footer-transparent"), p.Class) } { attrs(p)... }>
		{ children... }
	</div>
}

type StampProps struct {
	Class     string
	Icon      string // default "ti-star"; children replace the icon
	Large     bool   // card-stamp-lg
	Color     string // background of the circle, e.g. "yellow"
	TextColor string // color of the icon, e.g. "primary" on a white circle
}

// Stamp is a large, faded icon in the card's top corner; put it before the Body.
templ Stamp(p StampProps) {
	<div class={ kit.Classes("card-stamp", kit.If(p.Large, "card-stamp-lg"), p.Class) }>
		<div class={ kit.Classes("card-stamp-icon", kit.If(p.Color != "", "bg-"+p.Color), kit.If(p.TextColor != "", "text-"+p.TextColor)) }>
			if p.Icon != "" {
				@icon.Icon(p.Icon)
			} else {
				@icon.Icon("ti-star")
			}
			{ children... }
		</div>
	</div>
}

type ProgressProps struct {
	Class string
	Value int    // percent, 0–100
	Label string // aria-label, e.g. "94% used"
	Color string // bar color, e.g. "red"
}

// Progress is a progress bar along the card's edge; make it the first or the last child.
templ Progress(p ProgressProps) {
	<div class={ kit.Classes("progress card-progress", p.Class) }>
		<div
			class={ kit.Classes("progress-bar", kit.If(p.Color != "", "bg-"+p.Color)) }
			style={ "width: " + strconv.Itoa(p.Value) + "%" }
			role="progressbar"
			aria-valuenow={ strconv.Itoa(p.Value) }
			aria-valuemin="0"
			aria-valuemax="100"
			if p.Label != "" {
				aria-label={ p.Label }
			}
		></div>
	</div>
}

// ImagePlace is where an Image sits in the card; it decides which corners are rounded.
type ImagePlace string

const (
	ImageTop    ImagePlace = "top"
	ImageBottom ImagePlace = "bottom"
	ImageStart  ImagePlace = "start" // beside the body (fill the column: Class "w-100 h-100 object-cover")
	ImageEnd    ImagePlace = "end"
	ImageFull   ImagePlace = "full" // the whole card, e.g. under an Overlay (card-img)
)

type ImageProps struct {
	Class string
	Src   string
	Alt   string
	Place ImagePlace // default ImageTop
	// Bottom places the image below the body; same as Place ImageBottom.
	Bottom bool
}

func imageClass(p ImageProps) string {
	place := p.Place
	if p.Bottom {
		place = ImageBottom
	}
	switch place {
	case ImageFull:
		return "card-img"
	case "":
		place = ImageTop
	}
	return "card-img-" + string(place)
}

templ Image(p ImageProps) {
	<img src={ p.Src } alt={ p.Alt } class={ kit.Classes(imageClass(p), p.Class) }/>
}

// Overlay puts its children over a full-card Image (card-img-overlay); Dark adds a gradient that keeps
// light text readable.
templ Overlay(dark bool) {
	<div class={ kit.Classes("card-img-overlay", kit.If(dark, "card-img-overlay-dark")) }>
		{ children... }
	</div>
}

type CoverProps struct {
	Class   string // e.g. "text-center text-white"
	Image   string
	Blurred bool
}

// Cover is a header with a darkened background photo (card-cover); the children are its text.
templ Cover(p CoverProps) {
	<div class={ kit.Classes("card-cover", kit.If(p.Blurred, "card-cover-blurred"), p.Class) } style={ "background-image: url(" + p.Image + ")" }>
		{ children... }
	</div>
}

// Button is a full-width action at the bottom of a card (card-btn); several side by side form a bar,
// put them in a <div class="d-flex">. An icon color is optional, e.g. "muted".
templ Button(href, ic string, iconColor ...string) {
	<a href={ templ.URL(href) } class="card-btn">
		if ic != "" {
			@icon.Icon(ic, icon.Props{Class: "me-2", Color: strings.Join(iconColor, "")})
		}
		{ children... }
	</a>
}

// Meta is the muted line that goes with a title, e.g. a role or a date (card-meta).
templ Meta() {
	<div class="card-meta">
		{ children... }
	</div>
}

// Code replaces the Body for a code block that sits flush against the card edges (card-code).
templ Code() {
	<div class="card-code">
		{ children... }
	</div>
}

type DropdownProps struct {
	Class string
	Label string // aria-label of the button, default "More actions"
}

// Dropdown is the "more" button of a card header with its menu; the children are dropdown.Items.
templ Dropdown(p DropdownProps) {
	<div class={ kit.Classes("dropdown", p.Class) }>
		<button type="button" class="btn btn-action" data-bs-toggle="dropdown" aria-expanded="false" aria-label={ kit.Or(p.Label, "More actions") }>
			@icon.Icon("ti-dots-vertical")
		</button>
		<div class="dropdown-menu dropdown-menu-end">
			{ children... }
		</div>
	</div>
}
