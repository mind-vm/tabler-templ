package htmx

import (
	"github.com/mind-vm/tabler-templ/internal/csp"
	"github.com/mind-vm/tabler-templ/kit"
	"github.com/mind-vm/tabler-templ/toast"
)

type SetupProps struct {
	// AllowEval keeps htmx's eval (hx-on, js: in hx-vals); off by default, for a Content-Security-Policy
	// without 'unsafe-eval'.
	AllowEval bool
	// Offline is shown when a request does not reach the server; default kit.T(ctx).Offline.
	Offline string
	// ErrorText is shown when the server answers with an error htmx would not swap in (e.g. a 500 from a
	// handler that did not use Error); default kit.T(ctx).ErrorGeneric.
	ErrorText string
	// ToastPosition places the toast container, default bottom right.
	ToastPosition toast.Position
	// DialogSize is a modal size class for the dialog, e.g. "modal-lg"; default the normal width.
	DialogSize string
}

// Setup is the page's htmx client, once per page at the end of <body>, after Tabler's script (a second
// Setup on the page renders its elements but adds no listeners):
//   - the toast container (Toast, Error) and an empty dialog (a Tabler modal) that opens when content is
//     swapped into it (hx-target={ htmx.Target(htmx.DialogContentID) }) and closes on CloseDialog;
//   - htmx's configuration: 422 responses are swapped in (forms with errors), eval is off;
//   - toasts for a lost connection and for errors htmx would drop silently; a toast closes once an
//     action in it (an Undo button with hx-post) succeeded;
//   - Tabler after swaps: tooltips and popovers in new content start, charts in replaced content are torn
//     down first.
templ Setup(props ...SetupProps) {
	{{ p := kit.First(props) }}
	@toast.Container(toast.ContainerProps{Position: positionOr(p.ToastPosition), Attributes: templ.Attributes{"id": ToastsID, "aria-live": "polite"}})
	<div class="modal modal-blur fade" id={ DialogID } tabindex="-1" aria-hidden="true">
		<div class={ kit.Classes("modal-dialog modal-dialog-centered", p.DialogSize) } role="document">
			<div class="modal-content" id={ DialogContentID }></div>
		</div>
	</div>
	<script { csp.Nonce(ctx)... } data-allow-eval?={ p.AllowEval } data-offline={ kit.Or(p.Offline, kit.T(ctx).Offline) } data-error={ kit.Or(p.ErrorText, kit.T(ctx).ErrorGeneric) } data-close-event={ EventCloseDialog } data-toasts={ ToastsID } data-dialog={ DialogID } data-dialog-content={ DialogContentID }>
		(function () {
			'use strict';
			var me = document.currentScript;
			if (!window.htmx) { console.warn('htmx.Setup: htmx is not loaded (htmx.Library in the head)'); return; }
			// Once per page: a second Setup (or one swapped in again with hx-boost) adds no listeners.
			if (window.kitHtmxSetup) return;
			window.kitHtmxSetup = true;
			var ids = { toasts: me.dataset.toasts, dialog: me.dataset.dialog, content: me.dataset.dialogContent };
			var offline = me.dataset.offline, failed = me.dataset.error, closeEvent = me.dataset.closeEvent;
			// Elements are looked up when needed, so a page whose body was swapped still finds them.
			var el = function (id) { return document.getElementById(id); };
			var warned = false;
			var bs = function () {
				var b = window.tabler && window.tabler.Modal ? window.tabler : window.bootstrap;
				if (!b && !warned) { warned = true; console.warn('htmx.Setup: Tabler\'s script is not loaded; toasts fall back to plain ones and the dialog does not open'); }
				return b;
			};
			var cfg = htmx.config;
			cfg.allowEval = me.hasAttribute('data-allow-eval');
			cfg.historyRestoreAsHxRequest = false;
			cfg.responseHandling = [
				{ code: '204', swap: false },
				{ code: '[23]..', swap: true },
				{ code: '422', swap: true },
				{ code: '[45]..', swap: false, error: true },
				{ code: '...', swap: false }
			];
			var showToasts = function () {
				var box = el(ids.toasts);
				if (!box) return;
				box.querySelectorAll('.toast:not([data-kit-shown])').forEach(function (t) {
					t.setAttribute('data-kit-shown', '');
					var b = bs();
					if (b && b.Toast) {
						b.Toast.getOrCreateInstance(t).show();
						t.addEventListener('hidden.bs.toast', function () { t.remove(); });
					} else {
						t.classList.add('show');
						var d = parseInt(t.getAttribute('data-bs-delay') || '5000', 10);
						if (t.getAttribute('data-bs-autohide') !== 'false') setTimeout(function () { t.remove(); }, d);
					}
				});
			};
			var say = function (text) {
				var box = el(ids.toasts);
				if (!box) return;
				var t = document.createElement('div');
				t.className = 'toast toast-danger kit-htmx-toast';
				t.setAttribute('role', 'alert');
				t.setAttribute('data-bs-delay', '6000');
				var body = document.createElement('div');
				body.className = 'toast-body';
				body.textContent = text;
				t.appendChild(body);
				box.appendChild(t);
				showToasts();
			};
			var modal = function () { var b = bs(), d = el(ids.dialog); return b && b.Modal && d ? b.Modal.getOrCreateInstance(d) : null; };
			// htmx.Error answers with its real status and retargets the toast container: swap those in.
			document.addEventListener('htmx:beforeSwap', function (e) {
				var xhr = e.detail.xhr;
				if (xhr && xhr.status >= 400 && xhr.getResponseHeader('HX-Retarget') === '#' + ids.toasts) {
					e.detail.shouldSwap = true;
					e.detail.isError = false;
					e.detail.target = el(ids.toasts);
				}
				var t = e.detail.target;
				if (t && window.tablerCharts && window.tablerCharts.destroy && e.detail.shouldSwap) window.tablerCharts.destroy(t);
			});
			document.addEventListener('htmx:afterSettle', function (e) {
				showToasts();
				var root = e.detail.elt;
				var b = bs();
				if (root && root.querySelectorAll && b) {
					if (b.Tooltip) root.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (x) { b.Tooltip.getOrCreateInstance(x); });
					if (b.Popover) root.querySelectorAll('[data-bs-toggle="popover"]').forEach(function (x) { b.Popover.getOrCreateInstance(x); });
				}
				var d = el(ids.dialog);
				if (root && root.id === ids.content && root.children.length && d && !d.classList.contains('show')) {
					var m = modal();
					if (m) m.show();
				}
			});
			document.addEventListener('htmx:oobAfterSwap', showToasts);
			document.addEventListener(closeEvent, function () { var m = modal(); if (m) m.hide(); });
			document.addEventListener('hidden.bs.modal', function (e) {
				if (!e.target || e.target.id !== ids.dialog) return;
				if (window.tablerCharts && window.tablerCharts.destroy) window.tablerCharts.destroy(e.target);
				var c = el(ids.content);
				if (c) c.replaceChildren();
			});
			// An action in a toast (e.g. Undo) closes it once it succeeded; closing it before would remove the
			// element and htmx would cancel the request.
			document.addEventListener('htmx:afterRequest', function (e) {
				var x = e.detail.elt, t = x && x.closest && x.closest('#' + ids.toasts + ' .toast');
				if (!t || !e.detail.successful) return;
				var b = bs();
				if (b && b.Toast) b.Toast.getOrCreateInstance(t).hide(); else t.remove();
			});
			document.addEventListener('htmx:sendError', function () { say(offline); });
			document.addEventListener('htmx:responseError', function () { say(failed); });
		})();
	</script>
}

func positionOr(p toast.Position) toast.Position {
	if p == toast.Static {
		return toast.BottomEnd
	}
	return p
}
