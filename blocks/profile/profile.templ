// Package profile holds the profile blocks of the Tabler preview: the page header of a person
// (shared/components/layout/HeaderProfile) and the card with basic facts (cards/UserInfo).
package profile

import (
	"github.com/mind-vm/tabler-templ/avatar"
	"github.com/mind-vm/tabler-templ/card"
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/iconlist"
	"github.com/mind-vm/tabler-templ/kit"
)

// Fact is an entry of the header's dotted line, e.g. the email; Href links it.
type Fact struct {
	Icon string
	Text string
	Href string
}

type HeaderProps struct {
	Avatar   string
	Initials string
	Name     string
	Bio      string
	Facts    []Fact
	Actions  templ.Component // e.g. a button.List
}

// Header is the page header of a profile page; use it as layout.PageProps.Header.
templ Header(p HeaderProps) {
	<div class="page-header">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-auto">
					@avatar.Avatar(avatar.Props{Src: p.Avatar, Initials: p.Initials, Size: avatar.SizeLarge})
				</div>
				<div class="col">
					<h1 class="fw-bold m-0">{ p.Name }</h1>
					if p.Bio != "" {
						<div class="my-2">{ p.Bio }</div>
					}
					if len(p.Facts) > 0 {
						<div class="list-inline list-inline-dots text-secondary">
							for _, f := range p.Facts {
								<div class="list-inline-item">
									@icon.Icon(f.Icon, icon.Props{Inline: true})
									{ " " }
									if f.Href != "" {
										<a href={ templ.URL(f.Href) } class="text-reset">{ f.Text }</a>
									} else {
										{ f.Text }
									}
								</div>
								{ " " }
							}
						</div>
					}
				</div>
				if p.Actions != nil {
					<div class="col-auto ms-auto">
						@p.Actions
					</div>
				}
			</div>
		</div>
	</div>
}

// Item is a line of Info: an icon, a label and the value (Value or, with markup, Content).
type Item struct {
	Icon    string
	Label   string // e.g. "Went to:"
	Value   string
	Content templ.Component // replaces Value, e.g. a flag and a country
}

// Info is the card with a person's basic facts.
templ Info(title string, items []Item) {
	@card.Card() {
		@card.Body() {
			<h2 class="card-title">{ kit.Or(title, "Basic info") }</h2>
			@iconlist.List() {
				for _, it := range items {
					@iconlist.Item(iconlist.ItemProps{Icon: it.Icon}) {
						<span>
							{ it.Label }
							<strong>
								if it.Content != nil {
									@it.Content
								} else {
									{ it.Value }
								}
							</strong>
						</span>
					}
				}
			}
		}
	}
}
