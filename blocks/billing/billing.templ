// Package billing holds the billing parts of the Tabler preview: the subscription with its usage, the
// list of invoices, the payment methods, a card for billing details, cancelling the subscription, and
// the checkout page (pay).
package billing

import (

	"github.com/mind-vm/tabler-templ/badge"
	"github.com/mind-vm/tabler-templ/button"
	"github.com/mind-vm/tabler-templ/card"
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/kit"
	"github.com/mind-vm/tabler-templ/listgroup"
	"github.com/mind-vm/tabler-templ/payment"
	"github.com/mind-vm/tabler-templ/progress"
)

type CardProps struct {
	Class    string
	Title    string
	Subtitle string
	Action   templ.Component // at the end of the header, e.g. a small button
}

templ header(p CardProps) {
	@card.Header() {
		<div>
			<h2 class="card-title">{ p.Title }</h2>
			if p.Subtitle != "" {
				<p class="card-subtitle">{ p.Subtitle }</p>
			}
		</div>
		if p.Action != nil {
			@card.Actions() {
				@p.Action
			}
		}
	}
}

// Card is a billing card with a title, a subtitle and an action in the header; the children follow, e.g.
// a card.Body with a datagrid of billing details.
templ Card(p CardProps) {
	@card.Card(card.Props{Class: p.Class}) {
		@header(p)
		{ children... }
	}
}

// Usage is the metered part of a plan.
type Usage struct {
	Label string // e.g. "Monthly requests"
	Used  string // e.g. "7,420"
	Limit string // e.g. "/ 10,000"
	Value float64 // percent
	Text  string // below the bar
}

type PlanProps struct {
	Name        string // e.g. "Pro plan"
	Status      string // a badge after the name, e.g. "Active"
	StatusColor string // default "success"
	Renews      string // e.g. "Renews on September 18, 2026"
	Price       string // e.g. "$49"
	Period      string // e.g. "/month"
	Action      templ.Component // e.g. a small "Change plan" button
	Usage       *Usage
	// Details follow in a second body, e.g. a datagrid.
	Details templ.Component
}

// Plan is the current subscription: name and status, price, usage and details.
templ Plan(p PlanProps) {
	@card.Card() {
		@card.Header(card.Props{Class: "flex-wrap gap-3"}) {
			<div>
				<h2 class="card-title">
					{ p.Name }
					if p.Status != "" {
						@badge.Badge(badge.Props{Color: kit.Or(p.StatusColor, "success"), Light: true, Class: "ms-1"}) {
							{ p.Status }
						}
					}
				</h2>
				if p.Renews != "" {
					<p class="card-subtitle">{ p.Renews }</p>
				}
			</div>
			@card.Actions(card.Props{Class: "d-flex align-items-center gap-3"}) {
				<div class="d-flex align-items-baseline">
					<span class="h1 m-0">{ p.Price }</span>
					<span class="text-secondary">{ p.Period }</span>
				</div>
				if p.Action != nil {
					@p.Action
				}
			}
		}
		if u := p.Usage; u != nil {
			@card.Body() {
				<div class="d-flex justify-content-between align-items-baseline mb-2">
					<div class="fw-medium">{ u.Label }</div>
					<div>
						<strong>{ u.Used }</strong>
						<span class="text-secondary">{ u.Limit }</span>
					</div>
				</div>
				@progress.Progress(progress.Props{Size: progress.SizeSmall, Value: u.Value, Color: "primary", Class: "mb-2"})
				if u.Text != "" {
					<div class="text-secondary">{ u.Text }</div>
				}
			}
		}
		if p.Details != nil {
			@card.Body() {
				@p.Details
			}
		}
	}
}

// Invoice is a row of Invoices.
type Invoice struct {
	Date        string
	Number      string
	Amount      string
	Status      string // e.g. "Paid", "Open"
	StatusColor string // e.g. "success", "warning"
	PayHref     string // a "Pay now" button when set; "#" for a button without link
	Download    string // the download button's link; "" or "#" for a button without link
	// Labels, default "Pay now" and "Download invoice <Number>".
	PayLabel, DownloadLabel string
}

// Invoices lists invoices with amount, status and actions.
templ Invoices(p CardProps, invoices []Invoice) {
	@Card(p) {
		@listgroup.List(listgroup.Props{Hoverable: true, CardList: true}) {
			for _, in := range invoices {
				@listgroup.Item(listgroup.ItemProps{}) {
					<div class="row align-items-center g-3">
						<div class="col-12 col-sm">
							<div class="fw-medium">{ in.Date }</div>
							<div class="text-secondary">{ in.Number }</div>
						</div>
						<div class="col-auto fw-medium">{ in.Amount }</div>
						<div class="col-auto">
							@badge.Badge(badge.Props{Color: in.StatusColor, Light: true}) {
								{ in.Status }
							}
						</div>
						<div class="col-auto ms-auto ms-sm-0">
							@button.List() {
								if in.PayHref != "" {
									@button.Button(button.Props{Href: kit.If(in.PayHref != "#", in.PayHref), Type: kit.If(in.PayHref == "#", "button"), Variant: button.VariantPrimary, Size: button.SizeSmall}) {
										{ kit.Or(in.PayLabel, "Pay now") }
									}
								}
								@button.Button(button.Props{Href: kit.If(in.Download != "#", in.Download), Type: kit.If(in.Download == "" || in.Download == "#", "button"), Size: button.SizeSmall, Icon: "ti-download", IconOnly: true,
									Attributes: templ.Attributes{"aria-label": kit.Or(in.DownloadLabel, "Download invoice "+in.Number)}})
							}
						</div>
					</div>
				}
			}
		}
	}
}

// Method is a saved payment method.
type Method struct {
	ID       string // the radio's id
	Value    string
	Provider string // payment provider code, e.g. "visa"
	Title    string // e.g. "Visa ending in 4242"
	Detail   string // e.g. "Expires 09/2028"
	Default  bool   // a "Default" badge
	Checked  bool
	// Menu is the content of the method's actions menu (dropdown.Items); MenuLabel its aria-label.
	Menu      templ.Component
	MenuLabel string
}

type MethodsProps struct {
	CardProps
	Name         string // the radio group's name, default "payment-method"
	DefaultLabel string // default "Default"
}

// Methods lets the user pick the default payment method among the saved ones.
templ Methods(p MethodsProps, methods []Method) {
	@Card(p.CardProps) {
		@card.Body() {
			<div class="form-selectgroup form-selectgroup-boxes d-flex flex-column">
				for _, m := range methods {
					<div class="form-selectgroup-item flex-fill">
						<input type="radio" id={ m.ID } name={ kit.Or(p.Name, "payment-method") } value={ m.Value } class="form-selectgroup-input" checked?={ m.Checked }/>
						<div class="form-selectgroup-label d-flex align-items-center p-3">
							<label for={ m.ID } class="d-flex align-items-center flex-fill mb-0">
								<div class="me-3">
									<span class="form-selectgroup-check"></span>
								</div>
								@payment.Payment(m.Provider, payment.Props{Size: payment.SizeSmall, Class: "me-3"})
								<div class="me-auto">
									<div class="fw-medium">{ m.Title }</div>
									<div class="text-secondary">{ m.Detail }</div>
								</div>
								if m.Default {
									@badge.Badge(badge.Props{Color: "primary", Light: true, Class: "me-2"}) {
										{ kit.Or(p.DefaultLabel, "Default") }
									}
								}
							</label>
							if m.Menu != nil {
								<div class="dropdown">
									<button type="button" class="btn btn-action btn-sm" data-bs-toggle="dropdown" aria-expanded="false" aria-label={ kit.Or(m.MenuLabel, "Actions for "+m.Title) }>
										@icon.Icon("ti-dots-vertical")
									</button>
									<div class="dropdown-menu dropdown-menu-end">
										@m.Menu
									</div>
								</div>
							}
						</div>
					</div>
				}
			</div>
		}
	}
}

type CancelProps struct {
	Title  string // default "Cancel subscription"
	Text   string
	Button string // default "Cancel subscription"
	Href   string // a link instead of a button
}

// Cancel explains what happens on cancelling and offers the button.
templ Cancel(p CancelProps) {
	@card.Card() {
		@card.Body() {
			<h2 class="card-title">{ kit.Or(p.Title, "Cancel subscription") }</h2>
			if p.Text != "" {
				<p class="card-subtitle">{ p.Text }</p>
			}
			@button.Button(button.Props{Href: p.Href, Type: kit.If(p.Href == "", "button"), Variant: button.VariantDanger, Ghost: true, Size: button.SizeSmall, Icon: "ti-x"}) {
				{ kit.Or(p.Button, "Cancel subscription") }
			}
		}
	}
}

