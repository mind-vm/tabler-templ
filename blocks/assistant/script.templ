package assistant

import "github.com/mind-vm/tabler-templ/internal/csp"

var styles = csp.Sheet("blocks/assistant", css)

const css = `.assistant-message{max-width:80%;white-space:pre-wrap}
.assistant-composer{position:sticky;bottom:0;z-index:2;margin-top:1.5rem;padding:.75rem 0;background:var(--tblr-body-bg)}
.assistant-turn:has(form[data-ask]) .assistant-working{display:none!important}
fieldset:not(:has([data-other]:checked)) .assistant-other{display:none}
.assistant-step>summary{cursor:pointer;list-style:none}
.assistant-step>summary::-webkit-details-marker{display:none}
.assistant-step pre{white-space:pre-wrap;font-size:12px;max-height:24rem;overflow:auto}
.assistant .prose>:last-child{margin-bottom:0}
.assistant-prompt{display:flex;flex-direction:column;gap:.5rem;padding:.5rem;border:var(--tblr-border-width) solid var(--tblr-border-color);border-radius:var(--tblr-border-radius-lg);background:var(--tblr-bg-surface);box-shadow:var(--tblr-shadow-card)}
.assistant-prompt:focus-within{border-color:var(--tblr-primary)}
.assistant-prompt textarea{border:0;box-shadow:none!important;resize:none;padding:.25rem .5rem;background:transparent}
.assistant-selection{position:absolute;z-index:1060;background:var(--tblr-bg-surface)}
.assistant-thinking>summary,.assistant-sources>summary,.assistant-tools>summary,.assistant-alternatives>summary{cursor:pointer;list-style:none}
.assistant-thinking>summary::-webkit-details-marker,.assistant-sources>summary::-webkit-details-marker,.assistant-tools>summary::-webkit-details-marker,.assistant-alternatives>summary::-webkit-details-marker{display:none}
.assistant-chevron{transition:transform .2s}
details[open]>summary .assistant-chevron{transform:rotate(180deg)}
.assistant-trace{position:relative;display:flex;flex-direction:column;gap:.75rem;padding-left:.25rem}
.assistant-trace>li{position:relative}
.assistant-trace>li:not(:last-child)::before{content:"";position:absolute;left:.5rem;top:1.5rem;bottom:-.75rem;border-left:1px dashed var(--tblr-border-color)}
.assistant-trace pre{font-size:12px;white-space:pre-wrap;max-height:16rem;overflow:auto}
.assistant-cite{display:inline-flex;align-items:center;gap:.25rem;padding:0 .4rem 0 .15rem;border-radius:1rem;background:var(--tblr-bg-surface-secondary);color:var(--tblr-secondary);font-size:.75rem;line-height:1.25rem;text-decoration:none;vertical-align:baseline}
.assistant-cite:hover{color:var(--tblr-body-color);text-decoration:none}
.assistant-cite-mark{display:inline-flex;align-items:center;justify-content:center;flex:none;width:1.25rem;height:1.25rem;overflow:hidden;border-radius:50%;background:var(--tblr-bg-surface);border:1px solid var(--tblr-border-color);font-size:.625rem;font-weight:600;color:var(--tblr-secondary)}
.assistant-cite-mark .icon{width:auto;height:auto;font-size:.75rem;line-height:1;margin:0}
.assistant-stack{display:inline-flex}
.assistant-stack>*+*{margin-left:-.35rem}
.assistant-chip{display:inline-flex;align-items:center;gap:.375rem;max-width:100%;padding:.25rem .625rem;border:1px solid var(--tblr-border-color);border-radius:var(--tblr-border-radius);background:var(--tblr-bg-surface);font-size:.8125rem}
.assistant-chip-failed{border-color:var(--tblr-orange);background:var(--tblr-orange-lt)}
.assistant-task-state{display:inline-flex;align-items:center;justify-content:center;flex:none;width:1.5rem;height:1.5rem;border-radius:50%;font-size:.75rem;background:var(--tblr-bg-surface-secondary);color:var(--tblr-secondary)}
.assistant-task-done{background:var(--tblr-green-lt);color:var(--tblr-green)}
.assistant-task-failed{background:var(--tblr-red-lt);color:var(--tblr-red)}
.assistant-task-running{background:var(--tblr-blue-lt);color:var(--tblr-blue)}
.assistant-substeps{padding-left:2.75rem}
.assistant-lines{counter-reset:line;font-size:12px;line-height:1.6;padding:.5rem 0;overflow:auto;max-height:28rem;background:transparent;color:var(--tblr-body-color);border-radius:0}
.assistant-line{display:block;padding-right:1rem;white-space:pre}
.assistant-line::before{counter-increment:line;content:counter(line);display:inline-block;width:3rem;padding-right:1rem;text-align:right;color:var(--tblr-secondary);opacity:.6;user-select:none}
.assistant-line-add{background:var(--tblr-green-lt)}
.assistant-line-del{background:var(--tblr-red-lt)}
.assistant-line-hunk{color:var(--tblr-blue)}
.assistant-clamp{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.assistant-insight-radio{position:absolute;opacity:0;pointer-events:none}
.assistant-insight{display:none}
.assistant-insight-radio:checked+.assistant-insight{display:block}
.assistant-insight label.disabled{opacity:.35;pointer-events:none}
.assistant-option{display:flex;align-items:center;gap:.75rem;padding:.625rem .75rem;border:1px solid var(--tblr-border-color);border-radius:var(--tblr-border-radius);cursor:pointer}
.assistant-option:has(input:checked){border-color:var(--tblr-primary);background:var(--tblr-primary-lt)}
.assistant-old{color:var(--tblr-red);text-decoration:line-through;margin-right:.375rem}
ins.assistant-new{text-decoration:none;background:var(--tblr-green-lt);color:var(--tblr-green);padding:0 .25rem;border-radius:var(--tblr-border-radius-sm)}
.assistant-diff-rejected td{color:var(--tblr-secondary)}
.assistant-diff-pending{animation:assistant-sweep 1.2s ease-out both}
@keyframes assistant-sweep{from{background:var(--tblr-yellow-lt)}to{background:transparent}}
@media (prefers-reduced-motion:reduce){.assistant-diff-pending{animation:none}}
.assistant-action{padding:.5rem .75rem;border:1px solid var(--tblr-border-color);border-left:3px solid var(--tblr-primary);border-radius:var(--tblr-border-radius);background:var(--tblr-bg-surface)}
.assistant-action-refused{border-left-color:var(--tblr-danger)}
.assistant-action-fields{display:grid;grid-template-columns:auto 1fr;gap:0 .75rem;margin:.375rem 0 0 1.75rem;font-size:.8125rem}
.assistant-action-fields dt{font-weight:400;color:var(--tblr-secondary)}
.assistant-action-fields dd{margin:0;overflow-wrap:anywhere}
.assistant-action [data-action-note]:empty{display:none}
.assistant-filled{background-color:var(--tblr-yellow-lt)!important;border-color:var(--tblr-yellow)!important}
.assistant-shown{outline:3px solid var(--tblr-primary);outline-offset:4px;border-radius:var(--tblr-border-radius);animation:assistant-pulse 1s ease-in-out 3}
@keyframes assistant-pulse{50%{outline-color:transparent}}
@media (prefers-reduced-motion:reduce){.assistant-shown{animation:none}}
.assistant-copilot{--tblr-offcanvas-width:min(440px,100vw)}
@media (min-width:1200px){body:has(.assistant-copilot.show,.assistant-copilot.showing){padding-right:440px}}
.assistant-copilot .offcanvas-body{padding-bottom:0}
.assistant-copilot .assistant-message{max-width:90%}
.assistant-turns:has(.assistant-turn) .assistant-intro{display:none}`

// Styles are the conversation's few rules (once per page; Conversation renders them).
templ Styles() {
	@styles
}

var script = templ.NewOnceHandle()

// Script is the conversation's client (once per page; Conversation renders it): it posts a message to
// the Run URL, reads the event stream and puts each fragment in its slot, and posts the answers to an
// Ask to the Reply URL. A fragment whose id the page already shows replaces it: in place within the
// current turn, moved here from an earlier turn. Charts in replaced content are torn down first.
templ Script() {
	@script.Once() {
		<script { csp.Nonce(ctx)... }>
			(function () {
				'use strict';
				var root = document.querySelector('[data-assistant]');
				if (!root) return;
				var uuid = function () {
					if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
					return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
						var r = Math.random() * 16 | 0;
						return (c === 'x' ? r : (r & 3 | 8)).toString(16);
					});
				};
				var sessionId = root.dataset.session || uuid();
				var turns = root.querySelector('.assistant-turns');
				var composer = root.querySelector('.assistant-composer');
				var input = composer.querySelector('textarea');
				var sendButton = composer.querySelector('button');
				var model = composer.querySelector('select[name="model"]');
				var running = false;
				var actions = []; // run once the stream has ended: an action may leave the page

				var nodes = function (html) {
					var t = document.createElement('template');
					t.innerHTML = html;
					return t.content;
				};
				var dropCharts = function (el) {
					if (window.tablerCharts && window.tablerCharts.destroy) window.tablerCharts.destroy(el);
				};
				var currentTurn = function () {
					var all = turns.querySelectorAll('.assistant-turn');
					return all[all.length - 1];
				};

				function apply(f) {
					if (f.slot === 'turn') {
						var intro = root.querySelector('.assistant-intro');
						if (intro) intro.remove();
						turns.append(nodes(f.html));
						currentTurn().scrollIntoView({ block: 'start', behavior: 'smooth' });
						return;
					}
					var turn = currentTurn();
					var slot = turn && turn.querySelector('[data-slot="' + f.slot + '"]');
					if (!slot) return;
					var frag = nodes(f.html);
					var added = Array.prototype.slice.call(frag.children);
					var old = f.id ? document.getElementById(f.id) : null;
					if (f.mode === 'set') {
						dropCharts(slot);
						slot.replaceChildren(frag);
					} else if (old && turn.contains(old)) {
						if (old.open && added[0]) added[0].open = true;
						dropCharts(old);
						old.replaceWith(frag);
					} else {
						if (old) { dropCharts(old); old.remove(); }
						slot.append(frag);
					}
					if (window.tablerCharts) added.forEach(function (el) { window.tablerCharts.init(el); });
					// Interactive blocks carry hx-* attributes; htmx only knows content it swapped itself.
					if (window.htmx) added.forEach(function (el) { window.htmx.process(el); });
				}

				// Earlier turns drawn by the server (Transcript): start at the latest, also when a panel
				// around the conversation opens later.
				var toEnd = function () {
					var last = currentTurn();
					if (last) last.scrollIntoView({ block: 'start' });
				};
				if (currentTurn()) {
					toEnd();
					var panel = root.closest('.offcanvas');
					if (panel) panel.addEventListener('shown.bs.offcanvas', toEnd);
				}

				// The working line counts the seconds since it appeared.
				setInterval(function () {
					var now = Date.now();
					root.querySelectorAll('.assistant-elapsed').forEach(function (el) {
						if (!el.dataset.t0) el.dataset.t0 = now;
						el.textContent = ((now - el.dataset.t0) / 1000).toFixed(1) + 's';
					});
				}, 100);

				// EventSource cannot POST, and a message does not belong in a URL, so the stream is read
				// from fetch. Only data lines count; an event other than "html" is ignored.
				async function run(message) {
					var res = await fetch(root.dataset.run, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ message: message, sessionId: sessionId, model: model ? model.value : undefined }),
					});
					if (!res.ok || !res.body) throw new Error(res.status + ' ' + (await res.text()));
					var reader = res.body.pipeThrough(new TextDecoderStream()).getReader();
					var buf = '';
					for (;;) {
						var r = await reader.read();
						if (r.done) break;
						buf += r.value;
						var i;
						while ((i = buf.indexOf('\n\n')) >= 0) {
							var frame = buf.slice(0, i);
							buf = buf.slice(i + 2);
							var data = frame.split('\n').filter(function (l) { return l.indexOf('data: ') === 0; })
								.map(function (l) { return l.slice(6); }).join('\n');
							if (!data) continue;
							var e = JSON.parse(data);
							if (e.type === 'html') apply(e.args);
							else if (e.type === 'action') actions.push(e.args);
						}
					}
				}

				async function send(message) {
					message = message.trim();
					if (!message || running) return;
					running = true;
					input.value = '';
					input.disabled = sendButton.disabled = true;
					actions = [];
					try {
						await run(message);
						if (window.kitAssistant) {
							for (var a = 0; a < actions.length; a++) if (!window.kitAssistant.run(actions[a])) break;
						}
					} catch (err) {
						var turn = currentTurn();
						var status = turn && turn.querySelector('[data-slot="status"]');
						if (status) status.textContent = String(err);
					} finally {
						running = false;
						input.disabled = sendButton.disabled = false;
						input.focus();
					}
				}

				composer.addEventListener('submit', function (e) { e.preventDefault(); send(input.value); });
				input.addEventListener('keydown', function (e) {
					if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); send(input.value); }
				});
				root.addEventListener('click', function (e) {
					var ex = e.target.closest('[data-example]');
					if (ex) send(ex.dataset.example);
				});

				// The selection toolbar: shown over text selected inside a turn's answer or blocks.
				var toolbar = root.querySelector('.assistant-selection');
				var picked = '';
				if (toolbar) {
					document.body.append(toolbar);
					var hide = function () { toolbar.hidden = true; };
					document.addEventListener('mouseup', function (e) {
						if (toolbar.contains(e.target)) return;
						setTimeout(function () {
							var sel = window.getSelection();
							var text = sel && !sel.isCollapsed ? sel.toString().trim() : '';
							var node = text && sel.anchorNode;
							var el = node && (node.nodeType === 1 ? node : node.parentElement);
							if (!text || !el || !turns.contains(el) || el.closest('.assistant-message, form')) return hide();
							picked = text;
							var r = sel.getRangeAt(0).getBoundingClientRect();
							toolbar.hidden = false;
							// Relative to the toolbar's offset parent, which need not start at the page's top.
							var o = (toolbar.offsetParent || document.body).getBoundingClientRect();
							toolbar.style.top = (r.top - o.top - toolbar.offsetHeight - 8) + 'px';
							toolbar.style.left = Math.max(8, r.left - o.left + r.width / 2 - toolbar.offsetWidth / 2) + 'px';
						});
					});
					document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });
					toolbar.addEventListener('click', function (e) {
						var b = e.target.closest('[data-selection-prompt]');
						if (!b) return;
						hide();
						window.getSelection().removeAllRanges();
						send(b.dataset.selectionPrompt.replace('%s', '“' + picked + '”'));
					});
				}

				function answerOf(form, submitter) {
					switch (form.dataset.inputType) {
						case 'confirm':
							return { value: !!submitter && submitter.value === 'true' };
						case 'choice':
							return { value: submitter ? submitter.value : '' };
						case 'questions': {
							var value = {};
							var sets = form.querySelectorAll('fieldset[data-question]');
							for (var s = 0; s < sets.length; s++) {
								var fs = sets[s];
								var other = fs.querySelector('.assistant-other');
								other = other ? other.value.trim() : '';
								var picked = [];
								fs.querySelectorAll('input.form-selectgroup-input:checked').forEach(function (box) {
									if (box.dataset.other) { if (other) picked.push(other); } else picked.push(box.value);
								});
								if (!picked.length) {
									return { missing: (root.dataset.missing || '%s').replace('%s', fs.dataset.label || fs.dataset.question) };
								}
								value[fs.dataset.question] = fs.dataset.multi === 'true' ? picked : picked[0];
							}
							return { value: value };
						}
						default:
							return { value: form.elements.text.value };
					}
				}

				root.addEventListener('submit', async function (e) {
					var form = e.target.closest('form[data-ask]');
					if (!form) return;
					e.preventDefault();
					var a = answerOf(form, e.submitter);
					var error = form.querySelector('.assistant-ask-error');
					if (a.missing) {
						if (error) error.textContent = a.missing;
						return;
					}
					var buttons = form.querySelectorAll('button');
					buttons.forEach(function (b) { b.disabled = true; });
					var requestId = form.dataset.ask;
					var res = await fetch(root.dataset.reply, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ sessionId: sessionId, requestId: requestId, value: a.value }),
					});
					if (!res.ok) {
						buttons.forEach(function (b) { b.disabled = false; });
						if (error) error.textContent = await res.text();
						return;
					}
					var card = document.getElementById('ask-' + requestId);
					if (card) card.replaceWith(nodes(await res.text()));
				});
			})();
		</script>
	}
}
