package layout

import (
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/kit"
)

// Notification is an entry of Notifications.
type Notification struct {
	Title  string
	Text   string
	Href   string
	Unread bool   // a pulsing dot in Color
	Color  string // default "red"
	// Starred keeps the star visible; StarHref is the star's link (empty: no star).
	Starred   bool
	StarHref  string
	StarLabel string // aria-label of the star, e.g. "Add to favorites"
}

type NotificationsProps struct {
	Title       string          // default "Notifications"
	CloseLabel  string          // default kit.T(ctx).Close
	ReadLabel   string          // read out for read entries, default "Read"
	UnreadLabel string          // default "Unread"
	Footer      templ.Component // e.g. buttons to archive or mark all as read
}

// Notifications is the card of the navbar's notifications menu; put it into a NavDropdown with Card.
templ Notifications(p NotificationsProps, items []Notification) {
	<div class="card">
		<div class="card-header d-flex">
			<h2 class="card-title">{ kit.Or(p.Title, "Notifications") }</h2>
			<button type="button" class="btn-close ms-auto" data-navbar-notifications-close aria-label={ kit.Or(p.CloseLabel, kit.T(ctx).Close) }></button>
		</div>
		<div class="list-group list-group-flush list-group-hoverable">
			for _, n := range items {
				<div class="list-group-item">
					<div class="row align-items-center">
						<div class="col-auto">
							if n.Unread {
								<span class={ "status-dot status-dot-animated bg-" + kit.Or(n.Color, "red") + " d-block" }><span class="visually-hidden">{ kit.Or(p.UnreadLabel, "Unread") }</span></span>
							} else {
								<span class="status-dot d-block"><span class="visually-hidden">{ kit.Or(p.ReadLabel, "Read") }</span></span>
							}
						</div>
						<div class="col text-truncate">
							<a href={ templ.URL(kit.Or(n.Href, "#")) } class="text-body d-block">{ n.Title }</a>
							<div class="d-block text-secondary text-truncate mt-n1">{ n.Text }</div>
						</div>
						if n.StarHref != "" {
							<div class="col-auto">
								<a href={ templ.URL(n.StarHref) } class={ kit.Classes("list-group-item-actions", kit.If(n.Starred, "show")) } aria-label={ n.StarLabel }>
									@icon.Icon("ti-star", icon.Props{Color: kit.If(n.Starred, "yellow")})
								</a>
							</div>
						}
					</div>
				</div>
			}
		</div>
		if p.Footer != nil {
			<div class="card-body">
				@p.Footer
			</div>
		}
	</div>
}

// App is an entry of Apps.
type App struct {
	Name string
	Icon string // URL of the app's logo
	Href string
}

type AppsProps struct {
	Title         string // default "My Apps"
	SettingsHref  string // a settings button in the header; empty = none
	SettingsLabel string // default "App settings"
}

// Apps is the card of the navbar's app menu (a grid of app logos); put it into a NavDropdown with Card.
templ Apps(p AppsProps, apps []App) {
	<div class="card">
		<div class="card-header">
			<h2 class="card-title">{ kit.Or(p.Title, "My Apps") }</h2>
			if p.SettingsHref != "" {
				<div class="card-actions btn-actions">
					<a href={ templ.URL(p.SettingsHref) } class="btn btn-action" aria-label={ kit.Or(p.SettingsLabel, "App settings") }>
						@icon.Icon("ti-settings")
					</a>
				</div>
			}
		</div>
		<div class="card-body scroll-y p-2" style="max-height: 50vh">
			<div class="row g-0">
				for _, a := range apps {
					<div class="col-4">
						<a href={ templ.URL(kit.Or(a.Href, "#")) } class="d-flex flex-column text-center text-secondary py-2 px-2 link-hoverable">
							<img src={ a.Icon } class="w-6 h-6 mx-auto mb-2" width="24" height="24" alt=""/>
							<span class="h5">{ a.Name }</span>
						</a>
					</div>
				}
			</div>
		</div>
	</div>
}
