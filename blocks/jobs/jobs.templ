// Package jobs holds the job card of the Tabler preview's job listing: company logo, title, salary,
// facts (company, contract, place) and tags.
package jobs

import (
	"github.com/mind-vm/tabler-templ/avatar"
	"github.com/mind-vm/tabler-templ/badge"
	"github.com/mind-vm/tabler-templ/card"
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/kit"
)

// Fact is a line about the job, e.g. the company with an icon.
type Fact struct {
	Icon string
	Text string
}

type JobProps struct {
	Logo   string // URL of the company's logo
	Title  string
	Href   string // default "#"
	Salary string // e.g. "$140,000 - $180,000"
	Facts  []Fact
	Tags   []string
}

// Job is a card for one job offer; the facts form a dotted line on wide screens and a list on small ones.
templ Job(p JobProps) {
	@card.Card() {
		<div class="row g-0">
			<div class="col-auto">
				@card.Body() {
					@avatar.Avatar(avatar.Props{Src: p.Logo, Size: avatar.SizeMedium})
				}
			</div>
			<div class="col">
				@card.Body(card.Props{Class: "ps-0"}) {
					<div class="row">
						<div class="col">
							<h2 class="h3 mb-0">
								<a href={ templ.URL(kit.Or(p.Href, "#")) }>{ p.Title }</a>
							</h2>
						</div>
						if p.Salary != "" {
							<div class="col-auto fs-3 text-green">{ p.Salary }</div>
						}
					</div>
					<div class="row">
						<div class="col-md">
							<div class="mt-3 list-inline list-inline-dots mb-0 text-secondary d-sm-block d-none">
								for _, f := range p.Facts {
									<div class="list-inline-item">
										@icon.Icon(f.Icon, icon.Props{Inline: true})
										{ f.Text }
									</div>
									{ " " }
								}
							</div>
							<div class="mt-3 list mb-0 text-secondary d-block d-sm-none">
								for _, f := range p.Facts {
									<div class="list-item">
										@icon.Icon(f.Icon, icon.Props{Inline: true})
										{ f.Text }
									</div>
								}
							</div>
						</div>
						if len(p.Tags) > 0 {
							<div class="col-md-auto">
								@badge.List(badge.ListProps{Class: "mt-3"}) {
									for _, t := range p.Tags {
										@badge.Badge(badge.Props{Outline: true, Pill: true, Color: "secondary", Class: "fw-normal"}) {
											{ t }
										}
									}
								}
							</div>
						}
					</div>
				}
			</div>
		</div>
	}
}
