// Package stats is a block for key figures in a row, e.g. at the top of a dashboard: label, value, a
// small addition after the value and an optional link to where something needs doing.
//
//	@stats.Row([]stats.Stat{
//		{Label: "Open orders", Value: "12"},
//		{Label: "Volume", Value: "17.396,70 €", Extra: "26 %"},
//		{Label: "To check", Value: "3", Link: "/review", LinkText: "Review"},
//	})
package stats

import (
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/internal/csp"
	"github.com/mind-vm/tabler-templ/kit"
)

type Stat struct {
	Label    string
	Marker   templ.Component // before the label, e.g. a status dot
	Value    string
	Extra    string // small after the value, e.g. a share or a unit
	Link     string // optional; shown after the value with LinkText and an arrow
	LinkText string
}

type Props struct {
	Class string
}

// Row is a strip of tiles in one card; it wraps on narrow screens.
templ Row(items []Stat, props ...Props) {
	{{ p := kit.First(props) }}
	<div class={ kit.Classes("kit-stats", p.Class) }>
		for _, s := range items {
			@Tile(s)
		}
	</div>
}

templ Tile(s Stat) {
	<div class="kit-stat">
		<div class="kit-stat-label">
			if s.Marker != nil {
				@s.Marker
			}
			<span>{ s.Label }</span>
		</div>
		<div class="kit-stat-value">
			<span>{ s.Value }</span>
			if s.Extra != "" {
				<small>{ s.Extra }</small>
			}
			if s.Link != "" {
				<a href={ templ.URL(s.Link) }>
					<span>{ s.LinkText }</span>
					@icon.Icon("ti-arrow-right")
				</a>
			}
		</div>
	</div>
}

// Styles renders the block's CSS; the shell block includes it.
templ Styles() {
	@csp.Style(css)
}

const css = `.kit-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(10.5rem,1fr));margin-bottom:1rem;overflow:hidden;background:var(--tblr-bg-surface);border:var(--tblr-border-width) solid var(--tblr-border-color);border-radius:var(--tblr-border-radius-lg)}
.kit-stat{min-width:0;padding:1.25rem;border-right:var(--tblr-border-width) solid var(--tblr-border-color-translucent,var(--tblr-border-color))}
.kit-stat:last-child{border-right:0}
.kit-stat-label{display:flex;align-items:center;gap:.375rem;font-size:.8125rem;color:var(--tblr-secondary)}
.kit-stat-value{display:flex;flex-wrap:wrap;align-items:baseline;gap:.25rem .375rem;margin-top:.625rem;font-size:1.5rem;font-weight:600;white-space:nowrap}
.kit-stat-value small{font-size:.8125rem;font-weight:400;color:var(--tblr-secondary)}
.kit-stat-value a{font-size:.8125rem;font-weight:500}`
