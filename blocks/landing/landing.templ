// Package landing is a block for a public start page: a document without sidebar (Page) with a top bar
// (brand, anchor links, actions) and sections stacked full width: Hero, Section with Features or Steps,
// CallToAction and a Footer. No JavaScript; on small screens the anchor links are hidden and the
// sections stack to one column.
//
//	@landing.Page(landing.Props{Lang: "en", AppName: "Acme", Head: head(), Links: links, Actions: signIn()}) {
//		@landing.Hero(landing.HeroProps{Title: "Orders without paper", Lead: "…", Actions: buttons(), Visual: screenshot()})
//		@landing.Section(landing.SectionProps{ID: "features", Title: "What it does"}) {
//			@landing.Features(features)
//		}
//		@landing.CallToAction(landing.CallToActionProps{Title: "Try it"}) { @button.Button(…) { Sign in } }
//	}
package landing

import (
	"strconv"

	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/internal/csp"
	"github.com/mind-vm/tabler-templ/kit"
)

// Link is an entry of the top bar or the footer, e.g. an anchor "#features" or "/imprint".
type Link struct {
	Href string
	Text string
}

type Props struct {
	Lang        string // <html lang>, default "en"
	Title       string // <title>, default AppName
	Description string // <meta name="description">
	AppName     string
	Head        templ.Component // the app's stylesheets (Tabler, theme), after the block's CSS
	Scripts     templ.Component // end of <body>
	Brand       templ.Component // left in the top bar; default AppName
	BrandHref   string          // default "/"
	Links       []Link          // anchor links in the top bar, hidden on small screens
	Actions     templ.Component // right in the top bar, e.g. a sign-in button
	Footer      templ.Component // e.g. @landing.Footer(…)
}

templ Page(p Props) {
	<!DOCTYPE html>
	<html lang={ kit.Or(p.Lang, "en") }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<title>{ kit.Or(p.Title, p.AppName) }</title>
			if p.Description != "" {
				<meta name="description" content={ p.Description }/>
			}
			@Styles()
			if p.Head != nil {
				@p.Head
			}
		</head>
		<body class="kit-landing">
			<header class="kit-landing-bar">
				<div class="container-xl kit-landing-bar-inner">
					<a class="kit-landing-brand" href={ templ.URL(kit.Or(p.BrandHref, "/")) }>
						if p.Brand != nil {
							@p.Brand
						} else {
							{ p.AppName }
						}
					</a>
					if len(p.Links) > 0 {
						<nav class="kit-landing-links d-none d-md-flex">
							for _, l := range p.Links {
								<a href={ templ.URL(l.Href) }>{ l.Text }</a>
							}
						</nav>
					}
					if p.Actions != nil {
						<div class="kit-landing-actions">
							@p.Actions
						</div>
					}
				</div>
			</header>
			<main>
				{ children... }
			</main>
			if p.Footer != nil {
				@p.Footer
			}
			if p.Scripts != nil {
				@p.Scripts
			}
		</body>
	</html>
}

type HeroProps struct {
	Eyebrow string // small line above the title
	Title   string
	Lead    string
	Actions templ.Component // buttons below the lead
	Note    string          // small text below the actions
	Visual  templ.Component // a screenshot, an illustration, a card: right on large screens, below on small ones
	Class   string
}

// Hero is the first section: title, lead, actions and an optional visual; without one the text is centered.
templ Hero(p HeroProps) {
	{{ visual := p.Visual != nil }}
	<section class={ kit.Classes("kit-landing-hero", p.Class) }>
		<div class={ kit.Classes("container-xl kit-landing-hero-grid", kit.If(!visual, "kit-landing-hero-text")) }>
			<div>
				if p.Eyebrow != "" {
					<div class="kit-landing-eyebrow">{ p.Eyebrow }</div>
				}
				<h1 class="kit-landing-title">{ p.Title }</h1>
				if p.Lead != "" {
					<p class="kit-landing-lead">{ p.Lead }</p>
				}
				if p.Actions != nil {
					<div class="kit-landing-buttons">
						@p.Actions
					</div>
				}
				if p.Note != "" {
					<p class="kit-landing-note">{ p.Note }</p>
				}
			</div>
			if visual {
				<div class="kit-landing-visual">
					@p.Visual
				</div>
			}
		</div>
	</section>
}

type SectionProps struct {
	ID    string // anchor for the top bar's links
	Title string
	Lead  string
	Muted bool // the page background instead of the surface, to set sections apart
	Class string
}

// Section is a full-width band with a centered heading and the children below.
templ Section(p SectionProps) {
	<section id={ p.ID } class={ kit.Classes("kit-landing-section", kit.If(p.Muted, "kit-landing-muted"), p.Class) }>
		<div class="container-xl">
			if p.Title != "" || p.Lead != "" {
				<div class="kit-landing-head">
					if p.Title != "" {
						<h2>{ p.Title }</h2>
					}
					if p.Lead != "" {
						<p>{ p.Lead }</p>
					}
				</div>
			}
			{ children... }
		</div>
	</section>
}

type Feature struct {
	Icon  string // "ti-…"
	Title string
	Text  string
}

// Features is a grid of icon, title and text: three per row on large screens, two on medium, one on small.
templ Features(items []Feature) {
	<div class="kit-landing-features">
		for _, f := range items {
			<div class="kit-landing-feature">
				if f.Icon != "" {
					<span class="kit-landing-icon">
						@icon.Icon(f.Icon)
					</span>
				}
				<h3>{ f.Title }</h3>
				<p>{ f.Text }</p>
			</div>
		}
	</div>
}

type Step struct {
	Title string
	Text  string
}

// Steps is a numbered sequence, e.g. how a piece of work flows through the app.
templ Steps(items []Step) {
	<ol class="kit-landing-steps">
		for i, s := range items {
			<li>
				<span class="kit-landing-step-number" aria-hidden="true">{ strconv.Itoa(i + 1) }</span>
				<h3>{ s.Title }</h3>
				<p>{ s.Text }</p>
			</li>
		}
	</ol>
}

type CallToActionProps struct {
	ID    string
	Title string
	Text  string
	Class string
}

// CallToAction is a centered band near the end; the children are the buttons.
templ CallToAction(p CallToActionProps) {
	<section id={ p.ID } class={ kit.Classes("kit-landing-section", p.Class) }>
		<div class="container-xl">
			<div class="kit-landing-cta">
				<h2>{ p.Title }</h2>
				if p.Text != "" {
					<p>{ p.Text }</p>
				}
				<div class="kit-landing-buttons">
					{ children... }
				</div>
			</div>
		</div>
	</section>
}

type FooterProps struct {
	Text  string // left, e.g. "© 2026 Acme"
	Links []Link // right, e.g. imprint and privacy
}

templ Footer(p FooterProps) {
	<footer class="kit-landing-footer">
		<div class="container-xl kit-landing-footer-inner">
			<span>{ p.Text }</span>
			if len(p.Links) > 0 {
				<nav>
					for _, l := range p.Links {
						<a href={ templ.URL(l.Href) }>{ l.Text }</a>
					}
				</nav>
			}
		</div>
	</footer>
}

// Styles renders the block's CSS; Page includes it.
templ Styles() {
	@icon.Styles()
	@csp.Style(css)
}

const css = `.kit-landing{min-height:100vh;display:flex;flex-direction:column;background:var(--tblr-bg-surface)}
.kit-landing main{flex:1}
.kit-landing h1,.kit-landing h2,.kit-landing h3{color:var(--tblr-emphasis-color,var(--tblr-body-color))}
.kit-landing-bar{position:sticky;top:0;z-index:1020;background:var(--tblr-bg-surface);border-bottom:var(--tblr-border-width) solid var(--tblr-border-color)}
.kit-landing-bar-inner{display:flex;align-items:center;gap:1.5rem;min-height:3.75rem}
.kit-landing-brand{display:flex;align-items:center;gap:.625rem;font-size:1.125rem;font-weight:600;color:inherit;text-decoration:none}
.kit-landing-brand:hover{text-decoration:none}
.kit-landing-links{gap:1.25rem}
.kit-landing-links a{color:var(--tblr-secondary)}
.kit-landing-links a:hover{color:var(--tblr-body-color);text-decoration:none}
.kit-landing-actions{display:flex;gap:.5rem;margin-left:auto}
.kit-landing-hero{padding:4.5rem 0 4rem;background:var(--tblr-body-bg);border-bottom:var(--tblr-border-width) solid var(--tblr-border-color)}
.kit-landing-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:3rem;align-items:center}
.kit-landing-hero-text{grid-template-columns:minmax(0,46rem);justify-content:center;text-align:center}
.kit-landing-hero-text .kit-landing-buttons{justify-content:center}
.kit-landing-eyebrow{margin-bottom:.75rem;font-size:.8125rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--tblr-primary)}
.kit-landing-title{margin:0 0 1rem;font-size:clamp(2rem,1.4rem + 2.4vw,3rem);line-height:1.15;font-weight:700;letter-spacing:-.01em}
.kit-landing-lead{margin:0 0 1.75rem;font-size:1.125rem;line-height:1.6;color:var(--tblr-secondary);max-width:38rem}
.kit-landing-hero-text .kit-landing-lead{margin-left:auto;margin-right:auto}
.kit-landing-buttons{display:flex;flex-wrap:wrap;gap:.75rem}
.kit-landing-note{margin:1rem 0 0;font-size:.8125rem;color:var(--tblr-secondary)}
.kit-landing-visual{min-width:0}
.kit-landing-section{padding:4rem 0}
.kit-landing-muted{background:var(--tblr-body-bg);border-top:var(--tblr-border-width) solid var(--tblr-border-color);border-bottom:var(--tblr-border-width) solid var(--tblr-border-color)}
.kit-landing-head{max-width:40rem;margin:0 auto 2.5rem;text-align:center}
.kit-landing-head h2,.kit-landing-cta h2{margin:0 0 .75rem;font-size:1.75rem;font-weight:700}
.kit-landing-head p,.kit-landing-cta p{margin:0;font-size:1.0625rem;color:var(--tblr-secondary)}
.kit-landing-features{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem 2.5rem}
.kit-landing-feature h3,.kit-landing-steps h3{margin:0 0 .375rem;font-size:1rem;font-weight:600}
.kit-landing-feature p,.kit-landing-steps p{margin:0;color:var(--tblr-secondary);line-height:1.55}
.kit-landing-icon{display:inline-flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem;margin-bottom:.875rem;font-size:1.25rem;color:var(--tblr-primary);background:var(--tblr-primary-lt);border-radius:var(--tblr-border-radius-lg)}
.kit-landing-icon .ti{font-size:inherit}
.kit-landing-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:1.5rem;margin:0;padding:0;list-style:none}
.kit-landing-steps li{padding:1.25rem;background:var(--tblr-bg-surface);border:var(--tblr-border-width) solid var(--tblr-border-color);border-radius:var(--tblr-border-radius-lg)}
.kit-landing-step-number{display:inline-flex;align-items:center;justify-content:center;width:1.75rem;height:1.75rem;margin-bottom:.75rem;font-size:.8125rem;font-weight:600;color:var(--tblr-primary-fg,#fff);background:var(--tblr-primary);border-radius:50%}
.kit-landing-cta{max-width:44rem;margin:0 auto;padding:2.5rem 2rem;text-align:center;background:var(--tblr-body-bg);border:var(--tblr-border-width) solid var(--tblr-border-color);border-radius:var(--tblr-border-radius-lg)}
.kit-landing-cta p{margin-bottom:1.5rem}
.kit-landing-cta .kit-landing-buttons{justify-content:center}
.kit-landing-footer{padding:1.5rem 0;font-size:.8125rem;color:var(--tblr-secondary);border-top:var(--tblr-border-width) solid var(--tblr-border-color)}
.kit-landing-footer-inner{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.75rem 1.5rem}
.kit-landing-footer nav{display:flex;flex-wrap:wrap;gap:1.25rem}
.kit-landing-footer a{color:inherit}
@media (max-width:991.98px){.kit-landing-features{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:767.98px){.kit-landing-features{grid-template-columns:minmax(0,1fr)}.kit-landing-hero{padding:3rem 0 2.5rem}.kit-landing-hero-grid{grid-template-columns:minmax(0,1fr);gap:2rem}.kit-landing-section{padding:3rem 0}.kit-landing-cta{padding:2rem 1.25rem}}`
