// Package split lays out the panes of a back-office page: a list beside its detail (mail, tickets,
// customers), and an inspector on the right that the reader can show and hide. Each pane scrolls on its
// own and the page does not.
//
//	@split.Split(split.Props{
//		List:     ticketList(tickets, current),  // links to /tickets/{id}
//		Detail:   ticketDetail(current),         // nil shows Empty
//		Selected: current != nil,                // small screens show the detail instead of the list
//		BackHref: "/tickets",
//		Aside:    ticketFacts(current), AsideTitle: "Details",
//	})
//
// The server decides what is selected (the URL), so the layout needs no script; the small one in
// Script only shows and hides the inspector. With htmx, target the detail pane by DetailID.
package split

import (
	"strconv"

	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/internal/csp"
	"github.com/mind-vm/tabler-templ/kit"
)

type Props struct {
	ID    string // default "split"
	Class string
	// List is the left pane, e.g. a listgroup or a table; nil for a page of detail and inspector only.
	List templ.Component
	// ListWidth is the list's width on large screens, e.g. "20rem" (default "22rem").
	ListWidth string
	// Detail is the main pane; nil shows Empty.
	Detail templ.Component
	Empty  templ.Component
	// DetailID is the id of the detail pane, e.g. an htmx target; default ID + "-detail".
	DetailID string
	// Selected: an item of the list is open. On small screens the page then shows the detail with a
	// back link (BackHref) instead of the list.
	Selected  bool
	BackHref  string
	BackLabel string // default kit.T(ctx).Back
	// Aside is the inspector on the right (facts, properties, activity); AsideTitle heads it. It is
	// shown on extra-large screens unless AsideClosed, below the detail on smaller ones; AsideToggle
	// shows and hides it.
	Aside       templ.Component
	AsideTitle  string
	AsideClosed bool
	// Height of the panes on large screens, e.g. "40rem". By default the panes fill the window below
	// where the split starts (Script measures it; without script "calc(100vh - 13rem)").
	Height string
}

func styleOf(p Props) string {
	s := ""
	if p.ListWidth != "" {
		s += "--kit-split-list:" + p.ListWidth + ";"
	}
	if p.Height != "" {
		s += "--kit-split-height:" + p.Height + ";"
	}
	return s
}

// Split renders the panes. It renders Styles and Script.
templ Split(p Props) {
	{{ id := kit.Or(p.ID, "split") }}
	@Styles()
	<div
		id={ id }
		class={ kit.Classes("kit-split", kit.If(p.List != nil, "kit-split-has-list"), kit.If(p.Aside != nil, "kit-split-has-aside"), kit.If(p.Selected, "kit-split-selected"), p.Class) }
		if p.AsideClosed {
			data-aside-closed
		}
		if s := styleOf(p); s != "" {
			style={ s }
		}
		if p.Height == "" {
			data-fit
		}
	>
		if p.List != nil {
			<div class="kit-split-list card">
				@p.List
			</div>
		}
		<div class="kit-split-detail card" id={ kit.Or(p.DetailID, id+"-detail") }>
			if p.List != nil && p.BackHref != "" {
				<a href={ templ.URL(p.BackHref) } class="kit-split-back">
					@icon.Icon("ti-chevron-left")
					{ kit.Or(p.BackLabel, kit.T(ctx).Back) }
				</a>
			}
			if p.Detail != nil {
				@p.Detail
			} else if p.Empty != nil {
				<div class="kit-split-empty">
					@p.Empty
				</div>
			}
		</div>
		if p.Aside != nil {
			<aside class="kit-split-aside card" id={ id + "-aside" }>
				if p.AsideTitle != "" {
					<div class="card-header">
						<h3 class="card-title">{ p.AsideTitle }</h3>
					</div>
				}
				<div class="kit-split-aside-body">
					@p.Aside
				</div>
			</aside>
		}
	</div>
	@Script()
}

type ToggleProps struct {
	Target string // the Split's ID, default "split"
	Label  string // default kit.T(ctx).ToggleDetails
	Class  string // default "btn btn-icon"
	Closed bool   // the Split's AsideClosed, for aria-expanded
}

// AsideToggle is a button that shows and hides the inspector, e.g. in the page header's actions.
templ AsideToggle(p ToggleProps) {
	<button
		type="button"
		class={ kit.Or(p.Class, "btn btn-icon") + " kit-split-toggle" }
		data-kit-split-toggle={ kit.Or(p.Target, "split") }
		aria-controls={ kit.Or(p.Target, "split") + "-aside" }
		aria-expanded={ strconv.FormatBool(!p.Closed) }
		aria-label={ kit.Or(p.Label, kit.T(ctx).ToggleDetails) }
		title={ kit.Or(p.Label, kit.T(ctx).ToggleDetails) }
	>
		@icon.Icon("ti-layout-sidebar-right")
	</button>
}

type ListItemProps struct {
	Href   string
	Title  string
	Meta   string
	Text   string
	Active bool
	Unread bool // the title in bold, a dot before it
	Badge  templ.Component
}

// ListItem is a row of the list pane: a link with a title, a meta line (e.g. time) at the right, a
// muted text below and an optional badge. Active marks the open item.
templ ListItem(p ListItemProps) {
	<a
		href={ templ.URL(p.Href) }
		class={ kit.Classes("kit-split-item", kit.If(p.Active, "active"), kit.If(p.Unread, "unread")) }
		if p.Active {
			aria-current="page"
		}
	>
		<span class="kit-split-item-head">
			<span class="kit-split-item-title">{ p.Title }</span>
			if p.Meta != "" {
				<span class="kit-split-item-meta">{ p.Meta }</span>
			}
		</span>
		if p.Text != "" || p.Badge != nil {
			<span class="kit-split-item-foot">
				<span class="kit-split-item-text">{ p.Text }</span>
				if p.Badge != nil {
					@p.Badge
				}
			</span>
		}
	</a>
}

var styles = templ.NewOnceHandle()

// Styles renders the panes' CSS once per page; Split includes it.
templ Styles() {
	@styles.Once() {
		@csp.Style(css)
	}
}

var script = templ.NewOnceHandle()

// Script fits the panes to the window and shows and hides the inspector (AsideToggle); once per page,
// Split includes it.
templ Script() {
	@script.Once() {
		<script { csp.Nonce(ctx)... }>
			(function () {
				var fit = function () {
					document.querySelectorAll('.kit-split[data-fit]').forEach(function (s) {
						var bottom = parseFloat(getComputedStyle(s.closest('.page-body') || s).marginBottom) || 0;
						var top = s.getBoundingClientRect().top + window.scrollY;
						s.style.setProperty('--kit-split-height', Math.max(320, window.innerHeight - top - bottom) + 'px');
					});
				};
				fit();
				document.addEventListener('DOMContentLoaded', fit);
				window.addEventListener('load', fit);
				window.addEventListener('resize', fit);
				document.addEventListener('htmx:afterSettle', fit);
			})();
			document.addEventListener('click', function (e) {
				var b = e.target.closest && e.target.closest('[data-kit-split-toggle]');
				if (!b) return;
				var s = document.getElementById(b.getAttribute('data-kit-split-toggle'));
				if (!s) return;
				var closed = !s.hasAttribute('data-aside-closed');
				s.toggleAttribute('data-aside-closed', closed);
				b.setAttribute('aria-expanded', String(!closed));
			});
		</script>
	}
}

const css = `.kit-split{--kit-split-list:22rem;--kit-split-aside:18rem;--kit-split-height:calc(100vh - 13rem);display:grid;grid-template-columns:minmax(0,1fr);gap:1rem}
.kit-split>.card{margin:0;min-width:0}
.kit-split-list,.kit-split-detail,.kit-split-aside-body{overflow-y:auto}
.kit-split-back{display:none;align-items:center;gap:.25rem;padding:.75rem 1rem;border-bottom:var(--tblr-border-width) solid var(--tblr-border-color);color:var(--tblr-secondary);text-decoration:none}
.kit-split-empty{display:flex;align-items:center;justify-content:center;min-height:16rem;height:100%;padding:2rem}
.kit-split-item{display:flex;flex-direction:column;gap:.125rem;padding:.75rem 1rem;border-bottom:var(--tblr-border-width) solid var(--tblr-border-color);color:var(--tblr-body-color);text-decoration:none}
.kit-split-item:last-child{border-bottom:0}
.kit-split-item:hover{background:rgba(var(--tblr-body-color-rgb),.03);color:var(--tblr-body-color);text-decoration:none}
.kit-split-item.active{background:rgba(var(--tblr-primary-rgb),.08);box-shadow:inset 3px 0 0 var(--tblr-primary)}
.kit-split-item-head,.kit-split-item-foot{display:flex;align-items:center;gap:.5rem;min-width:0}
.kit-split-item-title{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500}
.kit-split-item.unread .kit-split-item-title{font-weight:700}
.kit-split-item.unread .kit-split-item-title::before{content:"";display:inline-block;width:.5rem;height:.5rem;margin-right:.375rem;border-radius:50%;background:var(--tblr-primary);vertical-align:middle}
.kit-split-item-foot>:not(.kit-split-item-text){flex:0 0 auto}
.kit-split-item-meta{flex:0 0 auto;font-size:.75rem;color:var(--tblr-secondary)}
.kit-split-item-text{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.8125rem;color:var(--tblr-secondary)}
.kit-split-toggle[aria-expanded=false]{opacity:.6}
@media (max-width:991.98px){
.kit-split-has-list.kit-split-selected>.kit-split-list{display:none}
.kit-split-has-list:not(.kit-split-selected)>:is(.kit-split-detail,.kit-split-aside){display:none}
.kit-split-has-list .kit-split-back{display:flex}
.kit-split-toggle{display:none}
}
@media (min-width:992px){
.kit-split-has-list{grid-template-columns:var(--kit-split-list) minmax(0,1fr)}
.kit-split-has-list>:is(.kit-split-list,.kit-split-detail){height:var(--kit-split-height)}
.kit-split-has-list>.kit-split-aside{grid-column:2}
}
@media (min-width:1200px){
.kit-split-has-aside:not([data-aside-closed]){grid-template-columns:minmax(0,1fr) var(--kit-split-aside)}
.kit-split-has-list.kit-split-has-aside:not([data-aside-closed]){grid-template-columns:var(--kit-split-list) minmax(0,1fr) var(--kit-split-aside)}
.kit-split-has-aside>.kit-split-aside{grid-column:auto;align-self:start;max-height:var(--kit-split-height);display:flex;flex-direction:column}
.kit-split-has-list>.kit-split-aside{height:var(--kit-split-height);max-height:none}
.kit-split[data-aside-closed]>.kit-split-aside{display:none}
}
@media (max-width:1199.98px){.kit-split[data-aside-closed]>.kit-split-aside{display:none}}`
