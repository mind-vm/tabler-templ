// Package datepicker renders Tabler's date picker: a text field, a button or an inline calendar that
// Tabler's Datepicker component (in tabler.js) turns into a calendar of Vanilla Calendar Pro. Load the
// plugin with Library in the head, before Tabler's script. The picked dates are YYYY-MM-DD.
//
//	@datepicker.Input(datepicker.Props{ID: "due", Name: "due", Value: "2026-06-20", Layout: datepicker.LayoutIcon})
package datepicker

import (
	"github.com/mind-vm/tabler-templ/cdn"
	"github.com/mind-vm/tabler-templ/versions"
	"strconv"
	"strings"

	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/internal/plugin"
	"github.com/mind-vm/tabler-templ/kit"
)

// Version is the Vanilla Calendar Pro version Library loads.
const Version = versions.VanillaCalendar

// LibraryURL is Vanilla Calendar Pro (on cdn.Base).
func LibraryURL() string { return cdn.URL("vanilla-calendar-pro", Version, "index.js") }

// Mode is what can be picked.
type Mode string

const (
	ModeSingle   Mode = ""                // one date
	ModeMultiple Mode = "multiple"        // any number of dates
	ModeRange    Mode = "multiple-ranged" // a start and an end
)

// Layout is the field around the input.
type Layout int

const (
	LayoutPlain       Layout = iota
	LayoutIcon               // a calendar icon at the end (input-icon)
	LayoutIconPrepend        // the icon at the start
)

type Props struct {
	ID         string
	Name       string // the input's name; for an Inline calendar, a hidden input that submits the dates
	Class      string // on the input, or the wrapper with a Layout
	Attributes templ.Attributes
	Value      string // YYYY-MM-DD
	// Placeholder, default "Select a date".
	Placeholder string
	Layout      Layout
	Inline      bool // the calendar in place instead of a popup
	Mode        Mode
	Months      int      // months side by side
	Selected    []string // preselected dates; a range is its start and end
	Min, Max    string
	// FirstWeekday is 0 for Sunday … 6; nil = Monday.
	FirstWeekday *int
	Placement    string // "left" (default), "center", "right", "auto"
	WeekNumbers  bool
	Disabled     bool
	Required     bool
}

// Attrs are the attributes that make any element a date picker, e.g. a button with a
// data-bs-datepicker-display span for the picked date.
func Attrs(p Props) templ.Attributes {
	a := templ.Attributes{"data-bs-toggle": "datepicker"}
	if p.Inline {
		a["data-bs-inline"] = "true"
	}
	if p.Mode != "" {
		a["data-bs-selection-mode"] = string(p.Mode)
	}
	if p.Months > 0 {
		a["data-bs-display-months-count"] = strconv.Itoa(p.Months)
	}
	if p.Selected != nil {
		a["data-bs-selected-dates"] = plugin.JSON(p.Selected)
	}
	if p.Min != "" {
		a["data-bs-date-min"] = p.Min
	}
	if p.Max != "" {
		a["data-bs-date-max"] = p.Max
	}
	if p.FirstWeekday != nil {
		a["data-bs-first-weekday"] = strconv.Itoa(*p.FirstWeekday)
	}
	if p.Placement != "" {
		a["data-bs-placement"] = p.Placement
	}
	if p.WeekNumbers {
		a["data-bs-week-numbers"] = "true"
	}
	return kit.Attrs(a, p.Attributes)
}

templ input(p Props, class string) {
	<input
		type="text"
		class={ kit.Classes("form-control", class) }
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Name != "" {
			name={ p.Name }
		}
		if p.Value != "" {
			value={ p.Value }
		}
		placeholder={ kit.Or(p.Placeholder, "Select a date") }
		autocomplete="off"
		disabled?={ p.Disabled }
		required?={ p.Required }
		{ Attrs(p)... }
	/>
}

// Input is a date field, or an Inline calendar.
templ Input(p Props) {
	if p.Inline {
		<div
			if p.Class != "" {
				class={ p.Class }
			}
			if p.ID != "" {
				id={ p.ID }
			}
			{ Attrs(p)... }
		>
			if p.Name != "" {
				<input
					type="hidden"
					name={ p.Name }
					if p.Selected != nil {
						value={ strings.Join(p.Selected, ",") }
					}
				/>
			}
		</div>
	} else if p.Layout == LayoutIcon {
		<div class={ kit.Classes("input-icon", p.Class) }>
			@input(p, "")
			<span class="input-icon-addon">
				@icon.Icon("ti-calendar")
			</span>
		</div>
	} else if p.Layout == LayoutIconPrepend {
		<div class={ kit.Classes("input-icon", p.Class) }>
			<span class="input-icon-addon">
				@icon.Icon("ti-calendar")
			</span>
			@input(p, "")
		</div>
	} else {
		@input(p, p.Class)
	}
	@Script()
}

// Script starts date pickers swapped in by htmx; Input renders it.
func Script() templ.Component {
	return plugin.Tabler("Datepicker", `[data-bs-toggle="datepicker"][data-bs-inline="true"]`)
}

// Library loads Vanilla Calendar Pro; put it in the head, before Tabler's script.
func Library() templ.Component {
	return templ.Join(plugin.Script(LibraryURL()), Script())
}

func init() {
	cdn.Register("datepicker", "vanilla-calendar-pro", Version, "index.js")
}
