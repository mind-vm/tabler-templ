// Package sparkline renders Tabler's sparkline: a tiny inline chart (line, bar, tristate, circle) that
// Tabler's own script draws from data attributes — no chart library needed.
package sparkline

import (
	"strconv"
	"strings"

	"github.com/mind-vm/tabler-templ/kit"
)

type Type string

const (
	Line     Type = ""
	Bar      Type = "bar"
	Tristate Type = "tristate"
	Circle   Type = "circle"
)

type Props struct {
	Class      string
	Attributes templ.Attributes
	Values     []float64
	Type       Type
	Color      string // text-{color}; the chart draws in the current color
	Size       string // "sm" or "lg"
	Square     bool   // as wide as high (for Circle)
	Fill       bool   // a tinted area under a line
	Spot       string // "last", "min" or "max": a dot on that value
	// Min and Max fix the value range; Threshold draws a dashed line. nil = none.
	Min, Max, Threshold *float64
	// Label is text centered over the chart; "auto" derives it from the data.
	Label     string
	BarGap    *float64
	BarRadius *float64
	Animation *int // tween length of updates in ms; 0 turns it off
	Disabled  bool
	AriaLabel string
}

func num(f float64) string { return strconv.FormatFloat(f, 'f', -1, 64) }

func values(vs []float64) string {
	s := make([]string, len(vs))
	for i, v := range vs {
		s[i] = num(v)
	}
	return strings.Join(s, ",")
}

func attrs(p Props) templ.Attributes {
	a := templ.Attributes{"data-bs-toggle": "sparkline", "data-bs-values": values(p.Values)}
	opt := func(k string, f *float64) {
		if f != nil {
			a[k] = num(*f)
		}
	}
	if p.Type != Line {
		a["data-bs-type"] = string(p.Type)
	}
	if p.Fill {
		a["data-bs-fill"] = "auto"
	}
	if p.Spot != "" {
		a["data-bs-spot"] = p.Spot
	}
	opt("data-bs-min", p.Min)
	opt("data-bs-max", p.Max)
	opt("data-bs-threshold", p.Threshold)
	if p.Label != "" {
		a["data-bs-label"] = p.Label
	}
	opt("data-bs-bar-gap", p.BarGap)
	opt("data-bs-bar-radius", p.BarRadius)
	if p.Animation != nil {
		a["data-bs-animation"] = strconv.Itoa(*p.Animation)
	}
	if p.Type == Circle {
		a["data-bs-width"], a["data-bs-height"] = "40", "40"
	}
	if p.AriaLabel != "" {
		a["role"], a["aria-label"] = "img", p.AriaLabel
	}
	return kit.Attrs(a, p.Attributes)
}

templ Sparkline(p Props) {
	<span class={ kit.Classes("sparkline", kit.If(p.Size != "", "sparkline-"+p.Size), kit.If(p.Square || p.Type == Circle, "sparkline-square"), kit.If(p.Disabled, "sparkline-disabled"), kit.If(p.Color != "", "text-"+p.Color), p.Class) } { attrs(p)... }></span>
}
