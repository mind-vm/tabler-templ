package mcpapp

import (
	"context"
	_ "embed"
	"io"

	"github.com/mind-vm/tabler-templ/assets"
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/internal/csp"
	"github.com/mind-vm/tabler-templ/kit"
)

//go:embed bridge.js
var bridgeJS string

type Props struct {
	Title string
	Lang  string // the document's lang; default the host's locale, else none
	// App names the view in ui/initialize (appInfo); default Title.
	App     string
	Version string // appInfo.version
	// Assets are Tabler's stylesheets (from cdn.Base: declare its origin in ResourceMeta.CSP, the default
	// does).
	Assets assets.Props
	// Scripts loads Tabler's script, for dropdowns, modals, tooltips and the like.
	Scripts bool
	// Head is added to the head after Tabler, e.g. the app's own CSS inline.
	Head templ.Component
	// HostStyles takes the host's colors, font and radius for Tabler's (hostContext.styles); without it
	// only the host's light or dark theme is applied and the view keeps Tabler's look.
	HostStyles bool
	Class      string // classes of the root element, default "p-3"
}

// Document is the UI resource: an HTML document with Tabler, the kit's CSS and the bridge; the children
// are the page. Put a Result element in it for the HTML of the tool's result.
templ Document(p Props) {
	<!DOCTYPE html>
	<html
		if p.Lang != "" {
			lang={ p.Lang }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title }</title>
			@assets.Head(p.Assets)
			@kitCSS()
			@icon.Styles()
			if p.Head != nil {
				@p.Head
			}
			@csp.Style(rootCSS)
		</head>
		<body>
			<div class={ kit.Or(p.Class, "p-3") } data-mcp-root>
				{ children... }
			</div>
			if p.Scripts {
				@assets.Scripts()
			}
			@bridge(p)
		</body>
	</html>
}

// Inside the frame the page has no height of its own: the host sizes the iframe from the root's height.
const rootCSS = `html,body{min-height:0;height:auto;background:transparent}body{margin:0}[data-mcp-root]{display:flow-root;background:var(--tblr-body-bg)}`

// kitCSS is every sheet of the kit inline when the app serves them as a file (csp.SetExternal): the
// sandbox cannot load the app's file.
func kitCSS() templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		if !csp.External() {
			return nil
		}
		return csp.Style(csp.All()).Render(ctx, w)
	})
}

func bridge(p Props) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		attr := func(k, v string) string { return " " + k + `="` + templ.EscapeString(v) + `"` }
		open := "<script" + csp.Attr(ctx) + attr("data-key", MetaHTML) + attr("data-protocol", ProtocolVersion) +
			attr("data-name", kit.Or(p.App, p.Title)) + attr("data-version", p.Version)
		if p.HostStyles {
			open += " data-host-styles"
		}
		_, err := io.WriteString(w, open+">"+bridgeJS+"</script>")
		return err
	})
}
