// Package datatable makes any table sortable and searchable in the browser with List.js, like Tabler's
// datatables: wrap the table in a Table, give the cells of each column a class (the field's name) and the
// headers a SortButton. A field can sort by a data attribute instead of the text, e.g. a date. Load the
// plugin with Library in the head.
//
//	@datatable.Table(datatable.Props{ID: "people", Fields: []datatable.Field{{Name: "sort-name"}, {Name: "sort-date", Attr: "data-date"}}}) {
//		<table class="table"> … <th>@datatable.SortButton("sort-name", "Name")</th> … <tbody class="table-tbody"> … </table>
//	}
package datatable

import (
	"github.com/mind-vm/tabler-templ/internal/plugin"
	"github.com/mind-vm/tabler-templ/kit"
)

// Version is the List.js version Library loads.
const Version = "2.3.1"

// LibraryURL is List.js on jsDelivr.
const LibraryURL = "https://cdn.jsdelivr.net/npm/list.js@" + Version + "/dist/list.min.js"

// Field is a column to sort and search by: the class of its cells, and optionally the attribute of the
// cell that holds the value to sort by.
type Field struct {
	Name string
	Attr string
}

type Props struct {
	ID         string // required
	Class      string // on the wrapper, default "table-responsive"
	Attributes templ.Attributes
	Fields     []Field
	// Search is the id of an input that filters the rows as the user types.
	Search string
	// PerPage pages the rows; Tabler's pagination goes into an element with class "pagination" in the
	// wrapper.
	PerPage int
}

func config(p Props) string {
	names := make([]any, len(p.Fields))
	for i, f := range p.Fields {
		if f.Attr != "" {
			names[i] = map[string]string{"attr": f.Attr, "name": f.Name}
		} else {
			names[i] = f.Name
		}
	}
	c := map[string]any{"valueNames": names}
	if p.Search != "" {
		c["search"] = p.Search
	}
	if p.PerPage > 0 {
		c["page"] = p.PerPage
	}
	return plugin.JSON(c)
}

// Table wraps a table that sorts by its SortButtons; the children are the table. Its rows go in a tbody
// with class "table-tbody".
templ Table(p Props) {
	<div id={ p.ID } class={ kit.Or(p.Class, "table-responsive") } data-tabler-list={ config(p) } { p.Attributes... }>
		{ children... }
	</div>
	@Script()
}

// SortButton is a column header that sorts by field.
templ SortButton(field, text string) {
	<button class="table-sort" data-sort={ field }>{ text }</button>
}

// Script starts the tables; Table renders it.
func Script() templ.Component {
	return plugin.Start("datatable", `function (root) {
		if (!window.List) return;
		window.tabler_list = window.tabler_list || {};
		root.querySelectorAll('[data-tabler-list]').forEach(function (el) {
			if (el.tablerList) return;
			var c = JSON.parse(el.getAttribute('data-tabler-list'));
			var options = { sortClass: 'table-sort', listClass: 'table-tbody', valueNames: c.valueNames };
			if (c.page) {
				options.page = c.page;
				options.pagination = {
					item: function (value) { return '<li class="page-item"><a class="page-link cursor-pointer">' + value.page + '</a></li>'; },
					innerWindow: 1, outerWindow: 1, left: 0, right: 0,
				};
			}
			var list = el.tablerList = window.tabler_list[el.id] = new List(el, options);
			var search = c.search && document.getElementById(c.search);
			if (search) search.addEventListener('input', function () { list.search(search.value); });
		});
	}`)
}

// Library loads List.js and starts every table on the page; put it in the head.
func Library() templ.Component {
	return templ.Join(plugin.Script(LibraryURL), Script())
}
