// Package icon renders a Tabler icon from the webfont (tabler-icons) with Tabler's .icon sizing.
package icon

import (
	"strings"

	"github.com/mind-vm/tabler-templ/internal/csp"
	"github.com/mind-vm/tabler-templ/kit"
)

// Size is one of Tabler's .icon-{size} modifiers; the zero value is the default 1.25rem.
type Size string

const (
	SizeDefault Size = ""
	SizeSmall   Size = "sm"
	SizeMedium  Size = "md"
	SizeLarge   Size = "lg"
)

type Props struct {
	Class      string
	Attributes templ.Attributes
	// Label makes the icon meaningful for screen readers; without it the icon is decorative (aria-hidden).
	Label  string
	Size   Size
	Color  string // text-{color}, e.g. "red" or "primary"
	Inline bool   // icon-inline: sized and aligned to the surrounding text
	// Filled uses the filled variant of the icon (also a name ending in "-filled", e.g. "ti-star-filled").
	// It comes from the filled webfont, which Styles loads.
	Filled bool
}

// filledGlyph returns the glyph of the filled variant of name, if there is one.
func filledGlyph(name string, p Props) (string, bool) {
	base, suffix := strings.CutSuffix(name, "-filled")
	if !p.Filled && !suffix {
		return "", false
	}
	r, ok := filled[base]
	if !ok {
		return "", false
	}
	return string(r), true
}

// Classes returns the class string of an icon.
func Classes(name string, p Props) string {
	return kit.Classes("ti", name, "icon", p.Class, kit.If(p.Color != "", "text-"+p.Color), kit.If(p.Inline, "icon-inline"),
		kit.If(p.Size != SizeDefault, "icon-"+string(p.Size)))
}

// Icon takes the full class name ("ti-pencil", not "pencil") so that build tools which subset the
// icon font can find every icon by scanning for "ti-…" in the source.
templ Icon(name string, props ...Props) {
	{{ p := kit.First(props) }}
	if g, ok := filledGlyph(name, p); ok {
		<i
			class={ kit.Classes("ti ti-filled icon", p.Class, kit.If(p.Color != "", "text-"+p.Color), kit.If(p.Inline, "icon-inline"), kit.If(p.Size != SizeDefault, "icon-"+string(p.Size))) }
			data-icon={ strings.TrimSuffix(name, "-filled") }
			if p.Label != "" {
				role="img"
				aria-label={ p.Label }
			} else {
				aria-hidden="true"
			}
			{ p.Attributes... }
		>{ g }</i>
	} else if p.Label != "" {
		<i class={ Classes(name, p) } role="img" aria-label={ p.Label } { p.Attributes... }></i>
	} else {
		<i class={ Classes(name, p) } aria-hidden="true" { p.Attributes... }></i>
	}
}

// Styles renders CSS and FilledCSS in a <style> element.
templ Styles() {
	@csp.Style(CSS + FilledCSS())
}
