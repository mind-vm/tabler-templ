// Package echart is a PROTOTYPE: the charts of package chart (same chart.Props) drawn with Apache
// ECharts (Apache-2.0) instead of ApexCharts. Load ECharts with Library.
//
//	@echart.Chart(chart.Props{ID: "revenue", Type: chart.Area, Series: …})
package echart

import (
	"encoding/json"
	"fmt"

	"github.com/mind-vm/tabler-templ/cdn"
	"github.com/mind-vm/tabler-templ/chart"
	"github.com/mind-vm/tabler-templ/internal/csp"
	"github.com/mind-vm/tabler-templ/kit"
)

// Version is the ECharts version Library loads.
const Version = "6.0.0"

// LibraryURL is ECharts (on cdn.Base).
func LibraryURL() string { return cdn.URL("echarts", Version, "dist/echarts.min.js") }

func jsonOf(p chart.Props) string {
	b, _ := json.Marshal(build(p))
	return string(b)
}

// Chart is a chart; its element is echart-<ID>.
templ Chart(p chart.Props) {
	<div
		id={ "echart-" + p.ID }
		class={ kit.Classes("position-relative", p.Class) }
		role="img"
		if p.Label != "" {
			aria-label={ p.Label }
		}
		style={ templ.SafeCSS(fmt.Sprintf("height:%.0fpx", heightPx(p))) }
		data-tabler-echart={ jsonOf(p) }
		{ p.Attributes... }
	></div>
	@Script()
}

// Toggle makes an element show and hide a serie of the chart with that ID.
func Toggle(id, serie string) templ.Attributes {
	return templ.Attributes{"data-echart-toggle": id, "data-series": serie}
}

// Library loads ECharts; put it in the page's head.
templ Library() {
	<script { csp.Nonce(ctx)... } src={ LibraryURL() } defer></script>
}

var once = templ.NewOnceHandle()

// Script starts every chart on the page; Chart renders it once per page.
templ Script() {
	@once.Once() {
		<script { csp.Nonce(ctx)... }>
			(function () {
				if (window.tablerECharts) return;
				var formatters = {
					thousands: function (v) { return Number(v).toLocaleString('en-US'); },
					'suffix-k': function (v) { return v + 'K'; },
					percent: function (v) { return v + '%'; },
					// timeline draws a range [start, end] on row value(0), like ApexCharts' rangeBar.
					timeline: function (params, api) {
						var row = api.value(0), s = api.coord([api.value(1), row]), e = api.coord([api.value(2), row]);
						var h = api.size([0, 1])[1] * 0.5;
						var cs = params.coordSys;
						var rect = echarts.graphic.clipRectByRect({ x: s[0], y: s[1] - h / 2, width: e[0] - s[0], height: h },
							{ x: cs.x, y: cs.y, width: cs.width, height: cs.height });
						return rect && { type: 'rect', transition: ['shape'], shape: Object.assign(rect, { r: 3 }), style: api.style() };
					},
				};
				// The canvas renderer needs literal colors: every var() / color-mix() is resolved on a probe inside
				// the chart (one style pass per chart) and turned into rgba() on a 1×1 canvas.
				var cx = Object.assign(document.createElement('canvas'), { width: 1, height: 1 }).getContext('2d', { willReadFrequently: true });
				function literal(css) {
					cx.clearRect(0, 0, 1, 1);
					cx.fillStyle = 'rgba(0,0,0,0)';
					cx.fillStyle = css;
					cx.fillRect(0, 0, 1, 1);
					var d = cx.getImageData(0, 0, 1, 1).data;
					return 'rgba(' + d[0] + ',' + d[1] + ',' + d[2] + ',' + (d[3] / 255).toFixed(3) + ')';
				}
				function walk(v, fn) {
					if (typeof v === 'string') return fn(v);
					if (Array.isArray(v)) return v.map(function (x) { return walk(x, fn); });
					if (v && typeof v === 'object') {
						var o = {};
						Object.keys(v).forEach(function (k) { o[k] = walk(v[k], fn); });
						return o;
					}
					return v;
				}
				function isCSS(s) { return s.indexOf('var(') >= 0 || s.indexOf('color-mix(') === 0; }
				function resolveAll(el, option) {
					var found = [];
					walk(option, function (s) { if (isCSS(s) && found.indexOf(s) < 0) found.push(s); return s; });
					var map = {};
					if (found.length) {
						var box = document.createElement('div');
						box.style.cssText = 'position:absolute;width:0;height:0;overflow:hidden;visibility:hidden';
						var probes = found.map(function (s) { var p = document.createElement('span'); p.style.color = s; box.appendChild(p); return p; });
						el.appendChild(box);
						found.forEach(function (s, i) { var c = getComputedStyle(probes[i]).color; map[s] = c ? literal(c) : s; });
						box.remove();
					}
					// extraCssText is CSS for the tooltip's HTML element: it keeps its var().
					return walk(option, function (s) { return (isCSS(s) && s.indexOf(';') < 0 && map[s]) || s; });
				}
				function set(obj, path, value) {
					var keys = path.split('.');
					for (var i = 0; i < keys.length - 1; i++) {
						if (obj[keys[i]] == null || typeof obj[keys[i]] !== 'object') return;
						obj = obj[keys[i]];
					}
					obj[keys[keys.length - 1]] = value;
				}
				function data(el) { return JSON.parse(el.getAttribute('data-tabler-echart')); }
				function option(el) {
					var d = data(el);
					var o = resolveAll(el, d.option);
					o.textStyle = Object.assign({}, o.textStyle, { fontFamily: getComputedStyle(el).fontFamily });
					Object.keys(d.formatters || {}).forEach(function (path) {
						var f = formatters[d.formatters[path]];
						if (f) set(o, path, f);
					});
					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) o.animation = false;
					return o;
				}
				function draw(el) {
					if (el.tablerChart) return;
					var d = data(el);
					var c = el.tablerChart = echarts.init(el, null, { renderer: 'canvas' });
					c.setOption(option(el));
					new ResizeObserver(function () { c.resize(); }).observe(el);
					if (d.group) { c.group = d.group; echarts.connect(d.group); }
					if (d.brush) {
						// The brush chart's slider zooms its target, which gets an inside zoom to follow it.
						var target = document.getElementById('echart-' + d.brush.target);
						if (target) {
							draw(target);
							var tc = target.tablerChart;
							tc.setOption({ dataZoom: [{ id: 'brush', type: 'inside', xAxisIndex: 0, filterMode: 'none' }] });
							var follow = function (from, to) { tc.dispatchAction({ type: 'dataZoom', dataZoomId: 'brush', startValue: from, endValue: to }); };
							follow(d.brush.from, d.brush.to);
							c.on('datazoom', function () {
								var z = c.getOption().dataZoom[0];
								follow(z.startValue, z.endValue);
							});
						}
					}
				}
				var io = 'IntersectionObserver' in window ? new IntersectionObserver(function (entries) {
					entries.forEach(function (e) { if (e.isIntersecting) { io.unobserve(e.target); draw(e.target); } });
				}, { rootMargin: '300px 0px' }) : null;
				function init(root) {
					if (!window.echarts) return;
					(root || document).querySelectorAll('[data-tabler-echart]').forEach(function (el) {
						if (el.tablerChart || el.tablerWatched) return;
						el.tablerWatched = true;
						io ? io.observe(el) : draw(el);
					});
				}
				function flush() { document.querySelectorAll('[data-tabler-echart]').forEach(function (el) { if (io) io.unobserve(el); draw(el); }); }
				function destroy(root) {
					if (!root || !root.querySelectorAll) return;
					var els = [].slice.call(root.querySelectorAll('[data-tabler-echart]'));
					if (root.matches && root.matches('[data-tabler-echart]')) els.push(root);
					els.forEach(function (el) {
						if (io) io.unobserve(el);
						el.tablerWatched = false;
						if (el.tablerChart) { el.tablerChart.dispose(); el.tablerChart = null; }
					});
				}
				window.addEventListener('beforeprint', flush);
				new MutationObserver(function () {
					document.querySelectorAll('[data-tabler-echart]').forEach(function (el) {
						if (el.tablerChart) el.tablerChart.setOption(option(el), { notMerge: true });
					});
				}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme', 'data-bs-theme-primary', 'data-bs-theme-base', 'data-bs-theme-pack'] });
				window.tablerECharts = { init: init, flush: flush, destroy: destroy, formatters: formatters };
				// ECharts loads with defer: start after it.
				function start() { init(); }
				document.readyState === 'complete' ? start() : window.addEventListener('load', start, { once: true });
				document.addEventListener('htmx:afterSettle', function (e) { init(e.target); });
				document.addEventListener('click', function (e) {
					var t = e.target.closest && e.target.closest('[data-echart-toggle]');
					var el = t && document.getElementById('echart-' + t.getAttribute('data-echart-toggle'));
					if (!el || !el.tablerChart) return;
					el.tablerChart.dispatchAction({ type: 'legendToggleSelect', name: t.getAttribute('data-series') });
					t.classList.toggle('legend-off');
				});
			})();
		</script>
	}
}

func init() {
	cdn.Register("echart", "echarts", Version, "dist/echarts.min.js")
}
