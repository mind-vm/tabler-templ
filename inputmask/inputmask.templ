// Package inputmask makes a text field accept only a pattern, e.g. a date, a phone number or an IP
// address, with Tabler's InputMask component (in tabler.js) on top of IMask. In a pattern 0 is a digit,
// 9 an optional digit, a a letter and * any character. Load the plugin with Library in the head, before
// Tabler's script.
//
//	@inputmask.Input(inputmask.Props{ID: "phone", Name: "phone", Mask: "(00) 0000-0000", Visible: true})
//	@form.Input(form.InputProps{Name: "zip", Attributes: inputmask.Attrs("00000-000", true)})
package inputmask

import (
	"github.com/mind-vm/tabler-templ/versions"
	"github.com/mind-vm/tabler-templ/internal/plugin"
	"github.com/mind-vm/tabler-templ/kit"
)

// Version is the IMask version Library loads.
const Version = versions.IMask

// LibraryURL is IMask on jsDelivr.
const LibraryURL = "https://cdn.jsdelivr.net/npm/imask@" + Version + "/dist/imask.min.js"

type Props struct {
	ID         string
	Name       string
	Class      string
	Attributes templ.Attributes
	Mask       string
	// Visible shows the pattern before typing.
	Visible bool
	// Reverse fills the pattern from the end, for amounts (data-mask-reverse).
	Reverse     bool
	Value       string
	Placeholder string // default the pattern
	Disabled    bool
	Required    bool
}

// Attrs are the attributes that put a mask on any input.
func Attrs(mask string, visible bool) templ.Attributes {
	a := templ.Attributes{"data-mask": mask}
	if visible {
		a["data-mask-visible"] = "true"
	}
	return a
}

// Input is a text field with a mask.
templ Input(p Props) {
	<input
		type="text"
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Name != "" {
			name={ p.Name }
		}
		class={ kit.Classes("form-control", p.Class) }
		if p.Value != "" {
			value={ p.Value }
		}
		data-mask={ p.Mask }
		if p.Visible {
			data-mask-visible="true"
		}
		placeholder={ kit.Or(p.Placeholder, p.Mask) }
		if p.Reverse {
			data-mask-reverse="true"
		}
		autocomplete="off"
		disabled?={ p.Disabled }
		required?={ p.Required }
		{ p.Attributes... }
	/>
	@Script()
}

// Script starts masks swapped in by htmx; Input renders it.
func Script() templ.Component {
	return plugin.Tabler("InputMask", "[data-mask]")
}

// Library loads IMask; put it in the head, before Tabler's script.
func Library() templ.Component {
	return templ.Join(plugin.Script(LibraryURL), Script())
}
