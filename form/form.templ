// Package form renders Tabler form controls: a Field (label, control, hint, error), the controls
// Input, Select, Textarea, Check, Range, NumberInput, OTP and Strength, input groups and icons,
// select groups, image and color checks, floating labels and fieldsets. Labels and controls are linked
// by ID when one is given.
package form

import (
	"github.com/mind-vm/tabler-templ/kit"
	"github.com/mind-vm/tabler-templ/popover"
)

// Size of a control; the zero value is the default.
type Size string

const (
	SizeDefault Size = ""
	SizeSmall   Size = "sm"
	SizeLarge   Size = "lg"
)

// State is the validation state of a control.
type State string

const (
	StateNone    State = ""
	StateValid   State = "valid"
	StateInvalid State = "invalid"
)

// stateClass returns is-valid / is-invalid (with -lite for the subtle look).
func stateClass(s State, invalid, lite bool) string {
	if invalid {
		s = StateInvalid
	}
	if s == StateNone {
		return ""
	}
	return kit.Classes("is-"+string(s), kit.If(lite, "is-"+string(s)+"-lite"))
}

func sized(base string, s Size) string {
	if s == SizeDefault {
		return ""
	}
	return base + "-" + string(s)
}

type FieldProps struct {
	Class      string // wrapper, default "mb-3"; pass "-" for none
	Attributes templ.Attributes
	Label      string
	For        string // id of the control; without it the label is a <div class="form-label">
	Required   bool   // marks the label (Tabler's .required)
	// RequiredLabel is read out after a Required label by screen readers, e.g. " (required)".
	RequiredLabel string
	Hint          string
	Error         string // shown below the control; mark the control Invalid as well
	Valid         string // positive feedback below the control (valid-feedback); mark the control State valid
	// Description sits at the end of the label line, e.g. a character count (form-label-description).
	Description string
	// Help is a "?" next to the label that opens a popover with this text (form-help).
	Help string
	// LabelHidden keeps the label for screen readers only, e.g. when the placeholder names the field.
	LabelHidden bool
	// Horizontal puts the label beside the control (a row with col-3 col-form-label); the control fills
	// the rest of the row.
	Horizontal bool
	// Fieldset is for a group of Checks: they go into a <fieldset> whose hidden legend repeats the label.
	Fieldset bool
	// Wrap puts the control inside the label (<label class="d-block"> with a span.form-label), so it
	// needs no ids.
	Wrap bool
}

func labelClass(p FieldProps) string {
	base := "form-label"
	if p.Horizontal {
		base = kit.Classes("col-3 col-form-label", kit.If(p.Fieldset, "pt-0"))
	}
	return kit.Classes(base, kit.If(p.Required, "required"), kit.If(p.LabelHidden, "visually-hidden"))
}

templ labelContent(p FieldProps) {
	if p.Help == "" && p.Description == "" && (!p.Required || p.RequiredLabel == "") {
		{ p.Label }
	} else {
		{ p.Label }
		if p.Required && p.RequiredLabel != "" {
			<span class="visually-hidden">{ p.RequiredLabel }</span>
		}
		if p.Help != "" {
			<span class="form-help" { popover.Attrs(popover.Props{Content: p.Help, Placement: popover.Top})... }>?</span>
		}
		if p.Description != "" {
			<span class="form-label-description">{ p.Description }</span>
		}
	}
}

templ fieldLabel(p FieldProps) {
	if p.For != "" {
		<label class={ labelClass(p) } for={ p.For }>
			@labelContent(p)
		</label>
	} else {
		<div class={ labelClass(p) }>
			@labelContent(p)
		</div>
	}
}

templ feedback(p FieldProps) {
	if p.Error != "" {
		<div class="invalid-feedback d-block">{ p.Error }</div>
	}
	if p.Valid != "" {
		<div class="valid-feedback d-block">{ p.Valid }</div>
	}
	if p.Hint != "" {
		<div class="form-hint">{ p.Hint }</div>
	}
}

templ group(p FieldProps, class string) {
	<fieldset
		if class != "" {
			class={ class }
		}
	>
		<legend class="visually-hidden">{ p.Label }</legend>
		{ children... }
	</fieldset>
}

// Field is a form field: a label, the control (the children), and a hint or validation message.
templ Field(p FieldProps) {
	{{ c := kit.Classes(wrapper(p.Class), kit.If(p.Horizontal, "row")) }}
	<div
		if c != "" {
			class={ c }
		}
		{ p.Attributes... }
	>
		if p.Wrap {
			<label class="d-block">
				if p.Label != "" {
					<span class={ labelClass(p) }>
						@labelContent(p)
					</span>
				}
				{ children... }
			</label>
			@feedback(p)
		} else if p.Horizontal {
			@fieldLabel(p)
			if p.Fieldset {
				@group(p, "col") {
					{ children... }
				}
			} else {
				<div class="col">
					{ children... }
					@feedback(p)
				</div>
			}
		} else {
			if p.Label != "" {
				@fieldLabel(p)
			}
			if p.Fieldset {
				@group(p, "") {
					{ children... }
				}
			} else {
				{ children... }
			}
			@feedback(p)
		}
	</div>
}

func wrapper(c string) string {
	switch c {
	case "":
		return "mb-3"
	case "-":
		return ""
	}
	return c
}

type InputProps struct {
	ID          string
	AriaLabel   string // for controls without a visible label
	Class       string
	Attributes  templ.Attributes
	Name        string
	Type        string // default "text"
	Value       string
	Placeholder string
	Required    bool
	Readonly    bool
	Disabled    bool
	Invalid     bool
	State       State // valid or invalid
	Lite        bool  // subtle validation look (is-valid-lite)
	Size        Size
	Rounded     bool   // form-control-rounded
	Flush       bool   // no border (form-control-flush)
	Plaintext   bool   // read-only value shown as text (form-control-plaintext)
	List        string // id of a <datalist> with suggestions
	// Autocomplete is the browser's autofill token, e.g. "email", "current-password", "off".
	Autocomplete string
}

func inputClasses(p InputProps) string {
	base := "form-control"
	if p.Plaintext {
		base = "form-control-plaintext"
	}
	return kit.Classes(base, sized("form-control", p.Size), kit.If(p.Type == "color", "form-control-color"), kit.If(p.Rounded, "form-control-rounded"),
		kit.If(p.Flush, "form-control-flush"), stateClass(p.State, p.Invalid, p.Lite), p.Class)
}

func controlAttrs(id, name, placeholder string, a templ.Attributes, ariaLabel ...string) templ.Attributes {
	a = kit.Attrs(a)
	if len(ariaLabel) > 0 && ariaLabel[0] != "" {
		a = kit.Default(a, "aria-label", ariaLabel[0])
	}
	if id != "" {
		a = kit.Default(a, "id", id)
	}
	if name != "" {
		a = kit.Default(a, "name", name)
	}
	if placeholder != "" {
		a = kit.Default(a, "placeholder", placeholder)
	}
	return a
}

templ Input(p InputProps) {
	<input
		if p.Type != "" && p.Type != "text" {
			type={ p.Type }
		}
		class={ inputClasses(p) }
		value={ p.Value }
		if p.List != "" {
			list={ p.List }
		}
		if p.Autocomplete != "" {
			autocomplete={ p.Autocomplete }
		}
		required?={ p.Required }
		readonly?={ p.Readonly }
		disabled?={ p.Disabled }
		if p.Invalid || p.State == StateInvalid {
			aria-invalid="true"
		}
		{ controlAttrs(p.ID, p.Name, p.Placeholder, p.Attributes, p.AriaLabel)... }
	/>
}

type Option struct {
	Value, Label string
	Disabled     bool
	// Attributes go on the <option>, e.g. data-custom-properties for an enhanced select.
	Attributes templ.Attributes
}

// OptionGroup is an <optgroup> of a Select.
type OptionGroup struct {
	Label   string
	Options []Option
}

type SelectProps struct {
	ID         string
	AriaLabel  string // for controls without a visible label
	Class      string
	Attributes templ.Attributes
	Name       string
	Options    []Option
	Groups     []OptionGroup // options in groups, after Options
	Selected   string
	// SelectedValues are the selected options of a Multiple select.
	SelectedValues []string
	Empty          string // first option with value "", e.g. "All"; empty = none
	Required       bool
	Disabled       bool
	Invalid        bool
	State          State
	Size           Size
	Multiple       bool
}

func selected(p SelectProps, v string) bool {
	if v == p.Selected && (p.Selected != "" || !p.Multiple) {
		return true
	}
	for _, s := range p.SelectedValues {
		if s == v {
			return true
		}
	}
	return false
}

templ Select(p SelectProps) {
	<select
		class={ kit.Classes("form-select", sized("form-select", p.Size), stateClass(p.State, p.Invalid, false), p.Class) }
		multiple?={ p.Multiple }
		required?={ p.Required }
		disabled?={ p.Disabled }
		{ controlAttrs(p.ID, p.Name, "", p.Attributes, p.AriaLabel)... }
	>
		if p.Empty != "" {
			<option value="">{ p.Empty }</option>
		}
		for _, o := range p.Options {
			<option value={ o.Value } selected?={ selected(p, o.Value) } disabled?={ o.Disabled } { o.Attributes... }>{ o.Label }</option>
		}
		for _, g := range p.Groups {
			<optgroup label={ g.Label }>
				for _, o := range g.Options {
					<option value={ o.Value } selected?={ selected(p, o.Value) } disabled?={ o.Disabled } { o.Attributes... }>{ o.Label }</option>
				}
			</optgroup>
		}
	</select>
}

type TextareaProps struct {
	ID          string
	AriaLabel   string // for controls without a visible label
	Class       string
	Attributes  templ.Attributes
	Name        string
	Value       string
	Rows        int
	Placeholder string
	Required    bool
	Readonly    bool
	Disabled    bool
	Invalid     bool
	State       State
	Lite        bool
	Size        Size
	// Autosize grows the textarea with its content (Tabler's script, data-bs-toggle="autosize").
	Autosize bool
}

templ Textarea(p TextareaProps) {
	<textarea
		class={ kit.Classes("form-control", sized("form-control", p.Size), stateClass(p.State, p.Invalid, p.Lite), p.Class) }
		if p.Rows > 0 {
			rows={ p.Rows }
		}
		if p.Autosize {
			data-bs-toggle="autosize"
		}
		required?={ p.Required }
		readonly?={ p.Readonly }
		disabled?={ p.Disabled }
		{ controlAttrs(p.ID, p.Name, p.Placeholder, p.Attributes, p.AriaLabel)... }
	>{ p.Value }</textarea>
}

type CheckProps struct {
	ID         string
	Class      string           // on the label (on the input for CheckInput)
	Attributes templ.Attributes // on the input
	Name       string
	Value      string
	Label      string
	Checked    bool
	Disabled   bool
	Radio      bool
	Switch     bool // Tabler's .form-switch
	Large      bool // a larger switch (form-switch-lg)
	Inline     bool // side by side (form-check-inline)
	Required   bool // marks the label
	// LabelOn and LabelOff replace Label with a text per state, e.g. "Enabled" / "Disabled".
	LabelOn  string
	LabelOff string
	// Description is a muted line below the label (form-check-description).
	Description string
	// Row puts the label at the start of a row and the control at its end, e.g. in a list of settings.
	Row   bool
	State State
}

func checkClasses(p CheckProps) string {
	return kit.Classes("form-check", kit.If(p.Switch, "form-switch"), kit.If(p.Switch && p.Large, "form-switch-lg"), kit.If(p.Inline, "form-check-inline"))
}

templ checkInput(p CheckProps, class string) {
	<input
		class={ kit.Classes("form-check-input", stateClass(p.State, false, false), class) }
		if p.Radio {
			type="radio"
		} else {
			type="checkbox"
		}
		if p.Value != "" {
			value={ p.Value }
		}
		checked?={ p.Checked }
		disabled?={ p.Disabled }
		{ controlAttrs(p.ID, p.Name, "", p.Attributes)... }
	/>
}

// CheckInput is a bare checkbox (or radio) without a label, e.g. in an Addon; give it an aria-label.
templ CheckInput(p CheckProps) {
	@checkInput(p, p.Class)
}

// Check is a checkbox (or radio) with its label, Tabler's .form-check.
templ Check(p CheckProps) {
	if p.Row {
		<label class={ kit.Classes("row", p.Class) }>
			<span class="col">{ p.Label }</span>
			<span class="col-auto">
				<span class={ kit.Classes(checkClasses(p), "form-check-single") }>
					@checkInput(p, "")
				</span>
			</span>
		</label>
	} else {
		<label class={ kit.Classes(checkClasses(p), p.Class) }>
			@checkInput(p, "")
			if p.LabelOn != "" || p.LabelOff != "" {
				<span class="form-check-label form-check-label-on">{ p.LabelOn }</span>
				<span class="form-check-label form-check-label-off">{ p.LabelOff }</span>
			} else {
				<span class={ kit.Classes("form-check-label", kit.If(p.Required, "required")) }>{ p.Label }</span>
			}
			if p.Description != "" {
				<span class="form-check-description">{ p.Description }</span>
			}
		</label>
	}
}

type FeedbackProps struct {
	ID    string // for the control's aria-describedby
	Valid bool   // valid-feedback; default invalid-feedback
}

// Feedback is a validation message right after a control that is marked valid or invalid; it shows
// only then.
templ Feedback(p FeedbackProps) {
	<div
		class={ kit.Classes(kit.If(p.Valid, "valid-feedback"), kit.If(!p.Valid, "invalid-feedback")) }
		if p.ID != "" {
			id={ p.ID }
		}
	>
		{ children... }
	</div>
}

// Datalist holds the suggestions of an Input with List.
templ Datalist(id string, values []string) {
	<datalist id={ id }>
		for _, v := range values {
			<option value={ v }></option>
		}
	</datalist>
}

type HelpProps struct {
	Content string // the popover's text
	HTML    bool   // Content is HTML; it is not escaped, never pass user input
	Label   string // aria-label, default "Help"
}

// Help is a "?" button that opens a popover, e.g. next to a control (form-help).
templ Help(p HelpProps) {
	<button type="button" class="form-help" { popover.Attrs(popover.Props{Content: p.Content, Placement: popover.Top, HTML: p.HTML})... } aria-label={ kit.Or(p.Label, "Help") }>?</button>
}
