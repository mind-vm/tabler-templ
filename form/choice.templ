package form

import (
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/kit"
)

type SelectGroupProps struct {
	Class      string
	Attributes templ.Attributes
	Pills      bool // rounded options (form-selectgroup-pills)
	Boxes      bool // options as boxes with a check and free content (form-selectgroup-boxes)
}

// SelectGroup shows options of a radio or checkbox field as buttons; the children are SelectItems.
templ SelectGroup(props ...SelectGroupProps) {
	{{ p := kit.First(props) }}
	<div class={ kit.Classes("form-selectgroup", kit.If(p.Pills, "form-selectgroup-pills"), kit.If(p.Boxes, "form-selectgroup-boxes"), p.Class) } { p.Attributes... }>
		{ children... }
	</div>
}

type SelectItemProps struct {
	Class      string           // on the item label, e.g. "flex-fill"
	Attributes templ.Attributes // on the input
	Name       string
	Value      string
	Label      string // text; Icon or children replace it
	Icon       string
	Checked    bool
	Disabled   bool
	Radio      bool
	// Box renders a box with a check mark, for a SelectGroup with Boxes: Title and Description, or
	// the children.
	Box         bool
	Title       string
	Description string
}

func choiceInput(radio bool) string {
	if radio {
		return "radio"
	}
	return "checkbox"
}

// SelectItem is one option of a SelectGroup.
templ SelectItem(p SelectItemProps) {
	<label class={ kit.Classes("form-selectgroup-item", p.Class) }>
		<input
			type={ choiceInput(p.Radio) }
			name={ p.Name }
			value={ p.Value }
			class="form-selectgroup-input"
			checked?={ p.Checked }
			disabled?={ p.Disabled }
			{ p.Attributes... }
		/>
		if p.Box && p.Title != "" {
			<span class="form-selectgroup-label d-flex align-items-center p-3">
				<span class="me-3">
					<span class="form-selectgroup-check"></span>
				</span>
				<span class="form-selectgroup-label-content">
					<span class="form-selectgroup-title strong mb-1">{ p.Title }</span>
					if p.Description != "" {
						<span class="d-block text-secondary">{ p.Description }</span>
					}
				</span>
			</span>
		} else if p.Box {
			<div class="form-selectgroup-label d-flex align-items-center p-3">
				<div class="me-3">
					<span class="form-selectgroup-check"></span>
				</div>
				<div>
					{ children... }
				</div>
			</div>
		} else {
			<span class="form-selectgroup-label">
				if p.Icon != "" {
					@icon.Icon(p.Icon, icon.Props{Class: kit.If(p.Label != "", "me-1")})
					if p.Label != "" {
						{ " " }
					}
				}
				{ p.Label }
				{ children... }
			</span>
		}
	</label>
}

type ImageCheckProps struct {
	Class      string
	Attributes templ.Attributes // on the input
	Name       string
	Value      string
	Src        string // the picture; without it the children (e.g. an avatar) are the image
	Alt        string
	Checked    bool
	Radio      bool
}

// ImageCheck is a picture that can be checked like a checkbox or radio.
templ ImageCheck(p ImageCheckProps) {
	<label class={ kit.Classes("form-imagecheck", p.Class) }>
		<input name={ p.Name } type={ choiceInput(p.Radio) } value={ p.Value } class="form-imagecheck-input" checked?={ p.Checked } { p.Attributes... }/>
		<span class="form-imagecheck-figure">
			if p.Src != "" {
				<img src={ p.Src } alt={ p.Alt } class="form-imagecheck-image"/>
			} else {
				<span class="form-imagecheck-image">
					{ children... }
				</span>
			}
		</span>
	</label>
}

type ColorCheckProps struct {
	Class      string
	Attributes templ.Attributes // on the input
	Name       string
	Value      string
	Color      string // background of the swatch, e.g. "lime" → bg-lime
	Label      string // aria-label, e.g. "Lime"
	Checked    bool
	Radio      bool
	// Light uses a dark check mark for light colors (form-colorinput-light).
	Light bool
	Round bool // a round swatch (rounded-circle)
	// CSSColor is any CSS color for the swatch instead of a Tabler color, e.g. "#ffcb9d".
	CSSColor string
}

// ColorCheck is a color swatch that can be checked like a checkbox or radio.
templ ColorCheck(p ColorCheckProps) {
	<label class={ kit.Classes("form-colorinput", kit.If(p.Light, "form-colorinput-light"), p.Class) }>
		<input
			name={ p.Name }
			type={ choiceInput(p.Radio) }
			value={ p.Value }
			class="form-colorinput-input"
			if p.Label != "" {
				aria-label={ p.Label }
			}
			checked?={ p.Checked }
			{ p.Attributes... }
		/>
		<span
			class={ kit.Classes("form-colorinput-color", kit.If(p.Color != "", "bg-"+p.Color), kit.If(p.Round, "rounded-circle")) }
			if p.CSSColor != "" {
				style={ "background-color: " + p.CSSColor }
			}
		></span>
	</label>
}
