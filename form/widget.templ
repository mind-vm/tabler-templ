package form

import (
	"encoding/json"
	"strconv"

	"github.com/mind-vm/tabler-templ/button"
	"github.com/mind-vm/tabler-templ/kit"
)

type RangeProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Name       string
	Min        int
	Max        int // default 100
	Step       int
	Value      int
	AriaLabel  string
}

// Range is the native range slider (form-range).
templ Range(p RangeProps) {
	<input
		type="range"
		class={ kit.Classes("form-range", p.Class) }
		min={ strconv.Itoa(p.Min) }
		if p.Max == 0 {
			max="100"
		} else {
			max={ strconv.Itoa(p.Max) }
		}
		if p.Step > 0 {
			step={ strconv.Itoa(p.Step) }
		}
		value={ strconv.Itoa(p.Value) }
		{ controlAttrs(p.ID, p.Name, "", p.Attributes, p.AriaLabel)... }
	/>
}

type NumberInputProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Name       string
	Value      string
	AriaLabel  string
	// Min, Max and Step bound the value (empty: none, step 1).
	Min, Max, Step string
	Size           Size
	// Number uses <input type="number"> for the browser's validation; default text without spin buttons.
	Number   bool
	NoRepeat bool // stop stepping while a button is held
	Disabled bool
	Readonly bool
	State    State
	// Width of the field for longer values, e.g. "7rem" (--tblr-number-input-input-width).
	Width string
	// Labels of the minus and plus buttons.
	DecrementLabel string
	IncrementLabel string
	// DecrementIcon and IncrementIcon render the buttons here instead of letting the script create them,
	// e.g. "ti-chevron-down" and "ti-chevron-up".
	DecrementIcon string
	IncrementIcon string
}

// NumberInput is a number field with minus and plus buttons, rendered by Tabler's script
// (data-bs-toggle="number-input").
templ NumberInput(p NumberInputProps) {
	if p.DecrementIcon != "" || p.IncrementIcon != "" {
		<div class="number-input" data-bs-toggle="number-input">
			@button.Button(button.Props{Type: "button", Icon: kit.Or(p.DecrementIcon, "ti-minus"), IconOnly: true,
				Attributes: templ.Attributes{"data-bs-number-input-action": "decrement", "aria-label": p.DecrementLabel}})
			@numberField(p, false)
			@button.Button(button.Props{Type: "button", Icon: kit.Or(p.IncrementIcon, "ti-plus"), IconOnly: true,
				Attributes: templ.Attributes{"data-bs-number-input-action": "increment", "aria-label": p.IncrementLabel}})
		</div>
	} else {
		@numberField(p, true)
	}
}

templ numberField(p NumberInputProps, toggle bool) {
	<input
		if p.Number {
			type="number"
		} else {
			type="text"
		}
		class={ kit.Classes("form-control", sized("form-control", p.Size), stateClass(p.State, false, false), p.Class) }
		if toggle {
			data-bs-toggle="number-input"
			if p.DecrementLabel != "" {
				data-bs-decrement-label={ p.DecrementLabel }
			}
			if p.IncrementLabel != "" {
				data-bs-increment-label={ p.IncrementLabel }
			}
		}
		if p.NoRepeat {
			data-bs-repeat="false"
		}
		if p.Value != "" {
			value={ p.Value }
		}
		if p.Min != "" {
			min={ p.Min }
		}
		if p.Max != "" {
			max={ p.Max }
		}
		if p.Step != "" {
			step={ p.Step }
		}
		disabled?={ p.Disabled }
		readonly?={ p.Readonly }
		if p.Width != "" {
			style={ "--tblr-number-input-input-width: " + p.Width }
		}
		{ controlAttrs(p.ID, p.Name, "", p.Attributes, p.AriaLabel)... }
	/>
}

// OTPType is the set of characters an OTP slot accepts.
type OTPType string

const (
	OTPNumeric      OTPType = ""
	OTPAlphanumeric OTPType = "alphanumeric"
	OTPAlpha        OTPType = "alpha"
)

type OTPProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes // on the wrapper
	Name       string
	Value      string
	AriaLabel  string
	Length     int // number of slots, default 6
	Type       OTPType
	Mask       bool   // shows filled slots as dots
	Groups     []int  // slots per visual group, e.g. 3, 3
	Separator  string // between groups, e.g. "-"
	Connected  bool   // slots joined into one control
	Size       Size
	Disabled   bool
	Invalid    bool
}

func groupsJSON(g []int) string {
	b, _ := json.Marshal(g)
	return string(b)
}

// OTP is a one-time code input with one slot per character, rendered by Tabler's script
// (data-bs-toggle="otp"); the form receives the whole code in one field.
templ OTP(p OTPProps) {
	<div
		class={ kit.Classes("otp", sized("otp", p.Size), kit.If(p.Connected, "otp-connected"), kit.If(p.Invalid, "is-invalid"), p.Class) }
		data-bs-toggle="otp"
		if p.Length > 0 {
			data-bs-length={ strconv.Itoa(p.Length) }
		}
		if p.Type != OTPNumeric {
			data-bs-type={ string(p.Type) }
		}
		if p.Mask {
			data-bs-mask="true"
		}
		if len(p.Groups) > 0 {
			data-bs-groups={ groupsJSON(p.Groups) }
		}
		if p.Separator != "" {
			data-bs-separator={ p.Separator }
		}
		{ p.Attributes... }
	>
		<input
			type="text"
			if p.ID != "" {
				id={ p.ID }
			}
			if p.Name != "" {
				name={ p.Name }
			}
			if p.Value != "" {
				value={ p.Value }
			}
			if p.Length > 0 {
				maxlength={ strconv.Itoa(p.Length) }
			}
			disabled?={ p.Disabled }
			if p.AriaLabel != "" {
				aria-label={ p.AriaLabel }
			}
			if p.Invalid {
				aria-invalid="true"
			}
		/>
	</div>
}

type StrengthProps struct {
	Class      string
	Attributes templ.Attributes // on the meter
	Segments   int              // bars, default 4
	// Input is a selector of the password field when the meter is not its sibling, e.g. "#password".
	Input      string
	MinLength  int
	Thresholds []int             // score bounds for weak, fair and good
	Messages   map[string]string // label per level (weak, fair, good, strong)
	NoText     bool              // no label below the meter
	TextClass  string
	Label      string // aria-label, default kit.T(ctx).PasswordStrength
}

func segments(p StrengthProps) int {
	if p.Segments <= 0 {
		return 4
	}
	return p.Segments
}

func jsonOf(v any) string {
	b, _ := json.Marshal(v)
	return string(b)
}

// Strength is a password strength meter, filled by Tabler's script as the user types; the children are
// the label shown while the field is empty.
templ Strength(p StrengthProps) {
	<div
		class={ kit.Classes("strength", p.Class) }
		data-bs-strength
		if p.Input != "" {
			data-bs-input={ p.Input }
		}
		if p.MinLength > 0 {
			data-bs-min-length={ strconv.Itoa(p.MinLength) }
		}
		if len(p.Thresholds) > 0 {
			data-bs-thresholds={ jsonOf(p.Thresholds) }
		}
		if len(p.Messages) > 0 {
			data-bs-messages={ jsonOf(p.Messages) }
		}
		aria-label={ kit.Or(p.Label, kit.T(ctx).PasswordStrength) }
		{ p.Attributes... }
	>
		for range segments(p) {
			<span class="strength-segment"></span>
		}
	</div>
	if !p.NoText {
		<div class={ kit.Classes("strength-text", p.TextClass) }>
			{ children... }
		</div>
	}
}
