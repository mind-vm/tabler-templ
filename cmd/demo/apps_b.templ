							{Term: "Account:", Value: "tabler"},
							{Term: "Location:", Content: countryFlag("pl", "xxs", "Poland")},
							{Term: "IP Address:", Value: "46.113.11.3"},
							{Term: "Operating system:", Value: "OS X 10.15.2 64-bit"},
