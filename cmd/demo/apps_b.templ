				{Icon: "ti-shopping-cart", Color: "green", Title: "78 Orders", Text: "32 shipped"},
				{Icon: "ti-user", Color: "red", Title: "1352 Members", Text: "163 registered today"},
				{Icon: "ti-message", Color: "yellow", Title: "132 Comments", Text: "16 waitings"},
				{ChartStart: true, Chart: circle("sales", "56", "primary", "12 waiting payments"), Title: "132 Sales", Text: "12 waiting payments"},
