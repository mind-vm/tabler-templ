							{Icon: "ti-home", Label: "Lives in:", Value: "Šentilj v Slov. Goricah, Slovenia"},
							{Icon: "ti-map-pin", Label: "From:", Content: countryFlag("si", "xs", "Slovenia")},
							{Icon: "ti-calendar", Label: "Birth date:", Value: "13/01/1985"},
							{Icon: "ti-clock", Label: "Time zone:", Value: "Europe/Ljubljana"},
