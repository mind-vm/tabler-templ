					Description: "New accounts that finished every setup step. There is no target for this metric yet."})
			</div>
			<div class="col-lg-6">
				@projects.Progress(projects.ProgressProps{Image: "https://cdn.dribbble.com/users/844826/screenshots/14553706/media/2be9a4847b939e02702648d058cf2df8.png",
					Title: "Food Deliver UI dashboards", Updated: "Updated 2 days ago", Progress: 25, Actions: bfMoreMenu()})
			</div>
			<div class="col-lg-6">
