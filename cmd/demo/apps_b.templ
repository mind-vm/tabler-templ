			</div>
			<div class="col-12 col-md-6 col-xxl-3 mb-4 mb-xxl-0">
				@metric.IconCard(metric.IconCardProps{Label: "Hours logged", Value: "42.7 hrs", Icon: "ti-clock", Countup: `{"suffix":" hrs","decimalPlaces":1}`})
			</div>
			<div class="col-12 col-md-6 col-xxl-3 mb-4 mb-md-0">
				@metric.IconCard(metric.IconCardProps{Label: "Avg. time", Value: "3:28 hrs", Icon: "ti-slideshow", Countup: `{"format":"time","suffix":" hrs"}`})
			</div>
			<div class="col-12 col-md-6 col-xxl-3">
				@metric.IconCard(metric.IconCardProps{Label: "Weekly growth", Value: "18.4%", Icon: "ti-discount", Countup: `{"suffix":"%","decimalPlaces":1}`})
			</div>
			<div class="col-md-4">
				@metric.Gauge(metric.GaugeProps{ID: "deliverability", Title: "Deliverability", Value: 96, Label: "delivered", Count: 48210, Total: 50219, Color: "green",
					Description: "Share of sent emails accepted by the receiving server. Anything above 95% is healthy."})
			</div>
			<div class="col-md-4">
				@metric.Gauge(metric.GaugeProps{ID: "storage", Title: "Storage used", Value: 82, Label: "used", Count: 410, Total: 500, Color: "yellow",
