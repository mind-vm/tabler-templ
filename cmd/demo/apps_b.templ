package main

import (
	"github.com/mind-vm/tabler-templ/avatar"
	"github.com/mind-vm/tabler-templ/blocks/cards"
	"github.com/mind-vm/tabler-templ/blocks/crypto"
	"github.com/mind-vm/tabler-templ/blocks/metric"
	"github.com/mind-vm/tabler-templ/blocks/profile"
	"github.com/mind-vm/tabler-templ/blocks/projects"
	userblocks "github.com/mind-vm/tabler-templ/blocks/users"
	"github.com/mind-vm/tabler-templ/chart"
	"github.com/mind-vm/tabler-templ/flag"
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/sparkline"
)

templ cryptoTickers() {
	<div class="col-12">
		<div class="row row-cards">
			for _, t := range []metric.TickerProps{
				{Title: "Total balance", Icon: "ti-currency-dollar", Value: "$253,545", Extra: "2.3 BTC", Trend: metric.Trend(0), Note: "Since last week"},
				{Title: "USD/BTC", Icon: "ti-currency-bitcoin", Value: "0.00000907", Extra: "$110,237", Note: "Volume: $34,042,670,971"},
				{Title: "LTC/BTC", Icon: "ti-currency-litecoin", Value: "0.00089444", Extra: "$98.6", Note: "Volume: 618,605,108"},
				{Title: "ETH/BTC", Icon: "ti-currency-ethereum", Value: "0.03528906", Extra: "$3,890.16", Note: "Volume: 18,899,881,132"},
				{Title: "XMR/BTC", Icon: "ti-currency-monero", Value: "0.00310313", Extra: "$342.08", Note: "Volume: 151,720,448"},
			} {
				<div class="col-12 col-md-6 col-xxl">
					@metric.Ticker(t)
				</div>
			}
		</div>
	</div>
}

templ cryptoViewAll() {
	<button class="btn btn-sm">View all</button>
}

templ dashboardCryptoPage() {
	@preview("dashboard-crypto") {
		<div class="row row-cards">
			@cryptoTickers()
			<div class="col-12">
				<div class="row row-cards">
					<div class="col-12 col-lg-5">
						@crypto.Markets(crypto.MarketsProps{Actions: bfMoreMenu()}, cryptoMarkets)
					</div>
					<div class="col-12 col-lg-7">
						@crypto.ChartCard(crypto.ChartCardProps{Title: "LTC/BTC", Switch: crypto.SwitchProps{Name: "timeframe", Options: []string{"1m", "5m", "30m", "1h", "1d"}, Active: 1}}) {
							@chart.Chart(tc("dashboard-crypto-candlestick", "LTC/BTC", 28))
						}
					</div>
				</div>
			</div>
			<div class="col-12">
				<div class="row row-cards">
					<div class="col-12 col-lg-12 col-xxl-3">
						@crypto.OrderForm(crypto.OrderFormProps{
							Operations: crypto.SwitchProps{Name: "operations", Options: []string{"Buy", "Sell", "Send"}},
							Currencies: cryptoSymbols, Amount: "0.25", Price: "23,077.05", Total: "5,769.27",
							Note: "The final amount could change depending on current market conditions.",
						})
					</div>
					<div class="col-12 col-lg-6 col-xxl">
						@crypto.Orders(crypto.OrdersProps{Title: "Sell Orders", Actions: cryptoViewAll()}, cryptoSellOrders)
					</div>
					<div class="col-12 col-lg-6 col-xxl">
						@crypto.Orders(crypto.OrdersProps{Title: "Buy Orders", Actions: cryptoViewAll()}, cryptoBuyOrders)
					</div>
				</div>
			</div>
		</div>
	}
}

func team(names ...string) []avatar.Props {
	out := make([]avatar.Props, len(names))
	for i, n := range names {
		out[i] = avatar.Props{Src: avatarURL(n)}
	}
	return out
}

func circle(id, value, color, label string) templ.Component {
	v := []float64{12}
	if value == "56" {
		v = []float64{56}
	}
	return sparkline.Sparkline(sparkline.Props{Attributes: templ.Attributes{"id": id}, Values: v, Type: sparkline.Circle, Color: color, Size: "lg", Label: "auto", AriaLabel: label})
}

func personAvatar(name string) *avatar.Props {
	return &avatar.Props{Src: avatarURL(name)}
}

templ editConfiguration() {
	<a href="#">
		Edit configuration
		@icon.Icon("ti-edit", icon.Props{Inline: true, Class: "ms-1"})
	</a>
}

templ countryFlag(code, size, name string) {
	@flag.Flag(code, flag.Props{Size: flag.Size(size)})
	{ " " + name }
}

templ subscribeButton() {
	<a href="#" class="btn">Subscribe </a>
}

const cardCode = `.card-footer {
  background: transparent;

  &:last-child {
    border-radius: 0 0 4px 4px;
  }
}`

templ widgetsPage() {
	@preview("widgets") {
		<div class="row row-cards">
			<div class="col-12 col-md-6 col-xxl-3 mb-4 mb-xxl-0">
