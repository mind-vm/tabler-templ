						{Icon: "ti-heart", Color: "red", Title: "1700", Text: "Users", Chart: sparkline.Sparkline(sparkline.Props{Attributes: templ.Attributes{"id": "widget-bar-red"}, Type: sparkline.Bar, Values: []float64{20, 40, 30, 10, 40, 60, 80, 70}, Color: "red", AriaLabel: "Trend"})},
						{Icon: "ti-brand-github", Color: "green", Title: "1700", Text: "Users", Chart: sparkline.Sparkline(sparkline.Props{Attributes: templ.Attributes{"id": "widget-bar-green"}, Type: sparkline.Bar, Values: []float64{20, 40, 20, -10, -30, 10, 40, 60, 80, 70}, Color: "green", AriaLabel: "Trend"})},
						{Avatar: personAvatar("063m"), Title: "1700", Text: "Users", Chart: circle("widget-donut-10", "12", "primary", "Trend")},
						{Avatar: personAvatar("006m"), Title: "1700", Text: "Users", Chart: circle("widget-donut-11", "12", "primary", "Trend")},
						{Avatar: personAvatar("000m"), Title: "1700", Text: "Users", Chart: circle("widget-donut-1", "56", "primary", "Trend")},
						{Avatar: personAvatar("003m"), Title: "1700", Text: "Users"},
						{Avatar: personAvatar("002m"), Title: "1700", Text: "Users", TitleIcon: "ti-trending-down", Color: "red"},
					} {
