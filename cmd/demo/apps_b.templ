			}
			for _, p := range []userblocks.Person{
				{Avatar: avatarURL("010m"), Name: "Thatcher Keel", Detail: "VP Sales"},
				{Avatar: avatarURL("005f"), Name: "Dyann Escala", Detail: "Mechanical Systems Engineer"},
				{Avatar: avatarURL("006f"), Name: "Avivah Mugleston", Detail: "Actuary"},
				{Initials: "AA", Name: "Arlie Armstead", Detail: "VP Quality Control"},
			} {
				<div class="col-md-6 col-xl-3">
					@userblocks.Profile(p, "")
				</div>
			}
			for i, p := range []userblocks.Person{
				{Avatar: avatarURL("012f"), Name: "Marsha Labat", Detail: "Research Associate"},
				{Avatar: avatarURL("013m"), Name: "Elston Muffett", Detail: "Account Coordinator"},
				{Avatar: avatarURL("013f"), Name: "Leigha Gorce", Detail: "Geologist II"},
				{Initials: "TB", Name: "Tallie Bettis", Detail: "Director of Sales"},
			} {
				<div class="col-md-6 col-xl-3">
					@userblocks.Cover(p, photo("photos/"+[]string{"blond-using-her-laptop-at-her-bedroom.jpg", "tropical-palm-leaves-floral-pattern-background.jpg",
