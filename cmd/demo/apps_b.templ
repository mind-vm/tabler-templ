					Title: "Projects Dashboards", Updated: "Updated 7 days ago", Progress: 76, Actions: bfMoreMenu()})
			</div>
			for i, p := range []userblocks.Person{
				{Avatar: avatarURL("001f"), Name: "Maryjo Lebarree", Detail: "Civil Engineer"},
				{Avatar: avatarURL("004m"), Name: "Egan Poetz", Detail: "Research Nurse"},
				{Avatar: avatarURL("002f"), Name: "Kellie Skingley", Detail: "Teacher"},
				{Avatar: avatarURL("003f"), Name: "Christabel Charlwood", Detail: "Tax Accountant"},
			} {
				<div class="col-md-6 col-xl-3">
					@userblocks.Link(p, i >= 2)
