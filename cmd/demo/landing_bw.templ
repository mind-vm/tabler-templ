func bwLogos() []templ.Component {
	var cs []templ.Component
	for _, l := range mktLogos {
		cs = append(cs, bwLogo(l))
	}
	return cs
}

templ bwLogo(l marketing.Logo) {
	<span class="bw-logo" aria-label={ l.Name } role="img">
		@l.Image
	</span>
}

templ bwPageBody() {
	@bwPage() {
		@marketing.Hero(marketing.HeroProps{Header: true, Class: "pb-0",
			Announcement:     marketing.Announcement(marketing.AnnouncementProps{Badge: "New", Text: "AI triage is in public beta", Href: "#features"}),
			TitleHTML:        templ.Raw("The issue tracker for<br/>teams that ship"),
			Description:      "Tasklane keeps issues, cycles and roadmaps in one fast, quiet place – so your team spends its time building, not updating tickets.",
			DescriptionClass: "mt-4",
			Actions:          []templ.Component{lpIconButton("Get started", "btn-lg btn-primary", "ti-arrow-right"), lpButton("Book a demo", "btn-lg", "#")}}) {
			<p class="text-secondary small mt-n3 mb-6">Free for up to 3 members · No credit card</p>
			<div class="container container-slim-lg">
				@bwIssueTable()
			</div>
		}
		<div id="customers">
			@marketing.Section(marketing.SectionProps{}) {
				<div class="container">
					<p class="text-center text-secondary mb-5">Trusted by product teams at fast-moving companies</p>
					@marketing.Marquee(marketing.MarqueeProps{Label: "Customers", Speed: "slow"}, bwLogos())
				</div>
			}
		</div>
		<div id="features">
			@marketing.Section(marketing.SectionProps{}) {
				@marketing.FeatureCards(marketing.FeatureCardsProps{Header: marketing.HeaderProps{Title: "Everything a product team needs", Description: "Opinionated where it saves you time, flexible where your process is different."}}, bwFeatures)
			}
		</div>
		@marketing.Section(marketing.SectionProps{}) {
			@marketing.Bento(marketing.HeaderProps{Title: "One tool, every view", Description: "From the first bug report to the release notes."}, bwBento)
		}
		@marketing.Section(marketing.SectionProps{}) {
			@marketing.Testimonials(marketing.TestimonialsProps{Header: marketing.HeaderProps{Title: "Loved by 4,000 teams", Description: "What engineers and product managers say after their first quarter."}}, mktTestimonials[:6])
		}
		<div id="pricing">
			@marketing.Section(marketing.SectionProps{}) {
				@marketing.Plans(marketing.PlansProps{ID: "bw-plans", Save: "-15%", Header: marketing.HeaderProps{Title: "Pricing that grows with your team", Description: "Start free, upgrade when you need cycles, insights and AI."}}, bwPlans)
			}
		</div>
		@marketing.Section(marketing.SectionProps{}) {
			@marketing.CTABox(marketing.CTABoxProps{Color: "light", Inline: true, Title: "Ship your next release with Tasklane",
				Text:    "Import from Jira or GitHub in minutes. Your team will thank you.",
				Actions: []templ.Component{lpButton("Book a demo", "", "#"), lpButton("Get started", "btn-primary", "#pricing")}})
		}
	}
}
