package main

import (
	"github.com/mind-vm/tabler-templ/blocks/layout"
	"github.com/mind-vm/tabler-templ/blocks/metric"
	"github.com/mind-vm/tabler-templ/chart"
	"github.com/mind-vm/tabler-templ/chart/svg"
	"github.com/mind-vm/tabler-templ/internal/catalog"
)

var (
	svgDays    = []string{"Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"}
	svgMonths  = []string{"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"}
	svgSolved  = []float64{155, 65, 465, 265, 225, 325, 80}
	svgOpened  = []float64{60, 40, 120, 90, 75, 110, 35}
	svgRevenue = []float64{12400, 15800, 14100, 18900, 21300, 19800, 23400, 25100, 22800, 27600, 29900, 31200}
	svgCosts   = []float64{9800, 10200, 11900, 12100, 13800, 14200, 15000, 15900, 16100, 17400, 18800, 19100}
)

func sv(name, color string, data ...float64) chart.Serie {
	return chart.Serie{Name: name, Color: color, Data: data}
}

// svgCharts are the examples of the SVG charts page: a title, what it shows, and the chart.
var svgCharts = []struct {
	Col, Title, Subtitle string
	Props                svg.Props
}{
	{third, "Bars", "`svg.Chart` with the default type: one serie, a tooltip per bar and per day.",
		svg.Props{Label: "Tickets solved per day", Categories: svgDays, Series: []chart.Serie{sv("Solved", "primary", svgSolved...)}}},
	{third, "Grouped bars", "Two series side by side with a legend and the data as a hidden table (`Table`).",
		svg.Props{Label: "Tickets solved and opened per day", Categories: svgDays, Legend: true, Table: true, Series: []chart.Serie{sv("Solved", "", svgSolved...), sv("Opened", "", svgOpened...)}}},
	{third, "Stacked bars", "`Stacked` with the values on the bars (`DataLabels`).",
		svg.Props{Label: "Tickets solved and opened per day, stacked", Categories: svgDays, Stacked: true, DataLabels: true, Series: []chart.Serie{sv("Solved", "", svgSolved...), sv("Opened", "", svgOpened...)}}},
	{third, "Horizontal bars", "`Horizontal`, with one color per bar (`Colors`, one serie).",
		svg.Props{Label: "Visitors per step", Horizontal: true, DataLabels: true, Categories: []string{"Visit", "Sign-up", "Trial", "Order", "Customer"},
			Colors: []string{"primary", "azure", "green", "orange", "red"}, Series: []chart.Serie{sv("Visitors", "", 4200, 2100, 980, 420, 260)}}},
	{third, "Negative values", "Bars below zero start at the zero line.",
		svg.Props{Label: "Profit per quarter", Categories: []string{"Q1", "Q2", "Q3", "Q4"}, Series: []chart.Serie{sv("Profit", "teal", 4.2, -1.8, 2.6, 6.1)}, YFormatter: chart.SuffixK}},
	{third, "Columns and a line", "`Serie.Type` mixes bars and lines in one chart.",
		svg.Props{Label: "Orders and returns per day", Categories: svgDays, Series: []chart.Serie{sv("Orders", "", svgSolved...), {Name: "Returns", Type: "line", Color: "red", Data: svgOpened}}, Legend: true}},
	{half, "Line", "A smooth line (`StrokeCurve: \"smooth\"`, monotone: no peaks the data does not have), dots and a target line; numbers in German (`Format: svg.German`).",
		svg.Props{Label: "Umsatz je Monat", Type: chart.Line, Categories: svgMonths, StrokeCurve: "smooth", ShowMarkers: true, Format: svg.German, Height: 14,
			Series: []chart.Serie{sv("Umsatz", "", svgRevenue...), sv("Kosten", "", svgCosts...)}, StrokeDash: []float64{0, 4}, Legend: true,
			AnnotationsY: []chart.Annotation{{Value: 20000.0, Label: "Ziel", Color: "green"}}}},
	{half, "Stepped line", "`StrokeCurve: \"stepline\"` for values that change in jumps.",
		svg.Props{Label: "Running instances during the day", Type: chart.Line, Height: 14, StrokeCurve: "stepline", Categories: []string{"0h", "3h", "6h", "9h", "12h", "15h", "18h", "21h"},
			Series: []chart.Serie{sv("Instances", "purple", 2, 2, 3, 6, 8, 7, 5, 3)}}},
	{third, "Area", "A filled area under a line.",
		svg.Props{Label: "Revenue per month", Type: chart.Area, Categories: svgMonths, Series: []chart.Serie{sv("Revenue", "", svgRevenue...)}, YFormatter: chart.Thousands}},
	{third, "Stacked areas", "Two areas on top of each other.",
		svg.Props{Label: "Storage used by media and backups", Type: chart.Area, Stacked: true, StrokeCurve: "smooth", Categories: svgMonths[:8], Legend: true,
			Series: []chart.Serie{sv("Media", "", 31, 40, 28, 51, 42, 60, 55, 70), sv("Backups", "", 11, 32, 45, 32, 34, 52, 41, 39)}}},
	{third, "Sparkline", "`Sparkline` drops axes, grid and padding, e.g. at the bottom of a card (`Size: chart.SizeSmall`).",
		svg.Props{Label: "Revenue trend", Type: chart.Area, Sparkline: true, Size: chart.SizeSmall, Series: []chart.Serie{sv("Revenue", "", svgRevenue...)}}},
	{third, "Donut", "Each serie is a slice with its value in `Data[0]`; `DataLabels` writes the shares.",
		svg.Props{Label: "Traffic by source", Type: chart.Donut, Legend: true, DataLabels: true, Height: 12,
			Series: []chart.Serie{sv("Direct", "", 44), sv("Search", "", 55), sv("Social", "", 13), sv("Referral", "", 33)}}},
	{third, "Pie", "The same without a hole.",
		svg.Props{Label: "Devices", Type: chart.Pie, Legend: true, DataLabels: true, Height: 12,
			Series: []chart.Serie{sv("Desktop", "", 63), sv("Mobile", "", 29), sv("Tablet", "", 8)}}},
	{third, "Radial bar", "A percentage on a ring, with its name in the middle.",
		svg.Props{Label: "Tasks done", Type: chart.RadialBar, Height: 12, Series: []chart.Serie{sv("Done", "green", 72)}}},
	{third, "Half gauge", "`StartAngle: -90, EndAngle: 90`.",
		svg.Props{Label: "Server load", Type: chart.RadialBar, Height: 9, StartAngle: -90, EndAngle: 90, Series: []chart.Serie{sv("Load", "orange", 42)}}},
	{third, "Tabler's radial", "`StartAngle: -120, EndAngle: 120`, like `chart.Radial`.",
		svg.Props{Label: "Active users", Type: chart.RadialBar, Height: 12, StartAngle: -120, EndAngle: 120, Series: []chart.Serie{sv("Active users", "", 58)}}},
	{third, "Rings", "Several percentages as rings, with the values in the legend.",
		svg.Props{Label: "Goals reached", Type: chart.RadialBar, Height: 12, Legend: true, Series: []chart.Serie{sv("Sales", "", 72), sv("Support", "", 48), sv("Hiring", "", 90)}}},
}

templ chartsSVGPage() {
	{{ p, _ := catalog.Find("charts-svg") }}
	{{ fp := frameProps("charts-svg", p.Title) }}
	{{ fp.Header = layout.PageHeader(layout.PageHeaderProps{Title: p.Title, Description: p.Description}) }}
	@layout.Page(fp) {
		<div class="row row-cards">
			for _, c := range svgCharts {
				<div class={ c.Col }>
					@section(c.Title, c.Subtitle) {
						<div class="mt-3">
							@svg.Chart(c.Props)
						</div>
					}
				</div>
			}
			<div class="col-md-6 col-lg-4">
				@metric.Gauge(metric.GaugeProps{ID: "svg", Title: "Delivery rate", Description: "metric.Gauge with SVG: true draws its ring as SVG too.",
					Value: 96, Label: "delivered", Count: 48210, Total: 50219, Color: "green", SVG: true})
			</div>
		</div>
	}
}
