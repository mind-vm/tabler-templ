// previewLibs is preview with the plugin libraries a page needs in the head, before Tabler's stylesheet
// (like the preview: Tabler's vendor styles override the plugins' own).
templ previewLibs(name string, libs ...templ.Component) {
	{{ p, _ := catalog.Find(name) }}
	{{ fp := frameProps(name, p.Title) }}
	{{ fp.Head = templ.Join(append(libs, assets())...) }}
	{{ fp.Header = layout.PageHeader(layout.PageHeaderProps{Title: p.Title, Description: p.Description, Actions: originalLink(name)}) }}
	@layout.Page(fp) {
		{ children... }
	}
}

// appFrameLibs is appFrame with plugin libraries in the head.
templ appFrameLibs(name, title, containerClass string, libs ...templ.Component) {
	{{ fp := frameProps(name, title) }}
	{{ fp.Head = templ.Join(append(libs, assets())...) }}
	{{ fp.Header = layout.PageHeader(layout.PageHeaderProps{Title: title, Actions: originalLink(name)}) }}
	{{ fp.ContainerClass = containerClass }}
	@layout.Page(fp) {
		{ children... }
	}
}

func intp(i int) *int { return &i }

// dpCard is a card of the datepicker page.
templ dpCard(col, title, subtitle string) {
	<div class={ col }>
		@section(title, subtitle) {
			{ children... }
		}
	</div>
}

templ dpLabel(id, text string) {
	<label class="form-label" for={ id }>{ text }</label>
}

templ datepickerPage() {
	{{ year := strconv.Itoa(time.Now().Year()) }}
	{{ rangeDates := []string{year + "-06-10", year + "-06-18"} }}
	@previewLibs("datepicker", datepicker.Library()) {
		<div class="row row-cards">
			@dpCard("col-md-6 col-lg-4", "Basic", "Add `data-bs-toggle=\"datepicker\"` to a text input. The calendar opens on focus.") {
				@dpLabel("datepicker-basic", "Date")
				@datepicker.Input(datepicker.Props{ID: "datepicker-basic"})
			}
			@dpCard("col-md-6 col-lg-4", "With icon", "Wrap the field in `.input-icon`. The popup lines up with the wrapper, not the input.") {
				@dpLabel("datepicker-icon", "Date")
				@datepicker.Input(datepicker.Props{ID: "datepicker-icon", Layout: datepicker.LayoutIcon, Class: "mb-3"})
				@dpLabel("datepicker-icon-prepend", "Date")
				@datepicker.Input(datepicker.Props{ID: "datepicker-icon-prepend", Layout: datepicker.LayoutIconPrepend})
			}
			@dpCard("col-md-6 col-lg-4", "Initial value", "A `value` in `YYYY-MM-DD` is shown on load and the calendar opens on that month.") {
				@dpLabel("datepicker-value", "Birth date")
				@datepicker.Input(datepicker.Props{ID: "datepicker-value", Value: "1990-06-20"})
			}
			@dpCard("col-md-6 col-lg-4", "Min and max", "Limit the pickable dates with `data-bs-date-min` and `data-bs-date-max`.") {
				@dpLabel("datepicker-min-max", "Event date ("+year+" only)")
				@datepicker.Input(datepicker.Props{ID: "datepicker-min-max", Min: year + "-01-01", Max: year + "-12-31", Placeholder: "Select a date in " + year})
			}
			@dpCard("col-md-6 col-lg-4", "Date range", "Set `data-bs-selection-mode=\"multiple-ranged\"` to pick a start and an end date.") {
				@dpLabel("datepicker-range", "Stay")
				@datepicker.Input(datepicker.Props{ID: "datepicker-range", Mode: datepicker.ModeRange, Selected: rangeDates, Placeholder: "Select start and end"})
			}
			@dpCard("col-md-6 col-lg-4", "Multiple dates", "Set `data-bs-selection-mode=\"multiple\"` to pick any number of dates.") {
				@dpLabel("datepicker-multiple", "Days off")
				@datepicker.Input(datepicker.Props{ID: "datepicker-multiple", Mode: datepicker.ModeMultiple, Placeholder: "Select dates"})
			}
			@dpCard("col-md-6 col-lg-4", "Two months", "Add `data-bs-display-months-count=\"2\"` to show two months side by side.") {
				@dpLabel("datepicker-two-months", "Stay")
				@datepicker.Input(datepicker.Props{ID: "datepicker-two-months", Mode: datepicker.ModeRange, Months: 2, Placeholder: "Select start and end"})
			}
			@dpCard("col-md-6 col-lg-4", "Week starts on Sunday", "Set `data-bs-first-weekday=\"0\"`. The default is Monday.") {
				@dpLabel("datepicker-sunday", "Date")
				@datepicker.Input(datepicker.Props{ID: "datepicker-sunday", FirstWeekday: intp(0)})
			}
			@dpCard("col-md-6 col-lg-4", "Week numbers", "Add `data-bs-week-numbers=\"true\"` to show the week number in front of each row.") {
				@dpLabel("datepicker-week-numbers", "Delivery date")
				@datepicker.Input(datepicker.Props{ID: "datepicker-week-numbers", WeekNumbers: true})
			}
			@dpCard("col-md-6 col-lg-4", "Placement", "Align the popup with `data-bs-placement`: left, center, right or auto.") {
				@dpLabel("datepicker-center", "Centered")
				@datepicker.Input(datepicker.Props{ID: "datepicker-center", Placement: "center", Class: "mb-3"})
				@dpLabel("datepicker-right", "Right aligned")
				@datepicker.Input(datepicker.Props{ID: "datepicker-right", Placement: "right"})
			}
			@dpCard("col-md-6 col-lg-4", "Button trigger", "Any element works as a trigger. Mark the text with `data-bs-datepicker-display` so the icon stays.") {
				<div class="btn-list">
					<button type="button" class="btn" { datepicker.Attrs(datepicker.Props{})... }>
						@icon.Icon("ti-calendar")
						<span data-bs-datepicker-display>Select date</span>
					</button>
					<button type="button" class="btn" { datepicker.Attrs(datepicker.Props{Mode: datepicker.ModeRange})... }>
						@icon.Icon("ti-calendar-event")
						<span data-bs-datepicker-display>Select range</span>
					</button>
				</div>
			}
			@dpCard("col-md-6 col-lg-4", "Events", "Listen to `change.bs.datepicker` to read the picked dates as `YYYY-MM-DD`.") {
				@dpLabel("datepicker-events", "Date")
				@datepicker.Input(datepicker.Props{ID: "datepicker-events", Mode: datepicker.ModeRange, Placeholder: "Select start and end"})
				<div class="form-text" id="datepicker-events-output">No dates picked yet.</div>
			}
		</div>
		<div class="row row-cards mt-4">
			@dpCard("col-md-6 col-lg-4", "Inline calendar", "Add `data-bs-inline=\"true\"` to render the calendar in place. It takes the card as its surface.") {
				@datepicker.Input(datepicker.Props{ID: "datepicker-inline", Inline: true})
			}
			@dpCard("col-md-6 col-lg-4", "Inline range", "Inline calendars take the same options. This one picks a start and an end date.") {
				@datepicker.Input(datepicker.Props{ID: "datepicker-inline-range", Inline: true, Mode: datepicker.ModeRange, Selected: rangeDates})
			}
			@dpCard("col-md-6 col-lg-4", "Inline in a form", "A hidden input inside the calendar submits the picked dates with the form.") {
				<form onsubmit="return false">
					@datepicker.Input(datepicker.Props{ID: "datepicker-inline-form", Inline: true, Name: "selected_date"})
					<button type="submit" class="btn btn-primary mt-3">Submit</button>
				</form>
			}
			@dpCard("col-md-6 col-lg-4", "Inline with week numbers", "Week numbers work in an inline calendar too, and with every selection mode.") {
				@datepicker.Input(datepicker.Props{ID: "datepicker-inline-week-numbers", Inline: true, WeekNumbers: true, Mode: datepicker.ModeRange, Selected: rangeDates})
			}
			@dpCard("col-md-12 col-lg-8", "Inline with two months", "Add `data-bs-display-months-count=\"2\"` for a wide calendar.") {
				@datepicker.Input(datepicker.Props{ID: "datepicker-inline-two-months", Inline: true, Mode: datepicker.ModeRange, Months: 2})
			}
		</div>
		<script>
			document.getElementById('datepicker-events').addEventListener('change.bs.datepicker', (event) => {
				const output = document.getElementById('datepicker-events-output')
				output.textContent = event.dates.length ? `Picked: ${event.dates.join(', ')}` : 'No dates picked yet.'
			})
		</script>
	}
}

templ dropzonePage() {
	@previewLibs("dropzone", dropzone.Library()) {
		<div class="row row-cards">
			<div class="col-md-6">
				@section("Basic Usage", "Drag a file in or click to browse — a single drop target for one upload.") {
					@dropzone.Dropzone(dropzone.Props{ID: "dropzone-default"})
				}
			</div>
			<div class="col-md-6">
				@section("Multiple File Upload", "Accept and preview several files at once from the same drop target.") {
					@dropzone.Dropzone(dropzone.Props{ID: "dropzone-multiple", Multiple: true})
				}
			</div>
			<div class="col-md-6">
				@section("Custom Dropzone", "Swap in your own label and helper text for the drop target.") {
					@dropzone.Dropzone(dropzone.Props{ID: "dropzone-custom", Title: "Your text here", Text: "Your custom description here"})
				}
			</div>
		</div>
	}
}

var colorTitles = []string{"Blue", "Azure", "Indigo", "Purple", "Pink", "Red", "Orange", "Yellow", "Lime", "Green", "Teal", "Cyan"}

templ colorpickerPage() {
	@previewLibs("colorpicker", colorpicker.Library()) {
		@section("Basic", "Click a swatch to open the picker and choose any color.") {
			<div class="row g-3">
				for i, c := range colorpicker.Swatches {
					<div class="col-2">
						<div>
							@colorpicker.Input(colorpicker.Props{ID: "colorpicker-" + strconv.Itoa(i+1), Value: c, Format: "hex", Label: colorTitles[i] + " color value"})
						</div>
					</div>
				}
			</div>
		}
	}
}

templ wysiwygPage() {
	@previewLibs("wysiwyg", wysiwyg.Library()) {
		@section("Rich text editor", "A formatting toolbar for headings, lists, and links, dropped into a normal form field.") {
			@form.Field(form.FieldProps{Label: "Your name", For: "wysiwyg-name"}) {
				@form.Input(form.InputProps{ID: "wysiwyg-name", Placeholder: "Name"})
			}
			@form.Field(form.FieldProps{Label: "Description", For: "hugerte-description"}) {
				@wysiwyg.Editor(wysiwyg.Props{ID: "hugerte-description", Value: "Hello, <b>Tabler</b>!"})
			}
		}
