// ---- datagrid

type bfPair struct{ Title, Value string }

templ bfPairs(pairs []bfPair, list bool) {
	for _, p := range pairs {
		@datagrid.Item(datagrid.ItemProps{Title: p.Title, List: list}) {
			{ p.Value }
		}
	}
}

var bfServer = []bfPair{{"CPU", "8 cores"}, {"Memory", "32 GB"}, {"Storage", "512 GB"}, {"Region", "eu-central"}, {"Uptime", "99.98%"}, {"Backups", "Daily"},
	{"IPv6", "Enabled"}, {"Port", "3306"}}

templ bfPersonCell(av, name string) {
	<div class="d-flex align-items-center">
		@avatar.Avatar(avatar.Props{Src: avatarURL(av), Size: avatar.SizeXS, Class: "me-2"})
		{ name }
	</div>
}

templ bfUsage(pct float64, color string) {
	<div class="mb-1">{ itoaPct(pct) }</div>
	@progress.Progress(progress.Props{Value: pct, Color: color, Size: progress.SizeSmall})
}

templ bfCopy(id, value, label string) {
	<div class="d-flex align-items-center gap-2">
		<code id={ id } class="text-truncate">{ value }</code>
		@clipboard.Button(clipboard.Props{Small: true, Class: "btn-action", Target: id, AriaLabel: label, FeedbackColor: "green"})
	</div>
}

templ bfGridCard(title, subtitle string) {
	@card.Card() {
		@card.Body() {
			@card.Title() {
				{ title }
			}
			@card.Subtitle() {
				@withCode(subtitle)
			}
			{ children... }
		}
	}
}

templ datagridPage() {
	@preview("datagrid") {
		<div class="row row-cards">
			<div class="col-12">
				@bfTitleCard("Base info", card.Props{}) {
					@card.Body() {
						@datagrid.Grid() {
							@bfPairs([]bfPair{{"Registrar", "Third Party"}, {"Nameservers", "Third Party"}, {"Port number", "3306"}, {"Expiration date", "–"}}, false)
							@datagrid.Item(datagrid.ItemProps{Title: "Creator"}) {
								@bfPersonCell("000m", "Paweł Kuna")
							}
							@bfPairs([]bfPair{{"Age", "15 days"}}, false)
							@datagrid.Item(datagrid.ItemProps{Title: "Edge network"}) {
								@status.Status(status.Props{Color: "green"}) {
									Active
								}
							}
							@datagrid.Item(datagrid.ItemProps{Title: "Avatars list"}) {
								@bfAvatars(avatar.SizeXS, "+3")
							}
							@datagrid.Item(datagrid.ItemProps{Title: "Checkbox"}) {
								@form.Check(form.CheckProps{Label: "Click me", Checked: true})
							}
							@datagrid.Item(datagrid.ItemProps{Title: "Icon"}) {
								@icon.Icon("ti-check", icon.Props{Color: "green", Inline: true})
								Checked
							}
							@datagrid.Item(datagrid.ItemProps{Title: "Form control"}) {
								@form.Input(form.InputProps{Flush: true, Placeholder: "Input placeholder"})
							}
							@bfPairs([]bfPair{{"Longer description", "Lorem ipsum dolor sit amet, consectetur adipisicing elit."}}, false)
						}
					}
				}
			</div>
			<div class="col-lg-6">
				@bfGridCard("Basic", "A `.datagrid` with plain text values.") {
					@datagrid.Grid() {
						@bfPairs([]bfPair{{"Plan", "Business"}, {"Billing period", "Monthly"}, {"Next invoice", "October 18, 2026"}, {"Seats", "8 of 10 used"}}, false)
					}
				}
			</div>
			<div class="col-lg-6">
				@bfGridCard("Description list", "Use `dl`, `dt` and `dd` so screen readers announce the pairs.") {
					@datagrid.Grid(datagrid.Props{List: true}) {
						@bfPairs([]bfPair{{"Company", "Tabler Ltd."}, {"Tax ID", "EU123456789"}, {"Billing email", "billing@tabler.io"}, {"Country", "Poland"}}, true)
					}
				}
			</div>
			<div class="col-lg-6">
				@bfGridCard("Narrow columns", "Lower `--tblr-datagrid-item-width` to fit more columns in a row.") {
					@datagrid.Grid(datagrid.Props{ItemWidth: "7rem"}) {
						@bfPairs(bfServer, false)
					}
				}
			</div>
			<div class="col-lg-6">
				@bfGridCard("Compact gap", "Lower `--tblr-datagrid-padding` to bring the items closer together.") {
					@datagrid.Grid(datagrid.Props{ItemWidth: "7rem", Gap: "0.75rem"}) {
						@bfPairs(bfServer, false)
					}
				}
			</div>
			<div class="col-lg-6">
				@bfGridCard("Horizontal", "Add `.datagrid-horizontal` to put the label beside the value.") {
					@datagrid.Grid(datagrid.Props{Horizontal: true, Gap: "1rem"}) {
						@bfPairs([]bfPair{{"Plan", "Business"}}, false)
						@datagrid.Item(datagrid.ItemProps{Title: "Status"}) {
							@status.Status(status.Props{Color: "green"}) {
								Active
							}
						}
						@bfPairs([]bfPair{{"Next invoice", "October 18, 2026"}, {"Address", "44 Harbor Street, Portland, OR 97209, United States"}}, false)
					}
				}
			</div>
			<div class="col-lg-6">
				@bfGridCard("Horizontal in columns", "Add `.datagrid-cols-2` and lower `--tblr-datagrid-title-width` to fit two pairs in a row.") {
					@datagrid.Grid(datagrid.Props{Horizontal: true, Columns: 2, Gap: "1rem", TitleWidth: "5rem"}) {
						@bfPairs(bfServer[:6], false)
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@bfGridCard("Single column", "Add `.datagrid-cols-1` to stack the items.") {
					@datagrid.Grid(datagrid.Props{Columns: 1, Gap: "1rem"}) {
						@datagrid.Item(datagrid.ItemProps{Title: "Customer"}) {
							@bfPersonCell("002m", "Mallory Hulme")
						}
						@datagrid.Item(datagrid.ItemProps{Title: "Email"}) {
							<a href="#">mhulme2@domainmarket.com</a>
						}
						@bfPairs([]bfPair{{"Shipping address", "44 Harbor Street, Portland, OR 97209, United States"}}, false)
						@datagrid.Item(datagrid.ItemProps{Title: "Notes"}) {
							<span class="text-secondary">Not set</span>
						}
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@bfGridCard("Two columns", "Add `.datagrid-cols-2` to keep two columns at any width.") {
					@datagrid.Grid(datagrid.Props{Columns: 2, Gap: "1rem"}) {
						@bfPairs([]bfPair{{"Order", "#48213"}}, false)
						@datagrid.Item(datagrid.ItemProps{Title: "Status"}) {
							@badge.Badge(badge.Props{Color: "green", Light: true}) {
								Paid
							}
						}
						@bfPairs([]bfPair{{"Placed", "September 12, 2026"}, {"Delivery", "September 16, 2026"}, {"Items", "3"}}, false)
						@datagrid.Item(datagrid.ItemProps{Title: "Total"}) {
							<strong>$248.00</strong>
						}
						@bfPairs([]bfPair{{"Payment", "Visa ending 4242"}, {"Carrier", "DHL Express"}}, false)
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@bfGridCard("Statuses and progress", "A value can hold a status, a badge or a progress bar.") {
					@datagrid.Grid(datagrid.Props{Columns: 2, Gap: "1rem"}) {
						@datagrid.Item(datagrid.ItemProps{Title: "State"}) {
							@status.Status(status.Props{Color: "green"}) {
								Running
							}
						}
						@datagrid.Item(datagrid.ItemProps{Title: "Health"}) {
							@status.Status(status.Props{Color: "yellow"}) {
								Degraded
							}
						}
						@datagrid.Item(datagrid.ItemProps{Title: "Environment"}) {
							@badge.Badge(badge.Props{Color: "blue", Light: true}) {
								Production
							}
						}
						@datagrid.Item(datagrid.ItemProps{Title: "Version"}) {
							<code>v1.6.1</code>
						}
						@datagrid.Item(datagrid.ItemProps{Title: "Disk usage"}) {
							@bfUsage(68, "")
						}
						@datagrid.Item(datagrid.ItemProps{Title: "Memory usage"}) {
							@bfUsage(41, "green")
						}
					}
				}
			</div>
			<div class="col-lg-6">
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Domain details
						}
						@card.Actions() {
							@button.Button(button.Props{Type: "button", Size: button.SizeSmall, Icon: "ti-pencil"}) {
								Edit
							}
						}
					}
					@card.Body() {
						@datagrid.Grid(datagrid.Props{ItemWidth: "12rem"}) {
							@datagrid.Item(datagrid.ItemProps{Title: "Domain"}) {
								<a href="#">
									tabler.io{ " " }
									@icon.Icon("ti-external-link", icon.Props{Inline: true})
								</a>
							}
							@bfPairs([]bfPair{{"Registrar", "Third Party"}}, false)
							@datagrid.Item(datagrid.ItemProps{Title: "SSL certificate"}) {
								@icon.Icon("ti-lock", icon.Props{Color: "green", Inline: true})
								Valid until May 2, 2027
							}
							@datagrid.Item(datagrid.ItemProps{Title: "Auto renew"}) {
								@form.Check(form.CheckProps{Switch: true, Checked: true, Label: "Enabled", Class: "mb-0"})
							}
							@datagrid.Item(datagrid.ItemProps{Title: "Owner"}) {
								@bfPersonCell("000f", "Emmy Levet")
							}
							@bfPairs([]bfPair{{"Expiration date", "–"}}, false)
						}
					}
					@card.Footer() {
						@button.List(button.ListProps{Class: "justify-content-end"}) {
							@button.Button(button.Props{Type: "button", Ghost: true, Variant: button.VariantSecondary}) {
								Transfer
							}
							@button.Button(button.Props{Type: "button", Variant: button.VariantPrimary}) {
								Renew domain
							}
						}
					}
				}
			</div>
			<div class="col-lg-6">
				@bfTitleCard("API credentials", card.Props{}) {
					@card.Body() {
						@card.Subtitle() {
							@withCode("Add a `data-bs-toggle=\"clipboard\"` button to let users copy a value.")
						}
						@datagrid.Grid(datagrid.Props{Columns: 1, Gap: "1rem"}) {
							@datagrid.Item(datagrid.ItemProps{Title: "Client ID"}) {
								@bfCopy("datagrid-client-id", "tblr_live_8f3a2c91d7e4", "Copy the client ID")
							}
							@datagrid.Item(datagrid.ItemProps{Title: "Webhook URL"}) {
								@bfCopy("datagrid-webhook-url", "https://example.com/hooks/tabler", "Copy the webhook URL")
							}
							@bfPairs([]bfPair{{"Last used", "2 hours ago"}}, false)
						}
					}
				}
			</div>
		</div>
	}
}

