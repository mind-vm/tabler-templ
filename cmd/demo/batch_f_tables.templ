func bfAvatarProps(a string) avatar.Props {
	if len(a) > 2 && a[:2] == "I:" {
		return avatar.Props{Initials: a[2:], Class: "me-2"}
	}
	return avatar.Props{Src: avatarURL(a), Class: "me-2"}
}

templ bfStaffTable(rows []bfStaff, striped bool) {
	@table.Table(table.Props{Responsive: true, VCenter: true, Card: true, Striped: striped}) {
		<thead>
			<tr>
				<th>Name</th>
				<th>Title</th>
				<th>Email</th>
				<th>Role</th>
				<th class="w-1"><span class="visually-hidden">Actions</span></th>
			</tr>
		</thead>
		<tbody>
			for _, r := range rows {
				<tr>
					<td>{ r.Name }</td>
					<td class="text-secondary">{ r.Title }</td>
					<td class="text-secondary"><a href="#" class="text-reset">{ r.Email }</a></td>
					<td class="text-secondary">{ r.Role }</td>
					<td><a href="#">Edit</a></td>
				</tr>
			}
		</tbody>
	}
}

templ bfMemberTable(rows []bfMember, mobile bool) {
	@table.Table(table.Props{Responsive: true, VCenter: true, Card: true, Mobile: pickStr(mobile, "md")}) {
		<thead>
			<tr>
				<th>Name</th>
				<th>Title</th>
				<th>Role</th>
				<th class="w-1"><span class="visually-hidden">Actions</span></th>
			</tr>
		</thead>
		<tbody>
			for _, r := range rows {
				<tr>
					<td data-label={ pickStr(mobile, "Name") }>
						<div class="d-flex py-1 align-items-center">
							@avatar.Avatar(bfAvatarProps(r.Avatar))
							<div class="flex-fill">
								<div class="fw-medium">{ r.Name }</div>
								<div class="text-secondary"><a href="#" class="text-reset">{ r.Email }</a></div>
							</div>
						</div>
					</td>
					<td data-label={ pickStr(mobile, "Title") }>
						<div>{ r.Title }</div>
						<div class="text-secondary">{ r.Dept }</div>
					</td>
					<td class="text-secondary" data-label={ pickStr(mobile, "Role") }>{ r.Role }</td>
					<td>
						if mobile {
							@button.List(button.ListProps{Class: "flex-nowrap"}) {
								@button.Button(button.Props{Type: "button"}) {
									Edit
								}
								@tables.RowActions(bfRowMenu())
							}
						} else {
							<a href="#">Edit</a>
						}
					</td>
				</tr>
			}
		</tbody>
	}
}

func pickStr(cond bool, s string) string {
	if cond {
		return s
	}
	return ""
}

templ bfRowMenu() {
	@dropdown.Item() {
		Action
	}
	@dropdown.Item() {
		Another action
	}
}

var bfTopPages = []tables.RankingRow{
	{Text: "/", Percent: 82.54, Value: "4896"}, {Text: "/form-elements.html", Percent: 76.29, Value: "3652"}, {Text: "/index.html", Percent: 72.65, Value: "3256"},
	{Text: "/icons.html", Percent: 44.89, Value: "986"}, {Text: "/docs/", Percent: 41.12, Value: "912"}, {Text: "/accordion.html", Percent: 32.65, Value: "855"},
	{Text: "/datagrid.html", Percent: 16.22, Value: "764"}, {Text: "/datatables.html", Percent: 8.69, Value: "686"},
}

var bfEmployeeColumns = []tables.Column{
	{Field: "sort-name", Label: "Name"}, {Field: "sort-city", Label: "City"}, {Field: "sort-status", Label: "Status"}, {Field: "sort-date", Label: "Start date"},
	{Field: "sort-tags", Label: "Tags"}, {Field: "sort-category", Label: "Category", Class: "py-0"},
}

func bfEmployeeTable() tables.AdvancedProps {
	rows := make([]tables.Row, len(bfEmployees))
	for i, e := range bfEmployees {
		a := e.Avatar
		a.Class = "me-2"
		rows[i] = tables.Row{Name: e.Name, Cells: []templ.Component{bfEmployeeName(a, e.Name), bfText(e.City), bfEmployeeStatus(e.Status, e.StatusColor),
			bfText(e.Date), bfTags(e.Tags), tables.OnChecked(e.Category, bfDotsButton())}}
	}
	return tables.AdvancedProps{ID: "advanced-table", Title: "Employee", Description: "Table description.", Search: true, Actions: bfEmployeeActions(),
		Columns: bfEmployeeColumns, Rows: rows, Page: 3, Pages: 10}
}

templ bfEmployeeName(a avatar.Props, name string) {
	@avatar.Avatar(a)
	{ name }
}

templ bfEmployeeStatus(text, color string) {
	@badge.Badge(badge.Props{Color: color, Light: true}) {
		{ text }
	}
}

templ bfTags(tags []string) {
	@badge.List() {
		for _, t := range tags {
			@badge.Badge() {
				{ t }
			}
		}
	}
}

templ bfDotsButton() {
	@button.Button(button.Props{Type: "button", IconOnly: true, Icon: "ti-dots", Label: "Actions"})
}

templ bfEmployeeActions() {
	@button.Button(button.Props{Type: "button", IconOnly: true, Icon: "ti-dots", Label: "More actions"})
	@dropdown.Dropdown() {
		@dropdown.Toggle(button.Props{}) {
			Download
		}
		@dropdown.Menu() {
			@dropdown.Item() {
				Action
			}
			@dropdown.Item() {
				Another action
			}
			@dropdown.Item() {
				Third action
			}
		}
	}
	@button.Button(button.Props{Type: "button"}) {
		Button
	}
}

templ tablesPage() {
	@preview("tables") {
		<div class="row row-cards">
			<div class="col-lg-8">
				@card.Card() {
					@bfHead("Basic table", "A clean list of rows and columns, ready to drop into any card.", nil)
					@bfStaffTable(bfStaffBasic, false)
				}
			</div>
			<div class="col-lg-4">
				@tables.Ranking(tables.RankingProps{Title: "Top Pages", Label: "Page", ValueLabel: "Visitors"}, bfTopPages)
			</div>
			<div class="col-12">
				@card.Card() {
					@bfHead("Striped rows", "Alternate row shading with `table-striped` to make wide tables easier to scan.", nil)
					@bfStaffTable(bfStaffStriped, true)
				}
			</div>
			<div class="col-12">
				@card.Card() {
					@bfHead("With avatars", "Swap the plain name column for an avatar, title, and department.", nil)
					@bfMemberTable(bfMembers, false)
				}
			</div>
			<div class="col-12">
				@card.Card() {
					@bfHead("Responsive with actions", "Collapses to stacked rows on mobile and adds an actions button per row.", nil)
					@bfMemberTable(bfMembersMobile, true)
				}
			</div>
			<div class="col-12">
				@tables.Invoices(tables.InvoicesProps{Count: 8, Total: 16, Page: 3, Pages: 5, Actions: bfRowMenu()}, bfInvoices)
			</div>
			<div class="col-12">
				@tables.Advanced(bfEmployeeTable())
			</div>
		</div>
		// List.js sorts, searches and pages the advanced table (a plugin, as in Tabler's preview).
		<script src={ cdn.URL("list.js", versions.ListJS, "dist/list.min.js") } defer></script>
		@tables.AdvancedScript(bfEmployeeTable())
	}
}

func itoaPct(n float64) string { return strconv.FormatFloat(n, 'f', -1, 64) + "%" }
