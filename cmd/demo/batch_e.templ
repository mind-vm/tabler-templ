func photoProps(g galleryItem) gallery.PhotoProps {
	av := ""
	if g.Avatar != "" {
		av = avatarURL(g.Avatar)
	}
	return gallery.PhotoProps{Src: photo("photos/" + g.File), Alt: g.Alt, Avatar: av, Initials: g.Initials, Name: g.Name, Time: g.Time, Views: g.Views, Likes: g.Likes, Liked: g.Liked}
}

templ photoCards(items []galleryItem) {
	for _, g := range items {
		<div class="col-sm-6 col-lg-4">
			@gallery.Photo(photoProps(g))
		</div>
	}
}

// Search results

templ searchResultsPage() {
	@preview("search-results") {
		<div class="row g-4">
			<div class="col-md-3">
				@search.Filters(search.FiltersProps{}) {
					@search.Categories("Category", []search.Category{{Name: "Games", Count: "24", Active: true}, {Name: "Clothing", Count: "11"}, {Name: "Jewelery", Count: "11"}, {Name: "Toys", Count: "54"}})
					@search.Choices(search.ChoicesProps{Title: "Rating", Name: "form-stars", Radio: true, Options: []search.Option{{Label: "5 stars", Checked: true}, {Label: "4 stars"}, {Label: "3 stars"}, {Label: "2 and less stars"}}})
					@search.Choices(search.ChoicesProps{Title: "Tags", Name: "form-tags[]", Options: []search.Option{{Label: "business", Checked: true}, {Label: "evening"}, {Label: "leisure"}, {Label: "party"}}})
					@search.Range(search.RangeProps{Title: "Price", Prefix: "$", From: "3"})
					@search.Select(search.SelectProps{Title: "Shipping", Name: "shipping-country", Options: []string{"United Kingdom", "USA", "Germany", "Poland", "Other…"}})
					@search.Buttons(search.ButtonsProps{})
				}
			</div>
			<div class="col-md-9">
				<div class="row row-cards">
					@photoCards(searchPhotos)
				</div>
			</div>
		</div>
	}
}

// Gallery

templ galleryActions() {
	<div class="d-flex">
		<div class="me-3">
			@form.InputIcon(form.InputIconProps{Icon: "ti-search"}) {
				@form.Input(form.InputProps{Type: "text", Placeholder: "Search…", AriaLabel: "Search"})
			}
		</div>
		@button.Button(button.Props{Type: "button", Variant: button.VariantPrimary, Icon: "ti-plus"}) {
			Add event
		}
	</div>
}

func eNoHref(int) string { return "#" }

templ galleryPage() {
	@layout.Page(eFramed("gallery", "", galleryActions())) {
		<div class="row row-cards">
			@photoCards(galleryPhotos)
		</div>
		<div class="d-flex mt-5">
			@pagination.Pagination(pagination.Props{Page: 3, Pages: 5, Href: eNoHref, Class: "ms-auto", Label: "Pagination"})
		</div>
	}
}

// Photogrid

type eGridTile struct{ File, Title, Ratio string }

func eTile(t eGridTile) gallery.TileProps {
	return gallery.TileProps{Src: photo("photos/" + t.File), Title: t.Title, Ratio: t.Ratio, Class: "rounded-3 border", Lightbox: "gallery"}
}

