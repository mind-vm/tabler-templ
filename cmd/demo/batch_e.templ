func batchEPages() map[string]templ.Component {
	return map[string]templ.Component{
		"faq":            faqPage(),
		"changelog":      changelogPage(),
		"search-results": searchResultsPage(),
		"job-listing":    jobListingPage(),
		"gallery":        galleryPage(),
		"photogrid":      photogridPage(),
		"logs":           logsPage(),
		"users":          usersPage(),
		"profile":        profilePage(),
		"cookie-banner":  cookieBannerPage(),
		"blank":          blankPage(),
	}
}

// framed is a preview page whose header has actions of its own (before the link to the original).
// title overrides the catalog's title where the original's heading differs.
func eFramed(name, title string, actions templ.Component) layout.PageProps {
	p, _ := catalog.Find(name)
	if title == "" {
		title = p.Title
	}
	fp := frameProps(name, title)
	fp.Header = layout.PageHeader(layout.PageHeaderProps{Title: title, Description: p.Description, Actions: eWithOriginal(name, actions)})
	return fp
}

templ eWithOriginal(name string, actions templ.Component) {
	<div class="d-flex align-items-center">
		@actions
		<div class="ms-3">
			@originalLink(name)
		</div>
	</div>
}

// FAQ

const faqLorem = "Lorem ipsum dolor sit amet, consectetur adipisicing elit. Accusantium alias dignissimos dolorum ea est eveniet, excepturi illum in iste iure maiores nemo recusandae rerum saepe sed, sunt totam! Explicabo, ipsa?"

templ faqAnswer() {
	<div>
		<p>{ faqLorem }</p>
		<p>{ faqLorem }</p>
	</div>
}

func faqQuestions(qs ...string) []faqblock.Question {
	out := make([]faqblock.Question, len(qs))
	for i, q := range qs {
		out[i] = faqblock.Question{Q: q, Answer: faqAnswer()}
	}
	return out
}

var faqSections = []faqblock.Section{
	{Title: "1. Introduction", Questions: faqQuestions("Welcome to our service!", "Who are we?", "What are our values?")},
	{Title: "2. Functionality", Questions: faqQuestions("What are the key features?", "Does your App support mobile devices?", "Why should I choose your service?", "Is my data secure?")},
	{Title: "3. Payments", Questions: faqQuestions("Is there any free plan?", "What are the available payment options?", "Can I get a refund?")},
}

templ faqCrumbs() {
	<div class="d-flex">
		@breadcrumb.Breadcrumb(breadcrumb.Props{Separator: breadcrumb.SeparatorArrows, Label: "Breadcrumb"}, []breadcrumb.Crumb{{Text: "Tabler", Href: "#"}, {Text: "Pages"}})
	</div>
}

templ faqPage() {
	@layout.Page(eFramed("faq", "", faqCrumbs())) {
		@faqblock.FAQ(faqblock.Props{}, faqSections)
	}
}

// Changelog: the preview redirects to the changelog on tabler.io.

templ changelogPage() {
	<!DOCTYPE html>
	<html lang="en-US">
		<meta charset="utf-8"/>
		<title>Redirecting…</title>
		<link rel="canonical" href="https://tabler.io/changelog"/>
		<meta http-equiv="refresh" content="0; url=https://tabler.io/changelog"/>
		<meta name="robots" content="noindex"/>
		<noscript><a href="https://tabler.io/changelog">Click here if you are not redirected.</a></noscript>
	</html>
}

