templ roleBadge(color, role string) {
	@badge.Badge(badge.Props{Color: color, Light: true}) {
		{ role }
	}
}

func userCard(p ePerson) userblock.CardProps {
	c := userblock.CardProps{Initials: p.Initials, Name: p.Name, Detail: p.Job,
		Actions: []userblock.Action{{Href: "#", Icon: "ti-mail", Text: "Email"}, {Href: "#", Icon: "ti-phone", Text: "Call"}}}
	if p.Avatar != "" {
		c.Avatar = avatarURL(p.Avatar)
	}
	if p.Role != "" {
		c.Badge = roleBadge(p.Badge, p.Role)
	}
	return c
}

templ usersActions() {
	<div class="d-flex">
		@form.Input(form.InputProps{Type: "search", Class: "d-inline-block w-9 me-3", Placeholder: "Search user…", AriaLabel: "Search user"})
		@button.Button(button.Props{Type: "button", Variant: button.VariantPrimary, Icon: "ti-plus"}) {
			New user
		}
	</div>
}

templ usersPage() {
	@layout.Page(eFramed("users", "Users", usersActions())) {
		<div class="row row-cards">
			for _, p := range userList {
				<div class="col-md-6 col-lg-3">
					@userblock.Card(userCard(p))
				</div>
			}
		</div>
		<div class="d-flex mt-4">
			@pagination.Pagination(pagination.Props{Page: 3, Pages: 5, Href: eNoHref, Class: "ms-auto", Label: "Pagination"})
		</div>
	}
}

