	{"job-9.jpg", "Laravel Developer", "", "Mindsize", "Full-time", "Remote / USA", []string{"PHP", "Laravel"}},
}

func jobProps(j eJob) jobs.JobProps {
	return jobs.JobProps{Logo: photo("jobs/" + j.Logo), Title: j.Title, Salary: j.Salary, Tags: j.Tags,
		Facts: []jobs.Fact{{Icon: "ti-building-community", Text: j.Company}, {Icon: "ti-license", Text: j.Contract}, {Icon: "ti-map-pin", Text: j.Place}}}
}

templ postJob() {
	@button.Button(button.Props{Type: "button", Variant: button.VariantPrimary, Icon: "ti-plus"}) {
		Post a eJob
	}
}

templ jobChecks(name string, labels []string, checked int, radio bool) {
	for i, l := range labels {
		@form.Check(form.CheckProps{Name: name, Value: string(rune('1' + i)), Label: l, Checked: i < checked, Radio: radio})
	}
}

templ onOff() {
	@form.Check(form.CheckProps{Switch: true, LabelOn: "On", LabelOff: "Off"})
}

templ jobListingPage() {
	@layout.Page(eFramed("job-listing", "", postJob())) {
		<div class="row g-4">
			<div class="col-md-3">
				@search.Filters(search.FiltersProps{Class: "sticky-top"}) {
					<div class="form-label">Job Types</div>
					<div class="mb-4">
						@jobChecks("form-type[]", []string{"Programming", "Design", "Management / Finance", "Customer Support", "Sales / Marketing"}, 2, false)
					</div>
					<div class="form-label">Remote</div>
					<div class="mb-4">
						@onOff()
					</div>
					<div class="form-label">Salary Range</div>
					<div class="mb-4">
						@jobChecks("form-salary", []string{"$20K - $50K", "$50K - $100K", "> $100K"}, 1, true)
					</div>
					<div class="form-label">Immigration</div>
					<div class="mb-4">
						@onOff()
						<div class="small text-secondary">Only show companies that can sponsor a visa</div>
					</div>
					<label class="form-label" for="job-location">Location</label>
					<div class="mb-4">
						<select class="form-select" id="job-location" name="location">
							for _, o := range []string{"Anywhere", "London", "San Francisco", "New York", "Berlin"} {
								<option>{ o }</option>
							}
						</select>
					</div>
					@search.Buttons(search.ButtonsProps{ResetHref: "#"})
				}
			</div>
			<div class="col-md-9">
				<div class="row row-cards">
					<div class="space-y">
						for _, j := range jobList {
							@jobs.Job(jobProps(j))
						}
					</div>
				</div>
			</div>
		</div>
	}
}

// Profile

templ profileActions() {
	@button.List() {
		@button.Button(button.Props{Type: "button", Icon: "ti-dots", IconOnly: true, Attributes: templ.Attributes{"aria-label": "More options"}})
		@button.Button(button.Props{Type: "button", Icon: "ti-message", IconOnly: true, Attributes: templ.Attributes{"aria-label": "Send message"}})
		@button.Button(button.Props{Type: "button", Variant: button.VariantPrimary, Icon: "ti-check"}) {
			Following
		}
	}
}

templ timelineTitle(title string) {
	<h2 class="h4">{ title }</h2>
}

templ friendRequests() {
	@timelineTitle("+3 Friend Requests")
	@avatar.List(avatar.ListProps{Class: "mt-3"}) {
		for _, a := range []string{"000m", "052f", "002m"} {
			@avatar.Avatar(avatar.Props{Src: avatarURL(a), Status: "success", StatusLabel: "Online"})
		}
	}
}

var timelinePhotos = []eGridTile{{"blue-sofa-with-pillows-in-a-designer-living-room-interior.jpg", "Blue sofa with pillows in a designer living room interior", ""},
	{"home-office-desk-with-macbook-iphone-calendar-watch-and-organizer.jpg", "Home office desk with Macbook, iPhone, calendar, watch & organizer", ""},
	{"young-woman-working-in-a-cafe.jpg", "Young woman working in a cafe", ""}}

templ slovenia() {
	@flag.Flag("si", flag.Props{Size: flag.SizeXS})
	Slovenia
}

templ profilePage() {
	{{ fp := frameProps("profile", "Profile") }}
	{{ fp.Header = profile.Header(profile.HeaderProps{Avatar: avatarURL("003m"), Name: "Dunn Slane", Bio: "Unemployed. Building a $1M solo business while traveling the world. Currently at $400k/yr.",
		Facts: []profile.Fact{{Icon: "ti-map", Text: "Harbin University of Civil Engineering & Architecture, China"}, {Icon: "ti-mail", Text: "dslane3@epa.gov", Href: "#"}, {Icon: "ti-cake", Text: "15/10/1972"}},
		Actions: profileActions()}) }}
	@layout.Page(fp) {
		<div class="row g-3">
			<div class="col">
				@timeline.Timeline() {
					@timeline.Event(timeline.EventProps{Icon: "ti-brand-x", Strong: "x", Time: "10 hrs ago"}) {
						@timelineTitle("+1150 Followers")
						<p class="text-secondary">You’re getting more and more followers, keep it up!</p>
					}
					@timeline.Event(timeline.EventProps{Icon: "ti-briefcase", Time: "2 hrs ago"}) {
						@timelineTitle("+3 New Products were added!")
						<p class="text-secondary">Congratulations!</p>
					}
					@timeline.Event(timeline.EventProps{Icon: "ti-check", Time: "1 day ago"}) {
						@timelineTitle("Database backup completed!")
						<p class="text-secondary">Download the <a href="#">latest backup</a>.</p>
					}
					@timeline.Event(timeline.EventProps{Icon: "ti-brand-facebook", Strong: "facebook", Time: "1 day ago"}) {
						@timelineTitle("+290 Page Likes")
						<p class="text-secondary">This is great, keep it up!</p>
					}
					@timeline.Event(timeline.EventProps{Icon: "ti-user-plus", Time: "2 days ago"}) {
						@friendRequests()
					}
					@timeline.Event(timeline.EventProps{Icon: "ti-photo", Time: "3 days ago"}) {
						@timelineTitle("+3 New photos")
						<div class="mt-3">
							<div class="row g-2">
								for _, t := range timelinePhotos {
									<div class="col-4">
										<img src={ photo("photos/" + t.File) } class="rounded" alt={ t.Title }/>
									</div>
								}
							</div>
						</div>
					}
					@timeline.Event(timeline.EventProps{Icon: "ti-settings", Time: "2 weeks ago"}) {
						@timelineTitle("System updated to v2.02")
						<p class="text-secondary">Check the complete changelog at the <a href="#">activity page</a>.</p>
					}
				}
			</div>
			<div class="col-lg-4">
				<div class="row row-cards">
					<div class="col-12">
						@profile.Info("Basic info", []profile.Item{
							{Icon: "ti-book", Label: "Went to:", Value: "University of Ljubljana"},
							{Icon: "ti-briefcase", Label: "Worked at:", Value: "Devpulse"},
							{Icon: "ti-home", Label: "Lives in:", Value: "Šentilj v Slov. Goricah, Slovenia"},
							{Icon: "ti-map-pin", Label: "From:", Content: slovenia()},
							{Icon: "ti-calendar", Label: "Birth date:", Value: "13/01/1985"},
							{Icon: "ti-clock", Label: "Time zone:", Value: "Europe/Ljubljana"},
						})
					</div>
					<div class="col-12">
						@card.Card() {
							@card.Body() {
								<h2 class="card-title">About Me</h2>
								<div>
									<p>
										Lorem ipsum dolor sit amet, consectetur adipisicing elit. Accusantium aliquid beatae eaque eius esse fugit, hic id illo itaque modi molestias nemo perferendis quae rerum soluta. Blanditiis laborum minima molestiae molestias nemo nesciunt nisi pariatur quae sapiente ut. Aut consectetur doloremque, error impedit, ipsum labore laboriosam minima non omnis perspiciatis possimus praesentium provident quo recusandae suscipit tempore totam.
									</p>
								</div>
							}
						}
					</div>
				</div>
			</div>
		</div>
	}
}

// Cookie banner

templ cookieText() {
	<strong>Do you like cookies?</strong> 🍪 We use cookies to ensure you get the best experience on our website.
}

templ cookieBannerPage() {
	@preview("cookie-banner") {
		@cookie.Banner(cookie.BannerProps{ID: "offcanvasBottom", Show: true, Text: cookieText(), LearnHref: "./terms-of-service.html",
			Buttons: []cookie.Button{{Text: "Essential Cookies Only"}, {Text: "Allow All Cookies"}}})
	}
}

// Blank page: no page header, an empty state in the middle.

// The original's inline SVG is 256px high; the PNG would grow to the container's width.
templ blankIllustration() {
	<img src={ photo("illustrations/light/computer-fix.png") } height="256" style="height:256px" alt=""/>
}

templ addClient() {
	@button.Button(button.Props{Href: ".", Variant: button.VariantPrimary, Icon: "ti-plus"}) {
		Add your first client
	}
}

templ blankPage() {
	{{ fp := frameProps("blank", "Blank page") }}
	{{ fp.ContainerClass = "my-auto" }}
	@layout.Page(fp) {
		<h1 class="visually-hidden">Blank page</h1>
		@empty.Empty(empty.Props{Image: blankIllustration(), Title: "No results found", Subtitle: "Try adjusting your search or filter to find what you're looking for.", Action: addClient()})
	}
}

