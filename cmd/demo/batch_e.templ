	{"pink-desk-in-the-home-office.jpg", "Pink desk in the home office", "3x1"},
}

templ eQuad(tiles []eGridTile) {
	<div class="row g-2 g-md-3">
		for _, t := range tiles {
			<div class="col-6">
				@gallery.Tile(eTile(t))
			</div>
		}
	</div>
}

templ photogridPage() {
	@preview("photogrid") {
		<div class="row g-2 g-md-3">
			<div class="col-lg-6">
				<div class="row g-2 g-md-3">
					<div class="col-12">
						@gallery.Tile(eTile(gridTiles[0]))
					</div>
					<div class="col-6">
						@gallery.Tile(eTile(gridTiles[1]))
					</div>
					<div class="col-6">
						@eQuad(gridTiles[2:6])
					</div>
					<div class="col-12">
						@gallery.Tile(eTile(gridTiles[6]))
					</div>
				</div>
			</div>
			<div class="col-lg-6">
				<div class="row g-2 g-md-3">
					<div class="col-6">
						@eQuad(gridTiles[7:11])
					</div>
					<div class="col-6">
						@gallery.Tile(eTile(gridTiles[11]))
					</div>
					<div class="col-12">
						@gallery.Tile(eTile(gridTiles[12]))
					</div>
					<div class="col-12">
						@gallery.Tile(eTile(gridTiles[13]))
					</div>
				</div>
			</div>
		</div>
	}
}

// Logs

const appLog = `2024-01-15 14:23:45 [INFO] Application started successfully
2024-01-15 14:23:46 [DEBUG] Database connection established
2024-01-15 14:23:47 [INFO] User authentication successful: user_id=12345
2024-01-15 14:23:48 [WARNING] Rate limit approaching: 85% of quota used
2024-01-15 14:23:49 [ERROR] Failed to process payment: transaction_id=tx_789
2024-01-15 14:23:50 [INFO] Cache cleared: keys=1523
2024-01-15 14:23:51 [DEBUG] API request completed: endpoint=/api/users, duration=234ms`

var requestTiming = []logs.Pair{{Key: "Effective URL", Value: "https://preview.tabler.io", Href: "https://preview.tabler.io"}, {Key: "Redirect count", Value: "0"}, {Key: "Name lookup time", Value: "3.4e-05"},
	{Key: "Connect time", Value: "0.000521"}, {Key: "Pre-transfer time", Value: "0.0"}, {Key: "Start-transfer time", Value: "0.0"}, {Key: "App connect time", Value: "0.0"}, {Key: "Redirect time", Value: "0.0"},
	{Key: "Total time", Value: "28.000601"}, {Key: "Response code", Value: "0"}, {Key: "Return keyword", Value: "operation_timedout"}}

templ checkedURL() {
	<pre><code>GET <a class="text-reset" target="_blank" href="https://preview.tabler.io">https://preview.tabler.io</a></code></pre>
}

templ logsPage() {
	@preview("logs") {
		<div class="row">
			<div class="col-lg-6">
				@card.Card() {
					@card.Body() {
						@logs.Section("Checked URL") {
							@checkedURL()
						}
						@logs.Section("Request Timing") {
							@logs.Pairs(0, requestTiming)
						}
						@logs.Section("Response Headers") {
							@logs.Text("HTTP/1.1 200 Connection established")
						}
					}
					@card.Footer() {
						@logs.Section("Escalation") {
							Entire team
						}
					}
				}
			</div>
			<div class="col-lg-6">
				@card.Card() {
					@card.Body() {
						@logs.Section("Application Log") {
							@logs.Code(appLog)
						}
						<h2>Log Levels</h2>
						@badge.List(badge.ListProps{Class: "mb-2"}) {
							for _, l := range []named{{"success", "INFO"}, {"warning", "WARNING"}, {"danger", "ERROR"}, {"secondary", "DEBUG"}} {
								@badge.Badge(badge.Props{Color: l.Variant}) {
									{ l.Text }
								}
							}
						}
					}
					@card.Footer() {
						@logs.Section("Log Source") {
							Application Server (prod-01)
						}
					}
				}
			</div>
		</div>
	}
}

