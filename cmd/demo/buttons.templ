package main

import "github.com/mind-vm/tabler-templ/button"

type named struct{ Variant, Text string }

var themeColors = []named{{"primary", "Primary"}, {"secondary", "Secondary"}, {"success", "Success"}, {"warning", "Warning"},
	{"danger", "Danger"}, {"info", "Info"}, {"dark", "Dark"}, {"light", "Light"}}

var extraColors = []named{{"blue", "Blue"}, {"azure", "Azure"}, {"indigo", "Indigo"}, {"purple", "Purple"}, {"pink", "Pink"},
	{"red", "Red"}, {"orange", "Orange"}, {"yellow", "Yellow"}, {"lime", "Lime"}, {"green", "Green"}, {"teal", "Teal"}, {"cyan", "Cyan"}}

type social struct{ Variant, Icon, Text string }

var socialColors = []social{{"facebook", "ti-brand-facebook", "Facebook"}, {"twitter", "ti-brand-twitter", "Twitter"}, {"x", "ti-brand-x", "X"},
	{"linkedin", "ti-brand-linkedin", "Linkedin"}, {"google", "ti-brand-google", "Google"}, {"youtube", "ti-brand-youtube", "Youtube"},
	{"vimeo", "ti-brand-vimeo", "Vimeo"}, {"dribbble", "ti-brand-dribbble", "Dribbble"}, {"github", "ti-brand-github", "Github"},
	{"instagram", "ti-brand-instagram", "Instagram"}, {"pinterest", "ti-brand-pinterest", "Pinterest"}, {"vk", "ti-brand-vk", "VK"},
	{"rss", "ti-rss", "RSS"}, {"flickr", "ti-brand-flickr", "Flickr"}, {"bitbucket", "ti-brand-bitbucket", "Bitbucket"}, {"tabler", "ti-brand-tabler", "Tabler"}}

// colorRow renders one button per color; style sets the shared props (outline, ghost, pill, square).
templ colorRow(colors []named, style button.Props) {
	@button.List() {
		for _, c := range colors {
			{{ p := style }}
			{{ p.Type, p.Variant = "button", button.Variant(c.Variant) }}
			@button.Button(p) {
				{ c.Text }
			}
		}
	}
}

templ sizeRow(size button.Size) {
	@button.List() {
		@button.Button(button.Props{Type: "button", Size: size}) {
			Button
		}
		@button.Button(button.Props{Type: "button", Size: size, Icon: "ti-star", IconOnly: true, Label: "Icon only"})
		@button.Button(button.Props{Type: "button", Size: size, Icon: "ti-star"}) {
			Button
		}
		@button.Button(button.Props{Type: "button", Size: size, IconEnd: "ti-star"}) {
			Button
		}
	}
}

type animated struct {
	Animate button.Animation
	Icon    string
	Text    string
}

templ buttonsPage() {
	@preview("buttons") {
		<div class="row row-cards mb-5">
			<div class="col-md-6 col-lg-4">
				@section("Basic", "Add an icon to the left, the right, or drop the label for an icon-only button.") {
					@button.List() {
						@button.Button(button.Props{Type: "button"}) {
							Button
						}
						@button.Button(button.Props{Type: "button", Icon: "ti-star"}) {
							With icon
						}
						@button.Button(button.Props{Type: "button", IconEnd: "ti-star"}) {
							Icon at end
						}
						@button.Button(button.Props{Type: "button", Icon: "ti-star", IconOnly: true, Label: "Icon only"})
						@button.Button(button.Props{Type: "button", Disabled: true}) {
							Disabled
						}
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Shapes", "Round the corners with `.btn-pill`, or square them off with `.btn-square`.") {
					@button.List() {
						@button.Button(button.Props{Type: "button"}) {
							Default
						}
						@button.Button(button.Props{Type: "button", Pill: true}) {
							Pill
						}
						@button.Button(button.Props{Type: "button", Square: true}) {
							Square
						}
						@button.Button(button.Props{Type: "button", Icon: "ti-star", IconOnly: true, Label: "Star"})
						@button.Button(button.Props{Type: "button", Icon: "ti-star", IconOnly: true, Label: "Star (pill)", Pill: true})
						@button.Button(button.Props{Type: "button", Icon: "ti-star", IconOnly: true, Label: "Star (square)", Square: true})
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Action buttons", "Compact, icon-only buttons for card headers and toolbars.") {
					@button.Actions() {
						for _, a := range []named{{"ti-edit", "Edit"}, {"ti-copy", "Copy"}, {"ti-settings", "Settings"}, {"ti-clipboard", "Clipboard"}, {"ti-x", "X"}} {
							@button.Button(button.Props{Href: "#", Icon: a.Variant, Action: true, Attributes: templ.Attributes{"aria-label": a.Text}})
						}
					}
				}
			</div>
			<div class="col-12 col-lg-8">
				@section("Sizes", "Scale a button from `btn-sm` to `btn-xl` without changing its icon layout.") {
					<div class="space-y">
						@sizeRow(button.SizeSmall)
						@sizeRow(button.SizeDefault)
						@sizeRow(button.SizeLarge)
						@sizeRow(button.SizeXLarge)
					</div>
				}
			</div>
			<div class="col-md-12 col-lg-4">
				@section("Animated icon", "Small hover animations draw attention to the icon.") {
					@button.List() {
						@button.Button(button.Props{Type: "button", Animate: button.AnimateMove, IconEnd: "ti-arrow-right"}) {
							Save
						}
						for _, a := range []animated{{button.AnimateRotate, "ti-plus", "Add"}, {button.AnimateShake, "ti-bell", "Notifications"},
							{button.AnimateRotate, "ti-settings", "Settings"}, {button.AnimatePulse, "ti-heart", "Love"}, {button.AnimateRotate, "ti-x", "Close"},
							{button.AnimateTada, "ti-check", "Confirm"}} {
							@button.Button(button.Props{Type: "button", Animate: a.Animate, Icon: a.Icon}) {
								{ a.Text }
							}
						}
						@button.Button(button.Props{Type: "button", Animate: button.AnimateMove, IconEnd: "ti-chevron-right"}) {
							Next
						}
						@button.Button(button.Props{Type: "button", Animate: button.AnimateMoveStart, Icon: "ti-chevron-left"}) {
							Previous
						}
					}
				}
			</div>
			<div class="col-12">
				@section("Standard", "Fill a button with a theme color to mark its purpose.") {
					@colorRow(themeColors, button.Props{})
				}
			</div>
			<div class="col-12">
				@section("Outline", "Keep the border colored and the background transparent for a subtler action.") {
					@colorRow(themeColors, button.Props{Outline: true})
				}
			</div>
			<div class="col-12">
				@section("Ghost", "Drop the border too — color appears only on hover.") {
					@colorRow(themeColors, button.Props{Ghost: true})
				}
			</div>
			<div class="col-12">
				@section("Pill", "Combine `.btn-pill` with a theme color.") {
					@colorRow(themeColors, button.Props{Pill: true})
				}
			</div>
			<div class="col-12">
				@section("Square", "Combine `.btn-square` with a theme color.") {
					@colorRow(themeColors, button.Props{Square: true})
				}
			</div>
			<div class="col-12">
				@section("Extra colors", "The full Tabler palette, beyond the eight theme colors.") {
					@colorRow(extraColors, button.Props{})
				}
			</div>
			<div class="col-12">
				@section("Social colors", "Brand colors for linking out to social networks.") {
					@button.List() {
						for _, s := range socialColors {
							@button.Button(button.Props{Type: "button", Variant: button.Variant(s.Variant), Icon: s.Icon}) {
								{ s.Text }
							}
						}
					}
				}
			</div>
			<div class="col-12">
				@section("Icon buttons", "Social brand colors without a label, for compact toolbars.") {
					@button.List() {
						for _, s := range socialColors {
							@button.Button(button.Props{Type: "button", Variant: button.Variant(s.Variant), Icon: s.Icon, IconOnly: true, Label: s.Text})
						}
					}
				}
			</div>
		</div>
	}
}
