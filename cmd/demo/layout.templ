package main

import (
	"strings"

	"github.com/mind-vm/tabler-templ/avatar"
	"github.com/mind-vm/tabler-templ/blocks/layout"
	"github.com/mind-vm/tabler-templ/button"
	"github.com/mind-vm/tabler-templ/card"
	"github.com/mind-vm/tabler-templ/dropdown"
	"github.com/mind-vm/tabler-templ/internal/catalog"
)

// assets are Tabler's stylesheet and the icon font.
templ assets() {
	<link rel="stylesheet" href={ "https://cdn.jsdelivr.net/npm/@tabler/core@" + tablerVersion + "/dist/css/tabler.min.css" }/>
	<link rel="stylesheet" href={ "https://cdn.jsdelivr.net/npm/@tabler/core@" + tablerVersion + "/dist/css/tabler-flags.min.css" }/>
	<link rel="stylesheet" href={ "https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@" + iconsVersion + "/dist/tabler-icons.min.css" }/>
	// Rules of the preview's own demo.scss (not part of Tabler's CSS), e.g. menus shown open in the page.
	<style>.dropdown-menu-demo{display:inline-block;width:100%;position:relative;top:0;margin-bottom:1rem!important}</style>
}

templ scripts() {
	<script src={ "https://cdn.jsdelivr.net/npm/@tabler/core@" + tablerVersion + "/dist/js/tabler.min.js" }></script>
}

// frameProps are the layout settings of a preview page; the layout-* pages change them.
func frameProps(name string, title string) layout.PageProps {
	return layout.PageProps{
		Title:   title + " · tabler-templ",
		Head:    assets(),
		Scripts: scripts(),
		Sidebar: layout.Sidebar(layout.SidebarProps{Brand: sidebarBrand(false), User: sidebarUser()}, menuFor(name)),
		Navbar:  layout.Navbar(layout.NavbarProps{Brand: navbarBrand(), Actions: navbarActions()}, menuFor(name)),
		Footer:  previewFooter(),
	}
}

templ logoSVG() {
	@templ.Raw(tablerLogo)
}

templ navbarBrand() {
	@layout.Brand(layout.BrandProps{Label: "Tabler", Class: "pe-0 pe-md-3"}) {
		@logoSVG()
	}
}

templ sidebarBrand(foldToggle bool) {
	if foldToggle {
		@layout.Brand(layout.BrandProps{Label: "Tabler", After: layout.FoldToggle("", false)}) {
			@templ.Raw(tablerMark)
		}
	} else {
		@layout.Brand(layout.BrandProps{Label: "Tabler"}) {
			@templ.Raw(tablerMark)
		}
	}
}

templ sidebarUser() {
	@layout.SidebarUser(previewUser) {
		@userItems()
	}
}

templ userItems() {
	@dropdown.Item(dropdown.ItemProps{Href: "/profile", Icon: "ti-user"}) {
		Profile
	}
	@dropdown.Item(dropdown.ItemProps{Href: "#", Icon: "ti-chart-pie"}) {
		Analytics
	}
	@dropdown.Divider()
	@dropdown.Item(dropdown.ItemProps{Href: "/settings"}) {
		Settings &amp; Privacy
	}
	@dropdown.Item(dropdown.ItemProps{Href: "#"}) {
		Help
	}
	@dropdown.Item(dropdown.ItemProps{Href: "/sign-in"}) {
		Sign out
	}
}

var previewUser = layout.UserProps{Avatar: avatar.Props{Src: avatarURL("000m")}, Name: "Paweł Kuna", Detail: "UI Designer"}

var previewNotifications = []layout.Notification{
	{Title: "Example 1", Text: "Change deprecated html tags to text decoration classes (#29604)", Unread: true, StarHref: "#", StarLabel: "Add to favorites"},
	{Title: "Example 2", Text: "justify-content:between ⇒ justify-content:space-between (#29734)", Starred: true, StarHref: "#", StarLabel: "Remove from favorites"},
	{Title: "Example 3", Text: "Update change-version.js (#29736)", StarHref: "#", StarLabel: "Add to favorites"},
	{Title: "Example 4", Text: "Regenerate package-lock.json (#29730)", Unread: true, Color: "green", StarHref: "#", StarLabel: "Add to favorites"},
}

func apps() []layout.App {
	as := make([]layout.App, len(previewApps))
	for i, a := range previewApps {
		as[i] = layout.App{Name: a.Name, Icon: photo("brands/" + a.Logo + ".svg")}
	}
	return as
}

templ notificationActions() {
	<div class="row">
		<div class="col">
			@button.Button(button.Props{Type: "button", Block: true}) {
				Archive all
			}
		</div>
		<div class="col">
			@button.Button(button.Props{Type: "button", Block: true}) {
				Mark all as read
			}
		</div>
	</div>
}

templ navbarActions() {
	<div class="d-none d-md-flex me-3">
		@layout.ThemeToggle(layout.ThemeToggleProps{})
		@layout.NavDropdown(layout.NavDropdownProps{Class: "d-none d-md-flex", Icon: "ti-bell", Label: "Show notifications", Dot: "red", Card: true}) {
			@layout.Notifications(layout.NotificationsProps{Footer: notificationActions()}, previewNotifications)
		}
		@layout.NavDropdown(layout.NavDropdownProps{Class: "d-none d-md-flex", Icon: "ti-apps", Label: "Show app menu", Card: true}) {
			@layout.Apps(layout.AppsProps{SettingsHref: "#"}, apps())
		}
		@layout.NavDropdown(layout.NavDropdownProps{Class: "d-none d-md-flex", Text: "EN", Label: "Select language"}) {
			for _, l := range previewLanguages {
				@dropdown.Item(dropdown.ItemProps{Href: "#", Attributes: templ.Attributes{"data-lang": l.Code}}) {
					{ l.Name }
				}
			}
		}
	</div>
	@layout.UserMenu(previewUser) {
		@userItems()
	}
}

templ previewFooter() {
	@layout.Footer(layout.FooterProps{
		Links: []layout.Link{{Text: "Documentation", Href: "https://docs.tabler.io", External: true}, {Text: "License", Href: "/license"},
			{Text: "Source code", Href: "https://github.com/mind-vm/tabler-templ", External: true}},
		Start: []templ.Component{copyright()},
	})
}

templ copyright() {
	Rebuilt with <a href="https://github.com/mind-vm/tabler-templ" class="link-secondary">tabler-templ</a> from Tabler { tablerVersion }.
}

// menuFor builds the preview's menu with the entry of the page active. Rebuilt pages link into the
// demo, open ones to the original preview.
func menuFor(page string) []layout.Entry {
	var es []layout.Entry
	for _, n := range previewMenu {
		e := layout.Entry{Title: n.Title, Icon: n.Icon, Section: n.Section, Columns: n.Columns, End: n.End, Badge: "", Href: menuHref(n.URL)}
		for _, c := range n.Children {
			it, active := menuItem(c, page)
			e.Children = append(e.Children, it)
			e.Active = e.Active || active
		}
		es = append(es, e)
	}
	return es
}

func menuItem(n menuNode, page string) (layout.Item, bool) {
	it := layout.Item{Title: n.Title, Icon: n.Icon, Badge: n.Badge, Color: n.Color, Href: menuHref(n.URL), Active: n.URL == page && page != "",
		External: strings.HasPrefix(n.URL, "http")}
	for _, c := range n.Children {
		ch, active := menuItem(c, page)
		it.Children = append(it.Children, ch)
		it.Active = it.Active || active
	}
	return it, it.Active
}

func menuHref(name string) string {
	if name == "" || strings.HasPrefix(name, "http") {
		return name
	}
	if _, ok := pages[name]; ok {
		return "/" + name
	}
	return "https://preview.tabler.io/" + name + ".html"
}

// preview is the frame of a rebuilt preview page: Tabler's navigation, a page header with the
// original's title and description and a link to the original, the page body and the footer.
templ preview(name string) {
	{{ p, _ := catalog.Find(name) }}
	{{ fp := frameProps(name, p.Title) }}
	{{ fp.Header = layout.PageHeader(layout.PageHeaderProps{Title: p.Title, Description: p.Description, Actions: originalLink(name)}) }}
	@layout.Page(fp) {
		{ children... }
	}
}

templ originalLink(name string) {
	<a href={ templ.SafeURL("https://preview.tabler.io/" + name + ".html") } target="_blank" rel="noopener" class="link-secondary">
		Original
		<i class="ti ti-external-link icon icon-sm icon-inline" aria-hidden="true"></i>
	</a>
}

// section is the card the component pages of the preview use for each example.
templ section(title, subtitle string) {
	@card.Card() {
		@card.Body() {
			@card.Title() {
				{ title }
			}
			if subtitle != "" {
				@card.Subtitle() {
					@withCode(subtitle)
				}
			}
			{ children... }
		}
	}
}

// withCode renders text with `backticks` as <code>, like the preview's subtitles.
templ withCode(text string) {
	for i, part := range strings.Split(text, "`") {
		if i%2 == 1 {
			<code>{ part }</code>
		} else {
			{ part }
		}
	}
}
