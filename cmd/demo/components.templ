package main

import (
	"github.com/mind-vm/tabler-templ/alert"
	"github.com/mind-vm/tabler-templ/badge"
	"github.com/mind-vm/tabler-templ/button"
	"github.com/mind-vm/tabler-templ/modal"
	"github.com/mind-vm/tabler-templ/pagination"
)

type alertExample struct {
	Variant alert.Variant
	Text    string
}

var alertExamples = []alertExample{
	{alert.VariantDanger, "An error occurred!"},
	{alert.VariantWarning, "Some information is missing!"},
	{alert.VariantSuccess, "Completed successfully!"},
	{alert.VariantInfo, "Just a quick note!"},
}

var passwordRules = []string{"Minimum 8 characters", "Include a special character"}

// describedAlerts are the alerts with a heading and a description in a style (important, minor);
// the other alerts follow in the given order.
templ describedAlerts(style alert.Props, others []alertExample) {
	{{ p := style }}
	{{ p.Variant, p.Title, p.Dismissible = alert.VariantDanger, "Password does not meet requirements:", true }}
	@alert.Alert(p) {
		@alert.List(passwordRules)
	}
	for _, o := range others {
		{{ p.Variant, p.Title = o.Variant, o.Text }}
		@alert.Alert(p) {
			This is a custom alert box with a description.
		}
	}
}

var customAlerts = []alertExample{{alert.VariantSuccess, "This is a custom alert box!"}, {alert.VariantWarning, "This is a custom alert box!"},
	{alert.VariantInfo, "This is a custom alert box!"}}

templ alertsPage() {
	@preview("alerts") {
		<div class="row row-cards">
			<div class="col-12">
				@section("Basic", "A title and a color are enough to show the status of an action.") {
					for _, a := range alertExamples {
						@alert.Alert(alert.Props{Variant: a.Variant}) {
							{ a.Text }
						}
					}
				}
			</div>
			<div class="col-12">
				@section("With action", "Add an `alert-action` link to give users something to do next.") {
					for _, a := range alertExamples {
						@alert.Alert(alert.Props{Variant: a.Variant, Dismissible: true}) {
							{ a.Text }
							@alert.Action("#") {
								Link
							}
						}
					}
				}
			</div>
			<div class="col-12">
				@section("Dismissible", "Add `alert-dismissible` and a `btn-close` button to let users close the alert.") {
					for _, a := range alertExamples {
						@alert.Alert(alert.Props{Variant: a.Variant, Dismissible: true}) {
							{ a.Text }
						}
					}
				}
			</div>
			<div class="col-12">
				@section("With a description", "Add an `alert-description` or an `alert-list` when the title alone isn't enough context.") {
					@describedAlerts(alert.Props{}, alertExamples[1:])
				}
			</div>
			<div class="col-12">
				@section("Important", "Add `alert-important` for a bolder style that stands out from the rest of the page.") {
					@describedAlerts(alert.Props{Important: true}, customAlerts)
					@alert.Alert(alert.Props{Variant: alert.VariantDanger, Important: true, Dismissible: true}) {
						An error occurred!
						@alert.Action("#") {
							Link
						}
					}
					@alert.Alert(alert.Props{Variant: alert.VariantInfo, Important: true, Dismissible: true}) {
						Just a quick note!
						@alert.Link("#") {
							Link
						}
					}
				}
			</div>
			<div class="col-12">
				@section("Minor", "Add `alert-minor` for a quieter style that fits inline with other content.") {
					@describedAlerts(alert.Props{Minor: true}, customAlerts)
				}
			</div>
		</div>
	}
}

var badgeColors = []string{"blue", "azure", "indigo", "purple", "pink", "red", "orange", "yellow", "lime", "green", "teal", "cyan", "dark", "light"}

func title(s string) string { return string(s[0]-'a'+'A') + s[1:] }

templ badgeRow(style badge.Props, icon string) {
	@badge.List() {
		for _, c := range badgeColors {
			{{ p := style }}
			{{ p.Color, p.Icon = c, icon }}
			@badge.Badge(p) {
				{ title(c) }
			}
		}
	}
}

templ badgeSizes(size badge.Size) {
	@badge.List() {
		@badge.Badge(badge.Props{Size: size}) {
			Default
		}
		@badge.Badge(badge.Props{Size: size, Icon: "ti-check"}) {
			Left icon
		}
		@badge.Badge(badge.Props{Size: size, IconEnd: "ti-arrow-right"}) {
			Right icon
		}
		@badge.Badge(badge.Props{Size: size, Icon: "ti-star-filled", IconOnly: true})
	}
}

templ badgesPage() {
	@preview("badges") {
		<div class="row row-cards mb-5">
			<div class="col-md-6 col-lg-4">
				@section("In headings", "A badge scales with the heading level it sits next to.") {
					for _, h := range []string{"h1", "h2", "h3", "h4", "h5", "h6"} {
						<div class={ h }>
							Example heading
							@badge.Badge() {
								New
							}
						</div>
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Sizes", "Three sizes, with an optional icon before or after the label.") {
					<div class="space-y">
						@badgeSizes(badge.SizeSmall)
						@badgeSizes(badge.SizeDefault)
						@badgeSizes(badge.SizeLarge)
					</div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Positioned", "Attach a count or a dot to a button with `.badge-notification`.") {
					@button.List() {
						@button.Button(button.Props{Type: "button"}) {
							Notifications
							@badge.Badge(badge.Props{Class: "text-bg-secondary ms-2"}) {
								4
							}
						}
						@button.Button(button.Props{Type: "button"}) {
							Inbox
							@badge.Badge(badge.Props{Color: "red", Notification: true}) {
								9+
								<span class="visually-hidden">unread messages</span>
							}
						}
						@button.Button(button.Props{Type: "button"}) {
							Profile
							@badge.Badge(badge.Props{Color: "red", Dot: true, Notification: true})
						}
						@button.Button(button.Props{Type: "button"}) {
							Settings
							@badge.Badge(badge.Props{Color: "red", Dot: true, Notification: true, Blink: true})
						}
						@button.Button(button.Props{Type: "button", Icon: "ti-bell", IconOnly: true}) {
							@badge.Badge(badge.Props{Color: "red", Dot: true, Notification: true, Blink: true})
						}
						@button.Button(button.Props{Type: "button", Icon: "ti-bell", IconOnly: true, Action: true, Attributes: templ.Attributes{"aria-label": "Notifications"}}) {
							@badge.Badge(badge.Props{Color: "red", Dot: true, Notification: true})
						}
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("On buttons", "Pair any badge color with a button label.") {
					@button.List() {
						for i, c := range badgeColors {
							@button.Button() {
								{ title(c) } badge
								@badge.Badge(badge.Props{Color: c, Class: "ms-2"}) {
									{ i + 1 }
								}
							}
						}
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Notification dot", "A pill-shaped counter positioned on the corner of a button.") {
					@button.List() {
						for i, c := range badgeColors {
							@button.Button(button.Props{Class: "position-relative"}) {
								{ title(c) } badge
								@badge.Badge(badge.Props{Color: c, Notification: true, Pill: true}) {
									{ i + 1 }
								}
							}
						}
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Blinking notification", "Add `.badge-blink` to draw attention to unread activity.") {
					@button.List() {
						for _, c := range badgeColors {
							@button.Button(button.Props{Class: "position-relative"}) {
								{ title(c) } badge
								@badge.Badge(badge.Props{Color: c, Notification: true, Blink: true})
							}
						}
					}
				}
			</div>
		</div>
		<div class="row row-cards">
			<div class="col-12">
				@section("Basic", "Fill a badge with a theme or extended color.") {
					@badgeRow(badge.Props{}, "")
				}
			</div>
			<div class="col-12">
				@section("Light", "A tinted background for a softer, secondary badge.") {
					@badgeRow(badge.Props{Light: true}, "")
				}
			</div>
			<div class="col-12">
				@section("Outline", "A colored border with a transparent background.") {
					@badgeRow(badge.Props{Outline: true}, "")
				}
			</div>
			<div class="col-12">
				@section("With icons", "Add an icon before the label to reinforce its meaning.") {
					@badgeRow(badge.Props{}, "ti-star-filled")
				}
			</div>
		</div>
	}
}

func pageHref(n int) string { return "#" }

templ paginationPage() {
	@preview("pagination") {
		<div class="row row-cards">
			<div class="col-12">
				@section("Numbered", "Page numbers, with or without Prev/Next text labels (`page-text`).") {
					@pagination.Pagination(pagination.Props{Page: 3, Pages: 5, Href: pageHref, Label: "Numbered pagination"})
					@pagination.Pagination(pagination.Props{Page: 3, Pages: 5, Href: pageHref, Label: "Pagination with text", Text: true})
				}
			</div>
			<div class="col-12">
				@section("With descriptions", "Name the adjacent page with `page-item-subtitle` for the direction and `page-item-title` for the page name.") {
					@pagination.Pagination(pagination.Props{Page: 1, Pages: 2, Href: pageHref, Label: "Pagination with descriptions",
						PrevTitle: "Getting started", NextTitle: "Breadcrumbs"})
				}
			</div>
		</div>
	}
}

// Inline modals: the preview shows its dialogs open within the page instead of over it.
const inlineModal = "modal-blur position-relative rounded d-block bg-surface-backdrop py-6 w-auto h-auto z-0 show"

const lorem = "Lorem ipsum dolor sit amet, consectetur adipisicing elit. Adipisci animi beatae delectus deleniti dolorem eveniet facere fuga iste nemo nesciunt nihil odio perspiciatis, quia quis reprehenderit sit tempora totam unde."

templ modalFooter() {
	@button.Button(button.Props{Type: "button", Class: "me-auto", Attributes: templ.Attributes{"data-bs-dismiss": "modal"}}) {
		Close
	}
	@button.Button(button.Props{Type: "button", Variant: button.VariantPrimary, Attributes: templ.Attributes{"data-bs-dismiss": "modal"}}) {
		Save changes
	}
}

type modalExample struct {
	Heading, ID, Title string
	Size               modal.Size
	DialogClass        string
	Scrollable         bool
	Paragraphs         int
}

var modalExamples = []modalExample{
	{"Simple modal", "modal-simple", "Modal title", modal.SizeDefault, "", false, 1},
	{"Large modal", "modal-large", "Large modal", modal.SizeLarge, "", false, 1},
	{"Full width modal", "modal-full-width", "Full width modal", modal.SizeDefault, "modal-full-width", false, 1},
	{"Scrollable modal", "modal-scrollable", "Scrollable modal", modal.SizeDefault, "", true, 12},
}

templ modalsPage() {
	@preview("modals") {
		<div class="card">
			<div class="card-body">
				<div class="space-y-6">
					for _, m := range modalExamples {
						<div>
							<h2>{ m.Heading }</h2>
							@modal.Modal(modal.Props{ID: m.ID, Title: m.Title, Size: m.Size, DialogClass: m.DialogClass, Scrollable: m.Scrollable,
								Centered: true, Fade: true, Class: inlineModal, Footer: modalFooter(), Attributes: templ.Attributes{"role": "dialog"}}) {
								for range m.Paragraphs {
									<p>{ lorem }</p>
								}
							}
						</div>
					}
				</div>
			</div>
		</div>
	}
}
