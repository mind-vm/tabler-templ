package main

import (
	"strings"

	"github.com/mind-vm/tabler-templ/blocks/metric"
	"github.com/mind-vm/tabler-templ/card"
	"github.com/mind-vm/tabler-templ/chart"
	"github.com/mind-vm/tabler-templ/legend"
)

// chartsPages are the chart plugin pages.
func chartsPages() map[string]templ.Component {
	return map[string]templ.Component{
		"charts":          chartsPage(),
		"charts-advanced": chartsAdvancedPage(),
	}
}

type demoChart struct{ ID, Col, Subtitle string }

type chartSection struct {
	Title, Description string
	Charts             []demoChart
}

const (
	third = "col-md-6 col-lg-4"
	half  = "col-lg-6"
	wide  = "col-lg-8"
)

var chartSections = []chartSection{
	{"Line charts", "Trends over time, where the change between points matters more than single values.", []demoChart{
		{"completion-tasks-2", third, "Tickets solved per day with a smooth curve, the default."},
		{"completion-tasks-4", third, "The same tickets drawn with straight segments."},
		{"completion-tasks-5", third, "A stepped line for values that change in jumps."},
		{"completion-tasks-7", third, "Tickets solved per day, labeled with values."},
		{"tasks", wide, "Issues opened, closed and reopened per day over the last 17 days."},
		{"line", third, "Monthly revenue of each plan, January to June."},
		{"line-stroke", third, "Monthly signups, dashed for paid and referral."},
		{"spline", third, "CPU load of web servers and workers in one day."},
		{"temperature", half, "Monthly average temperature in Tokyo and London."},
		{"stepline", half, "Number of running instances during the day."},
	}},
	{"Area charts", "Lines with a filled area, to stress volume or to show how parts add up to a total.", []demoChart{
		{"completion-tasks-3", third, "Tickets solved per day as a filled area."},
		{"completion-tasks-10", third, "Solved and reopened tickets as two overlapping areas."},
		{"completion-tasks-11", third, "Solved and reopened tickets stacked on top of each other."},
		{"area", third, "Monthly sessions on mobile and desktop."},
		{"area-spline", third, "Monthly egress and ingress traffic."},
		{"area-spline-stacked", third, "Storage used by media and backups, stacked."},
	}},
	{"Bar charts", "Comparison of separate categories, side by side or stacked.", []demoChart{
		{"completion-tasks", third, "Tickets solved per day, last week."},
		{"completion-tasks-6", third, "The same tickets as horizontal bars."},
		{"completion-tasks-8", third, "Solved and reopened tickets side by side."},
		{"completion-tasks-9", third, "Solved and reopened tickets in one stacked bar per day."},
		{"cache-status", third, "Cache status of requests per day, colored by meaning."},
		{"funnel", third, "Visitors left at each step from first visit to customer."},
	}},
	{"Circular charts", "Parts of a whole and progress toward a goal, best with a few values.", []demoChart{
		{"demo-pie", third, "Share of visits by source."},
		{"campaigns", third, "Delivery, open and click rates of one campaign."},
		{"polar-area", third, "Sales volume of each region."},
	}},
	{"Other charts", "Mixed series, distributions, schedules and hierarchies.", []demoChart{
		{"combination", wide, "Monthly spend as columns with leads and trials as lines."},
		{"radar", third, "Pro and Enterprise plans rated in six areas."},
		{"scatter", third, "Page load time samples on desktop and mobile."},
		{"timeline", wide, "Planned duration of each release phase."},
		{"bubble", third, "Search and social campaigns on three metrics."},
		{"treemap", third, "Disk space taken by each folder."},
		{"box-plot", third, "Spread of API response times in each month."},
	}},
}

func chartName(id string) string {
	if n := tablerChartNames[id]; n != "" {
		return n
	}
	n := strings.ReplaceAll(id, "-", " ")
	return strings.ToUpper(n[:1]) + n[1:]
}

// topLegend is the legend the charts page puts above a chart of two to four series (not a circular one);
// the chart's own legend is hidden then.
func topLegend(id string) []metric.Series {
	p := tablerCharts[id]
	switch p.Type {
	case chart.Pie, chart.Donut, chart.RadialBar, chart.PolarArea, chart.Radar:
		return nil
	}
	if len(p.Series) < 2 || len(p.Series) > 4 {
		return nil
	}
	var out []metric.Series
	for _, s := range p.Series {
		out = append(out, metric.Series{Text: s.Name, Color: orString(s.Color, "primary")})
	}
	return out
}

func orString(s, fallback string) string {
	if s == "" {
		return fallback
	}
	return s
}

func sectionChart(id string) chart.Props {
	p := tc(id, chartName(id), 15)
	if topLegend(id) != nil {
		p.Legend = false
	}
	return p
}

// activityCard is Tabler's Active users card (shared/components/parts/charts/Activity).
templ activityCard() {
	@metric.ChartCard(metric.ChartCardProps{
		Title:  "Active users",
		Action: metric.Range(metric.RangeProps{ID: "active-users", Label: "Select time range for active users"}),
		Side: metric.Values([]metric.Value{{Text: "Mobile", Color: "primary", Value: "10,601"},
			{Text: "Desktop", Color: "azure", Value: "6,109"}, {Text: "Tablet", Color: "green", Value: "2,260"}}),
	}) {
		@chart.Chart(tc("active-users-2", "Active users", 0))
	}
}

// socialReferralsCard is Tabler's Social referrals card.
templ socialReferralsCard() {
	@metric.ChartCard(metric.ChartCardProps{
		Title:  "Social referrals",
		Action: metric.Range(metric.RangeProps{ID: "social-referrals", Label: "Select time range for sales data"}),
	}) {
		@chart.Chart(tc("social-referrals", "Social referrals", 0))
	}
}

templ chartsPage() {
	@preview("charts") {
		<div class="row row-cards">
			<div class="col-lg-12">
				@activityCard()
			</div>
			<div class="col-12">
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Chart with legend
						}
					}
					@card.Body() {
						@legend.List(legend.ListProps{Divided: true, Class: "mb-3"}) {
							for _, l := range []lg{{"yellow", "Total visits", "63.0k", ""}, {"green", "Unique visitors", "43.0k", ""}, {"primary", "New users", "13.5k", ""}} {
								@legend.Legend(legend.Props{Button: true, Large: true, Color: l.Color, Text: l.Text, Value: l.Value, Attributes: chart.Toggle("legend-demo", l.Text)})
							}
						}
						@chart.Chart(tc("legend-demo", "Site traffic", 15))
					}
				}
			</div>
			<div class="col-12">
				@socialReferralsCard()
			</div>
			<div class="col-12">
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Sprint velocity
						}
					}
					@card.Body() {
						@chart.Chart(tc("tasks-overview", "Story points completed per sprint", 20))
					}
				}
			</div>
			for _, s := range chartSections {
				<div class="col-12">
					<h2 class="page-section-title">{ s.Title }</h2>
					<p class="page-section-description">{ s.Description }</p>
				</div>
				for _, c := range s.Charts {
					<div class={ c.Col }>
						@card.Card(card.Props{Class: "h-100"}) {
							@card.Header() {
								<div>
									@card.Title() {
										{ chartName(c.ID) }
									}
									@card.Subtitle() {
										{ c.Subtitle }
									}
								</div>
							}
							@card.Body() {
								if l := topLegend(c.ID); l != nil {
									@legend.List(legend.ListProps{Class: "justify-content-end mb-3"}) {
										for _, it := range l {
											@legend.Legend(legend.Props{Color: it.Color, Text: it.Text})
										}
									}
								}
								@chart.Chart(sectionChart(c.ID))
							}
						}
					</div>
				}
			}
		</div>
	}
}

templ advancedCard(col, title, subtitle string) {
	<div class={ col }>
		@section(title, subtitle) {
			{ children... }
		}
	</div>
}

templ chartsAdvancedPage() {
	@preview("charts-advanced") {
		<div class="row row-cards">
			@advancedCard("col-lg-6", "Two y-axes", "Plot values with different units together. Bind each axis to a series with the `yaxis.seriesName` chart option and move the second one to the right with `opposite`.") {
				@chart.Chart(tc("revenue-vs-orders", "Revenue in dollars and order count per month", 16))
			}
			@advancedCard("col-lg-6", "Threshold line", "Draw a target or a limit across the plot with `annotations.yaxis`, so a reader sees at a glance which points miss it.") {
				@chart.Chart(tc("uptime-sla", "Monthly uptime against the 99.9 percent service level target", 16))
			}
			@advancedCard("col-lg-6", "Marker lines", "Mark the moment something happened with `annotations.xaxis` — a release, a campaign, an incident.") {
				@chart.Chart(tc("sales-with-markers", "Monthly sales with campaign start markers", 16))
			}
			@advancedCard("col-lg-6", "Brush and zoom", "The small chart below picks the range shown above. Point it at the main chart id with `chart.brush` and render the main chart first.") {
				@chart.Chart(tc("traffic-zoom", "Sessions over 90 days, zoomed to the selected range", 11))
				@chart.Chart(tc("traffic-brush", "Range selector for the sessions chart", 5))
			}
			@advancedCard("col-12", "Synced charts", "Charts that share a `chart.group` name follow one another — hover or zoom on one and the rest do the same.") {
				@chart.Chart(tc("synced-visits", "Daily visits", 8))
				@chart.Chart(tc("synced-signups", "Daily sign-ups", 8))
				@chart.Chart(tc("synced-revenue", "Daily revenue", 8))
			}
		</div>
	}
}
