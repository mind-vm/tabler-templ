package main

import (
	"github.com/mind-vm/tabler-templ/cdn"
	"net/http"

	"github.com/mind-vm/tabler-templ/badge"
	"github.com/mind-vm/tabler-templ/blocks/layout"
	"github.com/mind-vm/tabler-templ/blocks/metric"
	"github.com/mind-vm/tabler-templ/button"
	"github.com/mind-vm/tabler-templ/card"
	"github.com/mind-vm/tabler-templ/chart"
	"github.com/mind-vm/tabler-templ/form"
	"github.com/mind-vm/tabler-templ/progress"
	"github.com/mind-vm/tabler-templ/themes"
)

// The themes gallery is the demo's own page (not a page of the Tabler preview): every ready-made theme
// in light and dark mode, each in a frame of its own so the theme applies to a whole page.

func themesRoutes(mux *http.ServeMux) {
	mux.Handle("GET /themes", templ.Handler(themesPage()))
	mux.HandleFunc("GET /themes/{name}", func(w http.ResponseWriter, r *http.Request) {
		t, ok := themes.Find(r.PathValue("name"))
		if !ok {
			http.NotFound(w, r)
			return
		}
		mode := "light"
		if r.URL.Query().Get("mode") == "dark" {
			mode = "dark"
		}
		templ.Handler(themeSample(t, mode)).ServeHTTP(w, r)
	})
}

func themeName(t themes.Theme) string {
	if t.Name == "" {
		return "tabler"
	}
	return t.Name
}

func themeCode(t themes.Theme) string {
	return "themes." + t.Label + ".Apply(&props)"
}

templ themesPage() {
	{{ p := frameProps("", "Themes") }}
	{{
		p.Header = layout.PageHeader(layout.PageHeaderProps{Title: "Themes",
			Description: "Ready-made looks in the spirit of shadcn/ui: an accent color, a gray base, a font and a corner radius, for light and dark mode. Pick one for your app with Apply, or let users pick in the settings panel (the brush at the bottom right)."})
	}}
	@layout.Page(p) {
		<div class="row row-cards">
			for _, t := range themes.All {
				<div class="col-12 col-xxl-6">
					@card.Card() {
						@card.Header() {
							<div>
								@card.Title() {
									{ t.Label }
								}
								@card.Subtitle(card.Props{Class: "mb-0"}) {
									{ t.Description }
								}
							</div>
							@card.Actions() {
								@button.Button(button.Props{Size: button.SizeSmall, Type: "button", Attributes: templ.Attributes{"data-theme-try": themeName(t)}}) {
									Try it here
								}
							}
						}
						<div class="row g-0">
							for _, mode := range []string{"light", "dark"} {
								<div class="col-6">
									<iframe src={ "/themes/" + themeName(t) + "?mode=" + mode } title={ t.Label + ", " + mode } class="d-block w-100 border-0" style="height:20rem" onload="this.style.height = this.contentDocument.documentElement.scrollHeight + 'px'"></iframe>
								</div>
							}
						</div>
						@card.Footer() {
							<code>{ themeCode(t) }</code>
						}
					}
				</div>
			}
		</div>
		// "Try it here" puts the theme on this page the way the settings panel does.
		<script>
			document.addEventListener('click', function (e) {
				var b = e.target.closest('[data-theme-try]');
				if (!b) return;
				var f = document.querySelector('form[data-theme-settings] input[name="theme-pack"][value="' + (b.dataset.themeTry === 'tabler' ? 'default' : b.dataset.themeTry) + '"]');
				if (f) { f.checked = true; f.dispatchEvent(new Event('change', { bubbles: true })); }
			});
		</script>
	}
}

// themeSample is a small page in one theme: the parts where a theme shows.
templ themeSample(t themes.Theme, mode string) {
	{{ attrs := templ.Attributes{"lang": "en", "data-bs-theme": mode} }}
	{{
	for k, v := range t.Attrs() {
		attrs[k] = v
	}
	}}
	<!DOCTYPE html>
	<html { attrs... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ t.Label }</title>
			<link rel="stylesheet" href={ cdn.URL("@tabler/core", tablerVersion, "dist/css/tabler.min.css") }/>
			<link rel="stylesheet" href={ cdn.URL("@tabler/core", tablerVersion, "dist/css/tabler-themes.min.css") }/>
			<link rel="stylesheet" href={ cdn.URL("@tabler/core", tablerVersion, "dist/css/tabler-vendors.min.css") }/>
			<link rel="stylesheet" href={ cdn.URL("@tabler/icons-webfont", iconsVersion, "dist/tabler-icons.min.css") }/>
			@chart.Library()
			@themes.Head(t)
		</head>
		<body>
			<div class="p-3 space-y-3">
				<div class="row g-3">
					<div class="col-6">
						@metric.Card(metric.Props{Label: "Revenue", Value: "$4,300", Trend: metric.Trend(8),
							Bottom: chart.Chart(small(as(tc("revenue-bg", "Revenue", 0), "rev-"+mode), "rounded-bottom-3"))})
					</div>
					<div class="col-6">
						@card.Card() {
							@card.Body() {
								<div class="subheader mb-2">Storage</div>
								<div class="h2 mb-2">68%</div>
								@progress.Progress(progress.Props{Value: 68, Size: progress.SizeSmall})
								<div class="mt-3">
									@badge.Badge(badge.Props{Color: "primary", Light: true}) {
										Pro
									}
									@badge.Badge(badge.Props{Color: "green", Light: true}) {
										Active
									}
								</div>
							}
						}
					</div>
				</div>
				@card.Card() {
					@card.Body() {
						@form.Field(form.FieldProps{Label: "Email", For: "e-" + mode, Class: "mb-2"}) {
							@form.Input(form.InputProps{ID: "e-" + mode, Value: "paweł@tabler.io"})
						}
						@form.Check(form.CheckProps{Switch: true, Checked: true, Label: "Send me updates"})
						<div class="d-flex gap-2 mt-2">
							@button.Button(button.Props{Variant: button.VariantPrimary, Type: "button"}) {
								Save
							}
							@button.Button(button.Props{Type: "button"}) {
								Cancel
							}
							@button.Button(button.Props{Variant: button.VariantPrimary, Outline: true, Type: "button", Icon: "ti-download"}) {
								Export
							}
						</div>
					}
				}
			</div>
		</body>
	</html>
}
