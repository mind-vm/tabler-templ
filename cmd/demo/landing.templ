package main

import (
	"net/http"
	"strconv"

	"github.com/mind-vm/tabler-templ/avatar"
	"github.com/mind-vm/tabler-templ/blocks/marketing"
	pricingtable "github.com/mind-vm/tabler-templ/blocks/pricing"
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/pricing"
)

// Landing pages are this module's own showcase of the marketing blocks; they have no page in the Tabler
// preview, so they are served next to the catalog (like /themes): /landing is a gallery of the section
// variants, /landing/saas, /landing/app and /landing/black-white are complete landing pages.
func landingRoutes(mux *http.ServeMux) {
	mux.Handle("GET /landing", templ.Handler(lpGalleryPage()))
	mux.Handle("GET /landing/saas", templ.Handler(lpSaaSPage()))
	mux.Handle("GET /landing/app", templ.Handler(lpAppPage()))
	mux.Handle("GET /landing/black-white", templ.Handler(bwPageBody()))
}

templ landingLink() {
	<a href="/landing" class="btn">
		@icon.Icon("ti-rocket")
		Landing pages
	</a>
}

// --- shared frame -----------------------------------------------------------------------------------------
templ lpBrand(name, ic string) {
	<a href="/landing" class="navbar-brand d-flex align-items-center gap-2 text-reset text-decoration-none">
		<span class="avatar avatar-sm bg-primary text-primary-fg">
			@icon.Icon(ic)
		</span>
		<span class="fw-bold fs-3">{ name }</span>
	</a>
}

templ lpNavAction(text string) {
	<a href="#pricing" class="btn btn-primary">{ text }</a>
}

func lpLinks(active string) []marketing.Link {
	var ls []marketing.Link
	for _, l := range [][2]string{{"Gallery", "/landing"}, {"SaaS", "/landing/saas"}, {"App", "/landing/app"}, {"B&W", "/landing/black-white"}, {"Features", "#features"}, {"Pricing", "#pricing"}, {"FAQ", "#faq"}} {
		ls = append(ls, marketing.Link{Text: l[0], Href: l[1], Active: l[1] == active})
	}
	return ls
}

templ lpFooter(name string) {
	@marketing.Footer(marketing.FooterProps{
		Columns: []marketing.Column{
			{Title: "Product", Links: []marketing.Link{{Text: "Features", Href: "#features"}, {Text: "Pricing", Href: "#pricing"}, {Text: "Changelog", Href: "#"}, {Text: "Roadmap", Href: "#"}}},
			{Title: "Company", Links: []marketing.Link{{Text: "About", Href: "#"}, {Text: "Careers", Href: "#"}, {Text: "Press", Href: "#"}, {Text: "Contact", Href: "#contact"}}},
			{Title: "Resources", Links: []marketing.Link{{Text: "Docs", Href: "#"}, {Text: "Guides", Href: "#"}, {Text: "Status", Href: "#"}, {Text: "API", Href: "#"}}},
		},
		Text:  name + " is a fictitious product: this page shows the landing sections of tabler-templ's blocks/marketing package.",
		Start: marketing.Inline("We accept", mktPayment("visa", "Visa"), mktPayment("mastercard", "Mastercard"), mktPayment("paypal", "PayPal")),
		End:   marketing.Inline("Follow us", mktSocial("github", "GitHub"), mktSocial("x", "X"), mktSocial("linkedin", "LinkedIn")),
	})
	@marketing.Legal(marketing.LegalProps{Copyright: templ.Raw("© 2026 " + name), Links: []marketing.Link{{Text: "Terms", Href: "#"}, {Text: "Privacy", Href: "#"}, {Text: "Imprint", Href: "#"}}}) {
		Built with tabler-templ.
	}
}

templ lpPage(title, name, ic, active string, typed bool) {
	@marketing.Page(marketing.PageProps{
		Title:   title + " · tabler-templ",
		Head:    lpHead(typed),
		Scripts: scripts(),
		Navbar:  marketing.Navbar(marketing.NavbarProps{Brand: lpBrand(name, ic), Links: lpLinks(active), Action: lpNavAction("Start free"), ID: "navbar-landing"}),
		Footer:  lpFooter(name),
	}) {
		{ children... }
	}
}

templ lpHead(typed bool) {
	@mktAssets(typed)
	@marketing.LandingStyles()
}

templ lpButton(text, class, href string) {
	<a href={ templ.URL(href) } class={ "btn " + class }>{ text }</a>
}

templ lpIconButton(text, class, ic string) {
	<a href="#" class={ "btn " + class }>
		@icon.Icon(ic)
		{ text }
	</a>
}

templ lpImg(src, alt string, height int) {
	<img src={ src } alt={ alt } class="img-fluid d-block mx-auto" style={ templ.SafeCSS("max-height:" + strconv.Itoa(height) + "px") } loading="lazy"/>
}

templ lpShot(src string) {
	<img src={ src } alt="" class="img-fluid rounded-3 shadow border" loading="lazy"/>
}

