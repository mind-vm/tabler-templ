	{Icon: "ti-chart-dots-3", Title: "Live analytics", Text: "Every event streams into dashboards within seconds, no batch jobs, no waiting for tomorrow's report.", Span: 4, Tall: true, Media: lpShot(photo("projects/dashboard-1.png"))},
	{Icon: "ti-bolt", Title: "Automations", Text: "Trigger workflows from any metric crossing a threshold.", Span: 2, Color: "primary"},
	{Icon: "ti-lock", Title: "SSO & audit log", Text: "SAML, SCIM and a tamper-proof trail of every change.", Span: 2},
	{Icon: "ti-world", Title: "Edge regions", Text: "Data stays in the EU, US or APAC – you pick.", Span: 3},
	{Icon: "ti-api", Title: "Open API", Text: "Everything in the UI is one REST or GraphQL call away.", Span: 3, Color: "dark"},
}

