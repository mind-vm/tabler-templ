	{Title: "Workflow", Rows: []pricingtable.Row{{Feature: "Alerts", Included: []bool{true, true, true}}, {Feature: "Automations", Included: []bool{false, true, true}}, {Feature: "API access", Included: []bool{false, true, true}}}},
	{Title: "Security", Rows: []pricingtable.Row{{Feature: "Two-factor login", Included: []bool{true, true, true}}, {Feature: "SSO / SCIM", Included: []bool{false, false, true}}, {Feature: "Audit log", Included: []bool{false, false, true}}}},
}

var lpFAQ = []marketing.Question{
	{Question: "Can I try it before I pay?", Answer: "Yes. Every paid plan starts with a 14-day trial, no credit card needed. Starter is free forever."},
	{Question: "What happens when I exceed my events?", Answer: "Nothing breaks. We keep collecting and let you know; you can upgrade or buy an add-on pack."},
	{Question: "Where is my data stored?", Answer: "In the region you choose at sign-up: Frankfurt, Virginia or Singapore. You can move later."},
	{Question: "Can I cancel any time?", Answer: "Of course. Monthly plans end with the month, yearly plans are refunded pro rata."},
}

templ lpBrowserHero() {
	@marketing.Hero(marketing.HeroProps{Header: true, Class: "pb-0",
		Announcement:     marketing.Announcement(marketing.AnnouncementProps{Badge: "New", Text: "Automations are here – see what's new", Href: "#features"}),
		TitleHTML:        templ.Raw("Analytics your whole team<br/>actually understands"),
		Description:      "Flowbase turns product events into clear dashboards, alerts and automations – set up in minutes, loved for years.",
		DescriptionClass: "mt-4",
		Actions:          []templ.Component{lpButton("Start for free", "btn-lg btn-primary", "#pricing"), lpIconButton("Watch the demo", "btn-lg", "ti-player-play")}}) {
		<p class="text-secondary small mt-n3 mb-5">No credit card · 14-day trial · Cancel any time</p>
		@marketing.Image() {
			@marketing.Browser(marketing.BrowserProps{URL: "https://app.flowbase.example"}) {
				@marketing.Screenshot(marketing.ScreenshotProps{Light: photo("marketing/preview.png"), Light2x: photo("marketing/preview@2x.png"),
					Dark: photo("marketing/preview-dark.png"), Dark2x: photo("marketing/preview-dark@2x.png"), Width: 1060, Height: 663})
			}
		}
	}
}

templ lpSaaSPage() {
	@lpPage("Flowbase – SaaS landing", "Flowbase", "ti-chart-arcs", "/landing/saas", false) {
		@lpBrowserHero()
		@marketing.Section(marketing.SectionProps{Background: "light", Class: "mt-n12 pt-12", Divider: marketing.Waves}) {
			@marketing.Logos("Trusted by product teams at", mktLogos)
		}
		<div id="features">
			@marketing.Section(marketing.SectionProps{}) {
				@marketing.Bento(marketing.HeaderProps{Title: "Everything in one place", Description: "From the first event to the last automation – no glue code, no spreadsheet exports."}, lpBento)
			}
		</div>
		@marketing.Section(marketing.SectionProps{Background: "light"}) {
			@marketing.Steps(marketing.HeaderProps{Title: "Up and running in three steps", Description: "Most teams see their first dashboard before their coffee gets cold."}, lpSteps)
		}
		@marketing.Section(marketing.SectionProps{}) {
			@marketing.Split(marketing.SplitProps{Header: marketing.HeaderProps{Title: "Made for the way you work"}, Media: lpShot(photo("projects/dashboard-2.png"))}) {
				@marketing.FeatureList(lpFeatureList)
			}
		}
		@marketing.Section(marketing.SectionProps{Background: "light"}) {
			@marketing.Counters([]marketing.Counter{{Value: "12k+", Label: "teams"}, {Value: "4.2B", Label: "events a day"}, {Value: "99.99%", Label: "uptime"}, {Value: "4.9/5", Label: "on G2"}})
		}
		<div id="pricing">
			@marketing.Section(marketing.SectionProps{}) {
				@marketing.Plans(marketing.PlansProps{Header: marketing.HeaderProps{Title: "Simple pricing that scales with you", Description: "Start free, upgrade when you grow. All plans include unlimited dashboards."}, Save: "-20%"}, lpPlans)
				<div class="container mt-6">
					@pricingtable.Table(pricingtable.TableProps{Title: "Compare plans", Text: "Every feature, side by side."}, []pricingtable.Plan{{Name: "Starter", Price: "$0"}, {Name: "Growth", Price: "$49", Featured: "primary"}, {Name: "Scale", Price: "$199"}}, lpCompare)
				</div>
			}
		</div>
		@marketing.Section(marketing.SectionProps{Background: "light"}) {
			@marketing.Quote(marketing.QuoteProps{Stars: 5, Logo: mktLogos[0].Image,
				Text:   "We replaced three tools and a weekly reporting meeting with Flowbase. Our PMs now answer their own questions in minutes.",
				Avatar: avatar.Props{Src: photo("avatars/000f.jpg")}, Name: "Emmy Levet", Role: "VP Product, Baremetrics"})
		}
		<div id="faq">
			@marketing.Section(marketing.SectionProps{}) {
				@marketing.FAQList(marketing.FAQListProps{Title: "Frequently asked questions", Description: "Anything else? Our team answers within a few hours.", More: lpButton("Contact support", "", "#")}, lpFAQ)
			}
		</div>
		@marketing.Section(marketing.SectionProps{}) {
			@marketing.CTABox(marketing.CTABoxProps{Title: "Ready to see your product clearly?", Text: "Join 12,000 teams that ship with confidence. Set up takes five minutes.",
				Actions: []templ.Component{lpButton("Start for free", "btn-lg btn-light", "#pricing"), lpButton("Talk to sales", "btn-lg btn-outline-light", "#")}})
		}
	}
}

