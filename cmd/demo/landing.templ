	{Name: "Plus", Featured: true, Badge: "Best value", Monthly: marketing.PlanPrice{Amount: "€4.99", Period: "/month"}, Features: []string{"Unlimited accounts", "Smart reminders", "Shared spaces for 10", "CSV & Notion export"}, Button: "Try Plus free"},
	{Name: "Family", Monthly: marketing.PlanPrice{Amount: "€8.99", Period: "/month"}, Features: []string{"Everything in Plus", "Up to 6 members", "Kids' pocket money"}, Button: "Choose Family"},
}

templ lpTypedTitle() {
	Money, finally
	<br/>
	@marketing.Typed(marketing.TypedProps{ID: "typed-app", Strings: []string{"under control", "shared fairly", "stress-free"}})
}

templ lpStoreButtons() {
	@lpIconButton("App Store", "btn-lg btn-dark", "ti-brand-apple")
}

templ lpPlayButton() {
	@lpIconButton("Google Play", "btn-lg", "ti-brand-google-play")
}

templ lpAppPage() {
	@lpPage("Pocketly – app landing", "Pocketly", "ti-pig-money", "/landing/app", true) {
		@marketing.SideHero(marketing.SideHeroProps{
			Announcement: marketing.Announcement(marketing.AnnouncementProps{Badge: "4.8 ★", BadgeColor: "yellow", Text: "App of the day in 14 countries"}),
			Subheader:    "Personal finance app", TitleHTML: lpTypedTitle(),
			Description: "Pocketly brings all your accounts into one calm place, tells you what's safe to spend and splits shared costs without awkward conversations.",
			Actions:     []templ.Component{lpStoreButtons(), lpPlayButton()},
			Media:       lpImg(photo("illustrations/light/boy-girl.png"), "Two people looking at their phone", 380)})
		<div id="features">
			@marketing.Section(marketing.SectionProps{Background: "light", Divider: marketing.Arc}) {
				@marketing.FeatureCards(marketing.FeatureCardsProps{Columns: 4, Header: marketing.HeaderProps{Title: "Small app, big relief", Description: "Four things our users say they can't live without."}}, lpAppFeatures)
			}
		</div>
		@marketing.Section(marketing.SectionProps{}) {
			@marketing.Split(marketing.SplitProps{Header: marketing.HeaderProps{Title: "Your week at a glance"}, MediaEnd: true, Media: lpImg(photo("illustrations/light/computer-fix.png"), "", 320)}) {
				@marketing.FeatureList([]marketing.Feature{
					{Icon: "ti-calendar-stats", Title: "Weekly digest", Text: "Every Sunday: what came in, what went out and what's coming up."},
					{Icon: "ti-receipt", Title: "Receipts by photo", Text: "Snap a receipt, Pocketly files it under the right category."},
					{Icon: "ti-target-arrow", Title: "Savings goals", Text: "Round-ups and rules move money to your goals automatically."},
				})
			}
		}
		@marketing.Section(marketing.SectionProps{Background: "light"}) {
			@marketing.Integrations(marketing.HeaderProps{Title: "Plays well with others", Description: "Connect the tools you already use."}, lpIntegrations)
		}
		@marketing.Section(marketing.SectionProps{}) {
			@marketing.Testimonials(marketing.TestimonialsProps{Header: marketing.HeaderProps{Title: "Loved by 2 million people"}}, mktTestimonials[9:15])
		}
		<div id="pricing">
			@marketing.Section(marketing.SectionProps{Background: "light"}) {
				@marketing.Plans(marketing.PlansProps{ID: "app-plans", NoSwitch: true, Header: marketing.HeaderProps{Title: "Pick your plan", Description: "Every plan starts with a free month."}}, lpAppPlans)
			}
		</div>
		@marketing.Section(marketing.SectionProps{}) {
			@marketing.Team(marketing.HeaderProps{Title: "The people behind Pocketly", Description: "A small team in Berlin and Lisbon."}, lpTeam)
		}
		<div id="faq">
			@marketing.Section(marketing.SectionProps{Background: "light"}) {
				@marketing.FAQGrid(marketing.HeaderProps{Title: "Questions & answers"}, []marketing.Question{
					{Question: "Is my bank data safe?", Answer: "We use read-only connections through licensed providers and never store your bank password."},
					{Question: "Which banks are supported?", Answer: "Over 3,000 banks in the EU and UK, plus PayPal and most credit cards."},
					{Question: "What does Plus add?", Points: []string{"Unlimited accounts", "Smart reminders", "Exports to CSV and Notion"}},
				})
			}
		</div>
		<div id="contact">
			@marketing.Section(marketing.SectionProps{}) {
				@marketing.Contact(marketing.ContactProps{Title: "Get in touch", Description: "Press, partnerships or just a question – we read every message.",
					Items: []marketing.ContactItem{
						{Icon: "ti-mail", Title: "Email", Text: "hello@pocketly.example", Href: "mailto:hello@pocketly.example"},
						{Icon: "ti-message-circle", Title: "Live chat", Text: "Mon–Fri, 9:00–18:00 CET"},
						{Icon: "ti-map-pin", Title: "Office", Text: "Torstraße 1, 10119 Berlin"},
					}})
			}
		</div>
		@marketing.Section(marketing.SectionProps{Background: "light"}) {
			@marketing.Subscribe(marketing.SubscribeProps{Title: "Money tips, once a month", Description: "No spam, unsubscribe with one click."})
		}
		@marketing.Section(marketing.SectionProps{}) {
			@marketing.CTABox(marketing.CTABoxProps{Color: "dark", Title: "Take the first calm look at your money", Text: "Free to download. Set up in two minutes.",
				Actions: []templ.Component{lpIconButton("App Store", "btn-lg btn-light", "ti-brand-apple"), lpIconButton("Google Play", "btn-lg btn-outline-light", "ti-brand-google-play")},
				Media:   lpImg(photo("illustrations/light/boy-with-key.png"), "", 220)})
		}
	}
}

// --- gallery ----------------------------------------------------------------------------------------------

// lpLabel names the block that follows.
templ lpLabel(name, note string) {
	<div class="container pt-5 pb-2 border-top mt-5">
		<code class="badge bg-azure-lt fs-5">{ name }</code>
		<span class="text-secondary ms-2">{ note }</span>
	</div>
}

templ lpPlanButton(primary bool) {
	<a href="#" class={ "btn w-100", templ.KV("btn-primary", primary) }>Choose</a>
}

templ lpGalleryPage() {
	@lpPage("Landing sections", "tabler-templ", "ti-layout-board", "/landing", true) {
		@marketing.Hero(marketing.HeroProps{Header: true,
			Announcement: marketing.Announcement(marketing.AnnouncementProps{Badge: "Demo", BadgeColor: "green", Text: "Three full landing pages built from these blocks", Href: "/landing/saas"}),
			Title:        "Landing page sections",
			Description:  "Every hero, feature, pricing, social-proof and call-to-action block of blocks/marketing, one after the other. Each is labeled with its component.",
			Actions:      []templ.Component{lpButton("SaaS landing", "btn-lg btn-primary", "/landing/saas"), lpButton("App landing", "btn-lg", "/landing/app"), lpButton("Black & white", "btn-lg", "/landing/black-white")}})
		// Heroes
		@lpLabel("marketing.SideHero", "text at the start, media at the end; Typed rotates words")
		@marketing.SideHero(marketing.SideHeroProps{Class: "py-6", Subheader: "Side hero", TitleHTML: mktTypedTitle(),
			Description: "Use it with an illustration, a carousel or a product shot.",
			Actions:     []templ.Component{mktButton("Primary", "btn-primary"), mktButton("Secondary", "")}, Media: lpImg(photo("illustrations/light/good-info.png"), "", 300)})
		@lpLabel("marketing.CoverHero + SearchForm", "tinted background photo")
		@marketing.CoverHero(marketing.CoverHeroProps{Image: photo("photos/city-lights-reflected-in-the-water-at-night.jpg"), Title: "Find your next workspace",
			Description: "Search 4,000 coworking spaces in 120 cities.", Color: "dark"}) {
			@marketing.SearchForm(marketing.SearchFormProps{Placeholder: "City or neighbourhood", ButtonColor: "primary"})
		}
		@lpLabel("marketing.Hero", "centered, with an Announcement pill")
		@marketing.Hero(marketing.HeroProps{Announcement: marketing.Announcement(marketing.AnnouncementProps{Badge: "v2.0", Text: "Read the release notes"}),
			Title: "A centered hero without an image", Description: "Great for documentation, open-source projects and simple product pages.",
			Actions: []templ.Component{mktButton("Get started", "btn-primary"), mktButton("GitHub", "")}})
		// Social proof
		@lpLabel("marketing.Logos", "customer logos")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Logos("", mktLogos)
		}
		@lpLabel("marketing.Marquee", "logos that scroll endlessly, pure CSS")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Marquee(marketing.MarqueeProps{Label: "Customers"}, bwLogos())
		}
		@lpLabel("marketing.Counters", "big numbers")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Counters([]marketing.Counter{{Value: "120", Label: "components"}, {Value: "40+", Label: "blocks"}, {Value: "0", Label: "lines of JS to write"}, {Value: "MIT", Label: "license"}})
		}
		// Features
		@lpLabel("marketing.Features", "icons in shapes, centered")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Features(mktFeatures)
		}
		@lpLabel("marketing.FeatureCards", "3 columns, colored shapes, no links")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.FeatureCards(marketing.FeatureCardsProps{}, []marketing.FeatureCard{
				{Icon: "ti-code", Title: "Type-safe templates", Text: "Props are Go structs; the compiler catches typos."},
				{Icon: "ti-palette", Color: "pink", Title: "Themes included", Text: "Switch colors, fonts and radius with Tabler's themes."},
				{Icon: "ti-accessible", Color: "green", Title: "Accessible", Text: "Labels, landmarks and focus states out of the box."},
			})
		}
		@lpLabel("marketing.Bento", "tiles of different widths and colors")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Bento(marketing.HeaderProps{}, lpBento)
		}
		@lpLabel("marketing.Steps", "numbered, joined by a dashed line")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Steps(marketing.HeaderProps{}, append(lpSteps, marketing.Step{Title: "Grow", Text: "Invite your team and scale up when you are ready."}))
		}
		@lpLabel("marketing.Split + FeatureList", "media and a list of features")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Split(marketing.SplitProps{Media: lpShot(photo("projects/dashboard-3.png"))}) {
				@marketing.FeatureList(lpFeatureList)
			}
		}
		@lpLabel("marketing.Integrations", "icon tiles")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Integrations(marketing.HeaderProps{}, lpIntegrations)
		}
		// Pricing
		@lpLabel("marketing.Plans", "monthly/yearly switch in pure CSS")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Plans(marketing.PlansProps{ID: "gallery-plans", Save: "2 months free"}, lpPlans)
		}
		@lpLabel("pricing.Pricing + pricing.Card", "Tabler's pricing cards")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			<div class="container">
				@pricing.Pricing() {
					@pricing.Card(pricing.CardProps{Title: "Basic", Currency: "$", Price: "9", Description: []string{"per user", "per month"}, Content: marketing.CheckList(mktPlanFeatures[:2], "my-5"), Button: lpPlanButton(false)})
					@pricing.Card(pricing.CardProps{Title: "Pro", Currency: "$", Price: "29", Description: []string{"per user", "per month"}, Featured: true, Label: mktPopular(), Content: marketing.CheckList(mktPlanFeatures, "my-5"), Button: lpPlanButton(true)})
					@pricing.Card(pricing.CardProps{Title: "Team", Currency: "$", Price: "99", Description: []string{"per team", "per month"}, Content: marketing.CheckList(mktPlanFeatures[1:], "my-5"), Button: lpPlanButton(false)})
				}
			</div>
		}
		@lpLabel("marketing.Banner", "a wide single offer")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Banner(marketing.BannerProps{Title: "Lifetime license", Text: "Pay once, use forever.", Features: mktPlanFeatures[:3], Currency: "$", Price: "299", Description: []string{"one-time", "per team"}, Action: mktTeamButton()})
		}
		@lpLabel("blocks/pricing.Table", "feature comparison")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			<div class="container">
				@pricingtable.Table(pricingtable.TableProps{Title: "Compare plans"}, []pricingtable.Plan{{Name: "Starter", Price: "$0"}, {Name: "Growth", Price: "$49", Featured: "primary"}, {Name: "Scale", Price: "$199"}}, lpCompare)
			</div>
		}
		// Testimonials
		@lpLabel("marketing.Quote", "one big testimonial with stars")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Quote(marketing.QuoteProps{Stars: 5, Text: "The fastest way we've found to ship a polished marketing site from a Go backend.",
				Avatar: avatar.Props{Src: photo("avatars/006m.jpg")}, Name: "Lorry Mion", Role: "Staff Engineer"})
		}
		@lpLabel("marketing.Testimonials", "quote cards in three columns")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Testimonials(marketing.TestimonialsProps{}, mktTestimonials[:6])
		}
		@lpLabel("marketing.Team", "people with links")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Team(marketing.HeaderProps{}, lpTeam)
		}
		// FAQ
		@lpLabel("marketing.FAQGrid", "questions in three columns")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.FAQGrid(marketing.HeaderProps{}, lpFAQ[:3])
		}
		@lpLabel("marketing.FAQList", "sticky title, questions below each other")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.FAQList(marketing.FAQListProps{Title: "FAQ", Description: "The questions we hear most."}, lpFAQ)
		}
		// Calls to action
		@lpLabel("marketing.CTA", "plain, centered")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.CTA(marketing.CTAProps{Title: "Start building today", Text: "Free and open source.", Actions: []templ.Component{mktGetStarted(), mktLearnMore()}})
		}
		@lpLabel("marketing.CTABox", "primary, centered")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.CTABox(marketing.CTABoxProps{Title: "Ready when you are", Text: "Spin up your landing page in an afternoon.", Actions: []templ.Component{lpButton("Get started", "btn-lg btn-light", "#"), lpButton("Read the docs", "btn-lg btn-outline-light", "#")}})
		}
		@lpLabel("marketing.CTABox", "colored, with media")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.CTABox(marketing.CTABoxProps{Color: "purple", Title: "Join the beta", Text: "Get early access to new blocks and shape what comes next.", Actions: []templ.Component{lpButton("Request access", "btn-lg btn-light", "#")}, Media: lpImg(photo("illustrations/light/boy-with-key.png"), "", 200)})
		}
		@lpLabel("marketing.CTABox", "light, inline: text at the start, actions at the end")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.CTABox(marketing.CTABoxProps{Color: "light", Inline: true, Title: "Questions before you start?", Text: "Our team walks you through it in 20 minutes.", Actions: []templ.Component{lpButton("Book a call", "btn-primary", "#")}})
		}
		@lpLabel("marketing.Subscribe", "newsletter")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Subscribe(marketing.SubscribeProps{Title: "Stay in the loop", Description: "One email per release."})
		}
		@lpLabel("marketing.Contact", "ways to reach you and a form")
		@marketing.Section(marketing.SectionProps{Class: "py-5"}) {
			@marketing.Contact(marketing.ContactProps{Title: "Talk to us", Description: "We usually answer within a day.", Items: []marketing.ContactItem{
				{Icon: "ti-mail", Title: "Email", Text: "team@example.com", Href: "mailto:team@example.com"},
				{Icon: "ti-phone", Title: "Phone", Text: "+49 30 1234567"},
			}})
		}
		@lpLabel("marketing.Section dividers", "Waves and Arc at the top of a section")
		@marketing.Section(marketing.SectionProps{Background: "light", Divider: marketing.Waves}) {
			<div class="container text-center text-secondary">Waves</div>
		}
		@marketing.Section(marketing.SectionProps{Background: "dark", Divider: marketing.Arc}) {
			<div class="container text-center">Arc on a dark section</div>
		}
	}
}
