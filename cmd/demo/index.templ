package main

import (
	"fmt"
	"github.com/mind-vm/tabler-templ/blocks/layout"

	"github.com/mind-vm/tabler-templ/badge"
	"github.com/mind-vm/tabler-templ/internal/catalog"
)

func rebuilt(group string) (n, of int) {
	for _, p := range catalog.Pages {
		if p.Group == group {
			of++
			if p.Status != catalog.Open {
				n++
			}
		}
	}
	return
}

templ themesLink() {
	<a href="/themes" class="btn btn-primary">
		<i class="ti ti-palette icon" aria-hidden="true"></i>
		Themes
	</a>
}

templ index() {
	{{ p := frameProps("", "Tabler preview") }}
	{{
		p.Header = layout.PageHeader(layout.PageHeaderProps{Title: "Tabler preview in Go and templ",
			Description: "Every page of the Tabler preview, rebuilt with tabler-templ. Linked pages are rebuilt (marked partial where parts are still missing); grey ones are still open, see ROADMAP.md.",
			Actions: themesLink()})
	}}
	@layout.Page(p) {
		<div class="row row-cards">
			for _, g := range catalog.Groups() {
				<div class="col-12">
					<div class="card">
						<div class="card-header">
							<h2 class="card-title">{ g }</h2>
							<div class="card-actions text-secondary">
								{{ n, of := rebuilt(g) }}
								{ fmt.Sprintf("%d of %d", n, of) }
							</div>
						</div>
						<div class="card-body">
							<div class="row g-2">
								for _, p := range catalog.Pages {
									if p.Group == g {
										<div class="col-sm-6 col-md-4 col-lg-3">
											if p.Status == catalog.Open {
												<span class="text-secondary opacity-50" title="open">{ p.Name }</span>
											} else {
												<a href={ templ.SafeURL("/" + p.Name) } title={ p.Title }>{ p.Name }</a>
												if p.Status == catalog.Partial {
													@badge.Badge(badge.Props{Color: "yellow", Light: true, Class: "ms-1", Attributes: templ.Attributes{"title": p.Note}}) {
														partial
													}
												}
											}
										</div>
									}
								}
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
}
