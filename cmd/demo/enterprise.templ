package main

import (
	"net/http"
	"strconv"

	"github.com/mind-vm/tabler-templ/alert"
	"github.com/mind-vm/tabler-templ/badge"
	"github.com/mind-vm/tabler-templ/blocks/actionbar"
	"github.com/mind-vm/tabler-templ/blocks/shell"
	"github.com/mind-vm/tabler-templ/blocks/split"
	"github.com/mind-vm/tabler-templ/card"
	"github.com/mind-vm/tabler-templ/cdn"
	"github.com/mind-vm/tabler-templ/empty"
	"github.com/mind-vm/tabler-templ/form"
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/sidebar"
)

// The enterprise demo is a small help-desk app in the shell: a workspace switcher and collapsible groups
// in the sidebar, tickets as list, detail and inspector (blocks/split), a settings form with a sticky
// action bar (blocks/actionbar) and a compact mode (?compact=1).

func enterpriseRoutes(mux *http.ServeMux) {
	mux.HandleFunc("GET /enterprise", func(w http.ResponseWriter, r *http.Request) {
		http.Redirect(w, r, "/enterprise/tickets"+entQuery(r), http.StatusFound)
	})
	mux.HandleFunc("GET /enterprise/tickets", func(w http.ResponseWriter, r *http.Request) {
		templ.Handler(entTicketsPage(r, nil)).ServeHTTP(w, r)
	})
	mux.HandleFunc("GET /enterprise/tickets/{id}", func(w http.ResponseWriter, r *http.Request) {
		for i := range entTickets {
			if strconv.Itoa(entTickets[i].ID) == r.PathValue("id") {
				templ.Handler(entTicketsPage(r, &entTickets[i])).ServeHTTP(w, r)
				return
			}
		}
		http.NotFound(w, r)
	})
	mux.HandleFunc("GET /enterprise/settings", func(w http.ResponseWriter, r *http.Request) {
		templ.Handler(entSettingsPage(r)).ServeHTTP(w, r)
	})
	mux.HandleFunc("POST /enterprise/settings", func(w http.ResponseWriter, r *http.Request) {
		q := "?saved=1"
		if r.URL.Query().Get("compact") == "1" {
			q += "&compact=1"
		}
		http.Redirect(w, r, "/enterprise/settings"+q, http.StatusSeeOther)
	})
}

templ enterpriseLink() {
	<a href="/enterprise" class="btn">
		@icon.Icon("ti-building-skyscraper")
		Enterprise app
	</a>
}

func compact(r *http.Request) bool { return r.URL.Query().Get("compact") == "1" }

func entQuery(r *http.Request) string {
	if compact(r) {
		return "?compact=1"
	}
	return ""
}

type entTicket struct {
	ID                      int
	Subject, From, Company  string
	Time, Status, Priority  string
	Preview, Body, Assignee string
	Unread                  bool
	Tags                    []string
}

var entTickets = []entTicket{
	{ID: 1042, Subject: "Invoices export stops at 10,000 rows", From: "Maria Lopez", Company: "Northwind", Time: "09:12", Status: "Open", Priority: "High", Unread: true,
		Preview: "Since Monday the CSV export of invoices ends after exactly 10,000 rows…", Assignee: "Paweł Kuna", Tags: []string{"export", "billing"},
		Body: "Since Monday the CSV export of invoices ends after exactly 10,000 rows. We have about 14,000 invoices for Q3 and need all of them for the audit on Friday.\n\nIs there a limit we can raise, or can the export be split by month?"},
	{ID: 1041, Subject: "SSO login loops back to the sign-in page", From: "Tom Becker", Company: "Contoso", Time: "08:47", Status: "Open", Priority: "Urgent", Unread: true,
		Preview: "After the certificate rotation our users land on the sign-in page again…", Assignee: "Jeffie Lewzey", Tags: []string{"sso", "auth"},
		Body: "After yesterday's certificate rotation our users land on the sign-in page again after signing in with Okta. Clearing cookies does not help."},
	{ID: 1039, Subject: "Add a second admin to our workspace", From: "Aiko Tanaka", Company: "Fabrikam", Time: "Yesterday", Status: "Pending", Priority: "Low",
		Preview: "Our admin is on parental leave, please make Kenji an admin too.", Assignee: "Mallory Hulme", Tags: []string{"account"},
		Body: "Our admin is on parental leave from next week. Please make Kenji Sato (kenji@fabrikam.example) an admin of the workspace too."},
	{ID: 1036, Subject: "Webhook deliveries delayed by 20 minutes", From: "Lena Fischer", Company: "Tailspin", Time: "Mon", Status: "Solved", Priority: "Normal",
		Preview: "Order events arrive with a delay of up to 20 minutes since Friday.", Assignee: "Paweł Kuna", Tags: []string{"webhooks"},
		Body: "Order events arrive with a delay of up to 20 minutes since Friday. Our warehouse relies on them to start picking."},
	{ID: 1031, Subject: "Question about the Enterprise plan's audit log", From: "Omar Haddad", Company: "Litware", Time: "Oct 30", Status: "Solved", Priority: "Normal",
		Preview: "How long are audit log entries kept, and can we export them?", Assignee: "Jeffie Lewzey", Tags: []string{"sales"},
		Body: "How long are audit log entries kept on the Enterprise plan, and can we export them to our SIEM?"},
}

func entStatusColor(s string) string {
	switch s {
	case "Open":
		return "blue"
	case "Pending":
		return "orange"
	}
	return "green"
}

func entPriorityColor(p string) string {
	switch p {
	case "Urgent":
		return "red"
	case "High":
		return "orange"
	}
	return "secondary"
}

templ entHead() {
	<link rel="stylesheet" href={ cdn.URL("@tabler/core", tablerVersion, "dist/css/tabler.min.css") }/>
	<link rel="stylesheet" href={ cdn.URL("@tabler/icons-webfont", iconsVersion, "dist/tabler-icons.min.css") }/>
}

templ entScripts() {
	<script src={ cdn.URL("@tabler/core", tablerVersion, "dist/js/tabler.min.js") }></script>
}

templ entSidebar(r *http.Request, current string) {
	@sidebar.Sidebar(sidebar.Props{ID: "sidebar", Collapsed: sidebar.Collapsed(r), Label: "Main navigation"}) {
		@sidebar.Header() {
			@sidebar.Switcher(sidebar.SwitcherProps{Initials: "AC", Title: "Acme Support", Subtitle: "Enterprise · 48 seats", Label: "Switch workspace"}) {
				<h6 class="dropdown-header">Workspaces</h6>
				<a class="dropdown-item active" href={ templ.URL("/enterprise/tickets" + entQuery(r)) }>
					@icon.Icon("ti-check", icon.Props{Class: "dropdown-item-icon"})
					Acme Support
				</a>
				<a class="dropdown-item" href={ templ.URL("/enterprise/tickets" + entQuery(r)) }>
					<span class="dropdown-item-icon"></span>
					Acme Sales
				</a>
				<a class="dropdown-item" href={ templ.URL("/enterprise/tickets" + entQuery(r)) }>
					<span class="dropdown-item-icon"></span>
					Globex Labs
				</a>
				<div class="dropdown-divider"></div>
				<a class="dropdown-item" href={ templ.URL("/enterprise/settings" + entQuery(r)) }>
					@icon.Icon("ti-plus", icon.Props{Class: "dropdown-item-icon"})
					New workspace
				</a>
			}
		}
		@sidebar.Content() {
			@sidebar.Group(sidebar.GroupProps{}) {
				@sidebar.Item(sidebar.ItemProps{Href: "/enterprise/tickets" + entQuery(r), Icon: "ti-inbox", Label: "Inbox", Count: 2, CountTitle: "unread", Active: current == "tickets"})
				@sidebar.Item(sidebar.ItemProps{Href: "/enterprise/tickets" + entQuery(r), Icon: "ti-user-check", Label: "Assigned to me"})
			}
			@sidebar.Group(sidebar.GroupProps{Label: "Favorites", Collapsible: true, Open: true}) {
				@sidebar.Item(sidebar.ItemProps{Href: "/enterprise/tickets/1041" + entQuery(r), Icon: "ti-star", Label: "SSO incidents"})
				@sidebar.Item(sidebar.ItemProps{Href: "/enterprise/tickets/1042" + entQuery(r), Icon: "ti-star", Label: "Billing escalations"})
			}
			@sidebar.Group(sidebar.GroupProps{Label: "Customers", Collapsible: true, Open: true}) {
				@sidebar.Item(sidebar.ItemProps{Href: "/enterprise/tickets" + entQuery(r), Icon: "ti-building", Label: "Organizations"})
				@sidebar.Item(sidebar.ItemProps{Href: "/enterprise/tickets" + entQuery(r), Icon: "ti-users", Label: "Contacts"})
			}
			@sidebar.Group(sidebar.GroupProps{Label: "Reports", Collapsible: true}) {
				@sidebar.Item(sidebar.ItemProps{Href: "/enterprise/tickets" + entQuery(r), Icon: "ti-chart-bar", Label: "Volume"})
				@sidebar.Item(sidebar.ItemProps{Href: "/enterprise/tickets" + entQuery(r), Icon: "ti-clock", Label: "Response times"})
				@sidebar.Item(sidebar.ItemProps{Href: "/enterprise/tickets" + entQuery(r), Icon: "ti-mood-smile", Label: "Satisfaction"})
			}
			@sidebar.Group(sidebar.GroupProps{End: true}) {
				@sidebar.Item(sidebar.ItemProps{Href: "/enterprise/settings" + entQuery(r), Icon: "ti-settings", Label: "Settings", Active: current == "settings"})
				@sidebar.Item(sidebar.ItemProps{Href: "/", Icon: "ti-arrow-left", Label: "Back to the preview"})
			}
		}
		@sidebar.Footer() {
			@sidebar.User(sidebar.UserProps{Initials: "PK", Name: "Paweł Kuna", Detail: "Support lead", Label: "Account"}) {
				<a class="dropdown-item" href="/enterprise/settings">Profile</a>
				<a class="dropdown-item" href="/">Sign out</a>
			}
		}
	}
}

templ entHeaderActions(r *http.Request) {
	if compact(r) {
		<a href={ templ.URL(r.URL.Path) } class="btn btn-sm">
			@icon.Icon("ti-arrows-maximize")
			Comfortable
		</a>
	} else {
		<a href={ templ.URL(r.URL.Path + "?compact=1") } class="btn btn-sm">
			@icon.Icon("ti-arrows-minimize")
			Compact
		</a>
	}
}

func entProps(r *http.Request, title, current string) shell.Props {
	return shell.Props{Title: title, AppName: "Acme Support", Head: entHead(), Scripts: entScripts(),
		Sidebar: entSidebar(r, current), Collapsed: sidebar.Collapsed(r), Compact: compact(r),
		HeaderActions: entHeaderActions(r)}
}

templ entTicketsPage(r *http.Request, t *entTicket) {
	{{
		p := entProps(r, "Inbox", "tickets")
		p.Breadcrumbs = []shell.Crumb{{Text: "Support", Href: "/enterprise" + entQuery(r)}, {Text: "Inbox"}}
		if t != nil {
			p.Title = "#" + strconv.Itoa(t.ID)
			p.Heading = t.Subject
			p.Breadcrumbs = []shell.Crumb{{Text: "Support", Href: "/enterprise" + entQuery(r)}, {Text: "Inbox", Href: "/enterprise/tickets" + entQuery(r)}, {Text: "#" + strconv.Itoa(t.ID)}}
			p.HeadingExtra = entStatus(t.Status)
			p.Tabs = entTabs()
			p.Actions = entTicketActions()
		}
	}}
	@shell.Page(p) {
		{{
			var detail, aside templ.Component
			if t != nil {
				detail, aside = entDetail(*t), entFacts(*t)
			}
		}}
		@split.Split(split.Props{List: entList(r, t), Detail: detail, Empty: entNoTicket(), Selected: t != nil,
			BackHref: "/enterprise/tickets" + entQuery(r), Aside: aside, AsideTitle: "Details"})
	}
}

templ entStatus(s string) {
	@badge.Badge(badge.Props{Color: entStatusColor(s), Light: true}) {
		{ s }
	}
}

templ entTabs() {
	<ul class="nav nav-bordered">
		<li class="nav-item"><a class="nav-link active" aria-current="page" href="#">Conversation</a></li>
		<li class="nav-item"><a class="nav-link" href="#">Activity</a></li>
		<li class="nav-item"><a class="nav-link" href="#">Linked tickets <span class="badge bg-secondary-lt ms-1">2</span></a></li>
	</ul>
}

templ entTicketActions() {
	@split.AsideToggle(split.ToggleProps{})
	<a href="#reply" class="btn btn-primary">
		@icon.Icon("ti-send")
		Reply
	</a>
}

templ entList(r *http.Request, current *entTicket) {
	<div class="card-header">
		<h3 class="card-title">Inbox</h3>
		<div class="card-actions">
			<span class="text-secondary small">{ strconv.Itoa(len(entTickets)) } tickets</span>
		</div>
	</div>
	for _, t := range entTickets {
		@split.ListItem(split.ListItemProps{Href: "/enterprise/tickets/" + strconv.Itoa(t.ID) + entQuery(r), Title: t.Subject,
			Meta: t.Time, Text: t.From + " · " + t.Preview, Unread: t.Unread, Active: current != nil && current.ID == t.ID,
			Badge: entStatus(t.Status)})
	}
}

templ entNoTicket() {
	@empty.Empty(empty.Props{Icon: "ti-inbox", Title: "No ticket open", Subtitle: "Pick a ticket from the list to read and answer it."})
}

templ entDetail(t entTicket) {
	<div class="card-body">
		<div class="d-flex align-items-center gap-3 mb-3">
			<span class="avatar">{ entInitials(t.From) }</span>
			<div class="min-w-0">
				<div class="fw-medium">{ t.From } · { t.Company }</div>
				<div class="text-secondary small">{ t.Time } · via e-mail</div>
			</div>
		</div>
		<div style="white-space:pre-line">{ t.Body }</div>
	</div>
	<div class="card-body border-top" id="reply">
		<form>
			@form.Field(form.FieldProps{Label: "Reply", For: "reply-text"}) {
				@form.Textarea(form.TextareaProps{ID: "reply-text", Name: "reply", Rows: 4, Placeholder: "Write a reply…"})
			}
			<div class="d-flex justify-content-end gap-2">
				<button type="button" class="btn">Internal note</button>
				<button type="button" class="btn btn-primary">Send reply</button>
			</div>
		</form>
	</div>
}

func entInitials(name string) string {
	out := ""
	for i, f := range []rune(name) {
		if i == 0 || (i > 0 && []rune(name)[i-1] == ' ') {
			out += string(f)
		}
	}
	return out
}

templ entFacts(t entTicket) {
	<dl class="datagrid p-3">
		<div class="datagrid-item">
			<dt class="datagrid-title">Priority</dt>
			<dd class="datagrid-content">
				@badge.Badge(badge.Props{Color: entPriorityColor(t.Priority), Light: true}) {
					{ t.Priority }
				}
			</dd>
		</div>
		<div class="datagrid-item">
			<dt class="datagrid-title">Assignee</dt>
			<dd class="datagrid-content">{ t.Assignee }</dd>
		</div>
		<div class="datagrid-item">
			<dt class="datagrid-title">Organization</dt>
			<dd class="datagrid-content">{ t.Company }</dd>
		</div>
		<div class="datagrid-item">
			<dt class="datagrid-title">Ticket</dt>
			<dd class="datagrid-content">#{ strconv.Itoa(t.ID) }</dd>
		</div>
		<div class="datagrid-item">
			<dt class="datagrid-title">Tags</dt>
			<dd class="datagrid-content">
				<div class="tags-list">
					for _, tag := range t.Tags {
						<span class="tag">{ tag }</span>
					}
				</div>
			</dd>
		</div>
		<div class="datagrid-item">
			<dt class="datagrid-title">SLA</dt>
			<dd class="datagrid-content text-orange">First reply due in 42 min</dd>
		</div>
	</dl>
}

templ entSettingsPage(r *http.Request) {
	{{
		p := entProps(r, "Settings", "settings")
		p.Breadcrumbs = []shell.Crumb{{Text: "Workspace"}, {Text: "Settings"}}
		p.Subtitle = entSettingsSubtitle()
		if r.URL.Query().Get("saved") == "1" {
			p.Flash = &shell.Flash{Variant: alert.VariantSuccess, Text: "Settings saved."}
		}
	}}
	@shell.Page(p) {
		<form id="settings" method="post" action={ templ.SafeURL("/enterprise/settings" + entQuery(r)) }>
			<div class="row row-cards">
				<div class="col-lg-8">
					@card.Card() {
						@card.Header() {
							@card.Title() {
								Workspace
							}
						}
						@card.Body() {
							@form.Field(form.FieldProps{Label: "Name", For: "ws-name", Required: true}) {
								@form.Input(form.InputProps{ID: "ws-name", Name: "name", Value: "Acme Support", Required: true})
							}
							@form.Field(form.FieldProps{Label: "Support address", For: "ws-mail", Hint: "Replies are sent from this address."}) {
								@form.Input(form.InputProps{ID: "ws-mail", Name: "mail", Type: "email", Value: "support@acme.example"})
							}
							@form.Field(form.FieldProps{Label: "Time zone", For: "ws-tz"}) {
								@form.Select(form.SelectProps{ID: "ws-tz", Name: "tz", Selected: "Europe/Berlin", Options: []form.Option{
									{Value: "Europe/London", Label: "London"}, {Value: "Europe/Berlin", Label: "Berlin"}, {Value: "America/New_York", Label: "New York"}}})
							}
							@form.Field(form.FieldProps{Label: "Signature", For: "ws-sig", Class: "mb-0"}) {
								@form.Textarea(form.TextareaProps{ID: "ws-sig", Name: "signature", Rows: 3, Value: "Your Acme support team"})
							}
						}
					}
					@card.Card(card.Props{Class: "mt-3"}) {
						@card.Header() {
							@card.Title() {
								Service levels
							}
						}
						@card.Body() {
							@form.Field(form.FieldProps{Label: "First reply within", For: "sla-first"}) {
								@form.Select(form.SelectProps{ID: "sla-first", Name: "sla_first", Selected: "1h", Options: []form.Option{
									{Value: "30m", Label: "30 minutes"}, {Value: "1h", Label: "1 hour"}, {Value: "4h", Label: "4 hours"}}})
							}
							@form.Check(form.CheckProps{Name: "business_hours", Label: "Count business hours only", Switch: true, Checked: true})
							@form.Check(form.CheckProps{Name: "escalate", Label: "Escalate breached tickets to the lead", Switch: true})
						}
					}
				</div>
				<div class="col-lg-4">
					@card.Card() {
						@card.Body() {
							<h3 class="card-title">Sticky action bar</h3>
							<p class="text-secondary mb-0">Change a field: the bar below says so, and leaving the page asks first. Discard resets the form.</p>
						}
					}
				</div>
			</div>
		</form>
		@actionbar.Bar(actionbar.Props{Form: "settings", Guard: true, Info: "Last saved today at 09:30"}) {
			<button type="reset" form="settings" class="btn">Discard</button>
			<button type="submit" form="settings" class="btn btn-primary">Save changes</button>
		}
	}
}

templ entSettingsSubtitle() {
	Workspace settings of Acme Support.
}
