// checkName leaves the name off the preview's disabled radios.
func checkName(name string, none bool) string {
	if none {
		return ""
	}
	return name
}

func maskAttrs(mask string, reverse bool) templ.Attributes {
	a := templ.Attributes{"data-mask": mask, "data-mask-visible": "true"}
	if reverse {
		a["data-mask-reverse"] = "true"
	}
	return a
}

