// options turns value/label pairs into select options.
func options(pairs ...string) []form.Option {
	var os []form.Option
	for i := 0; i+1 < len(pairs); i += 2 {
		os = append(os, form.Option{Value: pairs[i], Label: pairs[i+1]})
	}
	return os
}

// plainOptions are options whose value is their label.
func plainOptions(labels ...string) []form.Option {
	os := make([]form.Option, len(labels))
	for i, l := range labels {
		os[i] = form.Option{Value: l, Label: l}
	}
	return os
}

func numberOptions(from, to, step int) []form.Option {
	var os []form.Option
	for i := from; (step > 0 && i <= to) || (step < 0 && i >= to); i += step {
		s := strconv.Itoa(i)
		os = append(os, form.Option{Value: s, Label: s})
	}
	return os
}

// custom gives each option the HTML an enhanced select (Tom Select) shows next to it.
func custom(os []form.Option, html ...string) []form.Option {
	for i := range os {
		os[i].Attributes = templ.Attributes{"data-custom-properties": html[i]}
	}
	return os
}

