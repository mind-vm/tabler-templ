func avatarOptions() []form.Option {
	os := make([]form.Option, len(selectPeople))
	for i, p := range selectPeople {
		html := `<span class="avatar avatar-xs">` + p.Initials + `</span>`
		if p.Photo != "" {
			html = `<span class="avatar avatar-xs" style="background-image: url(` + avatarURL(p.Photo) + `)"></span>`
		}
		os[i] = form.Option{Value: strconv.Itoa(i + 1), Label: p.Name, Attributes: templ.Attributes{"data-custom-properties": html}}
	}
	return os
}

var flagCountries = options("pl", "Poland", "de", "Germany", "cz", "Czech Republic", "br", "Brazil")

func flagOptions() []form.Option {
	os := options("pl", "Poland", "de", "Germany", "cz", "Czech Republic", "br", "Brazil")
	for i := range os {
		os[i].Attributes = templ.Attributes{"data-custom-properties": `<span class="flag flag-xs flag-country-` + os[i].Value + `"></span>`}
	}
	return os
}

func signalHTML(color string, active int) string {
	s := `<span class="signal" aria-hidden="true">`
	if color != "" {
		s = `<span class="signal signal-` + color + `" aria-hidden="true">`
	}
	for i := range 3 {
		if i < active {
			s += `<span class="signal-bar active"></span>`
		} else {
			s += `<span class="signal-bar"></span>`
		}
	}
	return s + `</span>`
}

