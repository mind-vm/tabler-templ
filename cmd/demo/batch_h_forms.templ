// ---------------------------------------------------------------- form elements
templ paymentStyles() {
	<link rel="stylesheet" href={ "https://cdn.jsdelivr.net/npm/@tabler/core@" + tablerVersion + "/dist/css/tabler-payments.min.css" }/>
}

templ moreActions() {
	@dropdown.Item(dropdown.ItemProps{Href: "#"}) {
		Action
	}
	@dropdown.Item(dropdown.ItemProps{Href: "#"}) {
		Another action
	}
}

templ otherMenu() {
	@button.Group() {
		@dropdown.Toggle(button.Props{Attributes: templ.Attributes{"aria-haspopup": "true"}}) {
			Other
		}
		@dropdown.Menu() {
			@moreActions()
			@dropdown.Divider()
			for _, o := range []string{"Option 4", "Option 5", "Option 6"} {
				@dropdown.Item(dropdown.ItemProps{Href: "#"}) {
					{ o }
				}
			}
		}
	}
}

templ radioButtons(name string, labels ...string) {
	for i, l := range labels {
		@button.Check(button.CheckProps{Radio: true, Name: name, ID: name + "-" + strconv.Itoa(i+1), Label: l, Checked: i == 0})
	}
}

templ selectItems(name string, radio bool, values ...string) {
	for i, v := range values {
		@form.SelectItem(form.SelectItemProps{Name: name, Value: v, Label: v, Radio: radio, Checked: i == 0})
	}
}

templ datepickerInput(id string, class string) {
	@form.Input(form.InputProps{ID: id, Class: class, Value: "2020-06-20", Placeholder: "Select a date", Autocomplete: "off", Attributes: templ.Attributes{"data-bs-toggle": "datepicker"}})
}

templ maskInput(id, mask, placeholder string) {
	@form.Input(form.InputProps{ID: id, Name: "input-mask", Placeholder: placeholder, Autocomplete: "off", Attributes: templ.Attributes{"data-mask": mask, "data-mask-visible": "true"}})
}

templ formElementsColumn1() {
	<div class="col-md-6 col-xl-12">
