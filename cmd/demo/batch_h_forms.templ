templ formElementsColumn3() {
	<div class="col-md-6 col-xl-12">
		@form.Field(form.FieldProps{Label: "Image Check", Fieldset: true}) {
			<div class="row g-2">
				for i, im := range imageChecks {
					<div class="col-6 col-sm-4">
						@form.ImageCheck(form.ImageCheckProps{Class: "mb-2", Name: "form-imagecheck", Value: strconv.Itoa(i + 1), Src: photo("photos/" + im[0] + ".jpg"), Alt: im[1], Checked: i == 1 || i == 3})
					</div>
				}
			</div>
		}
		@form.Field(form.FieldProps{Label: "Image Check Radio", Fieldset: true}) {
			<div class="row g-2">
				for i, im := range imageRadios {
					<div class="col-6 col-sm-4">
						@form.ImageCheck(form.ImageCheckProps{Class: "mb-2", Name: "form-imagecheck-radio", Radio: true, Value: strconv.Itoa(i + 1), Src: photo("photos/" + im[0] + ".jpg"), Alt: im[1], Checked: i == 1})
					</div>
				}
			</div>
		}
		@form.Field(form.FieldProps{Label: "Color Input Check", Fieldset: true}) {
			<div class="row g-2">
				for _, c := range swatchColors {
					<div class="col-auto">
						@form.ColorCheck(form.ColorCheckProps{Name: "color", Value: c, Color: c, Label: c, Light: c == "white", Checked: c == "white"})
					</div>
				}
			</div>
		}
		@form.Field(form.FieldProps{Label: "Color Input Radio", Fieldset: true}) {
			<div class="row g-2">
				for _, c := range swatchColors {
					<div class="col-auto">
						@form.ColorCheck(form.ColorCheckProps{Name: "color-rounded", Radio: true, Round: true, Value: c, Color: c, Label: c, Light: c == "white", Checked: c == "white"})
					</div>
				}
			</div>
		}
		@form.Field(form.FieldProps{Label: "Color picker", For: "fe3-color-picker"}) {
			@form.Input(form.InputProps{ID: "fe3-color-picker", Type: "color", Value: "#066fd1", Attributes: templ.Attributes{"title": "Choose your color"}})
		}
		@form.Field(form.FieldProps{Label: "Validation States"}) {
			@form.Input(form.InputProps{State: form.StateValid, Class: "mb-2", Placeholder: "Valid State..", Attributes: templ.Attributes{"aria-invalid": "false"}})
			@form.Input(form.InputProps{Invalid: true, Placeholder: "Invalid State..", AriaLabel: "Invalid state", Attributes: templ.Attributes{"aria-describedby": "validation-invalid-feedback"}})
			@form.Feedback(form.FeedbackProps{ID: "validation-invalid-feedback"}) {
				Invalid feedback
			}
		}
		@form.Field(form.FieldProps{Label: "Validation States (lite)"}) {
			@form.Input(form.InputProps{State: form.StateValid, Lite: true, Class: "mb-2", Placeholder: "Valid State..", Attributes: templ.Attributes{"aria-invalid": "false"}})
			@form.Input(form.InputProps{Invalid: true, Lite: true, Placeholder: "Invalid State..", AriaLabel: "Invalid state"})
		}
		@form.Field(form.FieldProps{Class: "-", Label: "Form fieldset"}) {
			@form.Fieldset(form.FieldsetProps{}) {
				@requiredField("Full name", "fe3-fieldset-name", "text", "name")
				@requiredField("Company", "fe3-fieldset-company", "text", "organization")
				@requiredField("Email", "fe3-fieldset-email", "email", "email")
				@form.Field(form.FieldProps{Label: "Phone number", For: "fe3-fieldset-phone"}) {
					@form.Input(form.InputProps{ID: "fe3-fieldset-phone", Type: "tel", Autocomplete: "tel"})
				}
				@form.Check(form.CheckProps{Label: "I agree to the Terms & Conditions", Required: true})
			}
		}
	</div>
}

templ requiredField(label, id, typ, autocomplete string) {
	@form.Field(form.FieldProps{Label: label, For: id, Required: true, RequiredLabel: " (required)"}) {
		@form.Input(form.InputProps{ID: id, Type: typ, Autocomplete: autocomplete, Attributes: templ.Attributes{"aria-required": "true"}})
	}
}

templ formElementsColumn4() {
	<div class="col-md-6 col-xl-12">
		@form.Field(form.FieldProps{Label: "Simple selectgroup", Fieldset: true}) {
			@form.SelectGroup() {
				@selectItems("name", false, "HTML", "CSS", "PHP", "JavaScript")
			}
		}
		@form.Field(form.FieldProps{Label: "Icon input", Fieldset: true}) {
			@form.SelectGroup() {
				for i, v := range []string{"sun", "moon", "cloud-rain", "cloud"} {
					@form.SelectItem(form.SelectItemProps{Name: "name", Value: v, Icon: "ti-" + v, Checked: i == 0})
				}
				@form.SelectItem(form.SelectItemProps{Name: "name", Value: "Other", Label: "Other"})
			}
		}
		@form.Field(form.FieldProps{Label: "Selectgroup with icons and text", Fieldset: true}) {
			@form.SelectGroup() {
				for i, v := range []string{"home", "user", "circle", "square"} {
					@form.SelectItem(form.SelectItemProps{Name: "icons", Radio: true, Value: v, Icon: "ti-" + v, Label: sparkLabel(v), Checked: i == 0})
				}
			}
		}
		@form.Field(form.FieldProps{Label: "Different style", Fieldset: true}) {
			@form.SelectGroup(form.SelectGroupProps{Pills: true}) {
				@selectItems("name", false, "HTML", "CSS", "PHP", "JavaScript")
			}
		}
		@form.Field(form.FieldProps{Label: "Payment method", Fieldset: true}) {
			@form.SelectGroup(form.SelectGroupProps{Boxes: true, Class: "d-flex flex-column"}) {
				for _, pm := range []struct{ Code, End string }{{"visa", "7998"}, {"mastercard", "1000"}, {"paypal", ""}} {
					@form.SelectItem(form.SelectItemProps{Class: "flex-fill", Name: "form-payment", Radio: true, Value: pm.Code, Box: true, Checked: pm.Code == "mastercard"}) {
						@payment.Payment(pm.Code, payment.Props{Size: payment.SizeXS, Class: "me-2"})
						if pm.End != "" {
							ending in <strong>{ pm.End }</strong>
						}
					}
				}
			}
		}
		@form.Field(form.FieldProps{Label: "Project Manager", Fieldset: true}) {
			@form.SelectGroup(form.SelectGroupProps{Boxes: true, Class: "d-flex flex-column"}) {
				for i, pm := range projectManagers {
					@form.SelectItem(form.SelectItemProps{Class: "flex-fill", Name: "form-project-manager[]", Value: strconv.Itoa(i + 1), Box: true, Checked: i == 1}) {
						<div class="form-selectgroup-label-content d-flex align-items-center">
							@avatar.Avatar(avatar.Props{Src: avatarURL(pm.Photo), Class: "me-3"})
							<div>
								<div class="fw-medium">{ pm.Name }</div>
								<div class="text-secondary">{ pm.Role }</div>
							</div>
						</div>
					}
				}
			}
		}
		@form.Field(form.FieldProps{Label: "Buttons group", Fieldset: true}) {
			@button.Group(button.GroupProps{Class: "w-100"}) {
				@radioButtons("btn-radio-basic", "1 min", "5 min", "10 min", "30 min")
			}
		}
		@form.Field(form.FieldProps{Label: "Buttons group with dropdown", Fieldset: true}) {
			@button.Group(button.GroupProps{Class: "w-100"}) {
				@radioButtons("btn-radio-dropdown", "Option 1", "Option 2")
				@otherMenu()
			}
		}
		<div class="row">
			<div class="col">
				@form.Field(form.FieldProps{Label: "Vertical buttons group", Fieldset: true}) {
					@button.Group(button.GroupProps{Vertical: true, Class: "w-100"}) {
						@radioButtons("btn-radio-vertical", "Button 1", "Button 2", "Button 3", "Button 4", "Button 5")
					}
				}
			</div>
			<div class="col">
				@form.Field(form.FieldProps{Label: "Vertical with dropdown", Fieldset: true}) {
					@button.Group(button.GroupProps{Vertical: true, Class: "w-100"}) {
						@radioButtons("btn-radio-vertical-dropdown", "Button 1", "Button 2", "Button 3", "Button 4")
						@otherMenu()
					}
				}
			</div>
		</div>
		@form.Field(form.FieldProps{Label: "Toolbar", Fieldset: true}) {
			@button.Group(button.GroupProps{Class: "w-100"}) {
				// button.Check has no icon; the toolbar's icon labels are written out here.
				for i, ic := range []string{"bold", "italic", "underline", "copy", "scissors", "file-plus", "file-minus"} {
					<input type="radio" class="btn-check" name="btn-radio-toolbar" id={ "btn-radio-toolbar-" + strconv.Itoa(i+1) } autocomplete="off" checked?={ i == 0 }/>
					<label for={ "btn-radio-toolbar-" + strconv.Itoa(i+1) } class="btn btn-icon">
						@icon.Icon("ti-" + ic)
					</label>
				}
			}
		}
	</div>
}

templ checks(radio bool, name string, inline bool, labels []string, checked, disabled []int) {
	for i, l := range labels {
		@form.Check(form.CheckProps{Radio: radio, Name: checkName(name, radio && !inline && has(disabled, i)), Inline: inline, Label: l, Checked: has(checked, i), Disabled: has(disabled, i)})
	}
}

templ formElementsColumn5() {
	<div class="col-md-6 col-xl-12">
		@form.Field(form.FieldProps{Label: "Radios", Fieldset: true}) {
			@checks(true, "radios", false, []string{"Option 1", "Option 2", "Option 3", "Option 4"}, []int{0, 3}, []int{2, 3})
		}
		@form.Field(form.FieldProps{Label: "Inline Radios", Fieldset: true}) {
			@checks(true, "radios-inline", true, []string{"Option 1", "Option 2", "Option 3"}, []int{0}, []int{2})
		}
		@form.Field(form.FieldProps{Label: "Checkboxes", Fieldset: true}) {
			@checks(false, "", false, []string{"Checkbox input", "Disabled checkbox input", "Checked checkbox input"}, []int{2}, []int{1})
		}
		@form.Field(form.FieldProps{Label: "Inline Checkboxes", Fieldset: true}) {
			@checks(false, "", true, []string{"Option 1", "Option 2", "Option 3"}, []int{2}, []int{1})
		}
		@form.Field(form.FieldProps{Label: "Checkboxes with description", Fieldset: true}) {
			@form.Check(form.CheckProps{Label: "Default checkbox", Description: "Lorem ipsum dolor sit amet, consectetur adipisicing elit."})
			@form.Check(form.CheckProps{Label: "Longer checkbox item that wraps on to two separate lines", Description: "Ab alias aut, consequuntur cumque esse eveniet incidunt laborum minus molestiae."})
			@form.Check(form.CheckProps{Label: "Default checkbox without description"})
		}
		@form.Field(form.FieldProps{Label: "Toggle switches", Fieldset: true}) {
			for i, l := range []string{"Option 1", "Option 2", "Option 3"} {
				@form.Check(form.CheckProps{Switch: true, Label: l, Checked: i == 0})
			}
		}
		@form.Field(form.FieldProps{Label: "Single switch"}) {
			@form.Check(form.CheckProps{Switch: true, Label: "I agree with terms and conditions"})
		}
		@form.Field(form.FieldProps{Label: "Notification", Fieldset: true}) {
			<div class="divide-y">
				for i, l := range []string{"Push Notifications", "SMS Notifications", "Email Notifications"} {
					<div>
						@form.Check(form.CheckProps{Row: true, Switch: true, Label: l, Checked: i != 1})
					</div>
				}
			</div>
		}
		@form.Field(form.FieldProps{Label: "Custom File Input"}) {
			@form.Input(form.InputProps{Type: "file"})
		}
		@form.Field(form.FieldProps{Label: "Date of birth"}) {
			<div class="row g-2">
				<div class="col-5">
					@form.Select(form.SelectProps{Name: "user[month]", AriaLabel: "Month", Empty: "Month", Options: monthOptions(), Selected: "6"})
				</div>
				<div class="col-3">
					@form.Select(form.SelectProps{Name: "user[day]", AriaLabel: "Day", Empty: "Day", Options: numberOptions(1, 31, 1), Selected: "20"})
				</div>
				<div class="col-4">
					@form.Select(form.SelectProps{Name: "user[year]", AriaLabel: "Year", Empty: "Year", Options: numberOptions(2014, 1897, -1), Selected: "1989"})
				</div>
			</div>
		}
		@form.Field(form.FieldProps{Label: "Text mask", For: "fe5-input-mask-date"}) {
			@maskInput("fe5-input-mask-date", "00/00/0000", "00/00/0000")
		}
		@form.Field(form.FieldProps{Label: "Telephone mask", For: "fe5-input-mask-tel"}) {
			@maskInput("fe5-input-mask-tel", "(00) 0000-0000", "(00) 0000-0000")
		}
		@form.Field(form.FieldProps{Label: "Password strength", For: "fe5-password-strength"}) {
			@form.Input(form.InputProps{ID: "fe5-password-strength", Type: "password", Placeholder: "Type a password…", Autocomplete: "new-password"})
			@form.Strength(form.StrengthProps{})
			@form.Text("fe5-password-strength-hint") {
				The meter rates the password as the user types. It is a hint, not a validation.
			}
		}
		@form.Field(form.FieldProps{Label: "API key", For: "fe5-clipboard-key"}) {
			@form.Group() {
				@form.Input(form.InputProps{ID: "fe5-clipboard-key", Value: "tblr_live_8f2c41d0a7", Readonly: true})
				@clipboard.Button(clipboard.Props{Target: "fe5-clipboard-key", Label: "Copy"})
			}
			@form.Text("fe5-clipboard-key-hint") {
				The copy button reads the value of the field next to it.
			}
		}
		@form.Field(form.FieldProps{Label: "Autosize textarea", For: "fe5-textarea-autosize"}) {
			@form.Textarea(form.TextareaProps{ID: "fe5-textarea-autosize", Autosize: true, Placeholder: "Type something…"})
		}
	</div>
}

templ formElementsColumn6() {
	<div class="col-md-6 col-xl-12">
		@form.Field(form.FieldProps{Label: "Datalist example", For: "fe6-datalist"}) {
			@form.Input(form.InputProps{ID: "fe6-datalist", List: "datalistOptions", Placeholder: "Type to search..."})
			@form.Datalist("datalistOptions", countries2FA[:10])
		}
		@form.Field(form.FieldProps{Label: "Range input"}) {
			@form.Range(form.RangeProps{Class: "mb-2", AriaLabel: "Default range", Value: 40, Max: 100, Step: 10})
			@rangeslider.Slider(rangeslider.Props{ID: "range-simple", Values: []float64{20}, Connect: true, Step: 10, Label: "Connected range"})
			@rangeslider.Slider(rangeslider.Props{ID: "range-connect", Values: []float64{60, 90}, Step: 10, Label: "Price range"})
			@rangeslider.Slider(rangeslider.Props{ID: "range-color", Class: "text-green", Values: []float64{40}, Connect: true, Step: 10, Label: "Colored range"})
		}
		@form.Field(form.FieldProps{Label: "Datepicker"}) {
			@datepickerInput("datepicker-default", "mb-2")
			@form.InputIcon(form.InputIconProps{Class: "mb-2", Icon: "ti-calendar"}) {
				@datepickerInput("datepicker-icon", "")
			}
			@form.InputIcon(form.InputIconProps{Icon: "ti-calendar", Start: true}) {
				@datepickerInput("datepicker-icon-prepend", "")
			}
		}
		@form.Field(form.FieldProps{Label: "Inline datepicker"}) {
			<div id="datepicker-inline" data-bs-toggle="datepicker" data-bs-inline="true"></div>
		}
		@form.Field(form.FieldProps{Label: "Progress"}) {
			@progress.Progress(progress.Props{Class: "mb-2", Value: 38})
			@progress.Progress(progress.Props{Indeterminate: true, Color: "green"})
		}
		@form.Field(form.FieldProps{Label: "Form buttons"}) {
			<div class="row">
				<div class="col">
					@button.Button(button.Props{Type: "button", Block: true, Icon: "ti-brand-github"}) {
						Login with Github
					}
				</div>
				<div class="col">
					@button.Button(button.Props{Type: "button", Block: true, Icon: "ti-brand-x"}) {
						Login with X
					}
				</div>
			</div>
		}
		@form.Field(form.FieldProps{Label: "Tags input", For: "select-fe6-tags"}) {
			@form.Select(form.SelectProps{ID: "select-fe6-tags", AriaLabel: "Tags input", Multiple: true, Options: plainOptions(tagNames...),
				SelectedValues: []string{"HTML", "JavaScript", "Bootstrap"}, Attributes: kit.Attrs(templ.Attributes{"data-placeholder": "Select tags"}, selectbox.Attrs(nil))})
		}
		@form.Field(form.FieldProps{Label: "Advanced select", For: "select-fe6-advanced-select"}) {
			@form.Select(form.SelectProps{Attributes: selectbox.Attrs(nil), ID: "select-fe6-advanced-select", AriaLabel: "Advanced select", Options: options("1", "Chuck Tesla", "2", "Elon Musk", "3", "Paweł Kuna", "4", "Nikola Tesla"), Selected: "3"})
		}
		@form.Field(form.FieldProps{Label: "Advanced select with optgroup", For: "select-fe6-select-optgroup"}) {
			@form.Select(form.SelectProps{Attributes: selectbox.Attrs(nil), ID: "select-fe6-select-optgroup", AriaLabel: "Advanced select with optgroup",
				Groups: []form.OptionGroup{{Label: "Tags", Options: plainOptions(tagNames...)}, {Label: "People", Options: plainOptions(peopleNames...)}}})
		}
		@form.Field(form.FieldProps{Label: "Select with avatars", For: "select-fe6-select-avatars"}) {
			@form.Select(form.SelectProps{Attributes: selectbox.Attrs(nil), ID: "select-fe6-select-avatars", AriaLabel: "Select with avatars", Options: avatarOptions(), Selected: "4"})
		}
		@form.Field(form.FieldProps{Label: "Select with flags", For: "select-fe6-select-flags"}) {
			@form.Select(form.SelectProps{Attributes: selectbox.Attrs(nil), ID: "select-fe6-select-flags", AriaLabel: "Select with flags", Options: flagOptions(), Selected: "pl"})
		}
		@form.Field(form.FieldProps{Label: "Select with labels", For: "select-fe6-select-labels"}) {
			@form.Select(form.SelectProps{Attributes: selectbox.Attrs(nil), ID: "select-fe6-select-labels", AriaLabel: "Select with labels", Selected: "paste",
				Options: custom(options("copy", "Copy", "paste", "Paste", "cut", "Cut"),
					`<span class="badge bg-primary-lt">cmd + C</span>`, `<span class="badge bg-primary-lt">cmd + V</span>`, `<span class="badge bg-primary-lt">cmd + X</span>`)})
		}
		@form.Field(form.FieldProps{Label: "Select with priority", For: "select-fe6-select-priority"}) {
			@form.Select(form.SelectProps{Attributes: selectbox.Attrs(nil), ID: "select-fe6-select-priority", AriaLabel: "Select with priority", Selected: "normal",
				Options: custom(options("urgent", "Urgent", "normal", "Normal", "low", "Low", "none", "No priority"),
					signalHTML("orange", 3), signalHTML("blue", 2), signalHTML("green", 1), signalHTML("", 0))})
		}
		@form.Field(form.FieldProps{Label: "Advanced select with validation state"}) {
			@form.Select(form.SelectProps{Attributes: selectbox.Attrs(nil), ID: "select-countries-valid", AriaLabel: "Country (valid)", Class: "mb-3", State: form.StateValid, Options: flagCountries, Selected: "pl"})
			@form.Select(form.SelectProps{Attributes: selectbox.Attrs(nil), ID: "select-countries-invalid", AriaLabel: "Country (invalid)", Invalid: true, Options: flagCountries, Selected: "pl"})
		}
	</div>
}

templ formElementsCard() {
	<form action="https://httpbin.org/post" method="post" class="card">
		@card.Header() {
			@card.Title() {
				Form elements
			}
		}
		@card.Body() {
			<div class="row g-5">
				<div class="col-xl-4">
					<div class="row">
						@formElementsColumn1()
						@formElementsColumn2()
					</div>
				</div>
				<div class="col-xl-4">
					<div class="row">
						@formElementsColumn3()
						@formElementsColumn4()
					</div>
				</div>
				<div class="col-xl-4">
					<div class="row">
						@formElementsColumn5()
						@formElementsColumn6()
					</div>
				</div>
			</div>
		}
		@card.Footer(card.Props{Class: "text-end"}) {
			<div class="d-flex">
				@button.Button(button.Props{Href: "#", Variant: button.VariantLink}) {
					Cancel
				}
				@button.Button(button.Props{Type: "submit", Variant: button.VariantPrimary, Class: "ms-auto"}) {
					Send data
				}
			</div>
		}
	</form>
}

templ headerCardTitle(title string) {
	@card.Header() {
		@card.Title() {
			{ title }
		}
	}
}

templ submitFooter(label string) {
	@card.Footer(card.Props{Class: "text-end"}) {
		@button.Button(button.Props{Type: "submit", Variant: button.VariantPrimary}) {
			{ label }
		}
	}
}

// basicFormFields are the fields of the preview's "Basic form", stacked or Horizontal.
templ basicFormFields(horizontal bool, suffix string) {
	@form.Field(form.FieldProps{Label: "Email address", For: "form-layout-email" + suffix, Required: true, Horizontal: horizontal}) {
		@wrapIf(!horizontal) {
			@form.Input(form.InputProps{ID: "form-layout-email" + suffix, Type: "email", Placeholder: "Enter email", Autocomplete: "email",
				Attributes: templ.Attributes{"aria-describedby": "form-layout-email-hint" + suffix, "aria-required": "true"}})
			@form.Text("form-layout-email-hint" + suffix) {
				We'll never share your email with anyone else.
			}
		}
	}
	@form.Field(form.FieldProps{Label: "Password", For: "form-layout-password" + suffix, Required: true, Horizontal: horizontal}) {
		@wrapIf(!horizontal) {
			@form.Input(form.InputProps{ID: "form-layout-password" + suffix, Type: "password", Placeholder: "Password", Autocomplete: "new-password",
				Attributes: templ.Attributes{"aria-describedby": "form-layout-password-hint" + suffix, "aria-required": "true"}})
			@form.Text("form-layout-password-hint" + suffix) {
				Your password must be 8-20 characters long, contain letters and numbers, and must not contain spaces, special characters, or emoji.
			}
		}
	}
	@form.Field(form.FieldProps{Label: "Select", For: "form-layout-select" + suffix, Horizontal: horizontal}) {
		@wrapIf(!horizontal) {
			@form.Select(form.SelectProps{ID: "form-layout-select" + suffix, Options: plainOptions("Option 1", "Option 2", "Option 3", "Option 4"),
				Groups: []form.OptionGroup{{Label: "Optgroup 1", Options: plainOptions("Option 1", "Option 2")}, {Label: "Optgroup 2", Options: plainOptions("Option 1", "Option 2")},
					{Label: "Optgroup 3", Options: plainOptions("Option 1", "Option 2")}}})
		}
	}
	@form.Field(form.FieldProps{Label: "Checkboxes", Fieldset: true, Horizontal: horizontal, Class: kitIf(horizontal, "-")}) {
		@checks(false, "", false, []string{"Option 1", "Option 2", "Option 3"}, []int{0}, []int{2})
	}
}

// wrapIf puts the children into a <div>, like the preview's stacked fields.
templ wrapIf(wrap bool) {
	if wrap {
		<div>
			{ children... }
		</div>
	} else {
		{ children... }
	}
}

templ wrappedInput(label string, p form.InputProps) {
	@form.Field(form.FieldProps{Label: label, Wrap: true}) {
		@form.Input(p)
	}
}

templ formElementsPage() {
	@previewLibs("form-elements", rangeslider.Library(), datepicker.Library(), selectbox.Library(), inputmask.Library()) {
		@paymentStyles()
		<div class="row row-cards">
			<div class="col-12">
				@formElementsCard()
			</div>
			<div class="col-md-6">
				@card.Card(card.Props{Class: "h-100"}) {
					@card.Body() {
						@card.Title() {
							Project ID
						}
						@card.Subtitle() {
							Used when interacting with the API.
						}
						@form.InputIcon(form.InputIconProps{Icon: "ti-files"}) {
							@form.Input(form.InputProps{Value: "prj_5ae74426fe935327a8fa178b07d84ad9", Placeholder: "Search…", Readonly: true})
						}
					}
					@card.Footer() {
						<div class="row align-items-center">
							<div class="col">Learn more about <a href="#">Project ID</a></div>
							<div class="col-auto">
								@button.Button(button.Props{Type: "button", Variant: button.VariantPrimary}) {
									Save
								}
							</div>
						</div>
					}
				}
			</div>
			<div class="col-md-6">
				@card.Card() {
					@card.Body() {
						@card.Title() {
							Node.js Version
						}
						@card.Subtitle() {
							The version of Node.js that is used in the Build Step and for Serverless Functions. A new Deployment is required for your changes to take effect.
						}
						@form.Select(form.SelectProps{AriaLabel: "Node.js version", Options: plainOptions("14.x", "12.x")})
					}
					@card.Footer() {
						Learn more about <a href="#">Node.js Version</a>
					}
				}
			</div>
			<div class="col-12 col-lg-4">
				<form class="card h-100">
					@headerCardTitle("Basic form")
					@card.Body() {
						@basicFormFields(false, "")
					}
					@submitFooter("Submit")
				</form>
			</div>
			<div class="col-lg-8">
				<div class="row row-cards">
					<div class="col-12 col-lg-6">
						@card.Card() {
							@headerCardTitle("Input mask")
							@card.Body() {
								@maskField("Date", "00/00/0000", "00/00/0000", false)
								@maskField("Hour", "00:00:00", "00:00:00", false)
								@maskField("Date & Hour", "00/00/0000 00:00:00", "00/00/0000 00:00:00", false)
								@maskField("ZIP Code", "00000-000", "00000-000", false)
								@maskField("Money", "000.000.000.000.000,00", "000.000.000.000.000,00", true)
								@maskField("Telephone", "0000-0000", "0000-0000", false)
								@maskField("Telephone with Code Area", "(00) 0000-0000", "(00) 0000-0000", false)
								@maskField("IP Address", "099.099.099.099", "000.000.000.000", false)
							}
						}
					</div>
					<div class="col-12 col-lg-6">
						@card.Card() {
							@headerCardTitle("OTP input")
							@card.Body() {
								@form.Field(form.FieldProps{Label: "Basic", For: "otp-basic"}) {
									@form.OTP(form.OTPProps{ID: "otp-basic", Length: 6})
								}
								@form.Field(form.FieldProps{Label: "Sizes"}) {
									<div class="space-y">
										@form.OTP(form.OTPProps{ID: "otp-sm", Length: 4, Size: form.SizeSmall, AriaLabel: "Sizes small"})
										@form.OTP(form.OTPProps{ID: "otp-lg", Length: 4, Size: form.SizeLarge, AriaLabel: "Sizes large"})
									</div>
								}
								@form.Field(form.FieldProps{Label: "Groups & separator", For: "otp-groups"}) {
									@form.OTP(form.OTPProps{ID: "otp-groups", Length: 6, Groups: []int{3, 3}})
								}
								@form.Field(form.FieldProps{Label: "Alphanumeric & masked", For: "otp-alphanumeric"}) {
									@form.OTP(form.OTPProps{ID: "otp-alphanumeric", Length: 6, Type: form.OTPAlphanumeric, Mask: true})
								}
								@form.Field(form.FieldProps{Label: "Connected", For: "otp-connected"}) {
									@form.OTP(form.OTPProps{ID: "otp-connected", Length: 6, Connected: true})
								}
								@form.Field(form.FieldProps{Label: "Disabled", For: "otp-disabled"}) {
									@form.OTP(form.OTPProps{ID: "otp-disabled", Length: 6, Value: "123456", Disabled: true})
								}
							}
						}
					</div>
					<div class="col-12 col-lg-6">
						@card.Card() {
							@headerCardTitle("Number input")
							@card.Body() {
								@form.Field(form.FieldProps{Label: "Quantity", For: "number-input-basic"}) {
									@form.NumberInput(form.NumberInputProps{ID: "number-input-basic", Value: "1", Min: "1", Max: "99"})
								}
								@form.Field(form.FieldProps{Label: "Step of 0.25", For: "number-input-decimal"}) {
									@form.NumberInput(form.NumberInputProps{ID: "number-input-decimal", Value: "1.5", Min: "0", Max: "10", Step: "0.25"})
								}
								@form.Field(form.FieldProps{Label: "Without bounds", For: "number-input-unbounded"}) {
									@form.NumberInput(form.NumberInputProps{ID: "number-input-unbounded", Value: "0"})
								}
								@form.Field(form.FieldProps{Label: "Native number input", For: "number-input-number"}) {
									@form.NumberInput(form.NumberInputProps{ID: "number-input-number", Value: "5", Min: "0", Max: "10", Number: true})
								}
								@form.Field(form.FieldProps{Label: "Disabled", For: "number-input-disabled"}) {
									@form.NumberInput(form.NumberInputProps{ID: "number-input-disabled", Value: "3", Disabled: true})
								}
							}
						}
					</div>
					<div class="col-12 col-lg-6">
						<form class="card h-100">
							@headerCardTitle("My Profile")
							@card.Body() {
								<div class="mb-3">
									<div class="row">
										<div class="col-auto">
											@avatar.Avatar(avatar.Props{Src: avatarURL("002m"), Size: avatar.SizeMedium})
										</div>
										<div class="col">
											@wrappedInput("Email-Address", form.InputProps{Placeholder: "your-email@domain.com"})
										</div>
									</div>
								</div>
								@form.Field(form.FieldProps{Label: "Bio", Wrap: true}) {
									@form.Textarea(form.TextareaProps{Rows: 5, Value: "Big belly rude boy, million dollar hustler. Unemployed."})
								}
								@wrappedInput("Email-Address", form.InputProps{Placeholder: "your-email@domain.com"})
								@wrappedInput("Password", form.InputProps{Type: "password", Value: "password", Autocomplete: "current-password"})
							}
							@submitFooter("Save")
						</form>
					</div>
				</div>
			</div>
			<div class="col-lg-12">
				<div class="row row-cards">
					<div class="col-12 col-lg-6">
						@editProfileCard()
					</div>
					<div class="col-12 col-lg-6">
						@httpRequestCard()
					</div>
				</div>
			</div>
		</div>
		@form.PasswordToggleScript()
	}
}

templ maskField(label, mask, placeholder string, reverse bool) {
	@form.Field(form.FieldProps{Label: label, Wrap: true}) {
		@form.Input(form.InputProps{Name: "input-mask", Placeholder: placeholder, Autocomplete: "off", Attributes: maskAttrs(mask, reverse)})
	}
}

templ profileCol(class, label string, p form.InputProps) {
	<div class={ class }>
		@wrappedInput(label, p)
	</div>
}

templ editProfileCard() {
	<form class="card">
		@card.Body() {
			@card.Title() {
				Edit Profile
			}
			<div class="row row-cards">
				@profileCol("col-md-5", "Company", form.InputProps{Disabled: true, Placeholder: "Company", Value: "Creative Code Inc."})
				@profileCol("col-sm-6 col-md-3", "Username", form.InputProps{Placeholder: "Username", Value: "michael23"})
				@profileCol("col-sm-6 col-md-4", "Email address", form.InputProps{Type: "email", Placeholder: "Email"})
				@profileCol("col-sm-6 col-md-6", "First Name", form.InputProps{Placeholder: "Company", Value: "Chet"})
				@profileCol("col-sm-6 col-md-6", "Last Name", form.InputProps{Placeholder: "Last Name", Value: "Faker"})
				@profileCol("col-md-12", "Address", form.InputProps{Placeholder: "Home Address", Value: "Melbourne, Australia"})
				@profileCol("col-sm-6 col-md-4", "City", form.InputProps{Placeholder: "City", Value: "Melbourne"})
				@profileCol("col-sm-6 col-md-3", "Postal Code", form.InputProps{Placeholder: "ZIP Code"})
				<div class="col-md-5">
					@form.Field(form.FieldProps{Label: "Country", Wrap: true}) {
						@form.Select(form.SelectProps{Class: "form-control", AriaLabel: "Country", Empty: "Germany"})
					}
				</div>
				<div class="col-md-12">
					@form.Field(form.FieldProps{Class: "mb-3 mb-0", Label: "About Me", Wrap: true}) {
						@form.Textarea(form.TextareaProps{Rows: 5, Placeholder: "Here can be your description",
							Value: "Oh so, your weak rhyme You doubt I'll bother, reading into it I'll probably won't, left to my own devices But that's the difference in our opinions."})
					}
				</div>
			</div>
		}
		@submitFooter("Update Profile")
	</form>
}

var assertionSources = options("STATUS_CODE", "Status code", "JSON_BODY", "JSON body", "HEADERS", "Headers", "TEXT_BODY", "Text body", "RESPONSE_TIME", "Response time")
var assertionComparisons = options("EQUALS", "Equals", "NOT_EQUALS", "Not equals", "HAS_KEY", "Has key", "NOT_HAS_KEY", "Not has key", "HAS_VALUE", "Has value",
	"NOT_HAS_VALUE", "Not has value", "IS_EMPTY", "Is empty", "NOT_EMPTY", "Is not empty", "GREATER_THAN", "Greater than", "LESS_THAN", "Less than")

var assertions = []struct{ Source, Property, Comparison, Target string }{
	{"STATUS_CODE", "", "EQUALS", "200"},
	{"JSON_BODY", "parameters.alt.type", "HAS_VALUE", "string"},
	{"RESPONSE_TIME", "", "LESS_THAN", "500"},
	{"HEADERS", "content-type", "EQUALS", "application/json; charset=UTF-8"},
}

templ httpRequestCard() {
	@card.Card(card.Props{Class: "h-100"}) {
		@headerCardTitle("HTTP Request")
		@card.Body() {
			<div class="row row-cards">
				@form.Field(form.FieldProps{Class: "mb-3 col-sm-4 col-md-2", Label: "Method", Required: true, RequiredLabel: " (required)", Wrap: true}) {
					@form.Select(form.SelectProps{AriaLabel: "Method", Options: plainOptions("GET", "POST", "PUT", "HEAD", "DELETE", "PATCH")})
				}
				@form.Field(form.FieldProps{Class: "mb-3 col-sm-8 col-md-10", Label: "URL", Required: true, RequiredLabel: " (required)", Wrap: true}) {
					@form.Input(form.InputProps{Name: "url", Value: "https://content.googleapis.com/discovery/v1/apis/surveys/v2/rest"})
				}
			</div>
			@form.Field(form.FieldProps{Class: "-", Label: "Assertions"}) {
				@table.Table(table.Props{Responsive: true, Class: "mb-0"}) {
					<thead>
						<tr>
							<th>Source</th>
							<th>Property</th>
							<th>Comparison</th>
							<th>Target</th>
						</tr>
					</thead>
					<tbody>
						for _, a := range assertions {
							<tr>
								<td>
									@form.Select(form.SelectProps{AriaLabel: "Source", Options: assertionSources, Selected: a.Source})
								</td>
								<td>
									@form.Input(form.InputProps{AriaLabel: "Property", Value: a.Property})
								</td>
								<td>
									@form.Select(form.SelectProps{AriaLabel: "Comparison", Options: assertionComparisons, Selected: a.Comparison})
								</td>
								<td>
									@form.Input(form.InputProps{AriaLabel: "Target", Value: a.Target})
								</td>
							</tr>
						}
					</tbody>
				}
			}
		}
		@submitFooter("Make request")
	}
}

// ---------------------------------------------------------------- form layout
templ subtitledHeader(title, subtitle string) {
	@card.Header() {
		<div>
			@card.Title() {
				{ title }
			}
			@card.Subtitle() {
				{ subtitle }
			}
		</div>
	}
}

templ hiddenLabelField(class, label string, p form.InputProps) {
	@form.Field(form.FieldProps{Class: class, Label: label, For: p.ID, LabelHidden: true}) {
		@form.Input(p)
	}
}

templ plainField(label string, p form.InputProps) {
	@form.Field(form.FieldProps{Class: "-", Label: label, For: p.ID}) {
		@form.Input(p)
	}
}

templ iconField(ic string, p form.InputProps) {
	<div>
		@form.InputIcon(form.InputIconProps{Icon: ic, Start: true}) {
			@form.Input(p)
		}
	</div>
}

templ formLayoutPage() {
	@previewLibs("form-layout", datepicker.Library()) {
		<div class="row row-cards row-cols-1 row-cols-md-3">
			<div class="col">
				<div class="row row-cards">
					<div class="col-12">
						@card.Card() {
							@subtitledHeader("Basic Form", "A minimal sign-up form with just the essentials.")
							@card.Body() {
								<form class="space-y">
									<div class="row">
										@hiddenLabelField("col-6", "Name", form.InputProps{ID: "basic-name", Name: "name", Placeholder: "Name"})
										@hiddenLabelField("col-6", "Email address", form.InputProps{ID: "basic-email", Name: "email", Type: "email", Placeholder: "Email address"})
									</div>
									@hiddenLabelField("-", "Password", form.InputProps{ID: "basic-password", Name: "password", Type: "password", Placeholder: "Password", Autocomplete: "new-password"})
									@hiddenLabelField("-", "Confirm Password", form.InputProps{ID: "basic-password-confirm", Name: "password_confirm", Type: "password", Placeholder: "Confirm Password", Autocomplete: "new-password"})
									<div>
										@button.Button(button.Props{Type: "submit", Variant: button.VariantPrimary, Block: true}) {
											Submit
										}
									</div>
								</form>
							}
						}
					</div>
					<div class="col-12">
						@card.Card() {
							@subtitledHeader("Example Form", "A contact form with a subject select and a message field.")
							@card.Body() {
								<form>
									<div class="space-y">
										@plainField("First Name", form.InputProps{ID: "example-first-name", Name: "first_name", Placeholder: "Enter first name"})
										@plainField("Last Name", form.InputProps{ID: "example-last-name", Name: "last_name", Placeholder: "Enter last name"})
										@plainField("Email", form.InputProps{ID: "example-email", Name: "email", Type: "email", Placeholder: "Enter email address"})
										@form.Field(form.FieldProps{Class: "-", Label: "Select Subject", For: "example-subject"}) {
											@form.Select(form.SelectProps{ID: "example-subject", Name: "subject", Options: plainOptions("Option 1", "Option 2", "Option 3", "Option 4")})
										}
										@form.Field(form.FieldProps{Class: "-", Label: "Message", For: "example-message"}) {
											@form.Textarea(form.TextareaProps{ID: "example-message", Name: "message", Rows: 6, Placeholder: "Enter your message"})
										}
										<div>
											@button.Button(button.Props{Type: "submit", Variant: button.VariantPrimary, Block: true, IconEnd: "ti-arrow-right"}) {
												Send Message
											}
										</div>
									</div>
								</form>
							}
						}
					</div>
				</div>
			</div>
			<div class="col">
				<div class="row row-cards">
					<div class="col-12">
						@card.Card() {
							@subtitledHeader("Example Form with Icons", "Prefix each field with an icon for a friendlier sign-up flow.")
							@card.Body() {
								<form class="space-y">
									@iconField("ti-user", form.InputProps{Placeholder: "Username"})
									@iconField("ti-mail", form.InputProps{Type: "email", Placeholder: "Email address"})
									@iconField("ti-lock", form.InputProps{Type: "password", Placeholder: "Password", Autocomplete: "new-password"})
									@iconField("ti-lock", form.InputProps{Type: "password", Placeholder: "Confirm Password", Autocomplete: "new-password"})
									<div>
										<div class="row align-items-center">
											<div class="col">
												@form.Check(form.CheckProps{Class: "m-0", Label: "Remember me"})
											</div>
											<div class="col-auto">
												@button.Button(button.Props{Type: "submit", Variant: button.VariantPrimary, IconEnd: "ti-arrow-right"}) {
													Create Account
												}
											</div>
										</div>
									</div>
								</form>
							}
						}
					</div>
					<div class="col-12">
						@card.Card() {
							@subtitledHeader("Form with Icons and Validation", "Pair an icon input with valid and invalid feedback states.")
							@card.Body() {
								<form class="space-y">
									<div>
										@form.InputIcon(form.InputIconProps{Icon: "ti-user", Start: true}) {
											@form.Input(form.InputProps{Invalid: true, Placeholder: "Username", AriaLabel: "Username", Attributes: templ.Attributes{"aria-describedby": "username-invalid-feedback"}})
											@form.Feedback(form.FeedbackProps{ID: "username-invalid-feedback"}) {
												{ "This throws the icon out of bounds when input element contains `is-invalid` class." }
											}
										}
									</div>
									<div>
										@form.InputIcon(form.InputIconProps{Icon: "ti-mail", Start: true}) {
											@form.Input(form.InputProps{Type: "email", State: form.StateValid, Placeholder: "Email", AriaLabel: "Email",
												Attributes: templ.Attributes{"aria-invalid": "false", "aria-describedby": "email-valid-feedback"}})
											@form.Feedback(form.FeedbackProps{ID: "email-valid-feedback", Valid: true}) {
												This email looks good!
											}
										}
									</div>
								</form>
							}
						}
					</div>
					<div class="col-12">
						<form class="card h-100">
							@headerCardTitle("Horizontal form")
							@card.Body() {
								@basicFormFields(true, "-horizontal")
							}
							@card.Footer() {
								<div class="text-end">
									@button.Button(button.Props{Type: "submit", Variant: button.VariantPrimary}) {
										Submit
									}
								</div>
							}
						</form>
					</div>
					<div class="col-12">
						@card.Card() {
							@subtitledHeader("Example Form", "A longer profile form grouped into personal info and address sections.")
							@card.Body() {
								<form>
									<div class="space-y">
										<div><h3 class="h4">Personal Info</h3></div>
										<div class="row row-cols-2 g-4">
											@plainField("First Name", form.InputProps{ID: "example-form-first-name", Placeholder: "Enter first name", Autocomplete: "given-name"})
											@plainField("Last Name", form.InputProps{ID: "example-form-last-name", Placeholder: "Enter last name", Autocomplete: "family-name"})
											@form.Field(form.FieldProps{Class: "-", Label: "Gender", For: "example-form-gender"}) {
												<div>
													@form.Select(form.SelectProps{ID: "example-form-gender", Options: plainOptions("Male", "Female", "Others")})
												</div>
											}
											@form.Field(form.FieldProps{Class: "-", Label: "Date of Birth", For: "datepicker-birth-date"}) {
												<div>
													@form.InputIcon(form.InputIconProps{Icon: "ti-calendar"}) {
														@datepickerInput("datepicker-birth-date", "")
													}
												</div>
											}
										</div>
										@form.Field(form.FieldProps{Class: "-", Label: "Category", For: "example-form-category"}) {
											<div>
												@form.Select(form.SelectProps{ID: "example-form-category", Options: plainOptions("Category 1", "Category 2", "Category 3")})
											</div>
										}
										<div><h3 class="h4">Address</h3></div>
										@plainField("Street", form.InputProps{ID: "example-form-street", Autocomplete: "address-line1"})
										<div class="row row-cols-2 g-4">
											@plainField("City", form.InputProps{ID: "example-form-city", Autocomplete: "address-level2"})
											@plainField("State", form.InputProps{ID: "example-form-state", Autocomplete: "address-level1"})
											@plainField("Post Code", form.InputProps{ID: "example-form-postcode", Autocomplete: "postal-code"})
											@form.Field(form.FieldProps{Class: "-", Label: "Country", For: "example-form-country"}) {
												<div>
													@form.Select(form.SelectProps{ID: "example-form-country", Empty: "--Select Country--", Options: plainOptions(countries2FA...),
														Attributes: templ.Attributes{"autocomplete": "country-name"}})
												</div>
											}
										</div>
										<div>
											@form.Field(form.FieldProps{Class: "-", Label: "Membership"}) {
												<div class="d-flex flex-row gap-4">
													@form.Check(form.CheckProps{Radio: true, Name: "membership", Label: "Free", Checked: true})
													@form.Check(form.CheckProps{Radio: true, Name: "membership", Label: "Paid"})
												</div>
											}
										</div>
										@button.List(button.ListProps{Class: "justify-content-end"}) {
											@button.Button(button.Props{Type: "button"}) {
												Cancel
											}
											@button.Button(button.Props{Type: "submit", Variant: button.VariantPrimary}) {
												Save Changes
											}
										}
									</div>
								</form>
							}
						}
					</div>
				</div>
			</div>
			<div class="col">
				<form class="card">
					@card.Body() {
						@card.Title() {
							Payment Method
						}
						@card.Subtitle(card.Props{Class: "mb-4"}) {
							All transactions are secure and encrypted
						}
						@form.Field(form.FieldProps{Label: "Name on Card", For: "payment-form-name"}) {
							@form.Input(form.InputProps{ID: "payment-form-name", Placeholder: "John Doe", Autocomplete: "cc-name"})
						}
						<div class="row">
							<div class="col-8">
								@form.Field(form.FieldProps{Label: "Card Number", For: "payment-form-number"}) {
									@form.Input(form.InputProps{ID: "payment-form-number", Placeholder: "1234 5678 9012 3456", Autocomplete: "cc-number", Attributes: templ.Attributes{"aria-describedby": "payment-form-number-hint"}})
									@form.Text("payment-form-number-hint") {
										Enter your 16-digit number.
									}
								}
							</div>
							<div class="col-4">
								@form.Field(form.FieldProps{Label: "CVV", For: "payment-form-cvv"}) {
									@form.Input(form.InputProps{ID: "payment-form-cvv", Placeholder: "123", Autocomplete: "cc-csc"})
								}
							</div>
						</div>
						<div class="row">
							<div class="col-6">
								@form.Field(form.FieldProps{Label: "Month", For: "payment-form-exp-month"}) {
									@form.Select(form.SelectProps{ID: "payment-form-exp-month", Empty: "MM", Options: monthOptions(), Attributes: templ.Attributes{"autocomplete": "cc-exp-month"}})
								}
							</div>
							<div class="col-6">
								@form.Field(form.FieldProps{Label: "Year", For: "payment-form-exp-year"}) {
									@form.Select(form.SelectProps{ID: "payment-form-exp-year", Empty: "YYYY", Options: numberOptions(2025, 2030, 1), Attributes: templ.Attributes{"autocomplete": "cc-exp-year"}})
								}
							</div>
						</div>
						<hr class="my-4"/>
						@card.Title() {
							Billing Address
						}
						@card.Subtitle(card.Props{Class: "mb-4"}) {
							The billing address associated with your payment method
						}
						<div class="mb-3">
							@form.Check(form.CheckProps{Label: "Same as shipping address", Checked: true})
						</div>
						<hr class="my-4"/>
						@form.Field(form.FieldProps{Label: "Comments", For: "payment-form-comments"}) {
							@form.Textarea(form.TextareaProps{ID: "payment-form-comments", Rows: 3, Placeholder: "Add any additional comments"})
						}
						<div class="mt-4">
							@button.List() {
								@button.Button(button.Props{Type: "submit", Variant: button.VariantPrimary}) {
									Submit
								}
								@button.Button(button.Props{Type: "button"}) {
									Cancel
								}
							}
						</div>
					}
				</form>
			</div>
		</div>
	}
}
