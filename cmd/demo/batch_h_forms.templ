			@form.Input(form.InputProps{Plaintext: true, Readonly: true, Value: "Input value"})
		}
		@form.Field(form.FieldProps{Label: "Text", For: "fe1-text"}) {
			@form.Input(form.InputProps{ID: "fe1-text", Name: "example-text-input", Placeholder: "Input placeholder"})
		}
		@form.Field(form.FieldProps{Label: "Password", For: "fe1-password"}) {
			@form.Input(form.InputProps{ID: "fe1-password", Type: "password", Name: "example-password-input", Placeholder: "Input placeholder", Autocomplete: "current-password"})
		}
		@form.Field(form.FieldProps{Label: "Disabled", For: "fe1-disabled"}) {
			@form.Input(form.InputProps{ID: "fe1-disabled", Name: "example-disabled-input", Placeholder: "Disabled...", Value: "Well, she turned me into a newt.", Disabled: true})
		}
		@form.Field(form.FieldProps{Label: "Readonly", For: "fe1-readonly"}) {
			@form.Input(form.InputProps{ID: "fe1-readonly", Name: "example-disabled-input", Placeholder: "Readonly...", Value: "Well, how'd you become king, then?", Readonly: true})
		}
		@form.Field(form.FieldProps{Label: "Required", For: "fe1-required", Required: true, RequiredLabel: " (required)"}) {
			@form.Input(form.InputProps{ID: "fe1-required", Name: "example-required-input", Placeholder: "Required...", Attributes: templ.Attributes{"aria-required": "true"}})
		}
		@form.Field(form.FieldProps{Label: "Textarea", For: "fe1-textarea", Description: "56/100"}) {
			@form.Textarea(form.TextareaProps{ID: "fe1-textarea", Name: "example-textarea-input", Rows: 6, Placeholder: "Content..",
				Value: "Oh! Come and see the violence inherent in the system! Help, help, I'm being repressed! We shall say 'Ni' again to you, if you do not appease us. I'm not a witch. I'm not a witch. Camelot!"})
		}
		@form.Field(form.FieldProps{Label: "Select"}) {
			@form.Select(form.SelectProps{AriaLabel: "Select", Options: options("1", "One", "2", "Two", "3", "Three")})
		}
		@form.Field(form.FieldProps{Label: "Select multiple"}) {
			@form.Select(form.SelectProps{AriaLabel: "Select multiple", Multiple: true, Options: options("1", "One", "2", "Two", "3", "Three")})
		}
		@form.Field(form.FieldProps{Label: "Select multiple states"}) {
			@form.Select(form.SelectProps{ID: "select-states", AriaLabel: "Select multiple states", Multiple: true, Options: usStates, SelectedValues: []string{"AZ", "SC", "WY"},
				Attributes: kit.Attrs(templ.Attributes{"value": ""}, selectbox.Attrs(map[string]any{"controlInput": "<input>"}))})
		}
		@form.Field(form.FieldProps{Label: "Input group"}) {
			@form.Group(form.GroupProps{Class: "mb-2"}) {
				@form.Input(form.InputProps{Placeholder: "Search for…"})
				@button.Button(button.Props{Type: "button"}) {
					Go!
				}
			}
			@form.Group() {
				@dropdown.Toggle(button.Props{Attributes: templ.Attributes{"aria-haspopup": "true"}}) {
					Action
				}
				@dropdown.Menu() {
					@moreActions()
				}
				@form.Input(form.InputProps{AriaLabel: "Text input with dropdown button"})
			}
		}
		@form.Field(form.FieldProps{Label: "Input group buttons", For: "fe1-input-group-buttons"}) {
			@form.Group() {
				@form.Input(form.InputProps{ID: "fe1-input-group-buttons"})
				@button.Button(button.Props{Type: "button"}) {
					Action
				}
				@dropdown.Toggle(button.Props{Class: "dropdown-toggle-split", Attributes: templ.Attributes{"aria-label": "Toggle dropdown"}})
				@dropdown.Menu(dropdown.MenuProps{End: true}) {
					@moreActions()
				}
			}
		}
		@form.Field(form.FieldProps{Label: "Icon input"}) {
			@form.InputIcon(form.InputIconProps{Class: "mb-3", Icon: "ti-search"}) {
				@form.Input(form.InputProps{Placeholder: "Search…"})
			}
			@form.InputIcon(form.InputIconProps{Class: "mb-3", Icon: "ti-user", Start: true}) {
				@form.Input(form.InputProps{Placeholder: "Username"})
			}
		}
		@form.Field(form.FieldProps{Label: "Loader input"}) {
			@form.InputIcon(form.InputIconProps{Class: "mb-3", Loader: true}) {
				@form.Input(form.InputProps{Placeholder: "Loading…"})
			}
			@form.InputIcon(form.InputIconProps{Class: "mb-3", Loader: true, Start: true}) {
				@form.Input(form.InputProps{Placeholder: "Loading…"})
			}
		}
		@form.Field(form.FieldProps{Label: "Separated inputs", For: "fe1-separated-input"}) {
			<div class="row g-2">
				<div class="col">
					@form.Input(form.InputProps{ID: "fe1-separated-input", Placeholder: "Search for…"})
				</div>
				<div class="col-auto">
					@button.Button(button.Props{Href: "#", IconOnly: true, Icon: "ti-search", Attributes: templ.Attributes{"aria-label": "Button"}})
				</div>
			</div>
		}
		@form.Field(form.FieldProps{Label: "Input with help icon", For: "fe1-help-icon-input"}) {
			<div class="row g-2">
				<div class="col">
					@form.Input(form.InputProps{ID: "fe1-help-icon-input", Placeholder: "Search for…"})
				</div>
				<div class="col-auto align-self-center">
					@form.Help(form.HelpProps{Content: zipHelp, HTML: true})
				</div>
			</div>
		}
	</div>
}

