package main

import (
	"net/http"
	"strconv"
	"sync/atomic"

	"github.com/mind-vm/tabler-templ/blocks/layout"
	"github.com/mind-vm/tabler-templ/htmx"
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/internal/csp"
	"github.com/mind-vm/tabler-templ/motion"
)

// The motion demo shows the motion package: presets replayed by htmx swaps, staggered cards, counters,
// sections that enter as they scroll into view, and list items that leave animated.

func motionRoutes(mux *http.ServeMux) {
	mux.Handle("GET /motion", templ.Handler(motionPage()))
	mux.HandleFunc("GET /motion/preset/{name}", func(w http.ResponseWriter, r *http.Request) {
		motionPresetBox(motion.Preset(r.PathValue("name"))).Render(r.Context(), w)
	})
	mux.HandleFunc("POST /motion/items", func(w http.ResponseWriter, r *http.Request) {
		motionItem(int(motionItems.Add(1))).Render(r.Context(), w)
	})
	mux.HandleFunc("DELETE /motion/items/{id}", func(w http.ResponseWriter, r *http.Request) {})
}

var motionItems atomic.Int64

func init() { motionItems.Store(3) }

var motionPresets = []motion.Preset{motion.FadeIn, motion.FadeUp, motion.FadeDown, motion.SlideLeft, motion.SlideRight, motion.ZoomIn, motion.Pop}

templ motionLink() {
	<a href="/motion" class="btn">
		@icon.Icon("ti-sparkles")
		Motion
	</a>
}

templ motionPresetBox(p motion.Preset) {
	<div class="card card-sm bg-primary-lt" { motion.Attrs(motion.Props{Preset: p})... }>
		<div class="card-body text-center py-5">
			<div class="h2 mb-1">{ string(p) }</div>
			<div class="text-secondary">Swapped in by htmx, animated by Motion</div>
		</div>
	</div>
}

templ motionItem(id int) {
	<li class="list-group-item d-flex align-items-center" { motion.Attrs(motion.Props{Preset: motion.Pop, Exit: motion.SlideLeft})... }>
		<span class="avatar avatar-sm me-3">{ strconv.Itoa(id) }</span>
		<span class="flex-fill">Task { strconv.Itoa(id) }</span>
		<button
			type="button"
			class="btn btn-ghost-danger btn-icon btn-sm"
			aria-label="Remove"
			hx-delete={ "/motion/items/" + strconv.Itoa(id) }
			hx-target="closest li"
			hx-swap="outerHTML swap:200ms"
		>
			@icon.Icon("ti-x")
		</button>
	</li>
}

templ motionStat(title string, c motion.CounterProps, note string) {
	<div class="col-sm-6 col-lg-3">
		<div class="card">
			<div class="card-body">
				<div class="subheader">{ title }</div>
				<div class="h1 mb-1">
					@motion.Counter(c)
				</div>
				<div class="text-secondary">{ note }</div>
			</div>
		</div>
	</div>
}

templ motionPage() {
	{{ p := frameProps("", "Motion") }}
	{{ p.Head = templ.Join(htmx.Library(), motion.Library(), assets()) }}
	{{ p.Scripts = templ.Join(p.Scripts, htmx.Setup()) }}
	{{
		p.Header = layout.PageHeader(layout.PageHeaderProps{Title: "Motion",
			Description: "Enter and leave animations with Motion (formerly Framer Motion), without React: on load, on htmx swaps and on scroll."})
	}}
	@layout.Page(p) {
		@csp.Style(".motion-demo-gap{height:80vh}")
		<div class="row row-cards" { motion.Attrs(motion.Props{Stagger: 0.08})... }>
			@motionStat("Revenue", motion.CounterProps{To: 48210, Prefix: "$"}, "this month")
			@motionStat("Orders", motion.CounterProps{To: 1284}, "+12% on last month")
			@motionStat("Conversion", motion.CounterProps{To: 3.8, Decimals: 1, Suffix: "%"}, "of visitors")
			@motionStat("Uptime", motion.CounterProps{To: 99.98, Decimals: 2, Suffix: "%", Duration: 2}, "last 30 days")
		</div>
		<div class="row row-cards mt-0">
			<div class="col-lg-6">
				<div class="card" { motion.Attrs(motion.Props{Preset: motion.SlideRight, Delay: 0.3})... }>
					<div class="card-header">
						<h3 class="card-title">Presets</h3>
					</div>
					<div class="card-body">
						<div class="btn-list mb-3">
							for _, pr := range motionPresets {
								<button type="button" class="btn btn-sm" hx-get={ "/motion/preset/" + string(pr) } hx-target="#motion-preset">{ string(pr) }</button>
							}
						</div>
						<div id="motion-preset">
							@motionPresetBox(motion.FadeUp)
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-6">
				<div class="card" { motion.Attrs(motion.Props{Preset: motion.SlideLeft, Delay: 0.3})... }>
					<div class="card-header">
						<h3 class="card-title">Add and remove</h3>
						<div class="card-actions">
							<button type="button" class="btn btn-primary btn-sm" hx-post="/motion/items" hx-target="#motion-items" hx-swap="beforeend">
								@icon.Icon("ti-plus")
								Add
							</button>
						</div>
					</div>
					<ul id="motion-items" class="list-group list-group-flush">
						for i := 1; i <= 3; i++ {
							@motionItem(i)
						}
					</ul>
				</div>
			</div>
		</div>
		<div class="d-flex flex-column align-items-center justify-content-end text-secondary motion-demo-gap">
			Scroll down
			@icon.Icon("ti-chevrons-down")
		</div>
		<h2 class="mt-5 mb-3" { motion.Attrs(motion.Props{InView: true})... }>Enters as you scroll</h2>
		<div class="row row-cards" { motion.Attrs(motion.Props{Preset: motion.ZoomIn, Stagger: 0.06, InView: true})... }>
			for i, t := range []string{"Design", "Develop", "Test", "Review", "Ship", "Measure", "Learn", "Repeat"} {
				<div class="col-sm-6 col-lg-3">
					<div class="card card-sm">
						<div class="card-body d-flex align-items-center">
							<span class="avatar bg-azure-lt me-3">{ strconv.Itoa(i + 1) }</span>
							<div class="fw-medium">{ t }</div>
						</div>
					</div>
				</div>
			}
		</div>
		<div class="row row-cards mt-0" { motion.Attrs(motion.Props{Stagger: 0.1, InView: true})... }>
			@motionStat("Tickets closed", motion.CounterProps{To: 9312, InView: true}, "since launch")
			@motionStat("Response time", motion.CounterProps{To: 1.4, Decimals: 1, Suffix: " h", InView: true}, "median")
			@motionStat("Satisfaction", motion.CounterProps{To: 96, Suffix: "%", InView: true}, "of ratings")
			@motionStat("Agents", motion.CounterProps{To: 42, InView: true}, "online now")
		</div>
	}
}
