package main

import (
	"github.com/mind-vm/tabler-templ/typography"
	"github.com/mind-vm/tabler-templ/button"
	"github.com/mind-vm/tabler-templ/card"
	"github.com/mind-vm/tabler-templ/form"
	"github.com/mind-vm/tabler-templ/hovergallery"
	"github.com/mind-vm/tabler-templ/imagelabel"
	"github.com/mind-vm/tabler-templ/legend"
	"github.com/mind-vm/tabler-templ/mockup"
	"github.com/mind-vm/tabler-templ/placeholder"
	"github.com/mind-vm/tabler-templ/progress"
	"github.com/mind-vm/tabler-templ/shape"
)

// batchBPages are the legend, image-labels, hover-gallery, mockup-browser and shape pages.
func batchBPages() map[string]templ.Component {
	return map[string]templ.Component{
		"legend":         legendPage(),
		"image-labels":   imageLabelsPage(),
		"hover-gallery":  hoverGalleryPage(),
		"mockup-browser": mockupBrowserPage(),
		"shape":          shapePage(),
	}
}

// lg is a legend item: color, label, value and unit.
type lg struct{ Color, Text, Value, Unit string }

templ legends(items []lg, style legend.Props) {
	for _, it := range items {
		{{ p := style }}
		{{ p.Color, p.Text, p.Value, p.Unit = it.Color, it.Text, it.Value, it.Unit }}
		@legend.Legend(p)
	}
}

var (
	requestSplit = []lg{{"blue", "Allowed", "339.0k", ""}, {"red", "Denied", "1.2k", ""}, {"orange", "Challenged", "815", ""}}
	trafficSplit = []lg{{"azure", "Organic search", "38%", ""}, {"primary", "Direct", "27%", ""}, {"purple", "Social media", "18%", ""}, {"orange", "Referral", "12%", ""}, {"green", "Email", "5%", ""}}
	latency3     = []lg{{"primary", "P99", "124", "ms"}, {"azure", "P95", "76", "ms"}, {"green", "P75", "32", "ms"}}
	legendColors = []string{"blue", "azure", "indigo", "purple", "pink", "red", "orange", "yellow", "lime", "green", "teal", "cyan"}
	testResults  = []lg{{"green", "Passed", "128", ""}, {"red", "Failed", "4", ""}, {"yellow", "Skipped", "12", ""}, {"secondary", "Pending", "3", ""}}
)

// links renders legend items as links, the first active and, if offLast, the last off.
templ legendLinks(items []lg, large, offLast bool) {
	for i, it := range items {
		@legend.Legend(legend.Props{Href: "#", Color: it.Color, Text: it.Text, Value: it.Value, Large: large, Active: i == 0, Off: offLast && i == len(items)-1})
	}
}

templ legendPage() {
	@preview("legend") {
		<div class="row row-cards">
			<div class="col-md-6 col-lg-4">
				@section("Basic", "A `Legend` is a marker and a label. Set the series color with `color`.") {
					@legend.List(legend.ListProps{}) {
						@legends([]lg{{"primary", "This year", "", ""}, {"secondary", "Last year", "", ""}, {"", "Forecast", "", ""}}, legend.Props{})
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("With values", "Add `value` to show a number next to the label.") {
					@legend.List(legend.ListProps{}) {
						@legends(requestSplit, legend.Props{})
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("States", "Links and buttons get a tinted background on hover. Use `active` to keep it and `off` for a hidden series.") {
					@legend.List(legend.ListProps{}) {
						@legend.Legend(legend.Props{Button: true, Color: "blue", Text: "Default"})
						@legend.Legend(legend.Props{Button: true, Color: "purple", Text: "Active", Active: true})
						@legend.Legend(legend.Props{Button: true, Color: "teal", Text: "Off", Off: true})
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Colors", "Every palette color works with `legend-{color}`.") {
					@legend.List(legend.ListProps{}) {
						for _, c := range legendColors {
							@legend.Legend(legend.Props{Color: c, Text: title(c)})
						}
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Vertical", "Add `vertical` to the list to stack the items.") {
					@legend.List(legend.ListProps{Vertical: true}) {
						@legends(trafficSplit, legend.Props{})
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Marker only", "Use a bare `legend-dot` when the label lives elsewhere.") {
					<div class="d-flex align-items-center gap-2">
						for _, c := range legendColors {
							@legend.Dot(c)
						}
					</div>
				}
			</div>
			<div class="col-lg-8">
				@section("Large", "Set `size=\"lg\"` to put a big value under the label. Add `unit` for the unit and `divided` on the list for the lines.") {
					@legend.List(legend.ListProps{Divided: true}) {
						@legends(latency3, legend.Props{Large: true})
						@legend.Legend(legend.Props{Large: true, Color: "yellow", Off: true, Text: "Requests", Value: "1,234"})
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Under a stat", "A legend row explains the split behind a single number.") {
					@typography.Subheader() {
						Requests
					}
					<div class="h1 mb-3">341.0k</div>
					@legend.List(legend.ListProps{Class: "border-top pt-3"}) {
						@legends(append(requestSplit, lg{"purple", "Logged", "-", ""}, lg{"teal", "Rate limited", "-", ""}), legend.Props{})
					}
				}
			</div>
			<div class="col-lg-8">
				@section("Above a chart", "Large items show the latest value of each series, so the chart needs no legend of its own.") {
					@legend.List(legend.ListProps{Divided: true, Class: "mb-3"}) {
						@legends(append(latency3, lg{"yellow", "P50", "10", "ms"}), legend.Props{Large: true})
					}
					<div id="chart-legend-latency" class="position-relative" role="img" aria-label="Read latency by percentile"></div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Large vertical", "Combine `size=\"lg\"` with a `vertical` list for a side panel.") {
					@legend.List(legend.ListProps{Vertical: true}) {
						@legends([]lg{{"primary", "Documents", "3.5", "GB"}, {"info", "Media", "1.5", "GB"}, {"success", "Shared", "0.7", "GB"}}, legend.Props{Large: true})
					}
				}
			</div>
			<div class="col-lg-8">
				@section("Large links", "Large items work as links and buttons too. Mark the current one with `active` and a hidden series with `off`.") {
					@legend.List(legend.ListProps{Divided: true}) {
						@legendLinks(testResults, true, true)
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("With units", "Add `unit` to a regular item to show the unit after the value.") {
					@legend.List(legend.ListProps{}) {
						@legends(latency3, legend.Props{})
					}
				}
			</div>
			<div class="col-lg-8">
				@section("Without lines", "Leave out `divided` when the items sit in a tight space or wrap to more rows.") {
					@legend.List(legend.ListProps{}) {
						@legends(trafficSplit, legend.Props{Large: true})
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Loading", "Use `placeholder` blocks for the label and the value while the data loads.") {
					@legend.List(legend.ListProps{Divided: true, Class: "placeholder-glow"}) {
						for range 2 {
							@legend.Legend(legend.Props{Large: true, ValueContent: placeholder.Placeholder(placeholder.Props{Class: "col-6", Span: true})}) {
								@placeholder.Placeholder(placeholder.Props{Class: "col-9", Span: true})
							}
						}
					}
				}
			</div>
			<div class="col-lg-8">
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Interactive legend
						}
						@legend.List(legend.ListProps{Class: "ms-auto"}) {
							for _, it := range []lg{{"yellow", "Total visits", "63.0k", ""}, {"green", "Unique visitors", "43.0k", ""}, {"primary", "New users", "13.5k", ""}} {
								@legend.Legend(legend.Props{Button: true, Color: it.Color, Text: it.Text, Value: it.Value, Attributes: templ.Attributes{"data-series": it.Text}})
							}
						}
					}
					@card.Body() {
						@card.Subtitle() {
							@withCode("Button items call `toggleSeries()` on the chart and toggle `legend-off`.")
						}
						<div id="chart-legend-page-chart" class="position-relative" role="img" aria-label="Site traffic"></div>
					}
				}
			</div>
			<div class="col-lg-4">
				@section("Next to a donut", "A vertical list beside a chart with its own legend hidden.") {
					<div class="d-flex align-items-center gap-4">
						<div class="w-50">
							<div id="chart-legend-donut" class="position-relative" role="img" aria-label="Traffic sources"></div>
						</div>
						@legend.List(legend.ListProps{Vertical: true}) {
							@legends(trafficSplit, legend.Props{})
						}
					</div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("With a progress bar", "Label the segments of a `progress-separated` bar.") {
					<p class="mb-3">Using <strong>5.7 GB</strong> of 8 GB</p>
					@progress.Multi(progress.Props{Separated: true, Class: "mb-3"}, []progress.Bar{{Value: 44, Color: "primary", Label: "Documents"},
						{Value: 19, Color: "info", Label: "Media"}, {Value: 9, Color: "success", Label: "Shared"}})
					@legend.List(legend.ListProps{}) {
						@legends([]lg{{"primary", "Documents", "3.5 GB", ""}, {"info", "Media", "1.5 GB", ""}, {"success", "Shared", "0.7 GB", ""}, {"", "Free", "2.3 GB", ""}}, legend.Props{})
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Filter links", "Link items with `href` work as filters. Mark the current one with `active`.") {
					@legend.List(legend.ListProps{}) {
						@legendLinks(testResults, false, false)
					}
				}
			</div>
		</div>
	}
}

templ labeledImage(src, alt, width string) {
	<img src={ photo("photos/" + src + ".jpg") } class="rounded" width={ width } alt={ alt }/>
}

type listItem struct{ Photo, Alt, Name, Price, Label, Class string }

templ imageLabelsPage() {
	@preview("image-labels") {
		<div class="row row-cards">
			<div class="col-md-6 col-lg-4">
				@section("Basic", "Wrap the image in `.img-labeled` and add an `.img-label` next to it.") {
					@imagelabel.Labeled() {
						@labeledImage("book-on-the-grass", "A book on the grass", "240")
						@imagelabel.Label(imagelabel.LabelProps{Text: "AI"})
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("With an icon", "A label can hold an icon, a text, or both. Add `.img-label-icon` to a label with only an icon.") {
					<div class="d-flex flex-wrap gap-3">
						@imagelabel.Labeled() {
							@labeledImage("brainstorming-session-with-creative-designers", "A brainstorming session", "160")
							@imagelabel.Label(imagelabel.LabelProps{Icon: "ti-player-play", Text: "1:24"})
						}
						@imagelabel.Labeled() {
							@labeledImage("blond-using-her-laptop-at-her-bedroom", "A woman using a laptop", "160")
							@imagelabel.Label(imagelabel.LabelProps{Icon: "ti-crown", IconOnly: true, Text: "Premium"})
						}
					</div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Colors", "Add a background utility such as `.bg-red` with its `.text-red-fg`.") {
					<div class="d-flex flex-wrap gap-3">
						for _, c := range []string{"primary", "red", "green", "yellow"} {
							@imagelabel.Labeled() {
								@labeledImage("a-visit-to-the-bookstore", "A visit to the bookstore", "110")
								@imagelabel.Label(imagelabel.LabelProps{Text: "New", Class: "bg-" + c + " text-" + c + "-fg"})
							}
						}
					</div>
				}
			</div>
			<div class="col-md-6">
				@section("Position", "Move the label to another corner with `.img-label-top-start`, `.img-label-top-end` or `.img-label-bottom-start`.") {
					<div class="d-flex flex-wrap gap-3">
						for _, c := range []struct {
							Corner imagelabel.Corner
							Text   string
						}{{imagelabel.TopStart, "Top start"}, {imagelabel.TopEnd, "Top end"}, {imagelabel.BottomStart, "Bottom start"}, {imagelabel.BottomEnd, "Bottom end"}} {
							@imagelabel.Labeled() {
								@labeledImage("a-woman-works-on-a-laptop-at-home", "A woman working on a laptop", "140")
								@imagelabel.Label(imagelabel.LabelProps{Corner: c.Corner, Text: c.Text})
							}
						}
					</div>
				}
			</div>
			<div class="col-md-6">
				@section("Multiple labels", "Put several labels on one image, each in its own corner.") {
					@imagelabel.Labeled() {
						@labeledImage("brainstorming-session-with-creative-designers-2", "Designers at a brainstorming session", "320")
						@imagelabel.Label(imagelabel.LabelProps{Corner: imagelabel.TopStart, Text: "Live", Class: "bg-red text-red-fg"})
						@imagelabel.Label(imagelabel.LabelProps{Corner: imagelabel.TopEnd, Icon: "ti-lock", Text: "Members"})
						@imagelabel.Label(imagelabel.LabelProps{Text: "4K"})
					}
				}
			</div>
			<div class="col-12">
				@section("In a list", "Labels mark single items in a list of products or media.") {
					<div class="row g-3">
						for _, it := range []listItem{{"book-on-the-grass", "Reading corner", "Reading corner", "$129", "AI", ""},
							{"blue-sofa-with-pillows-in-a-designer-living-room-interior", "Designer sofa", "Designer sofa", "$849", "New", ""},
							{"books-and-purple-flowers-on-a-wooden-stool-by-the-bed", "Bedside stool", "Bedside stool", "$59", "-20%", "bg-red text-red-fg"}} {
							<div class="col-md-4">
								<div class="row g-3 align-items-center">
									<a href="#" class="col-auto">
										@imagelabel.Labeled(imagelabel.LabeledProps{Inline: true}) {
											@labeledImage(it.Photo, it.Alt, "120")
											@imagelabel.Label(imagelabel.LabelProps{Text: it.Label, Class: it.Class})
										}
									</a>
									<div class="col">
										<div class="fw-medium">{ it.Name }</div>
										<div class="text-secondary">{ it.Price }</div>
									</div>
								</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	}
}

var (
	backpack = []hovergallery.Image{
		{Src: photo("products/backpack-1.jpg"), Alt: "Black leather backpack, front view"},
		{Src: photo("products/backpack-2.jpg"), Alt: "Black leather backpack, view from the front left"},
		{Src: photo("products/backpack-3.jpg"), Alt: "Black leather backpack, side view"},
		{Src: photo("products/backpack-4.jpg"), Alt: "Black leather backpack, back view with the shoulder straps"},
		{Src: photo("products/backpack-5.jpg"), Alt: "Brass buckle and leather grain of the backpack"},
	}
	watch = []hovergallery.Image{
		{Src: photo("products/watch-1.jpg"), Alt: "Steel watch with a black dial, front view"},
		{Src: photo("products/watch-2.jpg"), Alt: "Steel watch with a black dial, view from the front left"},
		{Src: photo("products/watch-3.jpg"), Alt: "Steel watch, side view with the crown"},
		{Src: photo("products/watch-4.jpg"), Alt: "Steel watch, back view with the case back and buckle"},
		{Src: photo("products/watch-5.jpg"), Alt: "Close-up of the watch dial, bezel and crown"},
	}
	interiors = []hovergallery.Image{
		{Src: photo("photos/blue-sofa-with-pillows-in-a-designer-living-room-interior.jpg"), Alt: "Blue sofa with pillows in a designer living room interior"},
		{Src: photo("photos/colorful-exotic-flowers-and-greenery.jpg"), Alt: "Colorful Exotic Flowers and Greenery"},
		{Src: photo("photos/city-lights-reflected-in-the-water-at-night.jpg"), Alt: "City lights reflected in the water at night"},
	}
)

templ hoverGalleryPage() {
	@preview("hover-gallery") {
		<div class="row row-cards">
			<div class="col-md-6 col-lg-4">
				@section("Basic", "Wrap each image in `.hover-gallery-item`; every item is one hover column.") {
					@hovergallery.Gallery(hovergallery.Props{Class: "rounded"}, backpack)
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("With indicators", "Add `.hover-gallery-indicators` to show which image is on display.") {
					@hovergallery.Gallery(hovergallery.Props{Class: "rounded", Indicators: true}, watch)
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Aspect ratio", "Set `--tblr-hover-gallery-aspect-ratio` to change the shape.") {
					@hovergallery.Gallery(hovergallery.Props{Class: "rounded", Indicators: true, AspectRatio: "16 / 9"}, interiors)
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@card.Card() {
					@hovergallery.Gallery(hovergallery.Props{Class: "card-img-top", Indicators: true}, backpack)
					@card.Body() {
						@card.Title() {
							Product card
						}
						@card.Subtitle() {
							@withCode("Use the gallery with `.card-img-top` in place of the card image.")
						}
						<div class="h3 m-0">$189</div>
					}
				}
			</div>
		</div>
	}
}

templ pageHere() {
	<div class="ratio ratio-16x9">
		<div class="d-flex align-items-center justify-content-center text-secondary">Your page goes here</div>
	</div>
}

templ mockupBrowserPage() {
	@preview("mockup-browser") {
		<div class="row row-cards">
			<div class="col-lg-6">
				@section("Basic", "A screenshot in a `.mockup-browser` frame, with the window dots and an address bar.") {
					@mockup.Browser(mockup.Props{URL: "preview.tabler.io"}) {
						@pageHere()
					}
				}
			</div>
			<div class="col-lg-6">
				@section("Secure address", "Put a lock icon before the address to show a secure page.") {
					@mockup.Browser(mockup.Props{URL: "https://preview.tabler.io", Secure: true}) {
						@pageHere()
					}
				}
			</div>
			<div class="col-lg-6">
				@section("Without an address bar", "Leave out `.mockup-browser-url` for a plain window frame.") {
					@mockup.Browser(mockup.Props{}) {
						@pageHere()
					}
				}
			</div>
			<div class="col-12">
				@section("Sizes", "Add `.mockup-browser-sm` for a 24px toolbar with smaller dots and text, for thumbnails and cards.") {
					<div class="row g-3 align-items-start">
						<div class="col-md-7">
							@mockup.Browser(mockup.Props{URL: "preview.tabler.io", Secure: true}) {
								@pageHere()
							}
						</div>
						<div class="col-md-5">
							@mockup.Browser(mockup.Props{URL: "preview.tabler.io", Secure: true, Small: true}) {
								@pageHere()
							}
						</div>
					</div>
				}
			</div>
			<div class="col-lg-6">
				@section("Any content", "The body takes any markup, not only an image, so a component can be shown as a page.") {
					@mockup.Browser(mockup.Props{URL: "example.com/signup", Secure: true, BodyClass: "p-4"}) {
						@card.Title() {
							Create an account
						}
						@form.Field(form.FieldProps{Label: "Email", For: "mockup-browser-email"}) {
							@form.Input(form.InputProps{ID: "mockup-browser-email", Type: "email", Placeholder: "you@example.com"})
						}
						@form.Field(form.FieldProps{Label: "Password", For: "mockup-browser-password"}) {
							@form.Input(form.InputProps{ID: "mockup-browser-password", Type: "password", Placeholder: "Password"})
						}
						@button.Button(button.Props{Type: "button", Variant: button.VariantPrimary, Block: true}) {
							Sign up
						}
					}
				}
			</div>
			<div class="col-lg-6">
				@section("Custom look", "Set the `--tblr-mockup-browser-*` variables for a dark toolbar, other window dot colors or no shadow.") {
					@mockup.Browser(mockup.Props{URL: "preview.tabler.io", Secure: true, Attributes: templ.Attributes{"style": "--tblr-mockup-browser-toolbar-bg: var(--tblr-gray-900); --tblr-mockup-browser-toolbar-color: var(--tblr-gray-400); --tblr-mockup-browser-border-color: var(--tblr-gray-900); --tblr-mockup-browser-box-shadow: none"}}) {
						@pageHere()
					}
				}
			</div>
		</div>
	}
}

type feature struct{ Icon, Title, Text, Color string }

templ shapePage() {
	@preview("shape") {
		<div class="row row-cards">
			<div class="col-md-6 col-lg-4">
				@section("Sizes", "Add `.shape-{size}`, from `xxs` to `2xl`, the same sizes as an avatar.") {
					<div class="d-flex flex-wrap align-items-end gap-3">
						for _, s := range []string{"xxs", "xs", "sm", "md", "lg", "xl", "2xl"} {
							@shape.Shape("ti-star", shape.Props{Size: s})
						}
					</div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Colors", "Add `.shape-{color}` to use another palette color.") {
					<div class="d-flex flex-wrap gap-3">
						@shape.Shape("ti-brand-bootstrap")
						for _, c := range legendColors {
							@shape.Shape("ti-brand-bootstrap", shape.Props{Color: c})
						}
					</div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("With icons", "Put one `.icon` inside the shape; it is sized with the square.") {
					<div class="d-flex flex-wrap gap-3">
						for _, ic := range []string{"ti-devices", "ti-mailbox", "ti-palette", "ti-tools", "ti-brand-bootstrap", "ti-paint", "ti-rocket", "ti-shield-check"} {
							@shape.Shape(ic, shape.Props{Size: "md"})
						}
					</div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Corner radius", "Set `--tblr-shape-border-radius` to change the corners; the default is `35%`.") {
					<div class="d-flex flex-wrap gap-4">
						for _, r := range []named{{"0", "Square"}, {"", "Default"}, {"50%", "Circle"}} {
							<div class="text-center">
								if r.Variant != "" {
									@shape.Shape("ti-palette", shape.Props{Size: "lg", Attributes: templ.Attributes{"style": "--tblr-shape-border-radius: " + r.Variant}})
								} else {
									@shape.Shape("ti-palette", shape.Props{Size: "lg"})
								}
								<div class="text-secondary small mt-1">{ r.Text }</div>
							</div>
						}
					</div>
				}
			</div>
			<div class="col-lg-8">
				@section("Feature list", "A shape above each heading, with the same size and color on every item.") {
					<div class="row g-4 text-center">
						for _, f := range []feature{{"ti-devices", "Mobile-optimized", "Every page works on any screen size, from a phone to a wide monitor.", ""},
							{"ti-mailbox", "Tested email clients", "Checked in more than 90 email clients and devices.", ""},
							{"ti-palette", "Minimal design", "Clean layouts based on Bootstrap and Material Design principles.", ""}} {
							<div class="col-md-4">
								@shape.Shape(f.Icon, shape.Props{Size: "md", Class: "mb-3"})
								<h3 class="h3">{ f.Title }</h3>
								<p class="text-secondary mb-0">{ f.Text }</p>
							</div>
						}
					</div>
				}
			</div>
			<div class="col-12">
				@section("Feature list, inline", "A colored shape next to each heading, in a `.row` with an auto column.") {
					<div class="row g-4">
						for _, f := range []feature{{"ti-tools", "Easy to customize", "Change colors, fonts and spacing with Sass or CSS variables.", "blue"},
							{"ti-brand-bootstrap", "Built on Bootstrap", "Every Bootstrap component works out of the box.", "purple"},
							{"ti-paint", "Dark mode", "One attribute switches the whole interface to a dark theme.", "green"}} {
							<div class="col-md-4">
								<div class="row g-3">
									<div class="col-auto">
										@shape.Shape(f.Icon, shape.Props{Size: "md", Color: f.Color})
									</div>
									<div class="col">
										<h3 class="h4 mb-1">{ f.Title }</h3>
										<p class="text-secondary mb-0">{ f.Text }</p>
									</div>
								</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	}
}
