package main

import "github.com/mind-vm/tabler-templ/blocks/signin"

templ signInFooter() {
	Don't have account yet? <a href="#">Sign up</a>
}

templ signInPage() {
	@signin.Page(signin.Props{Title: "Login to your account", AppName: "tabler-templ", Head: assets(), Scripts: scripts(), Footer: signInFooter()}) {
		@signin.Password(signin.PasswordProps{Action: "#", RememberName: "remember", Submit: "Sign in"})
	}
}
