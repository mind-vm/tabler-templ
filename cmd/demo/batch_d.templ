	}
}

templ notLegalAdvice() {
	This is not legal advice.
	<a href="#" target="_blank">Learn more about repository licenses.</a>
}

func terms(names ...string) []legal.Term {
	ts := make([]legal.Term, len(names))
	for i, n := range names {
		ts[i] = legal.Term{Text: n}
	}
	return ts
}

templ licensePage() {
	@preview("license") {
		<div class="row row-cards">
			<div class="col-lg-8">
				@legal.Card(legal.CardProps{Large: true}) {
					@templ.Raw(licenseHTML)
				}
			</div>
			<div class="col-lg-4">
				@legal.LicenseSummary(legal.LicenseProps{Lead: "tabler/tabler is licensed under the", Name: "MIT License",
					Text:        "A short and simple permissive license with conditions only requiring preservation of copyright and license notices. Licensed works, modifications, and larger works may be distributed under different terms and without source code.",
					Permissions: terms("Commercial use", "Modification", "Distribution", "Private use"), Limitations: terms("Liability", "Warranty"),
					Conditions: terms("License and copyright notice"), Footer: notLegalAdvice()})
			</div>
		</div>
	}
}

templ termsPage() {
	{{ p, _ := catalog.Find("terms-of-service") }}
	@legal.Page(legal.PageProps{Title: p.Title + " · tabler-templ", Head: assets(), Scripts: scripts(), Brand: logo()}) {
		@legal.Card(legal.CardProps{Title: "Terms of service"}) {
			@templ.Raw(termsHTML)
		}
	}
}

// paymentsCSS loads Tabler's payment provider logos.
// TODO(parent): move into assets() in layout.templ.
templ paymentsCSS() {
	<link rel="stylesheet" href={ "https://cdn.jsdelivr.net/npm/@tabler/core@" + tablerVersion + "/dist/css/tabler-payments.min.css" }/>
}

templ providerGrid(title, subtitle string, dark bool) {
	@card.Card() {
		@card.Header() {
			<div>
				@card.Title() {
					{ title }
				}
				@card.Subtitle() {
					{ subtitle }
				}
			</div>
		}
		@card.Body() {
			<div class="row g-5 row-cols-5">
				for _, pr := range payment.Providers {
					<div class="col">
						<div class="row">
							<div class="col-auto">
								@payment.Payment(pr.Code, payment.Props{Dark: dark})
							</div>
							<div class="col">
								<strong class="d-block">{ pr.Name }</strong>
								<div class="mt-1">
									<code>{ pr.Code + kitIf(dark, "-dark") }</code>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		}
	}
}

templ paymentProvidersPage() {
	@preview("payment-providers") {
		@paymentsCSS()
		<div class="row row-cards">
			<div class="col-12">
				@providerGrid("Light version", "Provider logos on a light background, for use on white or light cards.", false)
			</div>
			<div class="col-12">
				@providerGrid("Dark version", "Provider logos with an inverted color scheme, for dark backgrounds.", true)
			</div>
		</div>
	}
}

templ smallTablerLogo() {
	<a href="." aria-label="Tabler" class="navbar-brand navbar-brand-autodark">
		@templ.Raw(tablerMark)
	</a>
}

templ payPage() {
	{{ p, _ := catalog.Find("pay") }}
	@billing.CheckoutPage(billing.CheckoutProps{Title: p.Title + " · tabler-templ", Head: payHead(), Scripts: scripts(), Brand: smallTablerLogo(),
		Cover: photo("bg-cover.jpg"), Avatar: avatarURL("000m"), Product: "Front-End Learning",
		Text: "Learn to build web apps with HTML & CSS. Get started quickly with included templates."}) {
		@nav.Segmented(nav.SegmentedProps{Block: true, Class: "mb-4"}) {
			@nav.Segment(nav.SegmentProps{Target: "tab-card", Icon: "ti-credit-card", Active: true}) {
				<span>Pay With Card</span>
			}
			@nav.Segment(nav.SegmentProps{Target: "tab-paypal", Icon: "ti-brand-paypal"}) {
				<span>Pay With PayPal</span>
			}
		}
		@nav.Content() {
			@nav.Pane(nav.PaneProps{ID: "tab-card", Active: true}) {
				@billing.CardForm(billing.CardFormProps{Submit: "Pay $253", Note: "You'll be charged $253, including $48 for VAT in Poland"})
			}
			@nav.Pane(nav.PaneProps{ID: "tab-paypal"}) {
				@button.Button(button.Props{Type: "button", Variant: button.VariantPrimary, Block: true, Icon: "ti-brand-paypal"}) {
					<span class="ms-2">Pay with PayPal - $253</span>
				}
				<div class="text-secondary text-center small mt-3">You'll be charged $253, including $48 for VAT in Poland</div>
			}
		}
	}
}

templ payHead() {
	@assets()
	@paymentsCSS()
}

templ smallButton(text, ic string) {
	@button.Button(button.Props{Type: "button", Size: button.SizeSmall, Icon: ic}) {
		{ text }
	}
}

templ viewAll() {
	@button.Button(button.Props{Href: "/invoice", Size: button.SizeSmall}) {
		View all
	}
}

templ seats() {
	<div class="d-flex align-items-center gap-2">
		@form.NumberInput(form.NumberInputProps{Size: form.SizeSmall, Value: "10", Min: "8", Max: "100", AriaLabel: "Seats in the plan"})
		<span class="text-secondary">8 used</span>
	</div>
}

templ planDetails() {
	@datagrid.Grid() {
		@datagrid.Item(datagrid.ItemProps{Title: "Billing period"}) {
			Monthly
		}
		@datagrid.Item(datagrid.ItemProps{Title: "Next invoice"}) {
			September 18, 2026
		}
		@datagrid.Item(datagrid.ItemProps{Title: "Seats"}) {
			@seats()
		}
	}
}

templ methodMenu(setDefault bool) {
	if setDefault {
		@dropdown.Item(dropdown.ItemProps{Icon: "ti-star"}) {
			Set as default
		}
	}
	@dropdown.Item(dropdown.ItemProps{Icon: "ti-pencil"}) {
		Edit
	}
	@dropdown.Item(dropdown.ItemProps{Icon: "ti-trash", Class: "text-danger"}) {
		Remove
	}
}

var demoInvoices = []billing.Invoice{
	{Date: "Sep 18, 2026", Number: "INV-2026-0089", Amount: "$49.00", Status: "Open", StatusColor: "warning", PayHref: "#"},
	{Date: "Aug 18, 2026", Number: "INV-2026-0081", Amount: "$49.00", Status: "Paid", StatusColor: "success"},
	{Date: "Jul 18, 2026", Number: "INV-2026-0074", Amount: "$49.00", Status: "Paid", StatusColor: "success"},
	{Date: "Jun 18, 2026", Number: "INV-2026-0066", Amount: "$49.00", Status: "Paid", StatusColor: "success"},
}

templ billingPage() {
	@preview("billing") {
		@paymentsCSS()
		<div class="row row-cards">
			<div class="col-lg-8">
				<div class="row row-cards">
					<div class="col-12">
						@billing.Plan(billing.PlanProps{Name: "Pro plan", Status: "Active", Renews: "Renews on September 18, 2026", Price: "$49", Period: "/month",
							Action: smallButton("Change plan", ""), Details: planDetails(),
							Usage: &billing.Usage{Label: "Monthly requests", Used: "7,420", Limit: "/ 10,000", Value: 74,
								Text: "74% of the included usage. The counter resets at the start of each billing period."}})
					</div>
					<div class="col-12">
						@billing.Invoices(billing.CardProps{Title: "Invoices", Subtitle: "Invoices are issued on the 18th of each month.", Action: viewAll()}, demoInvoices)
					</div>
				</div>
			</div>
			<div class="col-lg-4">
				<div class="row row-cards">
					<div class="col-12">
						@billing.Methods(billing.MethodsProps{CardProps: billing.CardProps{Title: "Payment method", Subtitle: "The default method is charged on every invoice.",
							Action: smallButton("Add method", "ti-plus")}}, []billing.Method{
							{ID: "payment-method-visa", Value: "visa", Provider: "visa", Title: "Visa ending in 4242", Detail: "Expires 09/2028", Default: true, Checked: true, Menu: methodMenu(false)},
							{ID: "payment-method-mastercard", Value: "mastercard", Provider: "mastercard", Title: "Mastercard ending in 5512", Detail: "Expires 03/2027", Menu: methodMenu(true)},
							{ID: "payment-method-paypal", Value: "paypal", Provider: "paypal", Title: "PayPal", Detail: "billing@tabler.io", Menu: methodMenu(true)},
						})
					</div>
					<div class="col-12">
						@billing.Card(billing.CardProps{Title: "Billing details", Subtitle: "Shown on every invoice and receipt.", Action: smallButton("Edit", "ti-pencil")}) {
							@card.Body() {
								@datagrid.Grid() {
									for _, d := range [][2]string{{"Company", "Tabler Ltd."}, {"Billing email", "billing@tabler.io"}, {"Tax ID", "EU123456789"},
										{"Address", "44 Harbor Street, Portland, OR 97209, United States"}} {
										@datagrid.Item(datagrid.ItemProps{Title: d[0]}) {
											{ d[1] }
										}
									}
								}
							}
						}
					</div>
					<div class="col-12">
						@billing.Cancel(billing.CancelProps{Text: "Your plan stays active until the end of the current billing period. After that the workspace switches to the free plan and API access is paused."})
					</div>
				</div>
			</div>
		</div>
	}
}
