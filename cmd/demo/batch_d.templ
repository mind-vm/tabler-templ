templ invoicePage() {
	{{ p, _ := catalog.Find("invoice") }}
	{{ fp := frameProps("invoice", p.Title) }}
	{{ fp.Header = layout.PageHeader(layout.PageHeaderProps{Title: "Invoice", Actions: printInvoice()}) }}
