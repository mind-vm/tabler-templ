func batchDPages() map[string]templ.Component {
	return map[string]templ.Component{
		"settings":      settingsPage(),
		"settings-plan": settingsPlanPage(),
		"pricing":       pricingPage(),
		"pricing-table": pricingTablePage(),
		"invoice":       invoicePage(),
		"license":       licensePage(),
		"terms-of-service": termsPage(),
		"payment-providers": paymentProvidersPage(),
		"pay":               payPage(),
		"billing":           billingPage(),
	}
}

// framed is a preview page with its own page header (title and pretitle as the preview shows them).
templ framed(name, title, pretitle string) {
	{{ p, _ := catalog.Find(name) }}
	{{ fp := frameProps(name, p.Title) }}
	{{ fp.Header = layout.PageHeader(layout.PageHeaderProps{Pretitle: pretitle, Title: title, Actions: originalLink(name)}) }}
	@layout.Page(fp) {
		{ children... }
	}
}

func settingsGroups(active string) []settings.Group {
	return []settings.Group{
		{Title: "Business settings", Links: []settings.Link{
			{Text: "My Account", Href: "/settings", Active: active == "settings"},
			{Text: "My Notifications", Href: "#"},
			{Text: "Connected Apps", Href: "#"},
			{Text: "Plans", Href: "/settings-plan", Active: active == "settings-plan"},
			{Text: "Billing & Invoices", Href: "#"},
		}},
		{Title: "Experience", Links: []settings.Link{{Text: "Give Feedback", Href: "#"}}},
	}
}

templ settingsFooter() {
	@settings.Footer() {
		@button.Button(button.Props{Type: "button"}) {
			Cancel
		}
		@button.Button(button.Props{Type: "button", Variant: button.VariantPrimary}) {
			Submit
		}
	}
}

templ settingsPage() {
	@framed("settings", "Account Settings", "") {
		@settings.Frame(settings.FrameProps{Groups: settingsGroups("settings")}) {
			@settings.Content("My Account") {
				@settings.Section(settings.SectionProps{Title: "Profile Details", First: true}) {
					<div class="row align-items-center">
						<div class="col-auto">
							@avatar.Avatar(avatar.Props{Src: avatarURL("000m"), Size: avatar.SizeXL})
						</div>
						<div class="col-auto">
							@button.Button(button.Props{Type: "button"}) {
								Change avatar
							}
						</div>
						<div class="col-auto">
							@button.Button(button.Props{Type: "button", Variant: "danger", Ghost: true}) {
								Delete avatar
							}
						</div>
					</div>
				}
				@settings.Section(settings.SectionProps{Title: "Business Profile"}) {
					<div class="row g-3">
						for _, f := range []struct{ ID, Label, Value string }{{"business-name", "Business Name", "Tabler"}, {"business-id", "Business ID", "560afc32"}, {"location", "Location", "Peimei, China"}} {
							<div class="col-md">
								<label class="form-label" for={ f.ID }>{ f.Label }</label>
								@form.Input(form.InputProps{ID: f.ID, Name: f.ID, Value: f.Value})
							</div>
						}
					</div>
				}
				@settings.Section(settings.SectionProps{Title: "Email", Subtitle: "This contact will be shown to others publicly, so choose it carefully."}) {
					<div>
						<div class="row g-2">
							<div class="col-auto">
								<label class="form-label visually-hidden" for="email">Email</label>
								@form.Input(form.InputProps{ID: "email", Name: "email", Type: "email", Value: "paweluna@howstuffworks.com", Autocomplete: "email", Class: "w-auto"})
							</div>
							<div class="col-auto">
								@button.Button(button.Props{Type: "button"}) {
									Change
								}
							</div>
						</div>
					</div>
				}
				@settings.Section(settings.SectionProps{Title: "Password", Subtitle: "You can set a permanent password if you don't want to use temporary login codes."}) {
					<div>
						@button.Button(button.Props{Type: "button"}) {
							Set new password
						}
					</div>
				}
				@settings.Section(settings.SectionProps{Title: "Public profile", Subtitle: "Making your profile public means that anyone on the Dashkit network will be able to find you."}) {
					<div>
						@form.Check(form.CheckProps{Switch: true, Large: true, LabelOn: "You're currently visible", LabelOff: "You're currently invisible"})
					</div>
				}
			}
			@settingsFooter()
		}
	}
}

templ users(n string) {
	<span><strong>{ n }</strong> Users</span>
}

// planFeatures are the preview's plan lines: users, then the four tools by availability.
func planFeatures(users string, have ...bool) []plans.Feature {
	fs := []plans.Feature{{Icon: "ti-users", Content: usersLine(users)}}
	for i, name := range []string{"Sharing Tools", "Design Tools", "Private Messages", "Twitter API"} {
		fs = append(fs, plans.Feature{Text: name, Missing: !have[i]})
	}
	return fs
}

func usersLine(n string) templ.Component { return users(n) }

templ bookDemo() {
	@button.Button(button.Props{Type: "button"}) {
		Book a demo
	}
}

templ planCards() {
	<div class="col-lg-4">
		@plans.Plan(plans.PlanProps{Name: "Free", Price: "$0", Features: planFeatures("3", true, false, false, false)})
	</div>
	<div class="col-lg-4">
		@plans.Plan(plans.PlanProps{Name: "Premium", Price: "$49", Featured: "green", Features: planFeatures("10", true, true, false, false)})
	</div>
	<div class="col-lg-4">
		@plans.Plan(plans.PlanProps{Name: "Enterprise", Price: "$99", Features: planFeatures("100", true, true, true, false)})
	</div>
	<div class="col-12">
		@plans.Quote(plans.QuoteProps{Text: "Tabler is designed to work great for large enterprises. Take a look at our feature comparison.", Action: bookDemo()})
	</div>
}

templ settingsPlanPage() {
	@framed("settings-plan", "Account Settings", "") {
		@settings.Frame(settings.FrameProps{Groups: settingsGroups("settings-plan")}) {
			@settings.Content("Plans") {
				<p class="text-secondary mb-4">This workspace’s Basic Plan is set to $34 per month and will renew on June 19, 2022.</p>
				@form.Field(form.FieldProps{Label: "Users", For: "plan-users", Class: "mb-4"}) {
					@form.NumberInput(form.NumberInputProps{ID: "plan-users", Value: "10", Min: "1", Max: "100"})
					@form.Text("plan-users-hint") {
						Each plan is billed per user. Pick how many people need access.
					}
				}
				<div class="row row-cards">
					@planCards()
				</div>
			}
		}
	}
}

templ popular() {
	@badge.Badge(badge.Props{Color: "primary"}) {
		Popular
	}
}

templ getStarted(text string, primary bool) {
	if primary {
		@button.Button(button.Props{Href: "#", Variant: button.VariantPrimary, Block: true}) {
			{ text }
		}
	} else {
		@button.Button(button.Props{Href: "#", Block: true}) {
			{ text }
		}
	}
}

func features(names ...string) []pricing.Feature {
	fs := make([]pricing.Feature, len(names))
	for i, n := range names {
		fs[i] = pricing.Feature{Text: n}
	}
	return fs
}

var perUserMonth = []string{"per user", "per month"}

templ pricingPage() {
	@preview("pricing") {
		<div class="row row-cards">
			<div class="col-sm-6 col-lg-3">
				@plans.Plan(plans.PlanProps{Name: "Free", Price: "$0", Href: "#", Features: planFeatures("3", true, false, false, false)})
			</div>
			<div class="col-sm-6 col-lg-3">
				@plans.Plan(plans.PlanProps{Name: "Premium", Price: "$49", Featured: "green", Features: planFeatures("10", true, true, false, false)})
			</div>
			<div class="col-sm-6 col-lg-3">
				@plans.Plan(plans.PlanProps{Name: "Enterprise", Price: "$99", Features: planFeatures("100", true, true, true, false)})
			</div>
			<div class="col-sm-6 col-lg-3">
				@plans.Plan(plans.PlanProps{Name: "Unlimited", Price: "$139", Features: planFeatures("Unlimited", true, true, true, true)})
			</div>
			<div class="col-12">
				@plans.Quote(plans.QuoteProps{Text: "Tabler is designed to work great for large enterprises. Take a look at our feature comparison.", Action: bookDemo()})
			</div>
			<div class="col-12">
				@pricing.Pricing() {
					@pricing.Card(pricing.CardProps{Title: "Free", Currency: "$", Price: "0", Description: perUserMonth,
						Features: features("Up to 3 users", "Basic components", "Community support"), Button: getStarted("Get started", false)})
					@pricing.Card(pricing.CardProps{Title: "Premium", Currency: "$", Price: "49", Description: perUserMonth, Featured: true, Label: popular(),
						Features: features("Up to 10 users", "All components", "Figma UI kit", "Priority support"), Button: getStarted("Get started", true)})
					@pricing.Card(pricing.CardProps{Title: "Enterprise", Currency: "$", Price: "99", Description: perUserMonth,
						Features: features("Unlimited users", "All components", "Dedicated support"), Button: getStarted("Contact us", false)})
				}
			</div>
		</div>
	}
}

var tablePlans = []bpricing.Plan{{Name: "Starter", Price: "$0"}, {Name: "Professional", Price: "$9", Featured: "green"}, {Name: "Business", Price: "$16"}}

func row(feature string, included ...bool) bpricing.Row {
	return bpricing.Row{Feature: feature, Included: included}
}

var tableGroups = []bpricing.Group{
	{Title: "Features", Rows: []bpricing.Row{row("Some info about feature", true, true, true), row("Online payment gateway", false, true, true),
		row("Unlimited products can be sold", false, false, true)}},
	{Title: "Reporting", Rows: []bpricing.Row{row("Free hosting and domain name", true, true, true), row("Admin dashboard to control items", true, true, true)}},
	{Title: "Support", Rows: []bpricing.Row{row("Email marketing and service", false, false, true), row("24/7 customer support online", false, true, true)}},
}

templ pricingTablePage() {
	@preview("pricing-table") {
		@bpricing.Table(bpricing.TableProps{Title: "Pricing plans for teams of all sizes",
			Text: "Choose an affordable plan that comes with the best features to engage your audience, create customer loyalty and increase sales."}, tablePlans, tableGroups)
	}
}

