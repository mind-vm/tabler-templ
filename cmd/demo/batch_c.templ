package main

import (
	"github.com/mind-vm/tabler-templ/sparkline"
	"github.com/mind-vm/tabler-templ/typography"
	"github.com/mind-vm/tabler-templ/avatar"
	"github.com/mind-vm/tabler-templ/button"
	"github.com/mind-vm/tabler-templ/card"
	"github.com/mind-vm/tabler-templ/carousel"
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/iconlist"
	"github.com/mind-vm/tabler-templ/listgroup"
	"github.com/mind-vm/tabler-templ/placeholder"
	"github.com/mind-vm/tabler-templ/progress"
	"github.com/mind-vm/tabler-templ/ribbon"
