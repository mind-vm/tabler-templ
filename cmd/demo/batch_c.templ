			<div class="col-md-6">
				@headerCard("Carousel with controls") {
					@carousel.Carousel(carousel.Props{ID: "carousel-controls", Indicators: carousel.NoIndicators, Label: "Carousel with controls"},
						slides("group-of-people-sightseeing-in-the-city", "Group of people sightseeing in the city",
							"color-palette-guide-sample-colors-catalog-", "Color Palette Guide. Sample Colors Catalog.",
							"stylish-workplace-with-computer-at-home", "Stylish workplace with computer at home",
							"pink-desk-in-the-home-office", "Pink desk in the home office",
							"young-woman-sitting-on-the-sofa-and-working-on-her-laptop", "Young woman sitting on the sofa and working on her laptop"))
				}
