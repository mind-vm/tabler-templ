// batchCPages are the carousel, placeholder and card-gradients pages.
func batchCPages() map[string]templ.Component {
	return map[string]templ.Component{
		"carousel":       carouselPage(),
		"placeholder":    placeholderPage(),
		"card-gradients": cardGradientsPage(),
	}
}

// slides turns photo file names (without .jpg) and their alt texts into carousel slides.
func slides(pairs ...string) []carousel.Slide {
	var ss []carousel.Slide
	for i := 0; i+1 < len(pairs); i += 2 {
		ss = append(ss, carousel.Slide{Src: photo("photos/" + pairs[i] + ".jpg"), Alt: pairs[i+1]})
	}
	return ss
}

func captioned(names ...string) []carousel.Slide {
	var ss []carousel.Slide
	for _, n := range names {
		ss = append(ss, carousel.Slide{Src: photo("photos/" + n + ".jpg"), Title: "Slide label", Text: "Nulla vitae elit libero, a pharetra augue mollis interdum."})
	}
	return ss
}

// headerCard is a card with a title in its header and the children in its body.
templ headerCard(title string) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				{ title }
			}
		}
		@card.Body() {
			{ children... }
		}
	}
}

