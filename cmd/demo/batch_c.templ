			<div class="col-md-6">
				@headerCard("Carousel with captions") {
					@carousel.Carousel(carousel.Props{ID: "carousel-captions", Indicators: carousel.NoIndicators, Label: "Carousel with captions"},
						captioned("coffee-on-a-table-with-other-items", "young-entrepreneur-working-from-a-modern-cafe-2",
							"soft-photo-of-woman-on-the-bed-with-the-book-and-cup-of-coffee-in-hands", "fairy-lights-at-the-beach-in-bulgaria", "woman-working-on-laptop-at-home-office"))
				}
			</div>
			<div class="col-md-6">
				@headerCard("Carousel with dot indicators") {
					@carousel.Carousel(carousel.Props{ID: "carousel-indicators-dot", Fade: true, Indicators: carousel.Dots, NoControls: true, Label: "Carousel with dot indicators"},
						slides("modern-home-office", "Modern Home Office",
							"blond-using-her-laptop-at-her-bedroom", "Blond using her laptop at her bedroom",
							"tropical-palm-leaves-floral-pattern-background", "Tropical palm leaves, floral pattern background",
							"woman-read-book-and-drink-coffee", "Woman read book and drink coffee",
							"book-on-the-grass", "Book on the grass"))
				}
			</div>
			<div class="col-md-6">
				@headerCard("Carousel with thumbnail indicators") {
					@carousel.Carousel(carousel.Props{ID: "carousel-indicators-thumb", Fade: true, Indicators: carousel.Thumbs, NoControls: true, Label: "Carousel with thumbnail indicators"},
						slides("colorful-exotic-flowers-and-greenery", "Colorful Exotic Flowers and Greenery",
							"workplace-with-laptop-on-table-at-home", "Workplace with laptop on table at home",
							"city-lights-reflected-in-the-water-at-night", "City lights reflected in the water at night",
							"cryptocurrency-bitcoin-coins", "Cryptocurrency Bitcoin coins",
							"woman-read-book-and-drink-coffee-2", "Woman read book and drink coffee"))
				}
			</div>
			<div class="col-md-6">
				@headerCard("Carousel with vertical dot indicators") {
					@carousel.Carousel(carousel.Props{ID: "carousel-indicators-dot-vertical", Fade: true, Indicators: carousel.Dots, Vertical: true, NoControls: true,
						Label: "Carousel with vertical dot indicators"},
