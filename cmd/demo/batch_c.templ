							"beautiful-blonde-woman-on-a-wooden-pier-by-the-lake", "Beautiful blonde woman on a wooden pier by the lake",
							"white-apple-imac-computer-with-elephant-mousepad", "White Apple iMac computer with elephant mousepad",
							"workplace-with-laptop-on-table-at-home-2", "Workplace with laptop on table at home",
							"working-in-a-restaurant-macbook-cheese-cake-and-cup-of-coffee", "Working in a restaurant: Macbook, Cheese Cake and Cup of Coffee"))
				}
			</div>
			<div class="col-md-6">
				@headerCard("Carousel with vertical thumbnail indicators") {
					@carousel.Carousel(carousel.Props{ID: "carousel-indicators-thumb-vertical", Fade: true, Indicators: carousel.Thumbs, Vertical: true, NoControls: true,
						Label: "Carousel with vertical thumbnail indicators"},
