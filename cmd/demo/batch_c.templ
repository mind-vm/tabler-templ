// Placeholder page: the preview's cards/placeholder/Card1–6.

// placeholderLines are the title line and the text lines of a placeholder card body.
templ placeholderLines(widths ...string) {
	@placeholder.Placeholder(placeholder.Props{Class: "col-9 mb-3"})
	for _, w := range widths {
		@placeholder.Placeholder(placeholder.Props{Class: w, Size: "xs"})
	}
}

templ placeholderButton() {
	<div class="mt-3">
		@button.Button(button.Props{Href: "#", Variant: button.VariantPrimary, Disabled: true, Class: "placeholder col-4", Attributes: templ.Attributes{"aria-hidden": "true"}})
	</div>
}

// placeholderImageCard is Card1: an image, a title, two lines and a button, glowing.
templ placeholderImageCard() {
	@card.Card(card.Props{Class: "placeholder-glow"}) {
		@placeholder.Placeholder(placeholder.Props{Class: "ratio ratio-21x9 card-img-top"})
		@card.Body() {
			@placeholderLines("col-10", "col-11")
			@placeholderButton()
		}
	}
}

templ placeholderAvatar(class string) {
	@placeholder.Placeholder(placeholder.Props{Class: "avatar avatar-rounded " + class})
}

templ placeholderPage() {
	@preview("placeholder") {
		<div class="row row-cards">
			for range 4 {
				<div class="col-6 col-md-3">
					@placeholderImageCard()
				</div>
			}
			<div class="col-12 col-md-4">
				<div class="row row-cards">
					<div class="col-12">
						@card.Card() {
							@card.Body() {
								<div class="row">
									<div class="col-auto">
										@placeholderAvatar("")
									</div>
									<div class="col">
										@placeholder.Placeholder(placeholder.Props{Class: "col-9", Size: "xs"})
										@placeholder.Placeholder(placeholder.Props{Class: "col-7", Size: "xs"})
									</div>
								</div>
							}
						}
					</div>
					<div class="col-12">
						@card.Card() {
							@card.Body(card.Props{Class: "py-5 text-center"}) {
								<div>
									@placeholderAvatar("avatar-lg mb-3")
								</div>
								<div class="w-75 mx-auto">
									@placeholderLines("col-10")
								</div>
							}
						}
					</div>
				</div>
			</div>
			<div class="col-12 col-md-4">
				<div class="row row-cards">
					<div class="col-12">
						@placeholderImageCard()
					</div>
					<div class="col-12">
						@card.Card() {
							<div class="row g-0 align-items-center placeholder-glow">
								<div class="col-3">
									@placeholder.Placeholder(placeholder.Props{Class: "ratio ratio-1x1 card-img-start"})
								</div>
								<div class="col">
									@card.Body() {
										@placeholderLines("col-10", "col-11")
									}
								</div>
							</div>
						}
					</div>
				</div>
			</div>
			<div class="col-12 col-md-4">
				<div class="row row-cards">
					<div class="col-12">
						@card.Card() {
							@card.Body(card.Props{Class: "text-end placeholder-glow"}) {
								@placeholderLines("col-10", "col-12", "col-11", "col-8", "col-10")
							}
						}
					</div>
					<div class="col-12">
						@card.Card() {
							@listgroup.List(listgroup.Props{Unordered: true, Flush: true, Class: "placeholder-glow"}) {
								for range 4 {
									@listgroup.Item(listgroup.ItemProps{ListItem: true}) {
										<div class="row align-items-center">
											<div class="col-auto">
												@placeholderAvatar("")
											</div>
											<div class="col-7">
												@placeholder.Placeholder(placeholder.Props{Class: "col-9", Size: "xs"})
												@placeholder.Placeholder(placeholder.Props{Class: "col-7", Size: "xs"})
											</div>
											<div class="col-2 ms-auto text-end">
												@placeholder.Placeholder(placeholder.Props{Class: "col-8", Size: "xs"})
												@placeholder.Placeholder(placeholder.Props{Class: "col-10", Size: "xs"})
											</div>
										</div>
									}
								}
							}
						}
					</div>
				</div>
			</div>
		</div>
	}
}

// Card gradients page.

// welcomeFigure is a key figure of the welcome card: label, value with trend and a bar.
templ welcomeFigure(label, value string, change float64, changeText string, bar float64, color string) {
	<div class="col-auto">
		@typography.Subheader() {
			{ label }
		}
		<div class="d-flex align-items-baseline">
			<div class="h3 me-2">{ value }</div>
			<div class="me-auto">
				@trending.Trending(trending.Props{Value: change, Text: changeText})
			</div>
		</div>
		@progress.Progress(progress.Props{Size: progress.SizeSmall, Value: bar, Color: color})
	</div>
}

// orderStat is a small figure card with an avatar icon and a bar.
templ orderStat(color, label, value, ic string, bar float64) {
	@card.Card(card.Props{Gradient: color, GradientEdge: "start"}) {
		@card.Body() {
			<div class="row g-3">
				<div class="col">
					@typography.Subheader(typography.SubheaderProps{Level: 2, Class: "mb-1"}) {
						{ label }
					}
					<div class="h3 m-0">{ value }</div>
				</div>
				<div class="col-auto">
					@avatar.Avatar(avatar.Props{Icon: ic, Color: color})
				</div>
				<div class="col-12">
					@progress.Progress(progress.Props{Size: progress.SizeSmall, Value: bar, Color: color})
				</div>
			</div>
		}
	}
}

templ weatherCard(gradient, city, ic, text, temp string) {
	@card.Card(card.Props{Gradient: gradient, GradientEdge: "end"}) {
		@card.Body() {
			<div class="row">
				<div class="col">
					<div class="row">
						<div class="col-auto">
							<h2 class="card-title mb-2">{ city }</h2>
						</div>
						<div class="col">
							@icon.Icon(ic)
						</div>
					</div>
					<div class="text-secondary">{ text }</div>
				</div>
				<div class="col-auto">
					<div class="display-5 lh-1 fw-lighter">{ temp }°</div>
				</div>
			</div>
		}
	}
}

templ trendCard(gradient, ic, value, change, label string) {
	@card.Card(card.Props{Size: card.SizeSmall, Gradient: gradient, GradientEdge: "end"}) {
		@card.Body() {
			<div class="row align-items-center">
				<div class="col-auto">
					@avatar.Avatar(avatar.Props{Icon: ic, Shape: avatar.ShapeSquare, Class: "bg-" + gradient + " text-white"})
				</div>
				<div class="col">
					<div class="fw-medium">
						{ value }
						<span class={ "float-end fw-medium text-" + gradient }>{ change }</span>
					</div>
					<div class="text-secondary">{ label }</div>
				</div>
			</div>
		}
	}
}

templ celebrationCard(gradient, emoji, emojiClass, title string, button_ string) {
	@card.Card(card.Props{Gradient: gradient}) {
		@card.Body(card.Props{Class: "text-center p-5"}) {
			<div class={ emojiClass + " lh-1 mb-2" }>{ emoji }</div>
			<h2 class="h1">{ title }</h2>
			{ children... }
			<div class="mt-5">
				@button.Button(button.Props{Type: "button", Variant: button.VariantPrimary, Icon: "ti-gift"}) {
					{ button_ }
				}
			</div>
		}
	}
}

templ contactButton(ic, label string) {
	@button.Button(button.Props{Href: "#", Icon: ic, IconOnly: true, Pill: true, Attributes: tooltip.Attrs(label, tooltip.Top)})
}

templ cardGradientsPage() {
	@preview("card-gradients") {
		<div class="row row-cards">
			<div class="col-md-6">
				<div class="row row-cards">
					<div class="col-12">
						@card.Card(card.Props{Gradient: "default"}) {
							@card.Body() {
								<div class="row gy-3">
									<div class="col-12 col-sm-6 d-flex flex-column">
										<h2 class="h2">Welcome back, Paweł</h2>
										<p class="text-secondary">You have 5 new messages and 2 new notifications.</p>
										<div class="row g-5 mt-auto">
											@welcomeFigure("Today's Sales", "6,782", 7, "", 75, "success")
											@welcomeFigure("Growth Rate", "78,4%", -1, "", 78, "danger")
										</div>
									</div>
									<div class="col-12 col-sm-6 d-flex justify-content-center">
										<a href="./illustrations" aria-label="Illustrations">
											<img src={ photo("illustrations/light/good-info.png") } height="200" alt=""/>
										</a>
									</div>
								</div>
							}
						}
					</div>
					<div class="col-12">
						<div class="row">
							<div class="col-6">
								<div class="row row-cards">
									<div class="col-12">
										@card.Card(card.Props{Gradient: "danger"}) {
											@card.Body(card.Props{Class: "p-5 text-center"}) {
												<h2 class="card-title">Are you sure to delete this card?</h2>
												<p class="text-secondary">If you delete this card, you will not be able to recover it.</p>
												@button.List(button.ListProps{Center: true, Class: "mt-5"}) {
													@button.Button(button.Props{Type: "button", Variant: button.VariantDanger}) {
														Yes, delete it
													}
													@button.Button(button.Props{Type: "button"}) {
														Cancel
													}
												}
											}
										}
									</div>
									<div class="col-12">
										@card.Card(card.Props{Gradient: "success"}) {
											@card.Body(card.Props{Class: "p-5 text-center"}) {
												<div class="mb-3">
													@icon.Icon("ti-circle-check", icon.Props{Size: icon.SizeLarge, Color: "success"})
												</div>
												<h2 class="card-title">Success!</h2>
												<p class="text-secondary">Your changes have been saved successfully.</p>
												@button.List(button.ListProps{Center: true, Class: "mt-5"}) {
													@button.Button(button.Props{Type: "button", Variant: button.VariantSuccess}) {
														Continue
													}
												}
											}
										}
									</div>
								</div>
							</div>
							<div class="col-6">
								<div class="row row-cards">
									<div class="col-12">
										@card.Card(card.Props{Gradient: "love"}) {
											@ribbon.Ribbon(ribbon.Props{Color: "pink", Text: "Featured"})
											@card.Body() {
												@typography.Subheader(typography.SubheaderProps{Class: "text-pink"}) {
												Professional
											}
												<div class="d-flex align-items-baseline mt-5">
													<div class="display-5">$199</div>
													<div class="fs-1 text-secondary">/ month</div>
												</div>
												@iconlist.List(iconlist.Props{Color: "success", Class: "mt-6"}) {
													@iconlist.Item() {
														<span><strong>Unlimited</strong> Target Audience</span>
													}
													@iconlist.Item() {
														<span><strong>1</strong> User Account</span>
													}
													@iconlist.Item() {
														<span><strong>100+</strong> Video Tuts</span>
													}
													@iconlist.Item(iconlist.ItemProps{Icon: "ti-x", Color: "secondary", Class: "text-secondary"}) {
														Public Displays
													}
												}
												<p class="mt-4 text-muted">This plan is perfect for small businesses and startups. It includes all the features you need to get started.</p>
												<div class="mt-6">
													@button.Button(button.Props{Type: "button", Variant: button.Variant("pink"), Block: true}) {
														Purchase Now
													}
												</div>
											}
										}
									</div>
									<div class="col-12">
										@orderStat("success", "Earned", "$2,847", "ti-credit-card", 75)
									</div>
									<div class="col-12">
										@orderStat("yellow", "Pending Orders", "47", "ti-clock", 38)
									</div>
									<div class="col-12">
										@orderStat("red", "Cancelled Orders", "12", "ti-shopping-cart-x", 8)
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-3">
				<div class="row row-cards">
					<div class="col-12">
						@celebrationCard("rainbow", "🍾 🎉", "display-5", "Happy Birthday, Andrew!", "Grab my special deal") {
							<p class="text-secondary">We truly hope your day is brimming with joy, laughter, and countless moments that bring a smile to your face!</p>
							<p class="text-secondary">To celebrate your special day, here's a discount code just for you: <strong class="text-body">NWYR20</strong>. Enjoy <strong class="text-body">20% off</strong> your next purchase!</p>
						}
					</div>
					<div class="col-12">
						@celebrationCard("gold", "🏆", "display-3", "You are winner!", "Claim Your Prize") {
							<p class="text-secondary">You've been selected as our lucky winner for completing <strong class="text-body">100 orders</strong> this month! Click below to claim your exclusive prize and enjoy the benefits!</p>
						}
					</div>
				</div>
			</div>
			<div class="col-3">
				<div class="row row-cards">
					<div class="col-12">
						@weatherCard("ocean", "Warsaw, PL", "ti-cloud-rain", "Cloudy morning", "3")
					</div>
					<div class="col-12">
						@weatherCard("snow", "Oslo, NO", "ti-cloud", "Snowy day", "-5")
					</div>
					<div class="col-12">
						@weatherCard("sun", "Dubai, AE", "ti-sun", "Sunny day", "32")
					</div>
					<div class="col-12">
						@card.Card(card.Props{Gradient: "yellow"}) {
							@card.Body(card.Props{Class: "text-center py-6"}) {
								<div class="position-absolute top-0 end-0 p-1">
									@button.Button(button.Props{Type: "button", Action: true, Icon: "ti-star-filled", IconOnly: true, Label: "Favorite", Class: "text-yellow"})
								</div>
								<div>
									@avatar.Avatar(avatar.Props{Src: avatarURL("004m"), Size: avatar.Size2XL, Shape: avatar.ShapeCircle})
								</div>
								<div class="h1 mt-4 mb-1">Egan Poetz</div>
								<div class="text-secondary">Research Nurse</div>
								@button.List(button.ListProps{Class: "justify-content-center mt-3"}) {
									@contactButton("ti-message", "Message")
									@contactButton("ti-phone", "Phone")
									@contactButton("ti-mail", "Email")
								}
							}
						}
					</div>
					<div class="col-12">
						@card.Card(card.Props{Size: card.SizeSmall, Gradient: "primary", GradientEdge: "end"}) {
							@card.Body() {
								<div class="row align-items-center">
									<div class="col">
										<div class="fw-medium">1700</div>
										<div class="text-secondary">Users</div>
									</div>
									<div class="col-auto">
										@sparkline.Sparkline(sparkline.Props{Color: "primary", Fill: true, AriaLabel: "Trend", Values: []float64{11, 16, 13, 20, 17, 24, 19, 23, 16, 20, 13, 17, 11, 19}})
									</div>
								</div>
							}
						}
					</div>
					<div class="col-12">
						@trendCard("green", "ti-arrow-up", "$5,256.99", "+4%", "Revenue last 30 days")
					</div>
					<div class="col-12">
						@trendCard("red", "ti-arrow-down", "342", "-4.3%", "Sales last 30 days")
					</div>
				</div>
			</div>
		</div>
	}
}
