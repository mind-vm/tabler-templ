		<div class="row row-cards">
			<div class="col-md-6">
				@headerCard("Carousel") {
					@carousel.Carousel(carousel.Props{ID: "carousel-default", Indicators: carousel.NoIndicators, NoControls: true, Label: "Carousel"},
						slides("beautiful-blonde-woman-relaxing-with-a-can-of-coke-on-a-tree-stump-by-the-beach", "Beautiful blonde woman relaxing with a can of coke on a tree stump by the beach",
							"brainstorming-session-with-creative-designers", "Brainstorming session with creative designers",
							"finances-us-dollars-and-bitcoins-currency-money", "Finances - US Dollars and Bitcoins - Currency - Money",
							"group-of-people-brainstorming-and-taking-notes-2", "Group of people brainstorming and taking notes",
							"blue-sofa-with-pillows-in-a-designer-living-room-interior", "Blue sofa with pillows in a designer living room interior"))
				}
			</div>
			<div class="col-md-6">
				@headerCard("Carousel with indicators") {
					@carousel.Carousel(carousel.Props{ID: "carousel-indicators", NoControls: true, Label: "Carousel with indicators"},
						slides("home-office-desk-with-macbook-iphone-calendar-watch-and-organizer", "Home office desk with Macbook, iPhone, calendar, watch & organizer",
							"young-woman-working-in-a-cafe", "Young woman working in a cafe",
							"everything-you-need-to-work-from-your-bed", "Everything you need to work from your bed",
							"young-entrepreneur-working-from-a-modern-cafe", "Young Entrepreneur Working from a Modern Cafe",
							"finances-us-dollars-and-bitcoins-currency-money-2", "Finances - US Dollars and Bitcoins - Currency - Money"))
