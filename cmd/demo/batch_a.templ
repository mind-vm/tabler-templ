package main

import (
	"github.com/mind-vm/tabler-templ/typography"
	"strconv"

	"github.com/mind-vm/tabler-templ/accordion"
	"github.com/mind-vm/tabler-templ/avatar"
	"github.com/mind-vm/tabler-templ/button"
	"github.com/mind-vm/tabler-templ/card"
	"github.com/mind-vm/tabler-templ/listgroup"
	"github.com/mind-vm/tabler-templ/shimmer"
	"github.com/mind-vm/tabler-templ/signal"
	"github.com/mind-vm/tabler-templ/switchicon"
	"github.com/mind-vm/tabler-templ/table"
	"github.com/mind-vm/tabler-templ/tag"
)

// batchAPages are the accordion, tags, signal, switch-icons and text-shimmer pages.
func batchAPages() map[string]templ.Component {
	return map[string]templ.Component{
		"accordion":    accordionPage(),
		"tags":         tagsPage(),
		"signal":       signalPage(),
		"switch-icons": switchIconsPage(),
		"text-shimmer": textShimmerPage(),
	}
}

// ---- accordion

type faq struct{ Q, A string }

var accordionFAQ = []faq{
	{"What makes Tabler different from other UI frameworks?", "Tabler offers a modern, responsive design with a clean aesthetic, built on Bootstrap for ease of use and flexibility."},
	{"How can I customize Tabler components to fit my design needs?", "You can customize Tabler components using CSS variables, SCSS, and utility classes to match your design preferences."},
	{"Is Tabler optimized for performance and fast loading times?", "Yes, Tabler is lightweight, optimized for modern browsers, and follows best practices for fast loading and efficiency."},
	{"How accessible are Tabler components?", "Tabler components follow WAI-ARIA standards and support keyboard navigation, screen readers, and accessibility best practices."},
}

templ text(s string) {
	{ s }
}

// faqItems builds the four sample items, the first one open.
func faqItems(plus bool, icon string) []accordion.Item {
	items := make([]accordion.Item, len(accordionFAQ))
	for i, f := range accordionFAQ {
		items[i] = accordion.Item{Key: strconv.Itoa(i + 1), Title: f.Q, Open: i == 0, Plus: plus, Icon: icon, Content: text(f.A)}
	}
	return items
}

templ accordionPage() {
	@preview("accordion") {
		<div class="row row-cards">
			<div class="col-md-6">
				@section("Default", "The base accordion — one panel open at a time.") {
					@accordion.Accordion(accordion.Props{ID: "accordion-default", HeadingLevel: 2}, faqItems(false, ""))
				}
			</div>
			<div class="col-md-6">
				@card.Card() {
					@card.Body() {
						@card.Title() {
							Flush
						}
						@card.Subtitle() {
							@withCode("Add `accordion-flush` to remove the card border and rounded corners.")
						}
					}
					@accordion.Accordion(accordion.Props{ID: "accordion-flush", HeadingLevel: 2, Style: accordion.Flush}, faqItems(false, ""))
				}
			</div>
			<div class="col-md-6">
				@section("Tabs", "Add `accordion-tabs` for a tab-like header instead of the default style.") {
					@accordion.Accordion(accordion.Props{ID: "accordion-tabs", HeadingLevel: 2, Style: accordion.Tabs}, faqItems(false, ""))
				}
			</div>
			<div class="col-md-6">
				@section("Inverted", "Add `accordion-inverted` to flip the toggle icon to the start of the header.") {
					@accordion.Accordion(accordion.Props{ID: "accordion-inverted", HeadingLevel: 2, Style: accordion.Inverted}, faqItems(false, ""))
				}
			</div>
			<div class="col-md-6">
				@section("Inverted with plus icon", "Combine `accordion-inverted` with `accordion-button-toggle-plus` and a custom icon in the toggle.") {
					@accordion.Accordion(accordion.Props{ID: "accordion-inverted-plus", HeadingLevel: 2, Style: accordion.Inverted}, faqItems(true, ""))
				}
			</div>
			<div class="col-md-6">
				@section("With icons", "Add an `accordion-button-icon` next to each panel's title.") {
					@accordion.Accordion(accordion.Props{ID: "accordion-icons", HeadingLevel: 2}, faqItems(false, "ti-link"))
				}
			</div>
		</div>
	}
}

// ---- tags

var tagFlags = []named{{"abkhazia", "Abkhazia"}, {"af", "Afghanistan"}, {"african-union", "African Union"}, {"ax", "Åland Islands"}, {"al", "Albania"},
	{"dz", "Algeria"}, {"as", "American Samoa"}, {"ad", "Andorra"}, {"ao", "Angola"}}

var tagIcons = []string{"bold", "italic", "underline", "copy", "scissors", "file-plus", "file-minus", "ghost", "star", "script", "photo", "dog", "piano"}

var tagPeople = []named{{"000m", "Paweł Kuna"}, {"052f", "Jeffie Lewzey"}, {"002m", "Mallory Hulme"}, {"003m", "Dunn Slane"}, {"000f", "Emmy Levet"},
	{"001f", "Maryjo Lebarree"}, {"004m", "Egan Poetz"}, {"002f", "Kellie Skingley"}}

var tagColors = []string{"blue", "azure", "indigo", "purple", "pink", "red", "orange", "yellow", "lime", "green", "teal", "cyan"}

func label(i int) string { return "Label " + strconv.Itoa(i) }

templ tagsPage() {
	@preview("tags") {
		<div class="row row-cards row-cols-1 row-cols-md-2 row-cols-lg-3">
			<div class="col">
				@section("Default tags", "The base tag, for a plain label.") {
					@tag.List() {
						for i := 1; i <= 14; i++ {
							@tag.Tag(tag.Props{Text: label(i), Removable: true})
						}
					}
				}
			</div>
			<div class="col">
				@section("Tags with flag", "Pair a tag with a country flag.") {
					@tag.List() {
						for _, f := range tagFlags {
							@tag.Tag(tag.Props{Text: f.Text, Flag: f.Variant, Removable: true})
						}
					}
				}
			</div>
			<div class="col">
				@section("Tags with icon", "Add an icon before the label.") {
					@tag.List() {
						for _, n := range tagIcons {
							@tag.Tag(tag.Props{Text: n, Icon: "ti-" + n, Removable: true})
						}
					}
				}
			</div>
			<div class="col">
				@section("Tags with avatar", "Add a person's avatar before the label.") {
					@tag.List() {
						for _, p := range tagPeople {
							@tag.Tag(tag.Props{Text: p.Text, Avatar: avatarURL(p.Variant), Removable: true})
						}
					}
				}
			</div>
			<div class="col">
				@section("Tags with status", "Add a small status dot in any theme or extended color.") {
					@tag.List() {
						for _, c := range tagColors {
							@tag.Tag(tag.Props{Text: title(c), Status: c, Removable: true})
						}
					}
				}
			</div>
			<div class="col">
				@section("Tags with legend", "Add a colored legend square instead of a dot.") {
					@tag.List() {
						for _, c := range tagColors {
							@tag.Tag(tag.Props{Text: title(c), Legend: c, Removable: true})
						}
					}
				}
			</div>
			<div class="col">
				@section("Selectable tags", "Add a `tag-check` checkbox to let users toggle a tag on and off.") {
					@tag.List() {
						for i := 1; i <= 12; i++ {
							@tag.Tag(tag.Props{Text: label(i), Check: true, Checked: i >= 7, Removable: true})
						}
					}
				}
			</div>
			<div class="col">
				@section("Tags with badge", "Add a `tag-badge` count to the end of the tag.") {
					@tag.List() {
						for i := 1; i <= 12; i++ {
							@tag.Tag(tag.Props{Text: "Label", Badge: strconv.Itoa(i), Removable: true})
						}
					}
				}
			</div>
		</div>
	}
}

// ---- signal

type level struct {
	Value, Max int
	Color      string
	Text       string
}

templ signalRows(levels []level) {
	<div class="d-flex flex-column gap-2">
		for _, l := range levels {
			<div class="d-flex align-items-center gap-2">
				@signal.Signal(signal.Props{Value: l.Value, Max: l.Max, Color: l.Color})
				{ l.Text }
			</div>
		}
	</div>
}

var signalSemantic = []string{"primary", "secondary", "success", "info", "warning", "danger", "dark", "muted"}

type taskPriority struct {
	Task  string
	Value int
	Color string
	Text  string
}

var signalTasks = []taskPriority{{"Payment page returns 500 on submit", 3, "red", "Urgent"}, {"Update the onboarding copy", 2, "blue", "Normal"},
	{"Export invoices to CSV", 2, "blue", "Normal"}, {"Refresh the team page photos", 1, "green", "Low"}}

templ signalColorRow(colors []string) {
	<div class="d-flex flex-wrap gap-3">
		for _, c := range colors {
			@signal.Signal(signal.Props{Value: 2, Color: c, Label: "2 of 3, " + c})
		}
	</div>
}

templ signalPage() {
	@preview("signal") {
		<div class="row row-cards">
			<div class="col-md-6 col-lg-4">
				@section("By priority", "The number of lit bars carries the level, the color only supports it.") {
					@signalRows([]level{{3, 3, "orange", "Urgent"}, {2, 3, "blue", "Normal"}, {1, 3, "green", "Low"}, {0, 3, "", "None"}})
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Number of bars", "Use from two to five `.signal-bar` elements; the steps stay even.") {
					@signalRows([]level{{1, 2, "primary", "1 of 2"}, {2, 3, "primary", "2 of 3"}, {3, 4, "primary", "3 of 4"}, {4, 5, "primary", "4 of 5"}})
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Sizes", "A signal is a `1.25rem` square, like an extra small avatar. Set `--tblr-signal-size` to resize it.") {
					<div class="d-flex align-items-end gap-4">
						for _, s := range []string{"1rem", "1.25rem", "1.5rem", "2rem", "2.5rem"} {
							@signal.Signal(signal.Props{Value: 2, Color: "primary", Label: "2 of 3", Attributes: templ.Attributes{"style": "--tblr-signal-size: " + s}})
						}
					</div>
				}
			</div>
			<div class="col-md-6">
				@section("Colors", "Add `.signal-{color}` to color the bars.") {
					<div class="d-flex flex-column gap-3">
						<div>
							@typography.Subheader(typography.SubheaderProps{Class: "mb-2"}) {
								Semantic colors
							}
							@signalColorRow(signalSemantic)
						</div>
						<div>
							@typography.Subheader(typography.SubheaderProps{Class: "mb-2"}) {
								Extra colors
							}
							@signalColorRow(tagColors)
						</div>
					</div>
				}
			</div>
			<div class="col-md-6">
				@card.Card() {
					@table.Table(table.Props{Responsive: true, Class: "table-vcenter card-table"}) {
						<thead>
							<tr>
								<th>Task</th>
								<th>Priority</th>
							</tr>
						</thead>
						<tbody>
							for _, t := range signalTasks {
								<tr>
									<td>{ t.Task }</td>
									<td class="text-nowrap">
										@signal.Signal(signal.Props{Value: t.Value, Color: t.Color, Class: "me-1"})
										{ t.Text }
									</td>
								</tr>
							}
						</tbody>
					}
				}
			</div>
		</div>
	}
}

// ---- switch icons

type toggle struct {
	Icon, Active, Color, Label string
}

// The five sample toggles; only heart and star switch to the filled icon, the others to the same outline.
var basicToggles = []toggle{{"ti-heart", "", "red", "Like"}, {"ti-star", "", "yellow", "Add to favorites"}, {"ti-bookmark", "", "primary", "Bookmark"},
	{"ti-bell", "", "orange", "Notify me"}, {"ti-thumb-up", "", "blue", "Vote up"}}

var twoIcons = []toggle{{"ti-check", "ti-x", "red", "Toggle"}, {"ti-player-play", "ti-player-pause", "primary", "Play"}, {"ti-volume", "ti-volume-off", "secondary", "Mute"},
	{"ti-eye", "ti-eye-off", "secondary", "Hide"}, {"ti-lock-open", "ti-lock", "green", "Lock"}}

var switchVariants = []switchicon.Variant{switchicon.Fade, switchicon.Scale, switchicon.Flip, switchicon.SlideUp, switchicon.SlideDown, switchicon.SlideStart, switchicon.SlideEnd}

type repo struct{ Name, Text string }

var starredRepos = []repo{{"tabler/tabler", "Dashboard UI kit"}, {"tabler/tabler-icons", "5900+ free SVG icons"}, {"tabler/tabler-react", "React components"},
	{"tabler/tabler-emails", "Responsive email templates"}}

func toggleProps(t toggle) switchicon.Props {
	return switchicon.Props{Icon: t.Icon, ActiveIcon: t.Active, ActiveColor: t.Color, Label: t.Label}
}

templ switchIconsPage() {
	@preview("switch-icons") {
		<div class="row row-cards">
			<div class="col-md-6 col-lg-4">
				@section("Basic", "A `SwitchIcon` swaps the outline icon for the filled one in `activeColor`.") {
					@button.List() {
						for _, t := range basicToggles {
							@switchicon.SwitchIcon(toggleProps(t))
						}
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Animations", "Pick a transition with `variant`: fade, scale, flip or one of the slides.") {
					@button.List() {
						for _, v := range switchVariants {
							@switchicon.SwitchIcon(switchicon.Props{Icon: "ti-heart", Variant: v, Label: "Like (" + string(v) + ")"})
						}
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Two icons", "Set `activeIcon` to switch to a different icon instead of the filled variant.") {
					@button.List() {
						for _, t := range twoIcons {
							{{ p := toggleProps(t) }}
							{{ p.Variant = switchicon.Flip }}
							@switchicon.SwitchIcon(p)
						}
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("In an action button", "Add `action` to wrap the switch in a `btn-action`, which then carries the toggle, hover and focus.") {
					@button.Actions() {
						for _, t := range basicToggles {
							{{ p := toggleProps(t) }}
							{{ p.Variant, p.Action = switchicon.Scale, true }}
							@switchicon.SwitchIcon(p)
						}
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Loading", "Add `loading` to show a spinner in place of the icons; clicks are ignored.") {
					@button.List() {
						for _, i := range []int{1, 0, 2} {
							{{ p := toggleProps(basicToggles[i]) }}
							{{ p.Loading = true }}
							@switchicon.SwitchIcon(p)
						}
					}
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Wait for a request", "Pass a promise to `event.wait()` and the switch waits for it. The last one fails and stays as it was.") {
					@button.List() {
						for _, i := range []int{1, 0, 2, 3} {
							{{ p := toggleProps(basicToggles[i]) }}
							{{ p.Variant = switchicon.Scale }}
							{{ p.Attributes = templ.Attributes{"data-request": kitIf(i == 3, "fail") + kitIf(i != 3, "ok")} }}
							@switchicon.SwitchIcon(p)
						}
					}
					@switchRequestScript()
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("In a list", "The event bubbles, so one listener on the list keeps the count in sync.") {
					@listgroup.List(listgroup.Props{Flush: true, Attributes: templ.Attributes{"id": "starred-repos"}}) {
						for i, r := range starredRepos {
							@listgroup.Item(listgroup.ItemProps{Class: "d-flex align-items-center gap-3 px-0"}) {
								<div class="flex-fill">
									<div class="fw-medium">{ r.Name }</div>
									<div class="text-secondary">{ r.Text }</div>
								</div>
								@switchicon.SwitchIcon(switchicon.Props{Icon: "ti-star", ActiveColor: "yellow", Variant: switchicon.Scale, Active: i < 2, Label: "Star " + r.Name})
							}
						}
					}
					<div class="text-secondary mt-3"><span id="starred-count">2</span> starred</div>
					@starredCountScript()
				}
			</div>
		</div>
	}
}

// switchRequestScript is the preview's demo of event.wait(): a simulated request behind the switch.
templ switchRequestScript() {
	<script>
		document.querySelectorAll('[data-request]').forEach((button) => {
			button.addEventListener('toggle.bs.switch-icon', (event) => {
				const fails = button.dataset.request === 'fail'
				event.wait(new Promise((resolve, reject) => setTimeout(fails ? reject : resolve, 1500)))
			})
		})
	</script>
}

// starredCountScript counts the active switches of the list after every change.
templ starredCountScript() {
	<script>
		(() => {
			const list = document.getElementById('starred-repos')
			list.addEventListener('change.bs.switch-icon', () => {
				document.getElementById('starred-count').textContent = list.querySelectorAll('.switch-icon.active').length
			})
		})()
	</script>
}

// ---- text shimmer

var shimmerLabels = []string{"Thinking… ", "Generating a reply… ", "Searching the web… ", "Reading 3 files… "}

templ shimmerSetting(variable, value, note string) {
	<div class="d-flex align-items-center gap-2">
		@shimmer.Shimmer(shimmer.Props{Attributes: templ.Attributes{"style": variable + ": " + value}}) {
			Thinking…
		}
		<span class="text-secondary small">{ note }</span>
	</div>
}

templ textShimmerPage() {
	@preview("text-shimmer") {
		<div class="row row-cards">
			<div class="col-md-6 col-lg-4">
				@section("Basic", "Add `.text-shimmer` to a short label that reports work in progress.") {
					<div class="d-flex flex-column gap-2">
						for _, l := range shimmerLabels {
							@shimmer.Shimmer(shimmer.Props{Live: true}) {
								{ l }
							}
						}
					</div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("With a loader", "Put an empty `.text-shimmer-loader` before the label. One element, a small spinner in the text color.") {
					<div class="d-flex flex-column gap-2">
						for _, l := range shimmerLabels {
							@shimmer.Shimmer(shimmer.Props{Live: true, Loader: true}) {
								{ l }
							}
						}
						@shimmer.Shimmer(shimmer.Props{Loader: true, Class: "text-primary"}) {
							Thinking…
						}
						@shimmer.Shimmer(shimmer.Props{Loader: true, Class: "h2 mb-0"}) {
							Thinking…
						}
					</div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Colors", "The text keeps its own color, so any text utility works.") {
					<div class="d-flex flex-column gap-2">
						for _, c := range []string{"", "text-secondary", "text-primary", "text-green", "text-red"} {
							@shimmer.Shimmer(shimmer.Props{Class: c}) {
								Thinking…
							}
						}
					</div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Sizes", "The shimmer follows the font size.") {
					<div class="d-flex flex-column gap-2">
						for _, c := range []string{"small", "", "h3 mb-0", "h1 mb-0"} {
							@shimmer.Shimmer(shimmer.Props{Class: c}) {
								Thinking…
							}
						}
					</div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Speed", "Set `--tblr-text-shimmer-duration` to change the speed of one sweep.") {
					<div class="d-flex flex-column gap-2">
						for _, s := range []string{"1s", "2s", "4s"} {
							@shimmerSetting("--tblr-text-shimmer-duration", s, s)
						}
					</div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("Contrast", "Set `--tblr-text-shimmer-opacity` to dim the text more or less between sweeps.") {
					<div class="d-flex flex-column gap-2">
						for _, o := range []string{"0.2", "0.4", "0.7"} {
							@shimmerSetting("--tblr-text-shimmer-opacity", o, o)
						}
					</div>
				}
			</div>
			<div class="col-md-6 col-lg-4">
				@section("In a chat", "A shimmering label stands in for the reply until it arrives.") {
					<div class="d-flex align-items-center gap-2">
						@avatar.Avatar(avatar.Props{Initials: "AI", Size: avatar.SizeXS})
						@shimmer.Shimmer(shimmer.Props{Live: true, Class: "text-secondary"}) {
							Reading the file…
						}
					</div>
				}
			</div>
		</div>
	}
}
