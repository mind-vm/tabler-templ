package main

import (
	"io"
	"net/http"
	"net/http/cookiejar"
	"net/http/httptest"
	"net/url"
	"strings"
	"testing"

	"[[.Module]]/internal/projects"
)

// TestApp signs in, opens the pages and creates a project.
func TestApp(t *testing.T) {
	srv := httptest.NewServer((&app{auth: newAuth(), projects: projects.NewStore()}).routes())
	defer srv.Close()
	jar, _ := cookiejar.New(nil)
	c := &http.Client{Jar: jar, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}

	get := func(path string) (int, string) {
		res, err := c.Get(srv.URL + path)
		if err != nil {
			t.Fatal(err)
		}
		defer res.Body.Close()
		b, _ := io.ReadAll(res.Body)
		return res.StatusCode, string(b)
	}
	post := func(path string, v url.Values) *http.Response {
		req, _ := http.NewRequest("POST", srv.URL+path, strings.NewReader(v.Encode()))
		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
		res, err := c.Do(req)
		if err != nil {
			t.Fatal(err)
		}
		res.Body.Close()
		return res
	}

	if code, _ := get("/projects"); code != http.StatusSeeOther {
		t.Fatalf("/projects without a session: %d, want a redirect to sign in", code)
	}
	if res := post("/sign-in", url.Values{"email": {"admin@example.com"}, "password": {"admin"}}); res.StatusCode != http.StatusSeeOther {
		t.Fatalf("sign in: %d", res.StatusCode)
	}
	for _, path := range []string{"/", "/projects", "/projects?q=app&status=active", "/projects/new", "/projects/1"} {
		if code, body := get(path); code != http.StatusOK || !strings.Contains(body, "</html>") {
			t.Errorf("%s: %d", path, code)
		}
	}
	res := post("/projects", url.Values{"name": {"Test project"}, "status": {"active"}, "budget": {"1200"}})
	if res.StatusCode != http.StatusSeeOther {
		t.Fatalf("create: %d", res.StatusCode)
	}
	if _, body := get(res.Header.Get("Location")); !strings.Contains(body, "Test project") {
		t.Error("the new project's page does not show it")
	}
	if res := post("/projects", url.Values{"name": {""}}); res.StatusCode != http.StatusUnprocessableEntity {
		t.Errorf("create without a name: %d, want 422", res.StatusCode)
	}
}
