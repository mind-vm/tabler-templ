// Package button renders Tabler buttons (.btn) as <button> or, with Href, as <a>.
package button

import (
	"github.com/mind-vm/tabler-templ/icon"
	"github.com/mind-vm/tabler-templ/kit"
)

// Variant picks the Tabler color class. The zero value is Tabler's neutral button.
type Variant string

const (
	VariantDefault   Variant = ""
	VariantPrimary   Variant = "primary"
	VariantSecondary Variant = "secondary"
	VariantSuccess   Variant = "success"
	VariantWarning   Variant = "warning"
	VariantDanger    Variant = "danger"
	VariantInfo      Variant = "info"
	VariantGhost     Variant = "ghost-secondary"
	VariantLink      Variant = "link"
)

type Size string

const (
	SizeDefault Size = ""
	SizeSmall   Size = "sm"
	SizeLarge   Size = "lg"
	SizeXLarge  Size = "xl"
)

// Animation is a hover animation of the button's icon (btn-animate-icon).
type Animation string

const (
	AnimateNone      Animation = ""
	AnimateMove      Animation = "move"       // the trailing icon moves to the end
	AnimateMoveStart Animation = "move-start" // the leading icon moves to the start
	AnimateRotate    Animation = "rotate"
	AnimateShake     Animation = "shake"
	AnimatePulse     Animation = "pulse"
	AnimateTada      Animation = "tada"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    Variant
	Outline    bool // btn-outline-<variant>
	Ghost      bool // btn-ghost-<variant>: no border, color on hover
	Size       Size
	Href       string // renders <a>
	Type       string // button type, default "submit" like a plain <button>
	Disabled   bool
	Icon       string // leading icon, e.g. "ti-plus"
	IconEnd    string // trailing icon (icon-end), not shown on icon-only buttons
	Block      bool   // full width (w-100)
	Pill       bool   // btn-pill: fully rounded
	Square     bool   // btn-square: no rounded corners
	Action     bool   // btn-action: compact, borderless icon button for card headers and toolbars
	Animate    Animation
	Floating   bool // pinned to the bottom corner of the viewport (btn-floating)
	Loading    bool   // btn-loading: a spinner replaces the content
	IconOnly   bool   // square icon button (btn-icon); give it a Label
	Label      string // aria-label and title, for icon-only buttons
}

// Classes returns the class string of a button, for styling other elements as one.
func Classes(p Props) string {
	v := ""
	if p.Variant != VariantDefault {
		if p.Outline {
			v = "btn-outline-" + string(p.Variant)
		} else if p.Ghost {
			v = "btn-ghost-" + string(p.Variant)
		} else {
			v = "btn-" + string(p.Variant)
		}
	}
	s := ""
	if p.Size != SizeDefault {
		s = "btn-" + string(p.Size)
	}
	a := ""
	if p.Animate != AnimateNone {
		a = "btn-animate-icon" + kit.If(p.Animate != AnimateMove, " btn-animate-icon-"+string(p.Animate))
	}
	return kit.Classes("btn", kit.If(p.Pill, "btn-pill"), kit.If(p.Square, "btn-square"), v, s, a, p.Class, kit.If(p.Action, "btn-action"), kit.If(p.Floating, "btn-floating"), kit.If(p.Block, "w-100"), kit.If(p.IconOnly, "btn-icon"), kit.If(p.Loading, "btn-loading"),
		kit.If(p.Disabled && p.Href != "", "disabled"))
}

func attrs(p Props) templ.Attributes {
	a := kit.Attrs(p.Attributes)
	if p.ID != "" {
		a = kit.Default(a, "id", p.ID)
	}
	if p.Label != "" {
		a = kit.Default(a, "aria-label", p.Label)
		a = kit.Default(a, "title", p.Label)
	}
	return a
}

templ Button(props ...Props) {
	{{ p := kit.First(props) }}
	if p.Href != "" {
		<a
			href={ templ.URL(p.Href) }
			class={ Classes(p) }
			if p.Disabled {
				aria-disabled="true"
				tabindex="-1"
			}
			{ attrs(p)... }
		>
			@content(p) {
				{ children... }
			}
		</a>
	} else {
		<button
			if p.Type != "" {
				type={ p.Type }
			}
			class={ Classes(p) }
			disabled?={ p.Disabled }
			{ attrs(p)... }
		>
			@content(p) {
				{ children... }
			}
		</button>
	}
}

templ content(p Props) {
	if p.Icon != "" {
		@icon.Icon(p.Icon)
	}
	{ children... }
	if p.IconEnd != "" && !p.IconOnly {
		@icon.Icon(p.IconEnd, icon.Props{Class: "icon-end"})
	}
}

type ListProps struct {
	Class      string
	Attributes templ.Attributes
	Center     bool // btn-list-center
}

// List lays out buttons in a row with Tabler's gaps (.btn-list).
templ List(props ...ListProps) {
	{{ p := kit.First(props) }}
	<div class={ kit.Classes("btn-list", kit.If(p.Center, "btn-list-center"), p.Class) } { p.Attributes... }>
		{ children... }
	</div>
}

// Actions groups action buttons (Action: true) without gaps (.btn-actions).
templ Actions(props ...ListProps) {
	{{ p := kit.First(props) }}
	<div class={ kit.Classes("btn-actions", p.Class) } { p.Attributes... }>
		{ children... }
	</div>
}

type GroupProps struct {
	Class      string
	Attributes templ.Attributes
	Vertical   bool
	Size       Size   // btn-group-sm, btn-group-lg
	Label      string // aria-label of the group
}

// Group joins buttons (or Checks) into one bar with shared borders (btn-group).
templ Group(props ...GroupProps) {
	{{ p := kit.First(props) }}
	<div
		class={ kit.Classes(kit.If(!p.Vertical, "btn-group"), kit.If(p.Vertical, "btn-group-vertical"), kit.If(p.Size != SizeDefault, "btn-group-"+string(p.Size)), p.Class) }
		role="group"
		if p.Label != "" {
			aria-label={ p.Label }
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

type CheckProps struct {
	ID         string // required: the label points at it
	Class      string // on the label, e.g. a variant such as "btn-outline-primary"
	Attributes templ.Attributes
	Name       string
	Value      string
	Label      string
	Checked    bool
	Radio      bool
	Disabled   bool
}

// Check is a radio or checkbox that looks like a button (btn-check), e.g. in a Group.
templ Check(p CheckProps) {
	<input
		if p.Radio {
			type="radio"
		} else {
			type="checkbox"
		}
		class="btn-check"
		if p.Name != "" {
			name={ p.Name }
		}
		if p.Value != "" {
			value={ p.Value }
		}
		id={ p.ID }
		autocomplete="off"
		checked?={ p.Checked }
		disabled?={ p.Disabled }
		{ p.Attributes... }
	/>
	<label for={ p.ID } class={ kit.Classes("btn", p.Class) }>{ p.Label }</label>
}
