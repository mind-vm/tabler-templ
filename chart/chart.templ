// Package chart renders Tabler's charts with Apache ECharts (Apache-2.0), set up the way the Tabler
// preview draws them (series in Tabler's colors, no chrome around a card's plot, sparklines, legends,
// annotations). The options are built in Go; a small script, rendered once per page, starts every chart.
// Load ECharts with Library.
//
//	@chart.Chart(chart.Props{
//		ID: "revenue", Label: "Revenue", Type: chart.Area, Size: chart.SizeSmall, Sparkline: true,
//		Series: []chart.Serie{{Name: "Revenue", Color: "primary", Data: revenue}},
//	})
//
// A chart is drawn when it comes near the screen, one chart at a time, so a page with many charts stays
// responsive. Charts in content swapped in later (e.g. by htmx) start on htmx:afterSettle, or call
// window.tablerCharts.init(element); window.tablerCharts.flush() draws all at once (it returns a promise).
// The ECharts instance of a drawn chart is element.tablerChart.
// Before removing or replacing content with charts in it, call window.tablerCharts.destroy(element): it
// frees the drawn charts and drops the ones still waiting to be drawn.
package chart

import (
	"github.com/mind-vm/tabler-templ/cdn"
	"encoding/json"
	"fmt"
	"github.com/mind-vm/tabler-templ/versions"
	"strings"

	"github.com/mind-vm/tabler-templ/internal/csp"
	"github.com/mind-vm/tabler-templ/kit"
)

// Version is the ECharts version Library loads.
const Version = versions.ECharts

// LibraryURL is ECharts (on cdn.Base).
func LibraryURL() string { return cdn.URL("echarts", Version, "dist/echarts.min.js") }

// Type is the kind of chart.
type Type string

const (
	Bar         Type = "bar"
	Line        Type = "line"
	Area        Type = "area"
	Pie         Type = "pie"
	Donut       Type = "donut"
	RadialBar   Type = "radialBar"
	PolarArea   Type = "polarArea"
	Radar       Type = "radar"
	Scatter     Type = "scatter"
	Heatmap     Type = "heatmap"
	Treemap     Type = "treemap"
	RangeBar    Type = "rangeBar" // a timeline
	BoxPlot     Type = "boxPlot"
	Bubble      Type = "bubble"
	Candlestick Type = "candlestick"
)

// Size is a preset height.
type Size int

const (
	SizeDefault Size = iota // Height, or 10rem
	SizeSmall               // 2.5rem, a sparkline at the bottom of a card (chart-sm)
	SizeLarge               // 15rem (chart-lg)
)

// Formatter names an axis label format.
type Formatter string

const (
	Thousands Formatter = "thousands" // 12,400
	SuffixK   Formatter = "suffix-k"  // 12K
	Percent   Formatter = "percent"   // 58%
)

// Point is one point of a serie that needs more than a number: x and y for a heatmap or treemap cell,
// y = [start, end] for a timeline row, [open, high, low, close] for a candlestick, [min, q1, median, q3,
// max] for a box plot, and z, the size, for a bubble.
type Point struct {
	X any `json:"x"`
	Y any `json:"y"`
	Z any `json:"z,omitempty"`
}

// Serie is one serie of a chart; in a pie, donut, radial bar or polar area chart it is one slice with
// its value in Data[0].
type Serie struct {
	Name string
	// Type overrides the chart's type for this serie, e.g. "column" in a line chart: a combination chart.
	Type   string
	Data   []float64
	Points []Point // instead of Data
	// Color is a Tabler color ("primary", "green") or any CSS color; default the chart's Color, or the
	// next color of Tabler's chart palette.
	Color        string
	ColorOpacity string // e.g. "80%"
}

// Annotation is a line across the plot: a target or limit on the y axis, a release on the x axis.
type Annotation struct {
	Value any // a number, or a category on the x axis
	Label string
	Color string // default "red"
	Dash  *int   // dash length, default 4
}

// YAxis is one of several y axes; the second one usually sits on the right (Opposite).
type YAxis struct {
	SeriesName string // the serie it scales
	Title      string
	Opposite   bool
	Min, Max   *float64
}

type Props struct {
	// ID names the chart; the element is chart-<ID>, and other charts reach it by this name
	// (BrushTarget).
	ID         string
	Label      string // what the chart shows, for screen readers
	Class      string
	Attributes templ.Attributes
	Type       Type    // default Bar
	Height     float64 // in rem, default 10
	Size       Size
	Series     []Serie
	Categories []string
	// Datetime makes the x axis a time axis; the points are days from StartDate (default 2020-06-20).
	Datetime  bool
	StartDate string
	// Sparkline draws only the plot: no axes, grid or padding.
	Sparkline  bool
	Stacked    bool
	Animations bool
	Toolbar    bool // a zoom, reset and download toolbar
	Horizontal bool // horizontal bars
	Funnel     bool // a bar chart as a funnel; give each stage a color in Colors
	Legend     bool
	// DataLabels writes the values on the bars, slices or points.
	DataLabels bool
	Title      string
	Color      string   // the color of every serie without its own
	Colors     []string // CSS colors, one per serie or per point (Funnel)
	RadarSize  float64  // the radar's radius in px
	// StrokeWidth, StrokeDash and StrokeCurve ("smooth", "straight", "stepline") style lines and areas;
	// StrokeLinecap ("round") the bar of a radial bar chart.
	StrokeWidth   []float64
	StrokeDash    []float64
	StrokeCurve   string
	StrokeLinecap string
	HideGrid      bool
	ShowX         bool // vertical grid lines
	XFormatter    Formatter
	YFormatter    Formatter
	YMax          *float64
	YTitle        string
	YTooltip      bool
	YAxes         []YAxis
	HideTooltip   bool
	HidePoints    bool // no dot on hover
	ShowMarkers   bool // a dot on every point
	AnnotationsX  []Annotation
	AnnotationsY  []Annotation
	// Group syncs the tooltip and zoom of charts with the same group.
	Group string
	// BrushTarget makes this chart the range selector of the chart with that ID, selecting
	// SelectionFrom to SelectionTo (Unix milliseconds) at first.
	BrushTarget                string
	SelectionFrom, SelectionTo float64
	// Options are ECharts options merged over the built ones (maps merge key by key; a list, such as
	// series or yAxis, replaces the built one).
	Options map[string]any

	raw        map[string]any // a complete config instead of the built one
	formatters map[string]string
}

func (p Props) json() string {
	b, _ := json.Marshal(p.build())
	return string(b)
}

// style is the element's height (ECharts draws into the element's box) and the style of Attributes.
func (p Props) style() string {
	s := fmt.Sprintf("height:%.0fpx;", p.heightPx())
	if v, ok := p.Attributes["style"].(string); ok {
		s += v
	}
	return s
}

func (p Props) attributes() templ.Attributes {
	if _, ok := p.Attributes["style"]; !ok {
		return p.Attributes
	}
	a := templ.Attributes{}
	for k, v := range p.Attributes {
		if k != "style" {
			a[k] = v
		}
	}
	return a
}

// Chart is a chart.
templ Chart(p Props) {
	<div
		id={ "chart-" + p.ID }
		class={ kit.Classes("position-relative", kit.If(p.Size == SizeSmall, "chart-sm"), kit.If(p.Size == SizeLarge, "chart-lg"), p.Class) }
		role="img"
		if p.Label != "" {
			aria-label={ p.Label }
		}
		style={ templ.SafeCSS(p.style()) }
		data-tabler-chart={ p.json() }
		{ p.attributes()... }
	></div>
	@Script()
}

type RadialProps struct {
	ID     string
	Class  string
	Title  string // shown above the value, in capitals
	Value  float64
	Height int // in px, default 350
	Color  string
}

// Radial is a single percentage as a radial bar with its title, e.g. the share of active users.
templ Radial(p RadialProps) {
	@Chart(radial(p))
}

func radial(p RadialProps) Props {
	h := p.Height
	if h == 0 {
		h = 350
	}
	color := colorVar(kit.Or(p.Color, "primary"))
	return Props{ID: p.ID, Label: p.Title, Class: p.Class, Height: float64(h) / 16, raw: Gauge(GaugeOptions{
		Value: p.Value, Label: strings.ToUpper(p.Title), Color: color, Width: 14, Radius: "90%",
		LabelSize: 14, ValueSize: 30, ValueWeight: 700,
	})}
}

// GaugeOptions describe a single percentage drawn as a ring from -120° to 120°.
type GaugeOptions struct {
	Value               float64
	Label               string // under the value, muted; empty for none
	Color               string // CSS color of the bar
	Track               string // CSS color of the ring behind it, default var(--tblr-bg-surface-secondary)
	Width               float64
	Radius              string // e.g. "90%"
	LabelSize           int
	ValueSize           int
	ValueWeight         int
	StartAngle, EndAngle float64 // ECharts angles, default 210 and -30
}

// Gauge is the ECharts option of a single percentage as a ring, for RawProps (chart.Radial and the
// Gauge card of blocks/metric use it).
func Gauge(g GaugeOptions) map[string]any {
	if g.StartAngle == 0 && g.EndAngle == 0 {
		g.StartAngle, g.EndAngle = 210, -30
	}
	track := firstOf(g.Track, "var(--tblr-bg-surface-secondary)")
	return map[string]any{
		"animation": false,
		"series": []map[string]any{{
			"type": "gauge", "startAngle": g.StartAngle, "endAngle": g.EndAngle, "min": 0, "max": 100, "radius": firstOf(g.Radius, "90%"),
			"progress": map[string]any{"show": true, "roundCap": true, "width": g.Width, "itemStyle": map[string]any{"color": g.Color}},
			"axisLine": map[string]any{"roundCap": true, "lineStyle": map[string]any{"width": g.Width, "color": [][2]any{{1, track}}}},
			"pointer":  map[string]any{"show": false}, "axisTick": map[string]any{"show": false}, "splitLine": map[string]any{"show": false},
			"axisLabel": map[string]any{"show": false}, "anchor": map[string]any{"show": false},
			"title": map[string]any{"show": g.Label != "", "offsetCenter": []any{0, "28%"}, "fontSize": g.LabelSize, "color": textColor},
			"detail": map[string]any{"formatter": "{value}%", "fontSize": g.ValueSize, "fontWeight": g.ValueWeight, "color": bodyColor,
				"offsetCenter": []any{0, map[bool]string{true: "-6%", false: "0%"}[g.Label != ""]}},
			"data": []map[string]any{{"value": g.Value, "name": g.Label}},
		}},
	}
}

// Toggle makes an element, e.g. a legend.Legend with Button, show and hide a serie of the chart with
// that ID; it also toggles legend-off on the element.
func Toggle(id, serie string) templ.Attributes {
	return templ.Attributes{"data-chart-toggle": id, "data-series": serie}
}

// Library loads ECharts; put it in the page's head.
templ Library() {
	<script { csp.Nonce(ctx)... } src={ LibraryURL() } defer></script>
}

var once = templ.NewOnceHandle()

// Script starts every chart on the page. Chart renders it (once per page), so it is only needed for
// charts rendered without this package.
templ Script() {
	@once.Once() {
		<script { csp.Nonce(ctx)... }>
			(function () {
				if (window.tablerCharts) return;
				var formatters = {
					thousands: function (v) { return Number(v).toLocaleString('en-US'); },
					'suffix-k': function (v) { return v + 'K'; },
					percent: function (v) { return v + '%'; },
					// timeline draws a range [start, end] on row value(0), for the timeline chart type.
					timeline: function (params, api) {
						var row = api.value(0), s = api.coord([api.value(1), row]), e = api.coord([api.value(2), row]);
						var h = api.size([0, 1])[1] * 0.5;
						var cs = params.coordSys;
						var rect = echarts.graphic.clipRectByRect({ x: s[0], y: s[1] - h / 2, width: e[0] - s[0], height: h },
							{ x: cs.x, y: cs.y, width: cs.width, height: cs.height });
						return rect && { type: 'rect', transition: ['shape'], shape: Object.assign(rect, { r: 3 }), style: api.style() };
					},
				};
				// ECharts draws on a canvas, which needs literal colors: every var() / color-mix() of a chart is
				// resolved on a probe inside the chart (one style pass per chart) and turned into rgba() on a 1×1
				// canvas. A new theme resolves them again.
				var cx = Object.assign(document.createElement('canvas'), { width: 1, height: 1 }).getContext('2d', { willReadFrequently: true });
				function literal(css) {
					cx.clearRect(0, 0, 1, 1);
					cx.fillStyle = 'rgba(0,0,0,0)';
					cx.fillStyle = css;
					cx.fillRect(0, 0, 1, 1);
					var d = cx.getImageData(0, 0, 1, 1).data;
					return 'rgba(' + d[0] + ',' + d[1] + ',' + d[2] + ',' + (d[3] / 255).toFixed(3) + ')';
				}
				function walk(v, fn) {
					if (typeof v === 'string') return fn(v);
					if (Array.isArray(v)) return v.map(function (x) { return walk(x, fn); });
					if (v && typeof v === 'object') {
						var o = {};
						Object.keys(v).forEach(function (k) { o[k] = walk(v[k], fn); });
						return o;
					}
					return v;
				}
				// A color is a whole string with var() or color-mix(); CSS text (a tooltip's extraCssText) keeps its var().
				function isColor(s) { return s.indexOf(';') < 0 && (s.indexOf('var(') >= 0 || s.indexOf('color-mix(') === 0); }
				function resolveAll(el, option) {
					var found = [];
					walk(option, function (s) { if (isColor(s) && found.indexOf(s) < 0) found.push(s); return s; });
					if (!found.length) return option;
					var box = document.createElement('div');
					box.style.cssText = 'position:absolute;width:0;height:0;overflow:hidden;visibility:hidden';
					var probes = found.map(function (s) { var p = document.createElement('span'); p.style.color = s; box.appendChild(p); return p; });
					el.appendChild(box);
					var map = {};
					found.forEach(function (s, i) { var c = getComputedStyle(probes[i]).color; map[s] = c ? literal(c) : s; });
					box.remove();
					return walk(option, function (s) { return map[s] || s; });
				}
				function set(obj, path, value) {
					var keys = path.split('.');
					for (var i = 0; i < keys.length - 1; i++) {
						if (obj[keys[i]] == null || typeof obj[keys[i]] !== 'object') return;
						obj = obj[keys[i]];
					}
					obj[keys[keys.length - 1]] = value;
				}
				function data(el) { return JSON.parse(el.getAttribute('data-tabler-chart')); }
				// option is a chart's ECharts option with formatters, the page's font and resolved colors.
				function option(el) {
					var d = data(el);
					var o = resolveAll(el, d.option);
					o.textStyle = Object.assign({ fontFamily: getComputedStyle(el).fontFamily }, o.textStyle);
					Object.keys(d.formatters || {}).forEach(function (path) {
						var f = formatters[d.formatters[path]];
						if (f) set(o, path, f);
					});
					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) o.animation = false;
					return o;
				}
				// draw starts one chart; a brush draws its target first.
				function draw(el) {
					if (el.tablerChart || !el.isConnected) return;
					var d = data(el);
					var c = el.tablerChart = echarts.init(el, null, { renderer: 'canvas' });
					c.setOption(option(el));
					el.tablerResize = new ResizeObserver(function () { c.resize(); });
					el.tablerResize.observe(el);
					if (d.group) { c.group = d.group; echarts.connect(d.group); }
					if (d.brush) {
						// The brush chart's slider zooms its target, which gets an inside zoom to follow it.
						var target = document.getElementById('chart-' + d.brush.target);
						if (target) {
							draw(target);
							var tc = target.tablerChart;
							if (!tc) return;
							tc.setOption({ dataZoom: [{ id: 'brush', type: 'inside', xAxisIndex: 0, filterMode: 'none' }] });
							var follow = function (from, to) { tc.dispatchAction({ type: 'dataZoom', dataZoomId: 'brush', startValue: from, endValue: to }); };
							follow(d.brush.from, d.brush.to);
							c.on('datazoom', function () {
								var z = c.getOption().dataZoom[0];
								follow(z.startValue, z.endValue);
							});
						}
					}
				}
				// A chart is drawn when it comes near the screen: charts further down wait, and charts in a
				// hidden tab or dialog are drawn when it opens, at their real width.
				var io = 'IntersectionObserver' in window ? new IntersectionObserver(function (entries) {
					entries.forEach(function (e) {
						if (e.isIntersecting) { io.unobserve(e.target); draw(e.target); }
					});
				}, { rootMargin: '300px 0px' }) : null;
				function init(root) {
					if (!window.echarts) return;
					var els = [].slice.call((root || document).querySelectorAll('[data-tabler-chart]'));
					if (root && root.matches && root.matches('[data-tabler-chart]')) els.push(root);
					els.forEach(function (el) {
						if (el.tablerChart || el.tablerWatched) return;
						el.tablerWatched = true;
						io ? io.observe(el) : draw(el);
					});
				}
				// flush draws every chart now, e.g. before a screenshot or printing.
				function flush() {
					document.querySelectorAll('[data-tabler-chart]').forEach(function (el) {
						if (io) io.unobserve(el);
						draw(el);
					});
					return Promise.resolve();
				}
				window.addEventListener('beforeprint', function () {
					flush();
					document.querySelectorAll('[data-tabler-chart]').forEach(function (el) { if (el.tablerChart) el.tablerChart.resize(); });
				});
				// destroy tears down the charts in root (root itself included) before it leaves the page: ECharts
				// keeps its instance and listeners after the element is gone, so content that is replaced again
				// and again (a stream, a polled panel) would pile them up.
				function destroy(root) {
					if (!root || !root.querySelectorAll) return;
					var els = [].slice.call(root.querySelectorAll('[data-tabler-chart]'));
					if (root.matches && root.matches('[data-tabler-chart]')) els.push(root);
					els.forEach(function (el) {
						if (io) io.unobserve(el);
						el.tablerWatched = false;
						if (el.tablerResize) { el.tablerResize.disconnect(); el.tablerResize = null; }
						if (!el.tablerChart) return;
						try { el.tablerChart.dispose(); } catch (e) { console.error(e); }
						el.tablerChart = null;
					});
				}
				// A new color mode or theme (Tabler's theme switch, the settings panel) redraws the drawn charts
				// with their colors resolved again.
				var restyling = false;
				new MutationObserver(function () {
					if (restyling) return;
					restyling = true;
					requestAnimationFrame(function () {
						restyling = false;
						document.querySelectorAll('[data-tabler-chart]').forEach(function (el) {
							if (el.tablerChart) el.tablerChart.setOption(option(el), { notMerge: true });
						});
					});
				}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme', 'data-bs-theme-primary', 'data-bs-theme-base', 'data-bs-theme-pack', 'data-bs-navbar-theme'] });
				window.tablerCharts = { init: init, flush: flush, destroy: destroy, formatters: formatters };
				// ECharts loads with defer, before DOMContentLoaded.
				document.readyState !== 'loading' ? init() : document.addEventListener('DOMContentLoaded', function () { init(); }, { once: true });
				document.addEventListener('htmx:afterSettle', function (e) { init(e.target); });
				document.addEventListener('click', function (e) {
					var t = e.target.closest && e.target.closest('[data-chart-toggle]');
					var el = t && document.getElementById('chart-' + t.getAttribute('data-chart-toggle'));
					if (!el || !el.tablerChart) return;
					el.tablerChart.dispatchAction({ type: 'legendToggleSelect', name: t.getAttribute('data-series') });
					t.classList.toggle('legend-off');
				});
			})();
		</script>
	}
}

func init() {
	cdn.Register("chart", "echarts", Version, "dist/echarts.min.js")
}
