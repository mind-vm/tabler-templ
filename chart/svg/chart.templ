package svg

import (
	"fmt"

	"github.com/mind-vm/tabler-templ/internal/csp"
	"github.com/mind-vm/tabler-templ/kit"
	"github.com/mind-vm/tabler-templ/legend"
)

// CSS is the charts' own CSS; Chart renders it once per page (Styles).
const CSS = `.chart-svg-box{position:relative;height:var(--chart-svg-h);font-size:.75rem;line-height:1}` +
	`.chart-svg-plot{position:absolute;container-type:inline-size}` +
	`.chart-svg-plot>svg,.chart-svg-round>svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}` +
	`.chart-svg-plot path{vector-effect:non-scaling-stroke}` +
	`.chart-svg-grid{fill:none;stroke:var(--tblr-border-color);stroke-dasharray:3 3}` +
	`.chart-svg-hit{fill:transparent}.chart-svg-hit:hover{fill:var(--tblr-body-color);fill-opacity:.06}` +
	`.chart-svg-bar:hover,.chart-svg-slice:hover{opacity:.85}` +
	`.chart-svg-line,.chart-svg-dot,.chart-svg-area{pointer-events:none}` +
	`.chart-svg-line{fill:none;stroke-width:2;stroke-linejoin:round;stroke-linecap:round}` +
	`.chart-svg-dot{fill:none;stroke-width:6;stroke-linecap:round}` +
	`.chart-svg-slice{stroke:var(--tblr-bg-surface,#fff);stroke-width:1}` +
	`.chart-svg-track,.chart-svg-ring{fill:none}.chart-svg-track{stroke:var(--tblr-border-color)}.chart-svg-ring{stroke-linecap:round}` +
	`.chart-svg-y,.chart-svg-x,.chart-svg-v,.chart-svg-note{position:absolute;white-space:nowrap;color:var(--tblr-secondary);pointer-events:none}` +
	`.chart-svg-y{right:100%;margin-right:.5rem;transform:translateY(-50%);max-width:16ch;overflow:hidden;text-overflow:ellipsis}` +
	`.chart-svg-x{top:100%;margin-top:.375rem;transform:translateX(-50%)}` +
	`.chart-svg-v{transform:translate(-50%,-100%);margin-top:-.25rem;color:var(--tblr-body-color);font-weight:500}` +
	`.chart-svg-v.chart-svg-in{transform:translate(-50%,-50%);margin:0;color:#fff}` +
	`.chart-svg-v.chart-svg-end{transform:translate(.25rem,-50%);margin:0}` +
	`.chart-svg-note{transform:translate(-100%,-100%);color:#fff;padding:.125rem .25rem;border-radius:2px}` +
	`.chart-svg-round text{text-anchor:middle;fill:var(--tblr-body-color)}` +
	`.chart-svg-big{font-size:16px;font-weight:600}.chart-svg-name{font-size:7px;fill:var(--tblr-secondary)!important}` +
	`.chart-svg-pl{font-size:6px;font-weight:600;fill:#fff!important}` +
	`@container (max-width:24rem){.chart-svg-alt{display:none}}`

var styles = csp.Sheet("chart/svg", CSS)

// Styles renders CSS in a <style> element, once per page; Chart does it itself.
templ Styles() {
	@styles
}

func (p Props) label() string {
	return kit.Or(p.Label, "Chart")
}

func pos(axis string, t tick) string {
	return fmt.Sprintf("%s:%s%%", axis, num(t.Pos))
}

// Chart is a chart drawn as SVG on the server.
templ Chart(p Props) {
	{{ v := p.view() }}
	@styles
	<div
		if p.ID != "" {
			id={ "chart-" + p.ID }
		}
		class={ kit.Classes("chart-svg", p.Class) }
		style={ templ.SafeCSS(p.style(v.Colors)) }
		{ p.Attributes... }
	>
		if v.Round {
			<div class="chart-svg-box chart-svg-round" role="img" aria-label={ p.label() }>
				<svg viewBox={ v.ViewBox } aria-hidden="true" focusable="false">
					@shapes(v.Shapes)
					for _, t := range v.Texts {
						<text x={ num(t.X) } y={ num(t.Y) } class={ t.Class }>{ t.Text }</text>
					}
				</svg>
			</div>
		} else {
			<div class="chart-svg-box" role="img" aria-label={ p.label() }>
				<div class="chart-svg-plot" style={ templ.SafeCSS(v.Inset) }>
					<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
						@shapes(v.Shapes)
					</svg>
					for _, t := range v.YTicks {
						<span class="chart-svg-y" style={ templ.SafeCSS(pos("top", t)) }>{ t.Text }</span>
					}
					for _, t := range v.XTicks {
						<span class={ kit.Classes("chart-svg-x", kit.If(t.Alt, "chart-svg-alt")) } style={ templ.SafeCSS(pos("left", t)) }>{ t.Text }</span>
					}
					for _, l := range v.Labels {
						<span class={ l.Class } style={ templ.SafeCSS(l.Style) }>{ l.Text }</span>
					}
				</div>
			</div>
		}
		if len(v.Legend) > 0 {
			@legend.List(legend.ListProps{Class: "justify-content-center mt-3"}) {
				for _, l := range v.Legend {
					@legend.Legend(legend.Props{Text: l.Name, Value: l.Value, Attributes: templ.Attributes{"style": "--tblr-legend-color: " + l.Color}})
				}
			}
		}
		if len(v.Rows) > 0 {
			<table class="visually-hidden">
				<caption>{ p.label() }</caption>
				<thead>
					<tr>
						for _, h := range v.Head {
							<th scope="col">{ h }</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, r := range v.Rows {
						<tr>
							<th scope="row">{ r[0] }</th>
							for _, c := range r[1:] {
								<td>{ c }</td>
							}
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

templ shapes(ss []shape) {
	for _, s := range ss {
		<path
			d={ s.D }
			if s.Class != "" {
				class={ s.Class }
			}
			if s.Style != "" {
				style={ templ.SafeCSS(s.Style) }
			}
		>
			if s.Title != "" {
				<title>{ s.Title }</title>
			}
		</path>
	}
}
